<?xml version="1.0" ?>
<serverDefs xmlns="http://grsoft.ru/schemas/serverDefs.xsd">
	<objects>

    <object name="OrgDiscount">
      <sources>
        <source name="SQTable" type="internal">
          <param name="readFilter">"id in (select id from org where userid = '" + $user.id + "')"</param>
        </source>
      </sources>
      
      <field name="id" type="string" />
      <field name="idItem" type="string" />
      <field name="isFolder" type="number" />
      <field name="discount" type="number" prec="2" />
    </object>
    
