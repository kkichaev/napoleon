#
# установить имя проекта
#
PROJECT=ApiSun

FEATURES = STOP_LIST RCV_MESSAGE VISIT_DOC POD_COMMENT GPS_POS PAY_DELAY
FEATURES+= ORG_COLOR ORG_INFO ORG_NOTE ORG_SKU ORG_REMNANTS ORD_DLV_BIND
FEATURES+= PRICE_MATRIX PRICE_COLOR PRICE_FILTER0 PRESENTATION_EDITOR
FEATURES+= NAPOLEON_APPS EDIT_USER PYTHON_REPORTER MAIN_DEPARTMENT
 
NPL_PDA_RESOURCE=

INST_FILES=addDefs.xml

#
# если есть WinMobile закомментарить
#
NO_WIN_MOBILE=1

NEW_CORE=1

MANAGER_SOURCE=FmPriceEx FmDetailEx UserFormEx DivisionFormEx

MANAGER_FORMS=FmAgentOrg FmDealer FmDealerEdit FmFolderEdit FmOrg FmOrgEdit FmOrgType FmOrgTypeEdit FmRegionEdit FmSKUEdit FmReport FmReportRemn FmReportAssortChanges FmReportPresent FmReportOrg FmClientCardReportParam FmPlanogramEdit FmVisitReport
MANAGER_SOURCE=Tree FmDetailEx FmPriceEx DivisionFormEx UserFormEx ClientCardReport PrjObj DivisionSummaryEx MainFormEx