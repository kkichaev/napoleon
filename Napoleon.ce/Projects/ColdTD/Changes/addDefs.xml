    <object name="PriceSeries">
      <sources>
        <source name="SQLQuery">
          <param name="stmt">
            "select * from PriceSeries where userid = '" + $user.id + "'"
          </param>
        </source>
      </sources>
      <field name="id" type="string" />
      <field name="qty" type="number" prec="3" />
      <field name="country" type="string" />
      <field name="countryCode" type="string" />
      <field name="prdDate" type="date" />
      <field name="ntd" type="string"  />
      <field name="party" type="string"  />
    </object>
    
    <object name="Rfrg">
