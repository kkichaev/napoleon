    <modify src="Price">
      <add>
        <field name="qtyInPack" type="number" prec="3" />
        <field name="qty" type="number" prec="3" />

        <field name="barcode" type="string" />
        <field name="packBarcode" type="string" />
        <field name="priceOrder" type="number" />
        <field name="assortimentGroup" type="string" />
        <field name="reportGroup" type="number" />
        <field name="articul" type="string" />
        <field name="packOKEI" type="string" />

        <field name="vanQty" type="number" prec="3" />
        <field name="tax1" type="number" prec="0" />
        <field name="ntd" type="string" />
        <field name="unit" type="string"  />
        <field name="unitCode" type="string" />
        <field name="country" type="string"  />
        <field name="packName" type="string"  />
        <field name="packCode" type="string"  />
        <field name="brutto" type="number" prec="3"  />
        <field name="countryCode" type="string"  />
      </add>
      <change>
        <sources>
          <source name="SQLQuery">
            <param name="stmt">
              "SELECT Price.id as id, folder, name, [weight], cost, barcode, packBarcode, priceOrder, reportGroup, assortimentGroup, articul, vanQty, tax1, ntd, unit, unitCode, country, packName, packCode, packCode as packOKEI, brutto, countryCode, qty, qtyInPack
              FROM Price, PriceCost where Price.id = PriceCost.id and Price.userid = '" + $user.id + "' ORDER BY Price.id, PriceCost.type"
            </param>
          </source>
        </sources>
      </change>
    </modify>

