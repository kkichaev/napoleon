    <object name="RdrgAudit">
      <sources>
        <source name="SQTable" type="internal" />
      </sources>

      <member name="table">"RGA"</member>
      <member name="primaryKey">"userid,created"</member>

      <field name="userid" type="string" data="USER_ID" execOn="Put">$user.id</field>
      <field name="date" type="date" />
      <field name="created" type="timestamp" />
      <field name="timeZone" type="number" />
      <field name="serverTimeZone" type="number" data="S_TZ" execOn="Put" features="USE_TIMEZONE">ServerTimeZone()</field>
      <field name="sended" type="timestamp" data="S_DATE" execOn="Put">Now()</field>
      <field name="id" width="30" type="string" />
      <field name="exclusive" width="2" type="number" data="EXCL" />
      <field name="items" type="collection">
        <data>
          <object name="Item">
            <sources>
              <source name="SQTable" type="internal" />
            </sources>

            <field name="doc_id" width="30" type="string" />
            <field name="fact_id" width="30" type="string" />
            <field name="fact_rfid" width="30" type="string" />
            <field name="model" width="50" type="string" />
            <field name="descr" width="100" type="string" />
          </object>
        </data>
      </field>

      <field name="latitude" type="number" prec="4" />
      <field name="longitude" type="number" prec="4" />

      <events>
        <event type="put">
          <action name="WriteInternal">$object.type</action>
          <action name="WriteToLog">$object.type;$object.date</action>
        </event>
      </events>
    </object>

    <object name="ItemsAudit">
      <sources>
        <source name="SQTable" type="internal" />
      </sources>

      <member name="table">"IA"</member>
      <member name="primaryKey">"userid,created"</member>

      <field name="userid" type="string" data="USER_ID" execOn="Put">$user.id</field>
      <field name="date" type="date" />
      <field name="created" type="timestamp" />
      <field name="timeZone" type="number" />
      <field name="serverTimeZone" type="number" data="S_TZ" execOn="Put" features="USE_TIMEZONE">ServerTimeZone()</field>
      <field name="sended" type="timestamp" data="S_DATE" execOn="Put">Now()</field>
      <field name="id" width="30" type="string" />
      <field name="orderCreated" type="number" width="1" data="ORD_OK" />
      <field name="items" type="collection">
        <data>
          <object name="Item">
            <sources>
              <source name="SQTable" type="internal" />
            </sources>

            <field name="id" width="30" type="string" data="ID_I"/>
            <field name="repr" type="number" width="1" />
            <field name="pack" type="number" width="1" />
            <field name="block" type="number" width="1" />
            <field name="price" type="number" width="1" />
          </object>
        </data>
      </field>

      <field name="latitude" type="number" prec="4" />
      <field name="longitude" type="number" prec="4" />

      <events>
        <event type="put">
          <action name="WriteInternal">$object.type</action>
          <action name="WriteToLog">$object.type;$object.date</action>
        </event>
      </events>
    </object>

