    <modify src="DiscountConditions" dest="AgentDiscountConditions">
      <change>
        <sources>
          <source name="SQLQuery">
            <param name="stmt">
              "select d.*, di.id id_i, di.type from
              (select * from DiscountConditions where
               id in 
               (select distinct od.id from
                (select id from OrgDiscount where idOrg in (select id from AgentData where userid = '$01' and [type] = 'Org')
                union all
                select d.id from Discount d left join OrgDiscount od on d.id = od.id where idOrg is null) od,
               (select distinct id from StoreDiscount where idStore in (select id from AgentStoreData where userid = '$01')
                 union all
                select d.id from Discount d left join StoreDiscount od on d.id = od.id where idStore is null) sd
               where od.id = sd.id)
              ) d left join
              (select * from DiscountConditions$items where
                [type] = 1 or id in (select id from AgentData where [type] = 'Price' and userid = '$01')
              ) di on d.id = di.DiscountConditions$id
              order by id, idCnd"
            </param>
            <param name="$01">$user.id</param>
          </source>
        </sources>
      </change>
    </modify>
    <modify src="AgentDiscountConditions$items">
      <change>
        <sources>
          <source name="SQLQuery">
            <param name="keyFields">"id,idCnd"</param>
            <param name="checkNullField">"id"</param>
          </source>
