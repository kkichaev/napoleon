    <modify src="Delivery" dest="AgentDelivery">
      <change>
        <sources>
          <source name="SQLQuery">
            <param name="stmt">
              "select d.* from Delivery d,
              (select distinct d.id, d.number from Delivery d, Delivery$items di,
              (select id from AgentData where [type] = 'Org' and userid = '$01') ad,
              (select id from AgentData where [type] = 'Price' and userid = '$01') ap
              where d.uid = di.Delivery$uid
              and d.id = ad.id and di.id = ap.id
              and d.date &gt;= $02) ad
              where d.id = ad.id and d.number = ad.number"
            </param>
            <param name="$01">$user.id</param>
            <param name="$02">ToDate(FormatDate(AdjustDate(Now(),-3,"month"),"DD.MM.YYYY"))</param>
