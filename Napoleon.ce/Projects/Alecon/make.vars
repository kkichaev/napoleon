#
# установить имя проекта
#
PROJECT=Alecon

FEATURES = STOP_LIST RCV_MESSAGE VISIT_DOC POD_COMMENT GPS_POS PAY_DELAY
FEATURES+= ORG_COLOR ORG_INFO ORG_NOTE ORG_SKU ORG_REMNANTS ORD_DLV_BIND
FEATURES+= PRICE_MATRIX PRICE_COLOR PRICE_FILTER0 PRESENTATION_EDITOR SQL_ORG_ROUTE 
FEATURES+= RETURN_DOC PRICE_MONITORING QUESTION QUESTION_REPORT STD_QUESTION_REPORT STD_MONITOR_REPORT SCRIPT_DOC
FEATURES+= NAPOLEON_APPS QUESTION_IN_SCRIPTS SUM_WEIGHT_LABEL USE_COST_IN_RETURNS

NPL_PDA_RESOURCE=

INST_FILES=addDefs.xml

#
# если есть WinMobile закомментарить
#
NO_WIN_MOBILE=1

NEW_CORE=1

MANAGER_SOURCE=FmOrgMatrixDesigner FmOrgMatrixDesigner.Designer FmOrgMatrix FmOrgMatrix.Designer
MANAGER_RESOURCE=FmOrgMatrixDesigner FmOrgMatrix