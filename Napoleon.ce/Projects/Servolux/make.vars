FEATURES = VERSION_4 STOP_LIST RCV_MESSAGE VISIT_DOC POD_COMMENT GPS_POS PAY_DELAY
FEATURES+= ORG_COLOR ORG_INFO ORG_NOTE ORG_SKU ORG_REMNANTS ORD_DLV_BIND
FEATURES+= PRICE_MATRIX PRICE_COLOR PRICE_FILTER0 PRESENTATION_EDITOR SQL_ORG_ROUTE HAVE_CONFIG_READER
FEATURES+= SCRIPT_DOC SELECT_ORG_LOCATION QUESTION QUESTION_REPORT STD_QUESTION_REPORT QUESTION_IN_SCRIPTS
FEATURES+= NAPOLEON_APPS PYTHON_REPORTER AGENT_ORG_TASK DETAIL_AGENT_TASK_MENU CAN_ADD_ORG_TO_CENSUS

FEATURES+= MAX_PIC_SIZE=220
FEATURES+= HTTP_SERVER FOTO_ON_DISK NO_YANDEX_LOCATION QUESTION_REPORT_PYTHON ORG_DISPOSITION 
FEATURES+= USE_CURL 
FEATURES+= COM_SERVER ODBC_PLUGIN VISIT_ITEM_DATE

#FEATURES+= RETURN_DOC INCASS_DEBET_DISTRIB

SERVER_X64 = 1

NPL_PDA_RESOURCE=

INST_FILES=addDefs.xml

#
# если есть WinMobile закомментарить
#
NO_WIN_MOBILE=1

NEW_CORE=1

MANAGER_SOURCE=FmDetailEx FmOrdersReportEx Helpers ProjectObjects MainFormEx FmReportsEx FmExportPhotoEx
MANAGER_SOURCE+=DivisionsEx FmMatrixDesignerEx FmScriptDesignerEx 	FmScriptEditEx ScriptOverviewEx StackedHeader FmMakeSheduleMerch
MANAGER_FORMS=DailyAgentPlans InputQty SVPlanChanges SVPlanCommit FmChangeOrders FmDisabledFirms DistribDetail FmDistribReport FmChOrdersReport 
#FmSelectOrgs
MANAGER_FORMS+=FmOrgMatrix FmSelMtx MatrixNameDlg FmAgentOrderReport FmDaysGoods FmReturnCauseEditor FmReturnLimitList FmEditAgentLimit FmReturnRequestList RRItems FmReturnRequestReport
MANAGER_FORMS+=FmMakeShedule FmNoOrderRsnList FmMMLEditor OrderBundleOverview ReturnReqOverview RejectActOverview

ADMIN_SOURCE=MainFormEx

ManagerVersion = 4.0.0.15