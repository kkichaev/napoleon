          <param name="readFilter">'"userid"=' + "'" + $user.id + "'"</param>
        </source>
      </sources>

      <member name="primaryKey">userid</member>

      <field name="userid" type="string" />
      <field name="pinHash" type="string" />
      <field name="authByPin" type="number" />
      <field name="resetPin" type="number" />
    </object>
    
