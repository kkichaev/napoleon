<?xml version="1.0" ?>
<serverDefs xmlns="http://grsoft.ru/schemas/serverDefs.xsd">
  <objects>
    <object name="MoveDocs">
      <sources>
        <source name="SQLExecutor" >
          <param name="stmt">
<![CDATA["begin transaction;
drop table temp_table;
commit
begin transaction;
select * into temp_table from [%doc%] where userid = '%src%';
update temp_table set userid = '%dst%' where userid = '%src%';
insert into [%doc%] select * from temp_table;
update %doc%$items set %doc%$userid= '%dst%' where %doc%$userid = '%src%';
delete from [%doc%] where userid = '%src%';
commit"]]></param>
        </source>
      </sources>
      <field name="src" type="string" />
      <field name="dst" type="string" />
      <field name="doc" type="string" />
    </object>

    <object name="CopyDocs">
      <sources>
        <source name="SQLExecutor" >
          <param name="stmt">
            <![CDATA["begin transaction;
drop table temp_table;
commit
begin transaction;
select * into temp_table from [%doc%] where userid = '%src%';
update temp_table set userid = '%dst%' where userid = '%src%';
insert into [%doc%] select * from temp_table;
commit
begin transaction;
drop table temp_table;
commit
select * into temp_table from [%doc%$items] where %doc%$userid = '%src%';
update temp_table set %doc%$userid = '%dst%' where %doc%$userid = '%src%';
insert into [%doc%$items] select * from temp_table;
commit"]]>
          </param>
        </source>
      </sources>
      <field name="src" type="string" />
      <field name="dst" type="string" />
      <field name="doc" type="string" />
    </object>

    <object name="UserPinData">
