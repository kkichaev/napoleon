    <modify src="Visit">
      <change>
        <sources>
          <source name="DBFCatalogTable">
            <param name="tableName">"VIT" + $user.id</param>
            <param name="catalog">"created"</param>
            <param name="ordered">1</param>
          </source>
          <source name="SQTable" type="internal" />
