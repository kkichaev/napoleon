<?xml version="1.0" ?>
<serverDefs xmlns="http://grsoft.ru/schemas/serverDefs.xsd">
  <objects>
    <object name="DistributionMatrix">
      <sources>
        <source name="SQTable" type="internal" />
      </sources>

      <member name="primaryKey">"id"</member>
      <field name="id" type="string" />
      <field name="items" type="collection">
        <data>
          <object name="Item">
            <sources>
              <source name="SQTable" type="internal" />
            </sources>
            <field name="id" type="string" />
          </object>
        </data>
      </field>
    </object>

    <object name="OrgDistribution">
      <sources>
        <source name="SQTable" type="internal" />
      </sources>

      <member name="primaryKey">"userid,created"</member>
      <field name="userid" type="string" data="USER_ID" execOn="Put">$user.id</field>
      <field name="created" type="timestamp" />
      <field name="timeZone" type="number" />
      <field name="serverTimeZone" type="number" data="S_TZ" execOn="Put" features="USE_TIMEZONE">ServerTimeZone()</field>
      <field name="sended" type="timestamp" data="S_DATE" execOn="Put">Now()</field>
      <field name="date" type="date" />
      <field name="id" width="30" type="string" />
      <field name="remark" type="string" />
      <field name="items" type="collection">
        <data>
          <object name="Item">
            <sources>
              <source name="SQTable" type="internal" />
            </sources>
            <field name="id" type="string" />
          </object>
        </data>
      </field>
    </object>

    <object name="OffTakeCoeff">
      <sources>
        <source name="SQTable" type="internal" />
      </sources>

      <member name="primaryKey">"id"</member>
      <field name="id" type="string" />
      <field name="coef" type="number" prec="2" />
    </object>

    <object name="OrgMargins">
      <sources>
        <source name="SQTable" type="internal">
          <param name="readFilter">'"userid"=' + "'" + $user.id + "'"</param>
        </source>
      </sources>

      <member name="primaryKey">"userid,id"</member>
      
      <field name="userid" type="string" />
      <field name="id" type="string" />
      <field name="value" type="number" prec="2" />
    </object>

    <object name="WorkTime">
      <sources>
        <source name="SQTable" type="internal" />
      </sources>

      <member name="primaryKey">"userid,id,start"</member>
      <field name="userid" type="string" execOn="Put">$user.id</field>
      <field name="id" type="string" />
      <field name="start" type="timestamp" />
      <field name="stop" type="timestamp" />
    </object>

    <object name="MatrixOrder">
      <sources>
        <source name="SQTable" type="internal">
          <param name="readFilter">'"userid"=' + "'" + $user.id + "'"</param>
        </source>
      </sources>

      <member name="primaryKey">"userid"</member>

      <field name="userid" type="string" execOn="Put">$user.id</field>
      <field name="items" type="collection">
        <data>
          <object name="MatrixName">
            <sources>
              <source name="SQTable" type="internal" />
            </sources>
            <field name="name" type="string" />
            <field name="order" type="number" />
          </object>
        </data>
      </field>
    </object>

    <object name="OrgCost">
      <sources>
        <source name="DBFTableSet">
          <param name="userTable">"CO"</param>
          <param name="commonTable">"ORGCOSTS"</param>
        </source>
      </sources>

      <field name="id" type="string" />
      <field name="id_i" type="string" />
      <field name="cost" type="number" prec="2" />
    </object>
    
    <object name="OrgPlan">
      <sources>
        <source name="SQTable" type="internal">
          <param name="readFilter">'"userid"=' + "'" + $user.id + "'"</param>
        </source>
      </sources>

      <member name="primaryKey">"userid,id,start"</member>
      
      <field name="id" type="string" />
      <field name="start" type="timestamp" />
      <field name="finish" type="timestamp" />
      <field name="userid" type="string" />
      <field name="changed" type="timestamp" />
      <field name="value" type="number" prec="3" />
      <field name="created" type="timestamp" />
    </object>

    <modify src="Agents">
      <add>
        <field name="division" type="string" width="30" />
      </add>
    </modify>
    <modify src="ManagerPrice">
      <add>
        <field name="unit" type="string" width="20" />
      </add>
    </modify>
    <modify src="Price">
      <add>
        <field name="delist" type="number" />
        <field name="unit" type="string" width="20" />
      </add>
      <change>
        <sources>
          <!-- таблица со включенным фильтром qty > 0  выключать/включать SetFilter(False/True) -->
          <source name="DBFPriceTable">
            <param name="userTable">"W"</param>
            <param name="commonTable">"WAREHOUS"</param>
            <param name="filter">"[folder] in $folder.fid"</param>
            <param name="userFieldName">"division"</param>
          </source>
        </sources>
      </change>
    </modify>
    <modify src="ManagerPrice">
      <change>
        <sources>
          <!-- таблица со включенным фильтром qty > 0  выключать/включать SetFilter(False/True) -->
          <source name="DBFTableSet">
            <param name="userTable">"W"</param>
            <param name="commonTable">"WAREHOUS"</param>
            <param name="userFieldName">"division"</param>
          </source>
        </sources>
      </change>
    </modify>
    <modify src="Org">
      <add>
        <field name="ido" type="string" data="ID_O" />
        <field name="limit" type="string" />
        <field name="payData" type="string" data="PAY_DATA" />
        <field name="dicsount" type="number" prec="2" data="DSC" />
        <field name="owner" type="string" />
      </add>
    </modify>
    <modify src="Delivery">
      <add>
        <field name="dogovor" type="string" />
        <field name="payDate" type="date" />
      </add>
    </modify>
    <modify src="Payment">
      <add>
        <field name="dogovor" type="string" />
      </add>
    </modify>
    <modify src="Order">
      <add>
        <field name="bonus" type="number" width="1" />
      </add>
    </modify>
    <modify src="Incass">
      <change>
        <field name="timeZone" type="number" data="" />
        <field name="serverTimeZone" type="number" data="" execOn="Put" features="USE_TIMEZONE">ServerTimeZone()</field>
      </change>
    </modify>
    <modify src="Returns">
      <change>
        <field name="timeZone" type="number" data="" />
        <field name="serverTimeZone" type="number" data="" execOn="Put" features="USE_TIMEZONE">ServerTimeZone()</field>
      </change>
    </modify>
    <modify src="Returns$items">
      <add>
        <field name="cause" type="string" width="50" />
        <field name="dlvNumber" type="string" width="30" data="NUM_I" />
      </add>
    </modify>
    <modify src="Order" dest="Bonus" table="Bonus">
      <change>
        <member name="table">"BNS"</member>
        <field name="timeZone" type="number" data="" />
        <field name="serverTimeZone" type="number" data="" execOn="Put" features="USE_TIMEZONE">ServerTimeZone()</field>
      </change>
    </modify>
    <modify src="OrgRemnants">
      <change>
        <sources>
          <source name="SQTable" type="internal" />
        </sources>
      </change>
    </modify>

    <modify src="Order" dest="LoadedOrders">
      <change>
        <sources>
          <source name="DBFTableSet">
            <param name="userTable">"LD_ORD"</param>
            <param name="commonTable">"LD_ORDERS"</param>
            <param name="catalog">"created;items;1"</param>
            <param name="filter">"[id] in $Org.id"</param>
            <param name="userFieldName">"division"</param>
          </source>
        </sources>

        <field name="items" type="collection">
          <data>
            <object name="Item">
              <field name="id" type="string" data="ID_I"/>
              <field name="qty" type="number" prec="3" />
              <field name="cost" type="number" prec="2" />
            </object>
          </data>
        </field>
      </change>
      <add>
        <field name="created" type="timestamp" data="CREATED"/>
      </add>
    </modify>
  </objects>
</serverDefs>
