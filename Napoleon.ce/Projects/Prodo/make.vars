PROJECT=Prodo

FEATURES = STOP_LIST RCV_MESSAGE VISIT_DOC POD_COMMENT GPS_POS PAY_DELAY
FEATURES+= ORG_COLOR ORG_INFO ORG_NOTE ORG_SKU ORG_REMNANTS ORD_DLV_BIND QUESTION STD_QUESTION_REPORT QUESTION_REPORT PYTHON_REPORTER
FEATURES+= PRICE_MATRIX PRICE_COLOR PRICE_FILTER0 PRESENTATION_EDITOR SQL_ORG_ROUTE RETURN_DOC SCRIPT_DOC AGENT_ORG_TASK STD_MONITOR_REPORT PRICE_MONITORING QUESTION_IN_SCRIPTS ORG_STOP_EDITOR COVER_IN_ORDER_REPORT
FEATURES+= NAPOLEON_APPS USE_TIMEZONE START_STOP

NPL_PDA_RESOURCE=

INST_FILES=addDefs.xml

#
# если есть WinMobile закомментарить
#
NO_WIN_MOBILE=1

NEW_CORE=1
MANAGER_FORMS=MatrixOrderEditor OffTakeCoeffEditor InputCoef DistribMatrix CopyMatrixTo MemoryBox DistribReport DistribOverview EditOrgMargin EditOrgPlan FmLoadPlan
MANAGER_SOURCE=UserFormEx FmDetailEx ProjectObjects MainFormEx HtmlReportEx

