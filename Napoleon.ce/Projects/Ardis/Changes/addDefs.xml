<?xml version="1.0" ?>
<serverDefs xmlns="http://grsoft.ru/schemas/serverDefs.xsd">
   <objects>
       <object name="AgentOrgs">
         <sources>
            <source name="SQTable" type="internal">
               <param name="readFilter">"userid = '" + $user.id + "'"</param>
            </source>
         </sources>
         <field name="userid" type="string" execOn="Put">$user.id</field>
         <field name="id" type="string" />
      </object>
       <object name="Cost">
         <sources>
            <source name="DBFCostReader">
               <param name="cost">"CS" + $user.id</param>
               <param name="costType">"CT" + $user.id</param>
            </source>
         </sources>
         <field name="data" type="binary" />
      </object>
       <modify src="Org">
           <add>
               <field name="delay" type="number" />
               <field name="costCode" type="string" data="COST" />
               <field name="limit" type="number" prec="2" />
               <field name="license" type="date" />
           </add>
       </modify>
       <modify src="Delivery">
           <add>
               <field name="payDate" type="date" />
           </add>
       </modify>
       <modify src="Price">
           <add>
               <field name="minOrder" type="number" prec="3" />
           </add>
       </modify>
   </objects>
</serverDefs>
