#
# установить имя проекта
#
PROJECT=StepUp

FEATURES = STOP_LIST RCV_MESSAGE VISIT_DOC POD_COMMENT GPS_POS PAY_DELAY
FEATURES+= ORG_COLOR ORG_INFO ORG_NOTE ORG_SKU ORG_REMNANTS ORD_DLV_BIND
FEATURES+= PRICE_MATRIX PRICE_COLOR PRICE_FILTER0 SQL_ORG_ROUTE HAVE_CONFIG_READER
FEATURES+= NAPOLEON_APPS SCRIPT_DOC QUESTION QUESTION_REPORT STD_QUESTION_REPORT QUESTION_IN_SCRIPTS PYTHON_REPORTER SQL_ORG_ROUTE

NPL_PDA_RESOURCE=

INST_FILES=addDefs.xml

#
# если есть WinMobile закомментарить
#
NO_WIN_MOBILE=1

NEW_CORE=1

MANAGER_SOURCE=FmDetailEx MainFormEx ProjectObjects DivisionsEx UserFormEx FmScriptEditEx
MANAGER_FORMS=ContractOverview FmCity FmCityEdit FmContract FmContractEdit FmContractReport FmExportPhoto FmOrg FmOrgAssign FmOrgEdit FmPriceEdit FmScrAssign FmSlsnet FmSlsnetEdit