#
# установить имя проекта
#
PROJECT=Plombir

FEATURES = STOP_LIST RCV_MESSAGE VISIT_DOC POD_COMMENT GPS_POS PAY_DELAY
FEATURES+= ORG_COLOR ORG_INFO ORG_NOTE ORG_SKU ORG_REMNANTS ORD_DLV_BIND
FEATURES+= PRICE_MATRIX PRICE_COLOR PRICE_FILTER0 SALES_MODULE SCRIPT_DOC PRESENTATION_EDITOR FOCUSED_GROUP
FEATURES+= QUESTION QUESTION_REPORT STD_QUESTION_REPORT QUESTION_IN_SCRIPTS AGENT_ORG_TASK

INST_FILES=addDefs.xml

FEATURES += PYTHON_REPORTER


#
# если есть WinMobile закомментарить
#
NO_WIN_MOBILE=1

MANAGER_SOURCE=FmDetailEx UserFormEx FmCensusEx 
MANAGER_FORMS=FmRpt  FmPtnzMap

NEW_CORE=1
