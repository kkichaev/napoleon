  <objects>
    <object name="ApproveReportDocs">
      <sources>
        <source name="SQLQuery">
          <param name="stmt">
"select a.userid, a.created, a.id, ai.qty from ApproveLayout a, LayoutApproveLog l,
(select ApproveLayout$userid as userid, ApproveLayout$created as created, sum(qty) as qty from ApproveLayout$items group by ApproveLayout$userid, ApproveLayout$created) ai
where a.created = l.created and a.id = l.id and ai.userid = a.userid and ai.created = a.created 
and l.aprDate &gt;= ToDate('$01') and l.aprDate &lt;= ToDate('$02')"
          </param>
        </source>
      </sources>

      <field name="qty" type="number" />
      <field name="created" type="timestamp" />
      <field name="id" type="string" />
      <field name="userid" type="string" />
    </object>
    <object name="ApproveOrgs">
