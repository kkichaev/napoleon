          <param name="stmt">
"select id, [name], address from Org where id in (select id from LayoutApproveLog where aprDate &gt;= ToDate('$01') and aprDate &lt;= ToDate('$02'))
union all 
select id, [name], address from PotenzialOrg where id in (select id from LayoutApproveLog where aprDate &gt;= ToDate('$01') and aprDate &lt;= ToDate('$02'))"
          </param>
        </source>
      </sources>

      <field name="name" type="string" />
      <field name="address" type="string" />
      <field name="id" type="string" />
    </object>

