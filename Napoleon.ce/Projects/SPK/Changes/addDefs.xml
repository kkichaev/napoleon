    <modify src="Price">
      <add>
        <field name="units" type="collection">
          <data>
            <object name="Units">
              <sources>
                <source name="SQLQuery">
                  <param name="keyFields">"id"</param>
                </source>
              </sources>
              <field name="id" type="string" data="u_id" />
              <field name="name" type="string" data="u_name" />
              <field name="inpack" type="number" prec="3" data="u_inpack" />
              <field name="code" type="string" data="u_code" />
            </object>
          </data>
        </field>
        <field name="division" type="number"/>
        <field name="expired" type="timestamp"/>
      </add>
      <change>
        <sources>
          <source name="SQLQuery">
            <param name="stmt">
              "select u.id_i as u_id, u.name as u_name, u.inpack as u_inpack, u.code as u_code, p.* from [Price] p left join [PriceUnit] u on p.id = u.id where p.division = " +
              $user.division + " order by p.id"
            </param>
          </source>
        </sources>
      </change>
    </modify>
    
