<?xml version="1.0" ?>
<serverDefs xmlns="http://grsoft.ru/schemas/serverDefs.xsd">
   <objects>
     <object name="LayoutActionCause">
       <sources>
         <source name="SQTable" type="internal" />
       </sources>

       <field name="action" type="number" />
       <field name="name" type="string" />
     </object>
     
   	 <object name="Quality">
         <sources>
            <source name="DBFTableSet">
               <param name="userTable">"QLTY"</param>
               <param name="commonTable">"QLTY"</param>
               <param name="catalog">"name;items;0"</param>
            </source>
         </sources>
         <field name="items" type="collection">
            <data>
               <object name="QualityItem">
                  <field name="id" width="30" type="string"/>
                  <field name="name" type="string" data="CAUSE"/>
               </object>
            </data>
         </field>
         <field name="name" type="string"/>
      </object>
      <object name="Returns">
         <sources>
            <source name="DBFCatalogTable">
               <param name="tableName">$object.table + $user.id</param>
               <param name="catalog">"id"</param>
               <param name="ordered">1</param>
            </source>
            <source name="SQTable" type="internal" />
         </sources>

         <member name="table">"VZT"</member>
         <member name="primaryKey">"userid,created"</member>

         <field name="userid" type="string" data="USER_ID" execOn="Put">$user.id</field>
         <field name="created" type="timestamp" data="CREATED"/>
         <field name="date" type="date" data="DATE" />
         <field name="id" width="100" type="string" />
         <field name="remark" type="string" />
         <field name="sended" type="timestamp" data="" execOn="Put">Now()</field>

         <field name="items" type="collection">
            <data>
               <object name="OrderItem">
                  <sources>
                     <source name="DBFCatalogItemTable"/>
                     <source name="SQTable" type="internal" />
                  </sources>

                  <field name="id" width="100" type="string" data="ID_I"/>
                  <field name="qty" type="number" prec="3" />
                  <field name="party" type="timestamp" />
                  <field name="cause" type="string" />
                  <field name="unit" type="string" data="ID_WU" />
                  <field name="ordflag" width="1" type="number" execOn="Put">FirstItem($object)</field>
               </object>
            </data>
         </field>
         <events>
            <event type="put">
               <action name="WriteInternal">$object.type</action>
               <action name="WriteToLog">$object.type;$object.created</action>
            </event>
         </events>
      </object>
      <object name="OrderDel">
         <sources>
            <source name="DBFTable">
               <param name="tableName">"ORDDEL"</param>
            </source>
         </sources>

         <field name="userid" type="string" data="USER_ID" execOn="Put">$user.id</field>
         <field name="created" type="timestamp" />
         <field name="date" type="timestamp" />
      </object>
      
      <object name="OrderImported" removeOnCommit="true">
         <sources>
            <source name="DBFTableSet">
               <param name="userTable">"ODR"</param>
               <param name="commonTable">"ODRR"</param>
               <param name="catalog">"created;items;0"</param>
            </source>
         </sources>
         
         <field name="created" type="timestamp" />
         <field name="date" type="date" />
         <field name="delay" type="number" prec="0" />
         <field name="id" width="100" type="string" />
         <field name="remark" type="string" />
         <field name="slsnum" type="string" />
         
         <field name="items" type="collection">
            <data>
               <object name="OrderItem">
                  <field name="id" width="30" type="string" data="ID_I"/>
                  <field name="qty" type="number" prec="3" />
                  <field name="cost" type="number" prec="2" />
                  <field name="unit" type="string" data="ID_WU" />
               </object>
            </data>
         </field>
      </object>
      
      <object name="SalesImported" removeOnCommit="true">
         <sources>
            <source name="DBFTableSet">
               <param name="userTable">"LSL"</param>
               <param name="commonTable">"LSLR"</param>
               <param name="catalog">"created;items;0"</param>
            </source>
         </sources>
         
         <field name="created" type="timestamp" />
         <field name="date" type="date" />
         <field name="delay" type="number" prec="0" />
         <field name="id" width="100" type="string" />
         <field name="remark" type="string" />
         <field name="items" type="collection">
            <data>
               <object name="SalesItem">
                  <field name="id" width="100" type="string" data="ID_I"/>
                  <field name="qty" type="number" prec="3" />
                  <field name="cost" type="number" prec="2" />
                  <field name="unit" type="string" data="ID_WU" />
                  <field name="weighted" type="number" prec="3" data="WDT" />
               </object>
            </data>
         </field>
      </object>
      
      <object name="ReturnsImported" removeOnCommit="true">
         <sources>
            <source name="DBFTableSet">
               <param name="userTable">"VTZ"</param>
               <param name="commonTable">"VTZZ"</param>
               <param name="catalog">"created;items;0"</param>
            </source>
         </sources>

         <field name="created" type="timestamp" />
         <field name="date" type="date" />
         <field name="id" width="100" type="string" />
         <field name="remark" type="string" />

         <field name="items" type="collection">
            <data>
               <object name="OrderItem">
                  <field name="id" width="100" type="string" data="ID_I"/>
                  <field name="qty" type="number" prec="3" />
                  <field name="party" type="timestamp" />
                  <field name="cause" type="string" />
                  <field name="unit" type="string" data="ID_WU" />
               </object>
            </data>
         </field>
      </object>
      
      <object name="OrderQuery">
      	<sources>
            <source name="DBFTable">
               <param name="tableName">"QRY" + $user.id</param>
            </source>
         </sources>
         
         <field name="date" type="date" />
      </object>

      <object name="ReturnQuery">
      	<sources>
            <source name="DBFTable">
               <param name="tableName">"RQRY" + $user.id</param>
            </source>
         </sources>
         
         <field name="date" type="date" />
      </object>
		
      <object name="Answer">
         <sources>
           <source name="DBFCatalogTable">
              <param name="tableName">$object.table + $user.id</param>
              <param name="catalog">"id"</param>
              <param name="ordered">1</param>
           </source>
           <source name="SQTable" type="internal" />
         </sources>

         <member name="table">"ANS"</member>
         <member name="primaryKey">"question,userid"</member>
        <memberArray name="index">"created"</memberArray>

        <field name="created" type="timestamp" data="CREATED"/>
         <field name="userid" type="string" data="USER_ID" execOn="Put">$user.id width="10"</field>
         <field name="question" type="string" data="QID" width="50"/>
         <field name="id" type="string" width="100"/>
         <field name="qname" type="string" width="10"/>
         <field name="sended" type="timestamp" data="" execOn="Put">Now()</field>

         <field name="items" type="collection">
           <data>
              <object name="AnswerItem">
                 <sources>
                    <source name="DBFCatalogItemTable"/>
                    <source name="SQTable" type="internal" />
                 </sources>
                 <member name="primaryKey">"id"</member>
                 <field name="id" type="string" data="ID_I" width="100"/>
                 <field name="answer" type="string" width="100"/>
              </object>
           </data>
         </field>
      </object>

      <object name="AgentQuest">
         <sources>
            <source name="SQTable" type="internal" />
            <param name="readFilter">"userid = '" + $user.id + "'";</param>
         </sources>

         <member name="primaryKey">"userid, idquest"</member>
         <field name="userid" type="string" />
         <field name="idquest" type="string" />
      </object>
      
      <object name="Reports">
      	<sources>
            <source name="DBFTable">
