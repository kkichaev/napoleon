      <object name="ReportAnswer" removeOnCommit="true">
      	<sources>
            <source name="DBFTable">
               <param name="tableName">"RA" + $user.id</param>
            </source>
        </sources>
        
        <field name="name" type="string" width="50"/>
        <field name="created" type="timestamp" />
        <field name="report" type="file" data="PATH" />
      </object>
      
      <object name="PrintForm" feature="SALES_MODULE">
      	<sources>
            <source name="DBFTable">
               <param name="tableName">"PFORM"</param>
            </source>
        </sources>
        
        <field name="name" type="string"/>
        <field name="form" type="file" data="PATH" />
      </object>
      
      <object name="PlanRoute">
          <sources>
              <source name="DBFTableSet">
                  <param name="userTable">"PLNRT"</param>
                  <param name="commonTable">"PLNRT"</param>
                  <param name="catalog">"date;items;0"</param>
              </source>
            <source name="SQTable" type="internal" />
         </sources>
    
         <member name="primaryKey">"userid,created"</member>
        <memberArray name="index">"created"</memberArray>

        <field name="created" type="timestamp" />
          <field name="plan" type="timestamp" />
          <field name="userid" type="string" data="USER_ID" execOn="Put">$user.id</field>
          
          <field name="items" type="collection">
              <data>
                  <object name="PlanRouteItem">
                     <sources>
                        <source name="SQTable" type="internal" />
                     </sources>
                       
                     <field name="id" type="string" width="100" />
                     <field name="spectask" type="string" width="250"/>
                     <field name="order" type="number" />
                     <field name="incass" type="number" />
                     <field name="returns" type="number" />
                     <field name="visit" type="number" />
                  </object>
               </data>
          </field>
          
         <events>
            <event type="put">
               <action name="WriteInternal">$object.type</action>
            </event>
         </events>          
      </object>
      
      <object name="PlanApprove">
          <sources>
              <source name="DBFTable">
                  <param name="tableName">"PLNAPR"  + $user.id</param>
              </source>
          </sources>
          
          <field name="plan" type="timestamp" />
      </object>

     <object name="LayoutApproveLog">
       <sources>
         <source name="SQTable" type="internal" />
       </sources>
       <field name="userid" type="string" />
       <field name="aprType" type="number" />
       <field name="aprRemark" type="string" />
       <field name="aprDate" type="timestamp" />
       <field name="id" type="string" />
       <field name="created" type="timestamp" />

       <member name="primaryKey">"userid,aprDate"</member>
