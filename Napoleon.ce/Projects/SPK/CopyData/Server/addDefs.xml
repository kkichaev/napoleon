      <object name="LayoutDef">
         <sources>
            <source name="DBFTableSet">
               <param name="userTable">"LAYD"</param>
               <param name="commonTable">"LAYDEF"</param>
               <param name="catalog">"id;items;0"</param>
            </source>
         </sources>

         <field name="id" type="string" />
         <field name="name" type="string" />
         <field name="pos" type="number" />

         <field name="items" type="collection">
            <data>
               <object name="LayoutDefItem">
                  <field name="id" type="string" data="ID_I"/>
                  <field name="name" type="string"  data="NAME_I" />
               </object>
            </data>
         </field>
      </object>

     <object name="OrgDisablePhoto">
       <sources>
         <source name="SQTable" type="internal">
           <param name="readFilter">'"userid"=' + "'" + $user.id + "'"</param>
         </source>
       </sources>

       <member name="primaryKey">"userid,id"</member>
       <field name="id" width="60" type="string" />
       <field name="userid" width="60" type="string" />
     </object>
      
      <object name="Layout">
        <sources>
          <source name="DBFCatalogTable">
            <param name="tableName">$object.table + $user.id</param>
            <param name="catalog">"id"</param>
            <param name="ordered">1</param>
          </source>
          <source name="SQTable" type="internal" />
        </sources>

        <member name="table">"LAY"</member>
        <member name="primaryKey">"userid,created"</member>

        <field name="userid" type="string" data="USER_ID" execOn="Put">$user.id</field>
        <field name="created" type="timestamp" data="CREATED,NUM"/>
        <field name="timeZone" type="number" />
        <field name="serverTimeZone" type="number" data="S_TZ" execOn="Put" feature="USE_TIMEZONE">ServerTimeZone()</field>
        <field name="sended" type="timestamp" data="S_DATE" execOn="Put">Now()</field>
        <field name="date" type="date" />
        <field name="id" width="60" type="string" />
        <field name="items" type="collection">
          <data>
            <object name="LayoutItem">
              <sources>
                <source name="DBFCatalogItemTable"/>
                <source name="SQTable" type="internal" />
              </sources>

              <field name="grid" width="55" type="string"/>
              <field name="grname" width="55" type="string"/>
              <field name="itid" width="55" type="string"/>
              <field name="itname" width="55" type="string"/>
              <field name="qty" type="number" prec="3" />
              <field name="grpos" type="number"  />
              <field name="ordflag" width="1" type="number" execOn="Put">FirstItem($object)</field>
            </object>
          </data>
        </field>

        <field name="latitude" type="number" prec="5" />
        <field name="longitude" type="number" prec="5" />

        <events>
          <event type="put">
            <!--<action name="WriteOrder" /> !-->
            <action name="WriteInternal">$object.type</action>
            <action name="WriteToLog">$object.type;$object.created</action>
          </event>
        </events>
      </object>

     <modify src="Layout" dest="ApproveLayout" table="ApproveLayout">
       <add>
         <field name="aprType" type="number" />
         <field name="aprRemark" type="string" width="100" data="APR_REM" />
       </add>
       <change>
         <member name="table">"APL"</member>
       </change>
     </modify>
      
      <modify src="Org">
         <add>
            <field name="matrix" type="collection">
               <data>
                  <object name="OrgMatrix">
                     <sources>
                        <source name="DBFTableSet">
                           <param name="userTable">"OMX"</param>
                           <param name="commonTable">"ORGMTX"</param>
                           <param name="filter">"[ID] = $parent.id"</param>
                        </source>
                     </sources>

                     <field name="id" data="ID_I" type="string" />
                  </object>
               </data>
            </field>
            <field name="focusedItems" type="collection">
               <data>
                  <object name="OrgMatrix">
                     <sources>
                        <source name="DBFTableSet">
                           <param name="userTable">"FMX"</param>
                           <param name="commonTable">"FORGMTX"</param>
                           <param name="filter">"[ID] = $parent.id"</param>
                        </source>
                     </sources>

                     <field name="id" data="ID_I" type="string" />
                  </object>
               </data>
            </field>
	        <field name="balance" type="number" prec="2" />
            <field name="useAvgWeight" data="WAVG" type="number"/>
            <field name="minWeight" data="WMIN" type="number" prec="3" />
         </add>
      </modify>
      <modify src="Price">
         <add>
         	<field name="units" type="collection">
               <data>
                  <object name="Units">
                     <sources>
                        <source name="DBFTableSet">
                           <param name="userTable">"WU"</param>
                           <param name="commonTable">"WUNITS"</param>
                           <param name="filter">"[ID_I] = $parent.id"</param>
                        </source>
                     </sources>
                     <field name="id" type="string" />
                     <field name="name" type="string" />
                     <field name="inpack" type="number" prec="3" />
                     <field name="coef" type="number" prec="3" />
                     <field name="code" type="string" />
                  </object>
               </data>
         	</field>
		    <field name="expired" type="timestamp"/>
            <field name="avgWeight" data="AVG" type="number" prec="3" />  
         </add>
      </modify>
      <modify src="Order$items">
         <add>
            <field name="unit" type="string" data="ID_WU" />
         </add>
         <change>
         	 <field name="id" width="100" type="string" data="ID_I"/>
