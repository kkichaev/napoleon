PROJECT=Myaskov

FEATURES = STOP_LIST RCV_MESSAGE VISIT_DOC POD_COMMENT GPS_POS PAY_DELAY
FEATURES+= ORG_COLOR ORG_INFO ORG_NOTE ORG_SKU ORG_REMNANTS ORD_DLV_BIND
FEATURES+= PRICE_MATRIX PRICE_COLOR PRICE_FILTER0 PRESENTATION_EDITOR SQL_ORG_ROUTE
FEATURES+= NAPOLEON_APPS QUESTION STD_QUESTION_REPORT QUESTION_REPORT SCRIPT_DOC QUESTION_IN_SCRIPTS FOCUSED_ITEMS PRICE_MONITORING STD_MONITOR_REPORT COVER_IN_ORDER_REPORT COST_MANAGER
FEATURES+= ORG_STOP_EDITOR

NPL_PDA_RESOURCE=

INST_FILES=addDefs.xml

#
# если есть WinMobile закомментарить
#
NO_WIN_MOBILE=1

NEW_CORE=1

MANAGER_FORMS=MinCostEditor