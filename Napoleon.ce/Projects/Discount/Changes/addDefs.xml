<?xml version="1.0" ?>
<serverDefs xmlns="http://grsoft.ru/schemas/serverDefs.xsd">
  <objects>
    <object name="ExistOut">
      <sources>
        <source name="DBFCatalogTable">
          <param name="tableName">$object.table + $user.id</param>
          <param name="catalog">"id"</param>
          <param name="ordered">1</param>
        </source>
        <source name="SQTable" type="internal" />
      </sources>

      <member name="table">"OUT_NAL"</member>
      <member name="primaryKey">"userid,created"</member>
      <memberArray name="index">"created"</memberArray>

      <field name="userid" type="string" data="USER_ID" execOn="Put">$user.id</field>
      <field name="created" type="timestamp" />
      <field name="timeZone" type="number" />
      <field name="serverTimeZone" type="number" data="S_TZ" execOn="Put" feature="USE_TIMEZONE">ServerTimeZone()</field>
      <field name="sended" type="timestamp" data="S_DATE" execOn="Put">Now()</field>
      <field name="date" type="date" />
      <field name="id" width="55" type="string" />
      <field name="remark" type="string" />
      <field name="items" type="collection">
        <data>
          <object name="Item">
            <sources>
              <source name="DBFCatalogItemTable"/>
              <source name="SQTable" type="internal" />
            </sources>

            <field name="id" width="40" type="string" data="ID_I"/>
            <field name="cost" type="number" prec="2" />
            <field name="priz" type="number" width="1" />
            <field name="sred" type="number" width="5" />
            <field name="present" type="number" width="1" data="NALICHIE" />

            <field name="ordflag" width="1" type="number" execOn="Put">FirstItem($object)</field>
          </object>
        </data>
      </field>

      <field name="latitude" type="number" prec="5" />
      <field name="longitude" type="number" prec="5" />

      <events>
        <event type="put">
          <action name="WriteInternal">$object.type</action>
          <action name="WriteToLog">$object.type;$object.created</action>
        </event>
      </events>
    </object>

    <object name="MonitoringGoods">
      <sources>
        <source name="DBFTable">
          <param name="tableName">"MON_GOODS"</param>
        </source>
      </sources>

      <field name="id" type="string" />
      <field name="folder" type="string" />
      <field name="name" type="string" />
    </object>

    <object name="MonitoringFolders">
      <sources>
        <source name="DBFTable">
          <param name="tableName">"MON_FOLDERS"</param>
        </source>
      </sources>

      <field name="id" type="number" key="true" data="rowid" />
      <field name="fid" type="string" data="id" width="40" />
      <field name="level" type="number" width="9" />
      <field name="name" type="string" width="60" />
    </object>

    <object name="MonitoringMatrix">
      <sources>
        <source name="DBFTableSet">
          <param name="userTable">"MMtx"</param>
          <param name="commonTable">"MON_MATRIX"</param>
          <param name="catalog">"name;items;0"</param>
        </source>
      </sources>
      <field name="items" type="collection">
        <data>
          <object name="MatrixItem">
            <field name="id" type="string" width="40" />
            <field name="order" type="number" data="rowid" />
          </object>
        </data>
      </field>
      <field name="name" type="string" width="30" data="type" />
    </object>

    <object name="Monitoring">
      <sources>
        <source name="DBFCatalogTable">
          <param name="tableName">$object.table + $user.id</param>
          <param name="catalog">"id"</param>
          <param name="ordered">1</param>
        </source>
        <source name="SQTable" type="internal" />
      </sources>

      <member name="table">"MNTR"</member>
      <member name="primaryKey">"userid,created"</member>
      <memberArray name="index">"created"</memberArray>

      <field name="userid" type="string" data="USER_ID" execOn="Put">$user.id</field>
      <field name="created" type="timestamp" />
      <field name="timeZone" type="number" />
      <field name="serverTimeZone" type="number" data="S_TZ" execOn="Put" feature="USE_TIMEZONE">ServerTimeZone()</field>
      <field name="sended" type="timestamp" data="S_DATE" execOn="Put">Now()</field>
      <field name="date" type="date" />
      <field name="id" width="55" type="string" />
      <field name="remark" type="string" />
      <field name="items" type="collection">
        <data>
          <object name="OrderItem">
            <sources>
              <source name="DBFCatalogItemTable"/>
              <source name="SQTable" type="internal" />
            </sources>

            <field name="id" width="40" type="string" data="ID_I"/>
            <field name="qty" type="number"  />
            <field name="facing" type="number"  />
            <field name="isAction" type="number" width="1" />
            <field name="cost" type="number" prec="2" />
            <field name="ordflag" width="1" type="number" execOn="Put">FirstItem($object)</field>
          </object>
        </data>
      </field>

      <field name="latitude" type="number" prec="5" />
      <field name="longitude" type="number" prec="5" />
      
      <events>
        <event type="put">
          <action name="WriteInternal">$object.type</action>
          <action name="WriteToLog">$object.type;$object.created</action>
        </event>
      </events>
    </object>
    
    <object name="QuestionDBF" >
      <sources>
        <source name="DBFTableSet">
          <param name="userTable">"QD"</param>
          <param name="commonTable">"QUEST"</param>
          <param name="catalog">"idquest;items;1"</param>
        </source>
      </sources>

      <member name="primaryKey">"idquest"</member>

      <field name="idquest" type="string" data="ID" />
      <field name="name" type="string" />
      <field name="from" type="timestamp" />
      <field name="till" type="timestamp" />
      <field name="text" type="string" />

      <field name="number" type="number" />
      
      <field name="items" type="collection">
        <data>
          <object name="QuestionItem">

            <field name="iditem" type="string" />
            <field name="id" type="string" data="TITLE" />
            <field name="text" type="string" data="TEXT_I" />
            <!--0-text, 1-number, 2-list, 3-set, 4-boolean, 5-dataset -->
            <field name="type" type="number" />
            <field name="optional" type="number" data="OPT" />
          </object>
        </data>
      </field>
    </object>
    <object name="QuestionItemValueDBF">
      <sources>
        <source name="DBFTableSet">
          <param name="userTable">"QVAL"</param>
          <param name="commonTable">"QVALS"</param>
        </source>
      </sources>
      <field name="iditem" type="string" />
      <field name="value" type="string"/>
    </object>

    <object name="OrgTaskDBF">
      <sources>
        <source name="DBFTable">
          <param name="tableName">"TASKS"</param>
        </source>
      </sources>

      <field name="id" type="string" />
      <field name="orgid" type="string" />
      <field name="start" type="timestamp" />
      <field name="finish" type="timestamp" />
      <field name="text" type="string" />
      <field name="userid" type="string" />
    </object>

    <object name="ActionsDiscount">
      <sources>
        <source name="DBFTableSet">
          <param name="userTable">"ACT"</param>
          <param name="commonTable">"ACTIONS"</param>
          <param name="filter">"[idWh] in $Sklad.id"</param>
        </source>
      </sources>

      <field name="id" type="string" />
      <field name="idWh" type="string" />
      <field name="id_i" type="string" />
      <field name="dsc" type="number" prec="2" />
      <field name="sum" type="number" prec="2" />
      <field name="type" type="number" />
      <field name="start" type="date" />
      <field name="finish" type="date" />
    </object>


    <object name="OrgFolder">
      <sources>
        <source name="DBFTableSet">
          <param name="userTable">"FORG"</param>
          <param name="commonTable">"FORGS"</param>
          <param name="catalog">"name;items;0"</param>
        </source>
      </sources>
      <field name="items" type="collection">
        <data>
          <object name="OrgFolderItem">
            <field name="name" type="string" data="ID" width="55"/>
            <field name="pos" type="number" />
          </object>
        </data>
      </field>
      <field name="name" type="string" width="20" />
      <field name="userid" type="string" width="55" />
    </object>

    <object name="Plan">
      <sources>
        <source name="DBFTableSet">
          <param name="userTable">"PLN"</param>
          <param name="commonTable">"PLAN"</param>
        </source>
      </sources>

      <field name="id" type="string" />
      <field name="pid" type="string" />
      <field name="qty" type="number" prec="3" />
    </object>

    <object name="Sklad">
      <sources>
        <source name="DBFTableSet">
          <param name="userTable">"SKL"</param>
          <param name="commonTable">"SKLADS"</param>
        </source>
      </sources>

      <field name="id" type="string" />
      <field name="name" type="string" />
    </object>

    <object name="SkladItem">
      <sources>
        <source name="DBFTableSet">
          <param name="userTable">"SW"</param>
          <param name="commonTable">"SWHS"</param>
          <param name="filter">"[id] in $Sklad.id"</param>
        </source>
      </sources>

      <field name="id" type="string" />
      <field name="id_i" type="string" />
      <field name="qty" type="number" prec="3" />

      <field name="cost" type="collection">
        <data>
          <object name="CostItem">
            <sources>
              <source name="Sequence">
                <param name="source">$parent.source</param>
              </source>
            </sources>
            <field name="cost" type="number" prec="2" />
          </object>
        </data>
      </field>
    </object>

    <modify src="Answer">
      <change>
        <sources>
          <source name="DBFCatalogTable">
            <param name="tableName">"ANS" + $user.id</param>
            <param name="catalog">"id"</param>
            <param name="ordered">1</param>
          </source>
          <source name="SQTable" type="internal" />
        </sources>
      </change>
      <add>
        <event type="put">
          <action name="WriteInternal">$object.type</action>
          <action name="WriteToLog">$object.type;$object.date</action>
        </event>
      </add>
    </modify>
    <modify src="Answer$items">
      <change>
        <sources>
          <source name="DBFCatalogItemTable"/>
          <source name="SQTable" type="internal" />
        </sources>
      </change>
      <add>
        <field name="ordflag" width="1" type="number" execOn="Put">FirstItem($object)</field>
      </add>
    </modify>

    <modify src="ScriptDef">
      <change>
        <sources>
          <source name="DBFTableSet">
            <param name="userTable">"SDF"</param>
            <param name="commonTable">"SCRDEF"</param>
            <param name="catalog">"id;items;0"</param>
          </source>
        </sources>
      </change>
    </modify>
    
    <modify src="ScriptDef$items">
      <change>
        <sources />
        <field name="curType" type="string" data="CT"/>
        <field name="name" type="string" data="NAME_I"/>
        <field name="condition" type="number" data="COND" />
        <field name="condParam" type="string" data="C_PRM" />
      </change>  
    </modify>

    <modify src="ScriptDoc">
      <change>
        <sources>
          <source name="DBFCatalogTable">
            <param name="tableName">SCR + $user.id</param>
            <param name="catalog">"id"</param>
            <param name="ordered">1</param>
          </source>
          <source name="SQTable" type="internal" />
        </sources>
      </change>
      <add>
        <event type="put">
          <action name="WriteInternal">$object.type</action>
          <action name="WriteToLog">$object.type;$object.date</action>
        </event>
      </add>
    </modify>
    <modify src="ScriptDoc$items">
      <change>
        <sources>
          <source name="DBFCatalogItemTable"/>
          <source name="SQTable" type="internal" />
        </sources>
        <field name="date" type="timestamp" data="DATE_I" />
      </change>
      <add>
        <field name="ordflag" width="1" type="number" execOn="Put">FirstItem($object)</field>
      </add>
    </modify>

    <modify src="Org">
      <add>
        <field name="orgType" type="string" data="type" />
        <field name="whPriceTypes" type="collection">
          <data>
            <object name="PriceTypes">
              <sources>
                <source name="DBFTableSet">
                  <param name="userTable">"PTO"</param>
                  <param name="commonTable">"PRCTYPES"</param>
                  <param name="filter">"[ID] = $parent.id"</param>
                </source>
              </sources>

              <field name="costype" type="number" />
              <field name="idWh" type="string" data="ID_WH" />
            </object>
          </data>
        </field>

        <field name="matrixExist" type="collection">
          <data>
            <object name="MatriExItem">
              <sources>
                <source name="DBFTableSet">
                  <param name="userTable">"NAL"</param>
                  <param name="commonTable">"NALEXt"</param>
                  <param name="filter">"[ID] = $parent.id"</param>
                </source>
              </sources>

              <field name="sred" type="number" />
              <field name="priz" type="number" />
              <field name="id" type="string" data="ID_I" />
            </object>
          </data>
        </field>
      </add>
    </modify>
    <modify src="Firm">
      <add>
        <field name="sklads" type="string"/>
      </add>
    </modify>

    <modify src="Delivery">
      <add>
        <field name="skladid" type="string"/>
      </add>
    </modify>

    <modify src="Payment">
      <add>
        <field name="skladid" type="string"/>
      </add>
    </modify>
    <modify src="Order">
      <add>
        <field name="whCode" type="string" width="30" />
        <field name="action" type="string" width="30" />
      </add>
    </modify>
    <modify src="Order$items">
      <add>
        <field name="costPrice" type="number" data="COST_PRC" prec="2" />
      </add>
    </modify>
    
    <modify src="OrgRemnants">
      <change>
        <sources>
          <source name="DBFCatalogTable">
            <param name="tableName">$object.table + $user.id</param>
            <param name="catalog">"id"</param>
            <param name="ordered">1</param>
          </source>
          <source name="SQTable" type="internal" />
        </sources>
      </change>
      <add>
        <event type="put">
          <action name="WriteInternal">$object.type</action>
          <action name="WriteToLog">$object.type;$object.date</action>
        </event>
      </add>
    </modify>
    <modify src="OrgRemnants$items">
      <change>
        <sources>
          <source name="DBFCatalogItemTable"/>
          <source name="SQTable" type="internal" />
        </sources>
      </change>
    </modify>
  </objects>
</serverDefs>
