#
# установить имя проекта
#
PROJECT=MobileAssistant

FEATURES = STOP_LIST RCV_MESSAGE VISIT_DOC POD_COMMENT GPS_POS PAY_DELAY
FEATURES+= ORG_COLOR ORG_INFO ORG_NOTE ORG_SKU ORG_REMNANTS ORD_DLV_BIND
FEATURES+= PRICE_MATRIX PRICE_COLOR PRICE_FILTER0 HAVE_CONFIG_READER
FEATURES+= NAPOLEON_APPS CAN_ADD_ORG_TO_CENSUS SQL_ORG_ROUTE

NPL_PDA_RESOURCE=

INST_FILES=addDefs.xml

#
# если есть WinMobile закомментарить
#
NO_WIN_MOBILE=1

NEW_CORE=1

MANAGER_SOURCE=FmDetailEx FmPtnzlOrgEditEx FmSelectContrAgentEx MainFormEx RouteEx ProjectObjects DivisionsEx UserFormEx
MANAGER_FORMS=FmTaskList FmTaskTemplates FmNewTask FmTasktemplateEdit FmTaskTextEdit