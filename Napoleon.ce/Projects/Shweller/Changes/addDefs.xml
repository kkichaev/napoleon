          <object name="Item">

            <field name="id" type="string" data="ID_I"/>
            <field name="barcode" type="string" data="BC_I" />
            <field name="unit" type="string" />
            <field name="qty" type="number" prec="3" />
            <field name="cost" type="number" prec="2" />
            <field name="pos" type="number" />
          </object>
        </data>
      </field>

      <field name="id" type="string" />
      <field name="sumD" type="number" prec="2" />
      <field name="number" type="string" />
      <field name="date" type="date" />
      <field name="barcode" type="string" />
      <field name="payDate" type="date" />
      <field name="created" type="timestamp" />
      <field name="userid" type="string" />
    </object>

    <modify src="Price">
      <add>
        <field name="units" type="collection">
          <data>
            <object name="UItem">
              <sources>
                <source name="DBFTableSet">
                  <param name="userTable">"UN"</param>
                  <param name="commonTable">"UNITS"</param>
                  <param name="filter">"[ID] = $parent.id"</param>
                </source>
              </sources>
              <field name="id" type="string" data="ID_U" />
              <field name="name" type="string" />
              <field name="inpack" type="number" prec="3" />
            </object>
          </data>
        </field>
      </add>
    </modify>

    <modify src="Order$items">
      <add>
        <field name="unit" type="string" width="55" />
      </add>
    </modify>

    <modify src="Returns$items">
      <add>
        <field name="uid" type="string" />
        <member name="primaryKey">"uid"</member>


        <field name="items" type="collection">
          <data>
            <object name="ReturnDlv">
              <sources>
                <source name="DBFCatalogItemTable"/>
                <source name="SQTable" type="internal" />
              </sources>

              <field name="number" width="40" type="string" data="NUM_I"/>
              <field name="date" type="date" data="DATE_I"/>
              <field name="qty" type="number" prec="3" data="QTY_I" />
              <field name="cost" type="number" prec="2" data="COST_I"/>
              <field name="docflag" width="1" type="number" execOn="Put">FirstItem($object)</field>
            </object>
          </data>
        </field>
      </add>
    </modify>
    
    <modify src="Price" dest="DPrice">
    </modify>

    <modify src="Visit" dest="DVisit" table="DVisit">
      <change>
        <sources>
          <source name="SQTable" type="internal" />
        </sources>
      </change>
    </modify>

  </objects>
</serverDefs>
