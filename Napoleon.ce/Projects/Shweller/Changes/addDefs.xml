<?xml version="1.0" ?>
<serverDefs xmlns="http://grsoft.ru/schemas/serverDefs.xsd">
  <objects>

    <object name="TareDoc">
      <sources>
        <source name="DBFCatalogTable">
          <param name="tableName">$object.table + $user.id</param>
          <param name="catalog">"id"</param>
          <param name="ordered">1</param>
        </source>
        <source name="SQTable" type="internal" />
      </sources>

      <member name="table">"TRD"</member>
      <member name="primaryKey">"userid,created"</member>
      <memberArray name="index">"created"</memberArray>

      <field name="userid" type="string" data="USER_ID" execOn="Put">$user.id</field>
      <field name="created" type="timestamp" data="CREATED,NUM"/>
      <field name="timeZone" type="number" />
      <field name="serverTimeZone" type="number" data="S_TZ" execOn="Put" feature="USE_TIMEZONE">ServerTimeZone()</field>
      <field name="sended" type="timestamp" data="S_DATE" execOn="Put">Now()</field>
      <field name="date" type="date" />
      <field name="id" width="55" type="string" />
      <field name="remark" type="string" />
      <field name="items" type="collection">
        <data>
          <object name="Item">
            <sources>
              <source name="DBFCatalogItemTable"/>
              <source name="SQTable" type="internal" />
            </sources>

            <field name="id" width="40" type="string" data="ID_I"/>
            <field name="ordflag" width="1" type="number" execOn="Put">FirstItem($object)</field>
          </object>
        </data>
      </field>
      
      <events>
        <event type="put">
          <action name="WriteInternal">$object.type</action>
          <action name="WriteToLog">$object.type;$object.created</action>
        </event>
      </events>
    </object>

    <modify src="TareDoc" dest="ReqTareDoc">
      <change>
        <sources>
          <source name="DBFCatalogTable">
            <param name="tableName">$object.table + $user.id</param>
            <param name="catalog">"id"</param>
            <param name="ordered">1</param>
          </source>
        </sources>
        
        <member name="table">"RTD"</member>
      </change>
      <add>
        <field name="number" type="string" />
      </add>
      <remove>
        <field name="userid" />
        <field name="created" />
        <field name="timeZone" />
        <field name="serverTimeZone" />
        <field name="sended" />
      </remove>
    </modify>

    <modify src="ReqTareDoc$items">
      <change>
        <sources>
          <source name="DBFCatalogItemTable"/>
        </sources>
      </change>
    </modify>

    <modify src="TareDoc" dest="DRetTareDoc">
      <change>
        <member name="table">"DRTD"</member>
      </change>
      <add>
        <event type="put">
          <action name="WriteInternal">$object.type</action>
          <action name="WriteToLog">$object.type;$object.created</action>
        </event>
      </add>
    </modify>

    <modify src="DRetTareDoc$items">
      <add>
        <field name="loaded" type="number" width="1" />
      </add>
    </modify>

    <object name="Dispatch">
      <sources>
        <source name="SQTable" type="internal" />
      </sources>

      <member name="primaryKey">"created,userid"</member>

      <field name="userid" type="string" execOn="Put">$user.id</field>
      <field name="date" type="timestamp"/>
      <field name="created" type="timestamp" />
      <field name="timeZone" type="number" />
      <field name="serverTimeZone" type="number" data="S_TZ" execOn="Put" feature="USE_TIMEZONE">ServerTimeZone()</field>
      <field name="sended" type="timestamp" data="S_DATE" execOn="Put">Now()</field>
      <field name="id" type="string" />
      <field name="latitude" type="number" prec="5" />
      <field name="longitude" type="number" prec="5" />
      <field name="itemid" type="string" />
      <field name="visit" type="timestamp" />

      <field name="times" type="collection">
        <data>
          <object name="DispatchTime">
            <sources>
              <source name="SQTable" type="internal" />
            </sources>

            <field name="start" type="timestamp"/>
            <field name="finish" type="timestamp"/>
          </object>
        </data>
      </field>

      <field name="items" type="collection">
        <data>
          <object name="DispatchItem">
            <sources>
              <source name="SQTable" type="internal" />
            </sources>

            <field name="number" type="string"/>
            <field name="state" type="number"/>
            <field name="remark" type="string"/>
            <field name="cause" type="string"/>
            <field name="date" type="timestamp"/>
            <field name="itemid" type="string"/>
            <field name="type" type="string"/>
          </object>
        </data>
      </field>

      <events>
        <event type="put">
          <action name="WriteInternal">$object.type</action>
          <action name="WriteToLog">$object.type;$object.date</action>
        </event>
      </events>
    </object>

    <object name="DIncass">
      <sources>
        <source name="DBFCatalogTable">
          <param name="tableName">"DINC" + $user.id</param>
