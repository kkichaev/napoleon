<?xml version="1.0" ?>
<serverDefs xmlns="http://grsoft.ru/schemas/serverDefs.xsd">
  <objects>
    <object name="PhotoCount">
      <sources>
        <source name="SQLQuery">
          <param name="stmt">
            "select count(i.name) as count_id, visit$date as date, visit$userid as userid, v.id as id from Visit$items as i , visit as v where visit$date &gt;= ToDate($01) "+
            "and visit$date &lt;= ToDate($02) and v.userid = i.visit$userid and v.date = i.visit$date group by visit$userid, visit$date, v.id"
          </param>

          <!--<param name="debug"/>-->
        </source>
      </sources>

      <field name="count" type="number" data="count_id" />
      <field name="date" type="timestamp" />
      <field name="userid" type="string" />
      <field name="id" type="string" />
    </object>

