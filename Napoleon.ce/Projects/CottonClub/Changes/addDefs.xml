<?xml version="1.0" ?>
<serverDefs xmlns="http://grsoft.ru/schemas/serverDefs.xsd">
  <objects>
    <object name="CommonAudit">
      <sources>
        <source name="SQTable" type="internal" />
      </sources>

      <member name="primaryKey">"userid,created"</member>

      <field name="userid" type="string" data="USER_ID" execOn="Put">$user.id</field>
      <field name="created" type="timestamp" data="CREATED"/>
      <field name="sended" type="timestamp" data="S_DATE" execOn="Put">Now()</field>
      <field name="date" type="date" />
      <field name="id" width="30" type="string" />
      <field name="remark" type="string" />
      <field name="items" type="collection">
        <data>
          <object name="OrderItem">
            <sources>
              <source name="SQTable" type="internal" />
            </sources>
            <field name="id" type="string" />
            <field name="presents" type="number" />
            <field name="stock" type="string" />
            <field name="price" type="string" />
            <field name="merch" type="string" />
          </object>
        </data>
        </field>

        <field name="answer" type="collection">
            <data>
                <object name="AnswerId">
                    <sources>
                        <source name="SQTable" type="internal" />
                    </sources>
                    <field name="answerid" type="string" />
                </object>
            </data>
        </field>
        <events>
        <event type="put">
          <action name="WriteInternal">$object.type</action>
          <action name="WriteToLog">$object.type;$object.created</action>
        </event>
      </events>
    </object>

      <object name="PromoAudit">
          <sources>
              <source name="SQTable" type="internal" />
          </sources>

          <member name="primaryKey">"userid,created"</member>

          <field name="userid" type="string" data="USER_ID" execOn="Put">$user.id</field>
          <field name="created" type="timestamp" data="CREATED"/>
          <field name="sended" type="timestamp" data="S_DATE" execOn="Put">Now()</field>
          <field name="date" type="date" />
          <field name="id" width="30" type="string" />
          <field name="remark" type="string" />
          <field name="answer" type="collection">
              <data>
                  <object name="AnswerId">
                      <sources>
                          <source name="SQTable" type="internal" />
                      </sources>
                      <field name="answerid" type="string" />
                  </object>
              </data>
          </field>
      </object>

      <object name="Answer">
          <sources>
              <source name="SQTable" type="internal" />
          </sources>

          <member name="primaryKey">"answerid"</member>

          <field name="answerid" type="string"/>
          <field name="price" type="string" />
          <field name="actprezent" type="number" />
          <field name="created" type="timestamp" data="CREATED"/>
          <field name="userid" type="string" data="USER_ID" execOn="Put">$user.id</field>
          <field name="question" type="string" data="QID" width="50"/>
          <field name="id" type="string" width="100"/>
          <field name="qname" type="string" width="10"/>
          <field name="sended" type="timestamp" data="" execOn="Put">Now()</field>
          <field name="longitude" type="number" prec="5" data="LONG" />
          <field name="latitude" type="number" prec="5" data="LAT" />

          <field name="items" type="collection">
              <data>
                  <object name="AnswerItem">
                      <sources>
                          <source name="SQTable" type="internal" />
                      </sources>

                      <field name="id" type="string" data="ID_I" width="100"/>
                      <field name="iditem" type="string" />
                      <field name="answer" type="string" width="100"/>
                      <field name="type" type="number"/>
                      <field name="remark" type="string" width="100" />
                  </object>
              </data>
          </field>

          <events>
              <event type="put">
                  <action name="WriteInternal">$object.type</action>
              </event>
          </events>
      </object>


      <object name="Cities">
      <sources>
        <source name="DBFTable">
          <param name="tableName">"CITIES"</param>
        </source>
      </sources>
      <field name="id" type="string" />
      <field name="name" type="string" />
    </object>

    <object name="Retails">
      <sources>
        <source name="DBFTable">
          <param name="tableName">"RETAILS"</param>
        </source>
      </sources>
      <field name="id" type="string" />
      <field name="name" type="string" />
    </object>

    <object name="InvTypes">
      <sources>
        <source name="KeyValueDBFTable">
          <param name="fileName">"INV_TYPES"</param>
          <param name="key">"ТипТоварногоЗапаса"</param>
          <param name="itemName">"NAME"</param>
          <param name="itemKey">"ID"</param>
        </source>
      </sources>

      <field name="key" type="string" />
      <field name="value" type="string" />
    </object>

    <object name="PriceTypes">
      <sources>
        <source name="KeyValueDBFTable">
          <param name="fileName">"PRC_TYPES"</param>
          <param name="key">"ТипЦенника"</param>
          <param name="itemName">"NAME"</param>
          <param name="itemKey">"ID"</param>
        </source>
      </sources>

      <field name="key" type="string" />
      <field name="value" type="string" />
    </object>
    
    <object name="MerchTypes">
      <sources>
        <source name="KeyValueDBFTable">
          <param name="fileName">"MERCH_TYPES"</param>
          <param name="key">"Мерчендайзинг"</param>
          <param name="itemName">"NAME"</param>
          <param name="itemKey">"ID"</param>
        </source>
      </sources>

      <field name="key" type="string" />
      <field name="value" type="string" />
    </object>

    <object name="Config">
      <sources>
        <source name="ObjectUnion">
          <param>"InvTypes"</param>
          <param>"PriceTypes"</param>
          <param>"MerchTypes"</param>
        </source>
      </sources>

      <field name="key" type="string" />
      <field name="value" type="string" />
    </object>

    <object name="ActionType">
      <sources>
        <source name="SQTable" type="internal" />
      </sources>

      <member name="primaryKey">"id"</member>

      <field name="id" type="string"/>
      <field name="name" type="string" />

      <field name="items" type="collection">
        <data>
          <object name="ActionTypeItem">
            <sources>
              <source name="SQTable" type="internal" />
            </sources>
            
            <member name="primaryKey">"id"</member>
            
            <field name="id" type="string" />
            <field name="text" type="string" />
            <field name="optional" type="number"/>
            <!--0-text, 1-number, 2-list, 3-set, 4-boolean, 5-dataset -->
            <field name="type" type="number" />
            <field name="values" type="collection">
              <data>
                <object name="ActionTypeValue">
                  <sources>
                    <source name="SQTable" type="internal" />
                  </sources>
                  <field name="value" type="string"/>
                </object>
              </data>
            </field>
          </object>
        </data>
      </field>
    </object>

    <object name="InAction">
      <sources>
        <source name="DBFTableSet">
          <param name="userTable">"INACT"</param>
          <param name="commonTable">"INACTION"</param>
        </source>
      </sources>

      <field name="id" type="string"/>
      <field name="name" type="string"/>
      <field name="org" type="string" data="ID_ORG"/>
      <field name="item" type="string" data="ID_I"/>
      <field name="action" type="string"/>
      <field name="begin" type="timestamp"/>
      <field name="end" type="timestamp"/>
      <field name="fio" type="string"/>
      <field name="phone" type="string"/>
      <field name="descr" type="string" />
    </object>
    
    <modify src="InAction" dest="Action" table="Action">
        <change>
	    	<sources>
	        	<sources>
	        		<source name="SQTable" type="internal" />
	        		<param name="readFilter">
            			'"begin" &lt;= ToDate("' + FormatDate(Now(),"DD.MM.YYYY") + '") and "end" &gt;= ToDate("' + FormatDate(Now(),"DD.MM.YYYY") + '")'
          			</param> 
	      		</sources>
	      	</sources>
      	</change>
      	
        <add>
        	<member name="primaryKey">"id,org,item"</member>
        </add>
    </modify>
    
    <modify src="Org">
      <add>
        <field name="city" type="string" data="ID_CITY" />
        <field name="retail" type="string" data="ID_RTL" />

        <field name="price" type="collection">
          <data>
            <object name="Price">
              <sources>
                <source name="DBFTableSet">
                  <param name="userTable">"MX"</param>
                  <param name="commonTable">"MATRIXES"</param>
                  <param name="filter">"[ID] = $parent.id"</param>
                </source>
              </sources>
              <field name="id" type="string" width="25" data="ID_I" />
            </object>
          </data>
        </field>
      </add>
    </modify>
  </objects>
</serverDefs>
