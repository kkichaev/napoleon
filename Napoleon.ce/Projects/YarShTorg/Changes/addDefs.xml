<?xml version="1.0" ?>
<serverDefs xmlns="http://grsoft.ru/schemas/serverDefs.xsd">
	<objects>
    <modify src="Org">
      <add>
        <field name="cost" type="collection">
          <data>
            <object name="OrgCost">
              <sources>
                <source name="DBFTableSet">
                  <param name="userTable">"OCS"</param>
                  <param name="commonTable">"ORGCOST"</param>
                  <param name="filter">"[ID] = $parent.id"</param>
                </source>
              </sources>
              <field name="cost" type="number" prec="2" />
              <field name="id" type="string" width="55" data="ID_I" />
            </object>
          </data>
        </field>
      </add>
    </modify>

    <modify src="Price">
      <add>
        <field name="href" type="string" />
      </add>
    </modify>
	</objects>
</serverDefs>
