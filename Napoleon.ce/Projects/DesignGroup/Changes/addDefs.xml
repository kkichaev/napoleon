<?xml version="1.0" ?>
<serverDefs xmlns="http://grsoft.ru/schemas/serverDefs.xsd">
	<objects>
    <object name="OrdConfig">
      <sources>
        <source name="KeyValueTable">
          <param name="fileName">"ord"+$user.id+".cfg"</param>
        </source>
        <source name="KeyValueTable">
          <param name="fileName">"order.cfg"</param>
        </source>
      </sources>

      <field name="key" type="string" />
      <field name="value" type="string" />
    </object>

    <object name="Sklads">
      <sources>
        <source name="KeyValueDBFTable">
          <param name="fileName">"SKL" + $user.id</param>
          <param name="key">"Склады"</param>
          <param name="itemName">"NAME"</param>
          <param name="itemKey">"ID"</param>
        </source>
        <source name="KeyValueDBFTable">
          <param name="fileName">"SKLADS"</param>
          <param name="key">"Склады"</param>
          <param name="itemName">"NAME"</param>
          <param name="itemKey">"ID"</param>
        </source>
      </sources>

      <field name="key" type="string" />
      <field name="value" type="string" />
    </object>

    <object name="Config">
      <sources>
        <source name="ObjectUnion">
          <param>"OrdConfig"</param>
          <param>"Sklads"</param>
        </source>
      </sources>

      <field name="key" type="string" />
      <field name="value" type="string" />
    </object>

    <modify src="Price">
      <change>
        <field name="whQty" type="collection">
          <data>
            <object name="PriceQty">
              <sources>
                <source name="Sequence">
                  <param name="source">$parent.source</param>
                  <param name="startIndex">2</param>
                </source>
              </sources>
              <field name="qty" type="number" prec="2" />
            </object>
          </data>
        </field>
      </change>
    </modify>

    <modify src="Org">
      <add>
        <field name="ido" type="string" />
      </add>
    </modify>

    <modify src="Order">
      <add>
        <field name="whCode" type="string" width="55" data="ID_WH" />
        <field name="whIndex" type="number" />
        <field name="ido" type="string" width="55" />
      </add>
    </modify>

    <modify src="Delivery">
      <change>
        <sources>
          <source name="DBFTableSet">
            <param name="userTable">"DLV"</param>
            <param name="commonTable">"DELIVERY"</param>
            <param name="catalog">"number,id;items;1"</param>
            <param name="filter">"[id] in $Org.ido"</param>
          </source>
        </sources>
      </change>
    </modify>

    <modify src="Payment">
      <change>
        <sources>
          <source name="DBFTable">
            <param name="tableName">$object.table + $user.id</param>
          </source>
          <source name="DBFTable">
            <param>$object.altTable</param>
            <param name="filter">"[id] in $Org.ido"</param>
          </source>
        </sources>
      </change>
    </modify>

    <modify src="PricePhoto">
      <change>
        <sources>
          <source name="DBFCatalogTable">
            <param name="tableName">"PHOTOS"</param>
            <param name="catalog">"[PATH]"</param>
            <param name="ordered">0</param>
          </source>
        </sources>
      </change>
    </modify>

  </objects>
</serverDefs>
