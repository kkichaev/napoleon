  </objects>

  <actions>
    <action name="CommitCheck">
      <do>
        <runReport name="check_handler" />
      </do>
    </action>
    <action name="CommitCheckBack">
      <do>
        <runReport name="check_back_handler" />
      </do>
    </action>
  </actions>
</serverDefs>
