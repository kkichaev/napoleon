<?xml version="1.0" ?>
<serverDefs xmlns="http://grsoft.ru/schemas/serverDefs.xsd">
  <objects>
    
    <!-- хочу миллион -->
    <object name="ItemGroups">
      <sources>
        <source name="DBFTable">
          <param name="tableName">"ITEMGRP"</param>
        </source>
      </sources>

      <field name="id" type="string" />
      <field name="name" type="string" />

    </object>

    <object name="AgentGroupPlan">
      <sources>
        <source name="DBFTableSet">
          <param name="userTable">"AGP"</param>
          <param name="commonTable">"AG_PLANS"</param>
          <param name="catalog">"userid;items;0"</param>
        </source>
      </sources>
      <member name="primaryKey">"userid"</member>

      <field name="userid" type="string" />
      <field name="weight" type="number" prec="3" />
      <field name="needSell" type="number" />
      <field name="items" type="collection">
        <data>
          <object name="AGItem">
            <field name="id" type="string" />
            <field name="weight" type="number" prec="3" data="WG_I" />
          </object>
        </data>
      </field>
    </object>
    <!-- хочу миллион -->

    <object name="AgentProcent">
      <sources>
        <source name="SQTable" type="internal">
          <param name="readFilter">'"userid"=' + "'" + $user.id + "'"</param>
        </source>
      </sources>
      <member name="primaryKey">"userid"</member>
      <field name="userid" type="string" />
      <field name="procent" type="number" prec="2" />
    </object>

    <object name="FolderColor">
      <sources>
        <source name="DBFTable">
          <param name="tableName">"CLR_FLD"</param>
        </source>
      </sources>

      <member name="primaryKey">"id"</member>

      <field name="id" type="string" />
      <field name="color" type="hex" />

    </object>

    <object name="AgentActivity">
      <sources>
        <source name="SQTable" type="internal" />
      </sources>

      <member name="primaryKey">"userid"</member>
      
      <field name="userid" type="string" execOn="Put">$user.id</field>
      <field name="login" type="string" />
      <field name="sended" type="timestamp" execOn="Put">Now()</field>
      <field name="phone" type="string" />
      <field name="imei" type="string" />

    </object>
    
    <object name="RequestChek">
      <sources>
        <source name="SQTable" type="internal" />
      </sources>

      <member name="primaryKey">"userid,created"</member>
      <memberArray name="index">"created"</memberArray>

      <field name="userid" type="string" execOn="Put">$user.id</field>
      <field name="created" type="timestamp" />
      <field name="timeZone" type="number" />
      <field name="serverTimeZone" type="number" execOn="Put" feature="USE_TIMEZONE">ServerTimeZone()</field>
      <field name="sended" type="timestamp" execOn="Put">Now()</field>
      <field name="date" type="date" />
      <field name="id" width="55" type="string" />
      <field name="remark" type="string" />
      <field name="latitude" type="number" prec="5" />
      <field name="longitude" type="number" prec="5" />

      <field name="sum" type="number" prec="2" />

      <events>
        <event type="put">
          <action name="WriteToLog">$object.type;$object.created</action>
        </event>
      </events>
    </object>

    <object name="ReturnChekBack">
      <sources>
        <source name="SQTable" type="internal" />
      </sources>

      <member name="primaryKey">"userid,created"</member>
      <memberArray name="index">"created"</memberArray>

      <field name="userid" type="string" execOn="Put">$user.id</field>
      <field name="created" type="timestamp" />
      <field name="timeZone" type="number" />
      <field name="serverTimeZone" type="number" execOn="Put" feature="USE_TIMEZONE">ServerTimeZone()</field>
      <field name="sended" type="timestamp" execOn="Put">Now()</field>
      <field name="date" type="date" />
      <field name="id" width="55" type="string" />
      <field name="remark" type="string" />
      <field name="latitude" type="number" prec="5" />
      <field name="longitude" type="number" prec="5" />

      <field name="sum" type="number" prec="2" />
      <field name="chek" type="timestamp" />

      <events>
        <event type="put">
          <action name="WriteToLog">$object.type;$object.created</action>
        </event>
      </events>
    </object>

    <object name="CheckConfirm">
      <sources>
        <source name="SQTable" type="internal" />
      </sources>

      <memberArray name="index">"created"</memberArray>
      <memberArray name="index">"handled"</memberArray>

      <field name="userid" type="string" />
      <field name="created" type="timestamp" />
      <field name="handled" type="timestamp" />
      <field name="type" type="number" />
      <field name="qrcode" type="string" />
      <field name="number" type="string" />
      <field name="remark" type="string" />
      <field name="status" type="number" />

    </object>

    <object name="OrdConfig">
      <sources>
        <source name="KeyValueTable">
          <param name="fileName">"ord"+$user.id+".cfg"</param>
        </source>
        <source name="KeyValueTable">
          <param name="fileName">"order.cfg"</param>
        </source>
      </sources>

      <field name="key" type="string" />
      <field name="value" type="string" />
    </object>

    <object name="Sklads">
      <sources>
        <source name="KeyValueDBFTable">
          <param name="fileName">"SKL" + $user.id + ".DBF"</param>
          <param name="key">"Склады"</param>
          <param name="itemName">"NAME"</param>
          <param name="itemKey">"ID"</param>
        </source>
        <source name="KeyValueDBFTable">
          <param name="fileName">"SKLADS"</param>
          <param name="key">"Склады"</param>
          <param name="itemName">"NAME"</param>
          <param name="itemKey">"ID"</param>
        </source>
      </sources>

      <field name="key" type="string" />
      <field name="value" type="string" />
    </object>

    <object name="Config">
      <sources>
        <source name="ObjectUnion">
          <param>"OrdConfig"</param>
          <param>"Sklads"</param>
        </source>
      </sources>

      <field name="key" type="string" />
      <field name="value" type="string" />
    </object>
    
    <object name="OrgStop" sendAlways="true">
      <sources>
        <source name="DBFTableSet">
          <param name="userTable">"O"</param>
          <param name="commonTable">"ORGS"</param>
        </source>
      </sources>

      <field name="id" type="string" />
      <field name="debt" type="number" prec="2" />
    </object>

