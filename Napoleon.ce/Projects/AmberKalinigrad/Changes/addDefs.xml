    <object name="CommonChek">
      <sources>
        <source name="SQTable" type="internal" />
      </sources>

      <member name="primaryKey">"userid,created"</member>

      <field name="created" type="timestamp" />
      <field name="remark" type="string" width="200" />
      <field name="userid" type="string" execOn="Put">$user.id</field>
      <field name="sended" type="timestamp" data="S_DATE" execOn="Put">Now()</field>
      <field name="bank" type="string" width="15" />

      <field name="items" type="collection">
        <data>
          <object name="CommonIncassItem">
            <sources>
              <source name="DBFCatalogItemTable"/>
              <source name="SQTable" type="internal" />
            </sources>
            <field name="id" type="string" width="30" />
            <field name="dvr" type="string" width="15" />
            <field name="sum" type="number" prec="2" />
            <field name="created" type="timestamp"  data="CR_I"/>
          </object>
        </data>
      </field>
    </object>

    <object name="Banks">
      <sources>
        <source name="DBFTable">
          <param name="tableName">"BANKS"</param>
        </source>
      </sources>

      <field name="id" type="string" width="30" />
      <field name="name" type="string" width="130" />

    </object>

    <object name="Dover">
      <sources>
        <source name="DBFTable">
          <param name="tableName">"DVR" + $user.id</param>
        </source>
      </sources>

      <field name="id" type="string" width="30" />
      <field name="name" type="string" width="130" />

    </object>

    <object name="Procuration">
      <sources>
        <source name="DBFCatalogTable">
          <param name="tableName">"PRT" + $user.id</param>
          <param name="catalog">"id"</param>
          <param name="ordered">1</param>
        </source>
        <source name="SQTable" type="internal" />
      </sources>

      <member name="primaryKey">"userid,created"</member>

      <field name="id" type="string" width="30" />
      <field name="created" type="timestamp" />
      <field name="date" type="date" />
      <field name="qty" type="number" />
      <field name="fio" type="string" width="100" />
      <field name="org" type="string" width="100" />
      <field name="firm" type="string" width="100" />
      <field name="route" type="string" width="100" />
      <field name="remark" type="string" width="100" />
      <field name="userid" type="string" execOn="Put">$user.id</field>
      <field name="sended" type="timestamp" data="S_DATE" execOn="Put">Now()</field>

      <events>
        <event type="put">
          <action name="WriteInternal">$object.type</action>
        </event>
      </events>
    </object>
    
    <object name="ReportsRequest">
      <sources>
        <source name="DBFTable">
          <param name="tableName">"RRQ" + $user.id</param>
        </source>
      </sources>
      <field name="date" type="timestamp" />
    </object>
    
    <object name="Report" removeOnCommit="true">
      <sources>
        <source name="DBFTable">
          <param name="tableName">"RPT" + $user.id</param>
        </source>
        <source name="DBFTable">
          <param name="tableName">"REPORTS"</param>
        </source>
      </sources>

      <!--  <field name="id" type="string" /> -->
      <field name="encoding" type="string" data="ENCODE"/>
      <field name="report" type="file" data="FILE" />
      <field name="date" type="timestamp" />
    </object>

    <modify src="Org">
      <add>
        <field name="priceType" type="string" width="20" data="PRCTYPE" />
        <field name="orgid" type="string"/>
        <field name="checkItemGroups" type="number" width="1" data="CHK_IG" />
      </add>
    </modify>
    <modify src="Order">
      <change>
        <sources>
          <source name="SQTable" type="internal" />
        </sources>
      </change>
      <add>
        <field name="priceType" type="string" width="20" data="PRCTYPE" />
        <field name="dvr_pay" type="number" width="1" execOn="Put">DecodeFlag($object.params, 16, "", "1")</field>
        <field name="dvr_ret" type="number" width="1" execOn="Put">DecodeFlag($object.params, 32, "", "1")</field>
        <field name="whCode" type="string" width="20" data="ID_WH" />
        <field name="outOrder" type="number" width="1" />
        <field name="outOrderRemark" type="string" data="OUT_REM" />
        <!--<field name="whRemark" type="string" data="SKL_REM" />
        <field name="otherRemark" type="string" data="OTH_REM" />-->
        
        <event type="put">
          <action name="WriteToLog">$object.type;$object.created</action>
        </event>
      </add>
      <remove>
        <field name="prcType" />
      </remove>
    </modify>
    <modify src="Order$items">
      <change>
        <sources>
          <source name="SQTable" type="internal" />
        </sources>
      </change>
      <add>
        <field name="remark" type="string" width="200" data="REM_I" />
        <field name="remarkWh" type="string" width="200" data="WHREM_I" />
        <field name="inKG" type="number" width="1" />
      </add>
    </modify>
    <modify src="OrderProceeded">
      <change>
        <sources>
          <source name="SQTable" type="internal">
            <param name="readFilter">'"userid"=' + "'" + $user.id + "'"</param>
          </source>
        </sources>
      </change>
      <add>
        <field name="userid" type="string" />
      </add>
    </modify>
    <modify src="OrderCommitted">
      <change>
        <sources>
          <source name="SQTable" type="internal">
            <param name="readFilter">'"userid"=' + "'" + $user.id + "'" + ' and "created" &gt;= ToDate(' + "'" + FormatDate(AdjustDate(Now(),-1,"month"),"DD.MM.YYYY") + "')" </param>
          </source>
        </sources>
      </change>
      <add>
        <member name="primaryKey">"userid,created"</member>
      </add>
    </modify>
    <!--<modify src="Folder">
      <add>
        <field name="color" type="hex" />
      </add>
    </modify>-->
    <modify src="Agents" dest="AgentsRcv">
      <add>
        <field name="userid" type="string" execOn="Get">$user.id</field>
      </add>
    </modify>
    <modify src="Visit">
      <add>
        <event type="put">
          <action name="WriteInternal">$object.type</action>
          <action name="WriteToLog">$object.type;$object.created</action>
        </event>
      </add>
      <change>
        <sources>
          <source name="DBFCatalogTable">
            <param name="tableName">"VIT" + $user.id</param>
            <param name="catalog">"id"</param>
            <param name="ordered">1</param>
          </source>
          <source name="SQTable" type="internal" />
        </sources>
      </change>
    </modify>
    <modify src="Returns$items">
      <add>
        <field name="cause" type="string" data="CAUSE_I" />
      </add>
    </modify>
    <modify src="Price">
      <add>
        <field name="orgid" type="string"/>
        <field name="color" type="hex" />
        <field name="packname" type="string" data="PN"/>
        <field name="desc" type="string"/>
        <field name="article" type="string" />
        <field name="cantdiv" type="number" />
        <field name="itemGroup" type="string" data="ID_IG" />
        
        <field name="whQty" type="collection">
          <data>
            <object name="QtyItem">
              <sources>
                <source name="Sequence">
                  <param name="source">$parent.source</param>
                </source>
              </sources>
              <field name="qty" type="number" prec="3" />
            </object>
          </data>
        </field>
      </add>
    </modify>

    
    <modify src="RequestChek" dest="RequestChekOnLine">
      <add>
        <event type="writeCommit">
          <action name="CommitCheck" />
        </event>
      </add>
    </modify>

    <modify src="ReturnChekBack" dest="ReturnChekBackOnLine">
      <add>
        <event type="writeCommit">
          <action name="CommitCheckBack" />
        </event>
      </add>
    </modify>


    
    <modify src="CommonIncass" dest="CopyCommonIncass">
      <change>
        <sources>
          <source name="SQTable" type="internal" />
