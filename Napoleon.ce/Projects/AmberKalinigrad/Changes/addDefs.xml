      </change>
    </modify>
    <modify src="Returns" dest="CopyReturns">
      <change>
        <sources>
          <source name="SQTable" type="internal" />
        </sources>
        <field name="userid" type="string" />
      </change>
    </modify>
    <modify src="Returns$items" dest ="CopyReturns$items">
