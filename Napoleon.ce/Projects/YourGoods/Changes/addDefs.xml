<?xml version="1.0" ?>
<serverDefs xmlns="http://grsoft.ru/schemas/serverDefs.xsd">
  <objects>
    <object name="AgentPlan">
      <sources>
        <source name="SQTable" type="internal">
          <param name="readFilter">
            '"userid"=' + "'" + $user.id + "' and " +
            '"begin" &lt;= ToDate("' + FormatDate(Now(),"DD.MM.YYYY") + '") and ' +
            '"end" &gt;= ToDate("' + FormatDate(Now(),"DD.MM.YYYY") + '")'
          </param>
        </source>
      </sources>

      <member name="primaryKey">"userid,begin"</member>

      <field name="userid" type="string" />
      <field name="begin" type="date" />
      <field name="end" type="date" />

      <field name="groups" type="collection">
        <data>
          <object name="AgemtPlanGroups">
            <sources>
              <source name="SQTable" type="internal" />
            </sources>
            <field name="id" type="string" />
            <field name="type" type="number"/>
            <field name="valueSum" type="number" prec="2" />
            <field name="valueQty" type="number" prec="3" />
          </object>
        </data>
      </field>
    </object>

    <object name="Firms">
      <sources>
        <source name="KeyValueDBFTable">
          <param name="fileName">"FIRMS"</param>
          <param name="key">"Организация"</param>
          <param name="itemName">"NAME"</param>
          <param name="itemKey">"ID"</param>
        </source>
      </sources>

      <field name="key" type="string" />
      <field name="value" type="string" />
    </object>

    <object name="OrdConfig">
      <sources>
        <source name="KeyValueTable">
          <param name="fileName">"ord"+$user.id+".cfg"</param>
        </source>
        <source name="KeyValueTable">
          <param name="fileName">"order.cfg"</param>
        </source>
      </sources>

      <field name="key" type="string" />
      <field name="value" type="string" />
    </object>

    <object name="Config">
      <sources>
        <source name="ObjectUnion">
          <param>"OrdConfig"</param>
          <param>"Firms"</param>
        </source>
      </sources>

      <field name="key" type="string" />
      <field name="value" type="string" />
    </object>

    <modify src="Sales">
      <add>
        <field name="isBlack" type="number" width="1" />
      </add>
    </modify>
    <modify src="Org">
      <add>
        <field name="ido" type="string" />
        <field name="dogovor" type="string" />
        <field name="divName" type="string" />
        <field name="stopMsg" type="string" />
        <field name="balance" type="number" prec="2" />
      </add>
    </modify>

    <modify src="Order">
      <add>
        <field name="prcCode" type="string" width="30" />
        <field name="stpRmt" type="string" width="30" />
      </add>
    </modify>

    <modify src="Delivery">
      <change>
        <sources>
          <source name="DBFTableSet">
            <param name="userTable">"_DLV"</param>
            <param name="commonTable">"DELIVERY"</param>
            <param name="catalog">"number;items;1"</param>
            <param name="filter">"[ido] in $Org.ido"</param>
          </source>
        </sources>
      </change>
        <add>
        <field name="ido" type="string" />
      </add>
    </modify>

    <modify src="Payment">
      <change>
        <source name="DBFTable">
          <param name="tableName">"_PAY" $user.id</param>
        </source>
        <source name="DBFTable">
          <param>"PAYMENT"</param>
          <param name="filter">"[ido] in $Org.ido"</param>
        </source>
      </change>
      <add>
        <field name="ido" type="string" />
      </add>
    </modify>
    
    <modify src="Returns">
      <add>
        <field name="dlvDate" type="date" />
        <field name="dlvNum" type="string" width="20" />
      </add>
    </modify>

    <modify src="Order" dest="LoadedOrders">
      <change>
        <sources>
          <source name="DBFTableSet">
            <param name="userTable">"LD_ORD"</param>
            <param name="commonTable">"LD_ORDERS"</param>
            <param name="catalog">"created;items;1"</param>
            <param name="filter">"[id] in $Org.id"</param>
            <param name="userFieldName">"division"</param>
          </source>
        </sources>

        <field name="items" type="collection">
          <data>
            <object name="Item">
              <field name="id" type="string" data="ID_I"/>
              <field name="qty" type="number" prec="3" />
              <field name="cost" type="number" prec="2" />
            </object>
          </data>
        </field>
      </change>
      <add>
        <field name="created" type="timestamp" data="CREATED"/>
      </add>
    </modify>

    <modify src="Price">
      <add>
        <field name="gost" type="string" />
        <field name="cert" type="string" />
        <field name="stcond" type="string" />
        <field name="bestBfr" type="string" />
      </add>
    </modify>

    <modify src="Firm">
      <add>
        <field name="bankName" type="string" data="B_NAME" />
        <field name="bic" type="string" />
        <field name="k_acc" type="string" />
        <field name="acc" type="string" />
      </add>
    </modify>
    
  </objects>
</serverDefs>
