<?xml version="1.0" ?>
<serverDefs xmlns="http://grsoft.ru/schemas/serverDefs.xsd">
   <objects>
   	<modify src="Org">
   		<add>
   			<field name="fiz" type="number" width="1" hidden="true" />
			<field name="stop" type="number" hidden="true" />
			<field name="flags" type="number" execOn="Get" >EncodeFlag($object.stop,2,$object.fiz,7)</field>			
   		</add>
   	</modify>
     <modify src="Price">
       <add>
         <field name="qty2" type="number" prec="3" />
         <field name="newItem" type="number" data="NEW" />
       </add>
     </modify>
      <modify src="Order">
         <add>
            <field name="discount" type="number" prec="1" />
         </add>
      </modify>
   </objects>
</serverDefs>
