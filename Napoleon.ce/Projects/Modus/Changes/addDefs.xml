    <modify src="Org">
      <change>
        <sources>
          <source name="SQTable" type="internal" >
            <param name="readFilter">'"userid" = ' + "'" + $user.id + "'"</param>
          </source>
        </sources>
      </change>
      <add>
        <member name="primaryKey">"userid,id"</member>
      </add>
    </modify>

    <modify src="CommonOrgs">
      <change>
        <sources>
          <source name="SQLQuery">
            <param name="stmt">
              'select distinct id, name, address from "Org"'
            </param>
          </source>

