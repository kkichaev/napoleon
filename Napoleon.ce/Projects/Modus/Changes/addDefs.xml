<?xml version="1.0" ?>
<serverDefs xmlns="http://grsoft.ru/schemas/serverDefs.xsd">
  <objects>
    <!--
      create table ap03 (orgid nvarchar(300) not null, priceid varchar(50) not null, qty real, cost real, primary key(orgid,priceid));
    -->
    <object name="ActionPrice">
      <sources>
          <source name="SQLQuery">
            <param name="stmt">"select * from [ap" + $user.id + "]" </param>
          </source>
      </sources>

      <field name="orgid" type="string" />
      <field name="priceid" type="string" />
      <field name="qty" type="number" prec="3"/>
      <field name="cost" type="number" prec="2"/>
      <field name="descr" type="string" />
    </object>
      
    <object name="Recommend">
      <sources>
        <source name="SQTable" type="internal">
          <param name="readFilter">"orgid in (select id from Org where [userid] = " + "'" + $user.id + "')"</param>
        </source>
      </sources>

      <member name="primaryKey">"orgid,priceid"</member>
      <field name="orgid" type="string" />
      <field name="priceid" type="string" />
    </object>
    
    <object name="CostFields">
      <field name="cost" type="number" prec="2" />
      <field name="price_id" type="string" />
      <field name="type_id" type="string" />
      <field name="type_name" type="string" />
    </object>

    <object name="Facing">
      <sources>
        <source name="SQTable" type="internal" />
      </sources>
      <member name="primaryKey">"userid,created"</member>

      <field name="userid" type="string" data="USER_ID" execOn="Put">$user.id</field>
      <field name="created" type="timestamp" />
      <field name="sended" type="timestamp" data="S_DATE" execOn="Put">Now()</field>
      <field name="id" width="30" type="string" />
      <field name="qty" type="number" prec="3" />
      <field name="remark" type="string" />

      <field name="latitude" type="number" prec="4" />
      <field name="longitude" type="number" prec="4" />

      <events>
        <event type="put">
          <action name="WriteInternal">$object.type</action>
          <action name="WriteToLog">$object.type;$object.date</action>
        </event>
      </events>
    </object>

    <object name="Cost">
      <sources>
        <source name="SQLCostReader">
          <param name="stmt">'select c."cost", c."ido" as "type_id", o."name" as "type_name", c."id" as "price_id" from [Cost] c, [Org] o where c."ido" = o."id" and o."userid" = ' + "'" + $user.id + "'"</param>
        </source>
      </sources>

      <field name="data" type="binary" />
    </object>

    <object name="MerchBegin">
      <sources>
        <source name="SQTable" type="internal" />
      </sources>
      <member name="primaryKey">"userid,created"</member>

      <field name="userid" type="string" data="USER_ID" execOn="Put">$user.id</field>
      <field name="created" type="timestamp" />
      <field name="sended" type="timestamp" data="S_DATE" execOn="Put">Now()</field>
      <field name="id" width="30" type="string" />
      <field name="items" type="collection">
        <data>
          <object name="MerchEndItem">
            <sources>
              <source name="SQTable" type="internal" />
            </sources>
            <field name="id" type="string" />
            <field name="start" type="number" prec="3" />
            <field name="finish" type="number" prec="3" />
          </object>
        </data>
      </field>

      <field name="latitude" type="number" prec="4" />
      <field name="longitude" type="number" prec="4" />

      <events>
        <event type="put">
          <action name="WriteInternal">$object.type</action>
          <action name="WriteToLog">$object.type;$object.date</action>
        </event>
      </events>
    </object>

    <object name="MerchEnd">
