    <object name="MTask">
      <sources>
        <source name="SQTable" type="internal" >
          <param name="readFilter">'"userid"=' + "'" + $user.id + "'" + ' and not "taskid" in (select "taskid" from "taskanswer")'</param>
        </source>
      </sources>
      <member name="primaryKey">"taskid"</member>

      <field name="taskid" type="string" />
      <field name="userid" type="string" data="USER_ID" execOn="Put">$user.id</field>
