  <objects>
    <object name="LastStock">
      <sources>
        <source name="SQLQuery">
          <param name="stmt">
            "select doc.qty, doc.aikos, ld.id
            from 
            (select d.qty, d.date, ISNULL( f.qty, 0) as aikos from 
              (SELECT sum([qty]) as qty, [OrgRemnants$date] as date FROM [OrgRemnants$items]
                where [OrgRemnants$userid] = '$01'
                group by OrgRemnants$userid, OrgRemnants$date) d left join
              (SELECT sum([qty]) as qty ,[OrgRemnants$date] as date FROM [OrgRemnants$items]
                where face = 1 and [OrgRemnants$userid] = '$01'
                group by OrgRemnants$userid, OrgRemnants$date) f on d.date = f.date
            ) doc,
            (select max(date) as date, id from OrgRemnants where userid = '$01' group by id) ld
            where doc.date = ld.date"
          </param>
          <param name="$01">$user.id</param>
        </source>
      </sources>
      <field name="qty" type="number" />
      <field name="id" type="string" />
      <field name="aikos" type="number" />
    </object>
    
