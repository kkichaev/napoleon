    <object name="TimeSheetQuery">
      <sources>
        <source name="SQLQuery">
          <param name="stmt">
            'select division.id as divid, division.description as divname, agents.name, agents.id, 
              sheet.day1, sheet.day2, sheet.day3, sheet.day4, sheet.day5, sheet.day6, sheet.day7, sheet.day8, sheet.day9, sheet.day10,
              sheet.day11, sheet.day12, sheet.day13, sheet.day14, sheet.day15, sheet.day16, sheet.day17, sheet.day18, sheet.day19, sheet.day20,
              sheet.day21, sheet.day22, sheet.day23, sheet.day24, sheet.day25, sheet.day26, sheet.day27, sheet.day28, sheet.day29, sheet.day30, sheet.day31,
              sheet.notWorkCount, sheet.start
              from  Division as division 
              left join Division$agents as divagent on division.id = divagent.Division$id 
              left join Agents as agents on divagent.id = agents.id
              left join TimeSheet as sheet on (agents.id = sheet.userid and sheet.start = $01)
          </param>
          <param name="$01">ToDate(FormatDate(Now(),"DD.MM.YYYY"))</param>
          <param name="debug"/>
        </source>
      </sources>

