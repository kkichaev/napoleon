<?xml version="1.0" ?>
<serverDefs xmlns="http://grsoft.ru/schemas/serverDefs.xsd">
  <objects>
    <object name="Carrier">
      <sources>
        <source name="DBFCatalogTable">
          <param name="tableName">"CARRIER"</param>
          <param name="catalog">"id"</param>
          <param name="ordered">1</param>
        </source>
      </sources>

      <field name="id" type="string" />
      <field name="name" type="string" />

      <field name="items" type="collection">
        <data>
          <object name="CarrierItem">
            <sources>
              <source name="DBFCatalogItemTable" />
            </sources>

            <field name="address" type="string"/>
          </object>
        </data>
      </field>
    </object>

    <object name="Agreement">
      <sources>
        <source name="DBFTable">
          <param name="tableName">"AGRMNT"</param>
        </source>
      </sources>

      <field name="id" type="string" />
      <field name="idOrg" type="string" />
      <field name="idFirm" type="string" />
      <field name="cost" type="number" />
      <field name="common" type="number" />
      <field name="name" type="string" />
    </object>

    <object name="Zone">
      <sources>
        <source name="DBFTable">
          <param name="tableName">"ZONE"</param>
        </source>
      </sources>

      <field name="id" type="string" />
      <field name="name" type="string" />
    </object>

    <object name="Report">
      <sources>
        <source name="DBFTable">
          <param name="tableName">"RPT" + $user.id</param>
        </source>
        <source name="DBFTable">
          <param name="tableName">"REPORTS"</param>
        </source>
      </sources>

      <field name="id" type="string" />
      <field name="encoding" type="string" data="COD"/>
      <field name="report" type="file" data="FILE" />
      <field name="date" type="timestamp" />
    </object>

    <object name="PayTime">
      <sources>
        <source name="DBFTable">
          <param name="tableName">"PAYTIME"</param>
        </source>
      </sources>

      <field name="id" type="string" />
      <field name="name" type="string" />
    </object>

    <object name="Cash">
      <sources>
        <source name="DBFTable">
          <param name="tableName">"CASH" + $user.id</param>
        </source>
      </sources>

      <field name="id" type="string" />
      <field name="firm" type="string" />
      <field name="name" type="string" />
    </object>

    <object name="MovementWh">
      <sources>
        <source name="DBFCatalogTable">
          <param name="tableName">$object.table + $user.id</param>
          <param name="catalog">"id"</param>
          <param name="ordered">1</param>
        </source>
        <source name="SQTable" type="internal" />
      </sources>

      <member name="table">"MVW"</member>
      <member name="primaryKey">"userid,created"</member>

      <field name="userid" type="string" data="USER_ID" execOn="Put">$user.id</field>
      <field name="created" type="timestamp" data="CREATED,NUM"/>
      <field name="timeZone" type="number" />
      <field name="serverTimeZone" type="number" data="S_TZ" execOn="Put" features="USE_TIMEZONE">ServerTimeZone()</field>
      <field name="sended" type="timestamp" data="S_DATE" execOn="Put">Now()</field>
      <field name="date" type="date" />
      <field name="id" width="30" type="string" />
      <field name="firma" type="string" width="40" />
      <field name="whSrc" type="string" width="40" />
      <field name="whDest" type="string" width="40" />
      <field name="remark" type="string" />

      <field name="items" type="collection">
        <data>
          <object name="Item">
            <sources>
              <source name="DBFCatalogItemTable"/>
              <source name="SQTable" type="internal" />
            </sources>

            <field name="id" width="30" type="string" data="ID_I"/>
            <field name="qty" type="number" prec="3" />
            <field name="flags" type="number" width="9" prec="0" data="" />
            <field name="pack" type="number" width="1" execOn="Put">DecodeFlag($object.flags, 1, "", "1")</field>
            <field name="ordflag" width="1" type="number" execOn="Put">FirstItem($object)</field>
          </object>
        </data>
      </field>

      <field name="params" type="number" width="9" prec="0" data="" />

      <events>
        <event type="put">
          <action name="WriteInternal">$object.type</action>
          <action name="WriteToLog">$object.type;$object.created</action>
        </event>
      </events>
    </object>    
    
    <modify src="Firm">
      <add>
        <field name="billform" type="string" data="BF"/>
        <field name="offerform" type="string" data="OF"/>
        <field name="email" type="string" />
        <field name="account" type="string" />
        <field name="bic" type="string" />
        <field name="kacc" type="string" />
        <field name="bname" type="string" />
        <field name="prefix" type="string" />
      </add>
    </modify>

    <modify src="Org">
      <add>
        <field name="email" type="string"/>
        <field name="prcType" type="string"/>
        <field name="ido" type="string"/>
      </add>
    </modify>

    <modify src="AgentPrefix">
      <add>
        <field name="email" type="string" />
      </add>
    </modify>
    <modify src="Order">
      <add>
        <field name="dlvtype" type="number" />
        <field name="dlvaddress" type="string" width="200" data="DLV_ADR" />
        <field name="zone" type="string" width="100"  />
        <field name="timeStart" type="string" width="15" data="TIME_ST" />
        <field name="timeFinish" type="string" width="15" data="TIME_FN"  />
        <field name="dlvinfo" type="string" width="150"  />
        <field name="carrier" type="string" width="15"  />
        <field name="caraddress" type="string" width="150" data="CR_ADR"  />
        <field name="place" type="number"  />
        <field name="priceType" type="string" width="40" data="PRC_TYPE" />
        <field name="whCode" type="string" width="40" />
        <field name="agreement" type="string" width="40" data="AGRMNT" />
        <field name="status" type="string" width="40" />
        <field name="docnumber" type="string" width="20" />
      </add>
      <change>
        <field name="id" type="string" width="40" />
      </change>
      <remove>
        <field name="ctype" />
      </remove>
    </modify>

    <modify src="Sales">
      <add>
        <field name="dlvtype" type="number" />
        <field name="dlvaddress" type="string" width="200" data="DLV_ADR" />
        <field name="zone" type="string" width="100"  />
        <field name="timeStart" type="string" width="15" data="TIME_ST" />
        <field name="timeFinish" type="string" width="15" data="TIME_FN"  />
        <field name="dlvinfo" type="string" width="150"  />
        <field name="carrier" type="string" width="15"  />
        <field name="caraddress" type="string" width="150" data="CR_ADR"  />
        <field name="place" type="number"  />
        <field name="priceType" type="string" width="40" data="PRC_TYPE" />
        <field name="whCode" type="string" width="40" />
        <field name="agreement" type="string" width="40" data="AGRMNT" />
        <field name="status" type="string" width="40" />
      </add>
      <change>
        <field name="id" type="string" width="40" />
      </change>
      <remove>
        <field name="ctype" />
      </remove>
    </modify>
    
    <modify src="Price">
      <add>
        <field name="whQty" type="collection">
          <data>
            <object name="QtyItem">
              <sources>
                <source name="Sequence">
                  <param name="source">$parent.source</param>
                </source>
              </sources>
              <field name="qty" type="number" prec="3" />
            </object>
          </data>
        </field>
      </add>
    </modify>

    <modify src="Order" dest="OfferDoc" table="OfferDoc">
      <change>
        <sources>
          <source name="SQTable" type="internal" />
        </sources>
      </change>
      <add>
        <field name="start" type="date" />
        <field name="finish" type="date" />
        <field name="paytime" type="string" />
      </add>
    </modify>
    
    <modify src="Returns">
      <add>
        <field name="firma" type="string" width="40" />
        <field name="id" type="string" width="40" />
        <field name="whCode" type="string" width="40" />
      </add>
    </modify>
    
    <modify src="Pko">
      <change>
        <field name="id" type="string" width="40" />
        <field name="supplyercode" type="string" width="40" data="FIRMA" />
        <field name="cash" type="string" width="40" />
      </change>
    </modify>
    
    <modify src="Pko" dest="Rko" table="RkoDoc">
      <change>
        <member name="table">"Rko"</member>
      </change>
      <add>
        <field name="cause" type="string" width="50" />
      </add>
    </modify>
  </objects>
</serverDefs>
