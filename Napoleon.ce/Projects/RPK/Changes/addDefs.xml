<?xml version="1.0" ?>
<serverDefs xmlns="http://grsoft.ru/schemas/serverDefs.xsd">
   <objects>
      <modify src="Org">
         <add>
            <field name="color" type="hex" />
            <field name="dogovor" type="string" />
            <field name="payDelay" type="number" prec="0" data="DELAY" />
            <field name="discount" type="number" prec="1" data="PRC" />
            
            <field name="remnants" type="collection">
               <data>
                  <object name="OrgRemnantsItem">
                     <sources>
                        <source name="DBFTableSet">
                           <param name="userTable">"ORM"</param>
                           <param name="commonTable">"ORMGEN"</param>
                           <param name="filter">"[ID] = $parent.id"</param>
                        </source>
                     </sources>

                     <field name="id" type="string" data="ID_I"/>
                     <field name="qty" type="string" width="20" />
                     <field name="date" type="timestamp" />
                  </object>
               </data>
            </field>
         </add>
      </modify>
      <modify src="Payment">
         <add>
            <field name="color" type="hex" />
            <field name="outSum" type="number" prec="2" data="SUMP" />
         </add>
      </modify>

      <modify src="Order">
         <add>
            <field name="params" type="number" data="" />
            <field name="quality" type="number" width="1" execOn="Put">DecodeFlag($object.params, 4, "", "1")</field>
            <field name="sert" type="number" width="1" execOn="Put">DecodeFlag($object.params, 8, "", "1")</field>
         </add>
      </modify>

      <modify src="Order" dest="Defect" table="Defect">
         <remove>
            <field name="firma" />
            <field name="delay" />
            <field name="paydate" />
            <field name="ctype" />
            <field name="survay" />
            <field name="quality" />
            <field name="sert" />
         </remove>
         <change>
            <member name="table">"DEF"</member>
         </change>
      </modify>
      <modify src="Defect$items">
         <remove>
            <field name="discount" />
            <field name="cost" />
            <field name="pack" />
         </remove>
      </modify>
      <modify src="Visit">
          <change>
              <sources>
                <source name="DBFTable">
                    <param name="tableName">"VIT" + $user.id</param>
                </source>
                <source name="SQTable" type="internal" />
              </sources>
          </change>
         <add>
            <event type="put">
               <action name="WriteInternal">$object.type</action>
               <action name="WriteToLog">$object.type;$object.date</action>
            </event>
         </add>
      </modify>
   </objects>
</serverDefs>
