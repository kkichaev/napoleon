<?xml version="1.0" ?>
<serverDefs xmlns="http://grsoft.ru/schemas/serverDefs.xsd">
	<objects>
    <object name="TaskRemark">
      <sources>
        <source name="SQTable" type="internal" />
      </sources>

      <member name="primaryKey">"taskid"</member>
      <memberArray name="index">"date"</memberArray>
      
      <field name="taskid" type="string" />
      <field name="remark" type="string" />
      <field name="date" type="timestamp" />
    </object>

    <object name="MatrixOrder">
      <sources>
        <source name="SQTable" type="internal">
          <param name="readFilter">'"userid"=' + "'" + $user.id + "'"</param>
        </source>
      </sources>

      <member name="primaryKey">"userid"</member>

      <field name="userid" type="string" execOn="Put">$user.id</field>
      <field name="items" type="collection">
        <data>
          <object name="MatrixName">
            <sources>
              <source name="SQTable" type="internal" />
            </sources>
            <field name="name" type="string" />
            <field name="order" type="number" />
          </object>
        </data>
      </field>
    </object>

    <object name="FocusMatrix">
      <sources>
        <source name="SQTable" type="internal" />
      </sources>

      <member name="primaryKey">"type"</member>
      <field name="type" type="string" />
      <field name="items" type="collection">
        <data>
          <object name="FocusItem">
            <sources>
              <source name="SQTable" type="internal" />
            </sources>
            <field name="id" type="string"/>
          </object>
        </data>
      </field>

    </object>

    <object name="FocusRejectReason">
      <sources>
        <source name="SQTable" type="internal" />
      </sources>

      <member name="primaryKey">"id"</member>
      <field name="id" type="string" />
      <field name="name" type="string" />
    </object>

    <object name="OrgTypeBinding">
      <sources>
        <source name="SQTable" type="internal" />
      </sources>

      <member name="primaryKey">"id"</member>
      <field name="id" type="string" />
      <field name="type" type="string" />
    </object>
    
    <object name="OrgType">
      <sources>
        <source name="DBFTable">
          <param name="tableName">"ORGTYPES"</param>
        </source>
      </sources>
      <field name="id" type="string" />
      <field name="name" type="string" />
    </object>
    
    <object name="Cost" feature="COST_MANAGER">
      <sources>
        <source name="DBFCostReader">
          <param name="cost">"CS" + $user.id</param>
          <param name="costType">"O" + $user.id</param>
        </source>
      </sources>

      <field name="data" type="binary" />
    </object>

    <modify src="ScriptDef">
      <add>
        <field name="type" type="string" />
      </add>
    </modify>

    <modify src="Order">
      <add>
        <field name="rejectItems" type="collection">
          <data>
            <object name="RejectItem">
              <sources>
                <source name="SQTable" type="internal" />
              </sources>
              <field name="id" type="string"/>
              <field name="reason" type="string"/>
            </object>
          </data>
        </field>
      </add>
    </modify>
  </objects>
</serverDefs>
