<?xml version="1.0" ?>
<serverDefs xmlns="http://grsoft.ru/schemas/serverDefs.xsd">
	<objects>
      <object name="DistrPrice">
         <sources>
            <source name="DBFTable">
               <param name="tableName">"DISTPRC"</param>
            </source>
         </sources>

         <field name="id" type="string" />
         <field name="number" type="number" />
         <field name="name" type="string" />
      </object>
      
      <object name="DistrDoc">
         <sources>
            <source name="DBFCatalogTable">
               <param name="tableName">$object.table + $user.id</param>
               <param name="catalog">"id"</param>
               <param name="ordered">1</param>
            </source>
            <source name="SQTable" type="internal" />
         </sources>
         
         <member name="table">"DISTR"</member>
         <member name="primaryKey">"userid,created"</member>

         <field name="userid" type="string" data="KOD_TP" width="8" execOn="Put">$user.id</field>
         <field name="created" type="timestamp" data="CREATED"/>
         <field name="date" type="date" data="DEN" />
         <field name="super" type="string" width="100" />
         <field name="userName" type="string" data="TP" width="100" execOn="Put">$user.name</field>
         <field name="id" width="30" type="string" data="KODKONTR" />
         <field name="name" width="100" type="string" data="KONTR" />
         <field name="items" type="collection">
            <data>
               <object name="DistrItem">
                  <sources>
                     <source name="DBFCatalogItemTable"/>
                     <source name="SQTable" type="internal" />
                  </sources>

                  <field name="id" width="30" type="string" data="KONTOV"/>
                  <field name="number" width="8" type="number" data="NOMER"/>
                  <field name="name" width="100" type="string" data="TOVDISTR"/>
                  <field name="exists" type="number" widht="1" data="SUMMA" />
                  <field name="ordflag" width="1" type="number" execOn="Put">FirstItem($object)</field>
               </object>
            </data>
         </field>

         <events>
            <event type="put">
               <action name="WriteInternal">$object.type</action>
               <action name="WriteToLog">$object.type;$object.created</action>
            </event>
         </events>
      </object>
	  
	  <modify src="Sales">
	        <add>
         		<field name="cash"  type="number" width="1" execOn="Put">DecodeFlag($object.params, 2, "", "1")</field>
	        </add>
	    </modify>
    <modify src="Firm">
      <add>
        <field name="prefix" type="string" />
        <field name="suplName" type="string" data="SPL_NAME" />
        <field name="suplAddress" type="string" data="SPL_ADR" />
        <field name="suplPhone" type="string" data="SPL_PH" />
        <field name="suplInn" type="string" data="SPL_INN" />
        <field name="suplBank" type="string" data="SPL_BANK" />
      </add>
    </modify>

    <modify src="AgentPrefix">
      <add>
        <field name="order" type="string" />
      </add>
    </modify>
	</objects>
</serverDefs>
