<?xml version="1.0" ?>
<serverDefs xmlns="http://grsoft.ru/schemas/serverDefs.xsd">
  <objects>
    <object name="Cost">
      <sources>
        <source name="DBFCostReader">
          <param name="cost">"CS" + $user.id</param>
          <param name="costType">"CTP" + $user.id</param>
        </source>
      </sources>
      <field name="data" type="binary" />
    </object>

    <object name="OrdConfig">
      <sources>
        <source name="KeyValueTable">
          <param name="fileName">"ord"+$user.id+".cfg"</param>
        </source>
        <source name="KeyValueTable">
          <param name="fileName">"order.cfg"</param>
        </source>
      </sources>

      <field name="key" type="string" />
      <field name="value" type="string" />
    </object>

    <object name="Skalds">
      <sources>
        <source name="KeyValueDBFTable">
          <param name="fileName">"SKLADS"+$user.id</param>
          <param name="key">"Склады"</param>
          <param name="itemName">"NAME"</param>
          <param name="itemKey">"ID"</param>
        </source>
        <source name="KeyValueDBFTable">
          <param name="fileName">"SKLADS"</param>
          <param name="key">"Склады"</param>
          <param name="itemName">"NAME"</param>
          <param name="itemKey">"ID"</param>
        </source>
      </sources>

      <field name="key" type="string" />
      <field name="value" type="string" />
    </object>

    <object name="DocNumConfig">
      <sources>
        <source name="KeyValueTable">
          <param name="fileName">"dmc"+$user.id+".cfg"</param>
        </source>
      </sources>

      <field name="key" type="string" />
      <field name="value" type="string" />
    </object>

    <object name="Config">
      <sources>
        <source name="ObjectUnion">
          <param>"OrdConfig"</param>
          <param>"Skalds"</param>
          <param>"DocNumConfig"</param>
        </source>
      </sources>

      <field name="key" type="string" />
      <field name="value" type="string" />
    </object>
    
    <modify src="Price">
      <add>
        <field name="color" type="hex" />
        <field name="quant" type="number" />

        <field name="whQty" type="collection">
          <data>
            <object name="QtyItem">
              <sources>
                <source name="Sequence">
                  <param name="source">$parent.source</param>
                  <param name="startIndex">2</param>
                </source>
              </sources>

              <field name="qty" type="number" prec="2" />
            </object>
          </data>
        </field>
      </add>
    </modify>
    
    <modify src="Order">
      <add>
        <field name="payment" type="number" width="1"/>
        <field name="whCode" type="string" width="30" />
      </add>
    </modify>

    <modify src="Org">
      <add>
        <field name="noSales" type="number" />
        <field name="whCode" type="string" width="30" />
        <field name="dogovors" type="collection">
          <data>
            <object name="OrgDogovor">
              <sources>
                <source name="DBFTableSet">
                  <param name="userTable">"DG"</param>
                  <param name="commonTable">"DOGOVORS"</param>
                  <param name="filter">"[ID] = $parent.id"</param>
                </source>
              </sources>
              <field name="id" type="string" data="ID_D" />
              <field name="name" type="string" />
              <field name="firm" type="string" />
            </object>
          </data>
        </field>
      </add>
    </modify>

    <modify src="AgentPrefix">
      <add>
        <field name="order" type="string" />
      </add>
    </modify>

    <modify src="Incass">
      <change>
        <sources>
          <source name="DBFCatalogTable">
            <param name="tableName">"PKO" + $user.id</param>
            <param name="catalog">"id"</param>
            <param name="ordered">1</param>
          </source>
          <source name="SQTable" type="internal" />
        </sources>
      </change>
    </modify>

  </objects>
</serverDefs>
