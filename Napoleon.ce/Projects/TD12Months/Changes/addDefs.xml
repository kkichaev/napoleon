<?xml version="1.0" ?>
<serverDefs xmlns="http://grsoft.ru/schemas/serverDefs.xsd">
  <objects>
    <modify src="Org">
      <add>
        <field name="matrix" type="collection">
          <data>
            <object name="OrgMatrix">
              <sources>
                <source name="DBFTableSet">
                  <param name="userTable">"OMX"</param>
                  <param name="commonTable">"ORGMTX"</param>
                  <param name="filter">"[ORGID] = $parent.id"</param>
                </source>
              </sources>

              <field name="orgid" type="string" />
              <field name="id" type="string" />
            </object>
          </data>
        </field>
      </add>
    </modify>
        <modify src="Price">
            <add>
                <field name="minqty" type="number" prec="3"/>
            </add>
        </modify> 
        <modify src="Order">
            <add>
                <field name="priceType" type="string" width="30" data="PT"/>
            </add>
        </modify> 
        
        <modify src="Order$items">
            <add>
                <field name="priceType" type="string" width="30" data="PT_I"/>
            </add>
        </modify> 
    </objects>
</serverDefs>
