#
# установить имя проекта
#
PROJECT=MeatAlliance

FEATURES = STOP_LIST RCV_MESSAGE VISIT_DOC POD_COMMENT GPS_POS PAY_DELAY
FEATURES+= ORG_COLOR ORG_INFO ORG_NOTE ORG_SKU ORG_REMNANTS ORD_DLV_BIND
FEATURES+= PRICE_MATRIX PRICE_COLOR PRICE_FILTER0 PRESENTATION_EDITOR SQL_ORG_ROUTE
FEATURES+= NAPOLEON_APPS FOCUSED_GROUP FOCUSED_ITEMS SCRIPT_DOC QUESTION QUESTION_IN_SCRIPTS QUESTION_REPORT RETURN_DOC STD_QUESTION_REPORT PYTHON_REPORTER
FEATURES+= USE_ONLY_ORDER_IN_SUM REPORT_INCLUDE_DELIVERIES QUESTION_REPORT_WITHOUT_PHOTO RETURN_DOC CENSUS_FILTER ORG_STOP_EDITOR

NPL_PDA_RESOURCE=

INST_FILES=addDefs.xml

#
# если есть WinMobile закомментарить
#
NO_WIN_MOBILE=1

NEW_CORE=1

MANAGER_SOURCE=FmDetailEx DivisionFormEx ProjectObjects
MANAGER_FORMS=FmAgentPlan OrderAnalize FmReturnsReport
