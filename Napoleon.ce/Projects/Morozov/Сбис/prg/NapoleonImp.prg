Функция НаполеонНомерСклада(оТовар)
{
   Очистить(оКарточкаСклада);
   оКарточкаСклада = Выборка( "Складская картотека" );
   пИспользуемыеСклады = ",7,4,";

   #Ищем где максимальный остаток
   пНомСкл = 0;
   пОстСкл = 0;
   оКарточкаСклада = Выборка( "Складская картотека" );
   Пока( Следующий( оТовар.Лицо_, оКарточкаСклада, "Номенклатура-Склад" ) )
   {   
      Если( оКарточкаСклада.Остаток > 0 и Найти( пИспользуемыеСклады, "," + 'оКарточкаСклада.N склада' + "," ) != 0 )
      {
         Если( оКарточкаСклада.Остаток > пОстСкл )
         {
            пНомСкл = 'оКарточкаСклада.N склада';
            пОстСкл =  оКарточкаСклада.Остаток;
         }
      }
   }
   вернуть пНомСкл;
}


Функция НаполеонСоздатьНакладную(оНакладная)
