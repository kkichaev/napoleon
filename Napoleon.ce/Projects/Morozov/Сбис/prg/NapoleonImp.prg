Функция НаполеонДобавитьТовар(оНакладная, оНовыйДок, нпп)
{
   оНаименование = Объект("Расход");
   оТовар = НайтиЛицо(оНакладная.ID_I, "Номенклатура");

   Если( Есть( оТовар ) == 1 )
   {
      пНомСкл = НаполеонНомерСклада(оТовар);

      Очистить(оКарточкаСклада);
      оКарточкаСклада = Выборка( "Складская картотека" );
      Пока( Следующий( оТовар.Лицо_, оКарточкаСклада, "Номенклатура-Склад" ) )
      {   
         #Товар берем только с одного склада где его больше, остальное не грузим
         Если( оКарточкаСклада.Остаток > 0 и Число(пНомСкл) == Число('оКарточкаСклада.N склада') )
         {
            пСписать = Мин( оНакладная.QTY, оКарточкаСклада.Остаток );
           'оНаименование.N п/п'         =   нпп;
            оНаименование.дата           =   оНовыйДок.Дата; 
            оНаименование.Кол_во         =   пСписать; 
           'оНаименование.Код упаковки'  = 'оКарточкаСклада.Код упаковки';
            оНаименование.СуммаЦен       =  пСписать * оНакладная.COST;
            оНаименование.Признаки = "-Перемещение-Закрыто-Не просчитано+Резерв";
            Связать( 'оНаименование.Склад-Расход', оКарточкаСклада );
            Установить(оНовыйДок);
            Связать( 'оНаименование.Накладная-Расход', оНовыйДок );
            Добавить( оНаименование );

            оНовыйДок.Сумма += пСписать * оНакладная.COST;
            Сохранить(оНовыйДок);
            Очистить( оНаименование );

            вернуть 1;
         }
      }  
   }
   вернуть 0;
}                        

Функция НаполеонПриемНакладных()
{
   чНакладных = 0;
   нпп = 1;

   папкаОбмена = НаполеонКаталогОбмена();
   папкаПрограмм = НаполеонКаталогОбмена() + "src\\";

   #Объединим файлы заявок
   параметры = "\"" + папкаОбмена + "invoice.dbf\" " + 
               "\"" + папкаОбмена + "ord*.dbf\"";
   программа = папкаПрограмм + "NplCombine.exe " + параметры;
#отладить();
   Запустить( программа, 1);

#отладить();
            #вернуть 1;

   #создаем накладные
   оНакладная = Объект(папкаОбмена + "invoice.dbf");
     
   Очистить(оНовыйДок);
   документСоздан = 0;
#отладить();
   Пока(Следующий(оНакладная))
   {
      Если(Число(оНакладная.ORDFLAG) != 0)
      {
         нпп = 1;
 
         оНовыйДок = НаполеонСоздатьНакладную(оНакладная);

         Если( Есть(оНовыйДок) == 1 )
         {
            документСоздан = 1;
            Если( Есть(оНакладная.CREATED) == 1 )
            {
              #сохраним тэг принятой накладной для отправки на КПК
              параметры = папкаОбмена + " " + 
                          оНакладная.USER_ID + " " + 
                          папкаПрограмм;

              программа = папкаПрограмм + "cppod.bat " + параметры;
              Запустить(программа, 1);

              оПН = Объект(папкаОбмена + "pod" + оНакладная.USER_ID + ".DBF");
              оПН.CREATED = оНакладная.CREATED;
              Добавить(оПН);
              Очистить(оПН);
            }               
            чНакладных++;
         } 
# иначе
#            отладить();         
      }

      Если( документСоздан == 1 )
      {
         Если( НаполеонДобавитьТовар(оНакладная, оНовыйДок, нпп) == 1 )
            нпп++;
      }
      Удалить(оНакладная);
   }

   Очистить(оНакладная);
   вернуть чНакладных;
}

