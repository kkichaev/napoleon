    <modify src="Order$items">
      <change>
        <sources>
          <source name="SQTable" type="internal" />
        </sources>
      </change>
      <add>
        <field name="uid" type="string" />
        <field name="action" type="string" width="55" data="ACT_ID" />
        <field name="whData" type="collection">
          <data>
            <object name="OrderWhData">
              <sources>
                <source name="SQTable" type="internal" />
