    <modify src="AgentAssortMtx" dest="UserAssortMtx">
      <change>
        <sources>
          <source name="SQTable" type="internal">
            <param name="readFilter">'"userid"=' + "'" + $user.id + "'"</param>
          </source>
        </sources>
      </change>
    </modify>

    <modify src="Org">
      <change>
        <sources>
          <source name="SQLQuery">
            <param name="stmt">
              "select o.*, c.id as c_id, c.name as c_name, c.phone as phone from Org o left join OrgContacts c on o.id = c.id where o.userid = '" + $user.id + "' order by o.id"
            </param>
          </source>
        </sources>
      </change>
      <add>
        <field name="license" type="date" />
        <field name="cfo" type="string" />
        <field name="comment" type="string" />
        <field name="color" type="hex" />
        <field name="userid" type="string" />
        <field name="dlvFrom" type="string" />
        <field name="dlvTill" type="string" />
        <field name="kpp" type="string" />

        <field name="email" type="string" />
      </add>
    </modify>
    <modify src="Org$contacts">
      <change>
        <sources>
          <source name="SQLQuery">
            <param name="keyFields">"id"</param>
          </source>
        </sources>
        <field name="name" data="c_name" type="string" width="100" />
        <field name="phone" type="string" width="100" />
        <field name="id" data="c_id" type="string" width="30" />
      </change>
    </modify>
    <modify src="CommonOrgs">
      <change>
        <sources>
          <source name="SQLQuery">
            <param name="stmt">
              "select distinct id as tag, * from Org "
            </param>
          </source>
        </sources>
      </change>
    </modify>

    <modify src="Price">
      <change>
        <field name="action" type="number" hidden="true" width="1" />
        <field name="flags" type="number" execOn="Get">EncodeFlag($object.action,4)</field>
        <field name="info" type="string" />
        <field name="rezerv" type="number" prec="3" />
        <field name="horeca" type="number" />

        <field name="country" type="string" />
        <field name="region" type="string" />
        <field name="grape" type="string" />
        
        <field name="brand" type="string" />
        <field name="strength" type="number" prec ="1" />
        
        <sources>
          <source name="SQLQuery">
            <param name="stmt">"select * from [Price]" </param>
          </source>
        </sources>
      </change>
    </modify>
    <modify src="Order">
      <change>
        <sources>
          <source name="SQTable" type="internal" />
        </sources>
      </change>
      <add>
        <field name="dlvDir" type="string" width="30" />
        <field name="dlvMethod" type="string" width="30" data="DLVMTHD" />
