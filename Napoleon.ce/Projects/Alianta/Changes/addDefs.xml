    </object>

    <object name="PriceQty">
      <sources>
        <source name="SQTable" type="internal" />
      </sources>

      <member name="primaryKey">"id,idStore,year"</member>

      <field name="id" type="string" />
      <field name="idStore" type="string" />
      <field name="year" type="number" />
      <field name="qty" type="number" prec="3" />
      <field name="rezerv" type="number" prec="3" />

      <field name="items" type="collection">
        <data>
          <object name="ActionItem">
            <sources>
              <source name="SQTable" type="internal" />
            </sources>
            <field name="cfo" type="string"/>
            <field name="cost" type="number" prec="2" />
          </object>
        </data>
      </field>
    </object>

    <object name="Actions">
      <sources>
        <source name="SQTable" type="internal">
          <param name="readFilter">'"end" &gt;= ToDate("' + FormatDate(Now(),"DD.MM.YYYY") + '")'</param>
        </source>
      </sources>

      <member name="primaryKey">"id"</member>
      <memberArray name="index">"end"</memberArray>

      <field name="id" type="string" />
      <field name="name" type="string" />
      <field name="cfo" type="string"/>
      <field name="costype" type="number"/>

      <field name="start" type="date" />
      <field name="end" type="date" />

      <field name="isManual" type="number" />

      <field name="orgs" type="collection">
        <data>
          <object name="OrgItem">
            <sources>
              <source name="SQTable" type="internal" />
            </sources>
            <field name="id" type="string"/>
          </object>
        </data>
      </field>

    <field name="items" type="collection">
        <data>
          <object name="ActionItem">
            <sources>
              <source name="SQTable" type="internal" />
            </sources>
            <field name="id" type="string"/>
            <field name="discount" type="number" prec="2" />
          </object>
        </data>
      </field>
    </object>

    <object name="AgentPlan">
      <sources>
        <source name="SQTable" type="internal">
          <param name="readFilter">
            '"userid"=' + "'" + $user.id + "' and " +
            '"begin" &lt;= ToDate("' + FormatDate(Now(),"DD.MM.YYYY") + '") and ' +
            '"end" &gt;= ToDate("' + FormatDate(Now(),"DD.MM.YYYY") + '")'
          </param>
        </source>
      </sources>

      <member name="primaryKey">"userid,begin"</member>

      <field name="userid" type="string" />
      <field name="begin" type="timestamp" />
      <field name="end" type="timestamp" />

      <field name="groups" type="collection">
        <data>
          <object name="AgemtPlanGroups">
            <sources>
              <source name="SQTable" type="internal" />
            </sources>
            <field name="id" type="string" />
            <field name="type" type="number"/>
            <field name="valueSum" type="number" prec="2" />
            <field name="valueQty" type="number" prec="3" />
          </object>
        </data>
      </field>
    </object>

    <object name="PricePhoto" sendLimit="300000" feature="!PRESENTATION_EDITOR">
      <sources>
        <source name="DBFCatalogTable">
          <param name="tableName">$object.table + $user.id</param>
          <param name="catalog">"[PATH]"</param>
          <param name="ordered">0</param>
        </source>
        <source name="DBFCatalogTable">
          <param name="tableName">$object.altTable</param>
          <param name="filter">"[FOLDER] in $folder.fid"</param>
          <param name="catalog">"[PATH]"</param>
          <param name="ordered">0</param>
        </source>
      </sources>

      <member name="table">"W"</member>
      <member name="altTable">"WAREHOUS"</member>

      <field name="items" type="collection">
        <data>
          <object name="PhotoPriceItem">
            <sources>
              <source name="DBFCatalogItemTable" />
            </sources>
            <field name="id" type="string" data="ID"/>
          </object>
        </data>
      </field>
      <field name="photo" type="file" data="PATH" />
    </object>

    <object name="PricePhoto" sendLimit="300000" feature="PRESENTATION_EDITOR">
      <sources>
        <source name="SQTable" type="internal" />
      </sources>

      <member name="primaryKey">"name"</member>

      <field name="items" type="collection">
        <data>
          <object name="PhotoPriceItem">
            <sources>
              <source name="SQTable" type="internal" />
            </sources>
            <field name="id" type="string"/>
          </object>
        </data>
      </field>

      <field name="name" type="string" />
      <field name="photo" type="binary"  />
      <!--<field name="photo" type="file" src="name" />-->
    </object>

