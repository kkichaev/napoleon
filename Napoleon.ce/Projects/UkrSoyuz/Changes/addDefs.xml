<?xml version="1.0" ?>
<serverDefs xmlns="http://grsoft.ru/schemas/serverDefs.xsd">
  <objects>
    <object name="ReturnData">
      <sources>
        <source name="DBFTable">
          <param name="tableName">"RD"  + $user.id</param>
        </source>
      </sources>

      <field name="unloadsum" type="number" prec="2" data="US"/>
      <field name="returnsum" type="number" prec="2" data="RS"/>
      <field name="unloadweight" type="number" prec="3" data="UW"/>
      <field name="returnweight" type="number" prec="3" data="RW"/>
    </object>
    <object name="ExchDoc">
      <sources>
        <source name="DBFCatalogTable">
          <param name="tableName">$object.table + $user.id</param>
          <param name="catalog">"id"</param>
          <param name="ordered">1</param>
        </source>
        <source name="SQTable" type="internal" />
      </sources>

      <member name="table">"EXD"</member>
      <member name="primaryKey">"userid,created"</member>

      <field name="userid" type="string" data="USER_ID" execOn="Put">$user.id</field>
      <field name="created" type="timestamp" />
      <field name="sended" type="timestamp" data="S_DATE" execOn="Put">Now()</field>
      <field name="date" type="date" />
      <field name="id" width="40" type="string" />

      <field name="items" type="collection">
        <data>
          <object name="ExchDocItem">
            <sources>
              <source name="DBFCatalogItemTable"/>
              <source name="SQTable" type="internal" />
            </sources>

            <field name="id" width="30" type="string" data="ID_I"/>
            <field name="qty" type="number" prec="3" />
            <field name="date" type="date" data="DATE_I" />
            <field name="ordflag" width="1" type="number" execOn="Put">FirstItem($object)</field>
          </object>
        </data>
      </field>
      <events>
        <event type="put">
          <action name="WriteInternal">$object.type</action>
          <action name="WriteToLog">$object.type;$object.date</action>
        </event>
      </events>

    </object>

    <object name="PriceSetQty">
      <sources>
        <source name="DBFTableSet">
          <param name="userTable">"QCO"</param>
          <param name="commonTable">"ORGSETTY"</param>
        </source>
      </sources>

      <field name="id" width="30" type="string" data="ID_I"/>
    </object>

    <object name="PriceItemColor">
      <sources>
        <source name="DBFTableSet">
          <param name="userTable">"ICL"</param>
          <param name="commonTable">"ITEMSCOLOR"</param>
        </source>
      </sources>

      <field name="id" width="30" type="string" data="ID_I"/>
      <field name="color" type="hex" />
    </object>

    <modify src="Org">
      <add>
        <field name="delay" type="number" width="5" />
        <field name="wrkTime" type="string" width="50" />
        <field name="balance" type="number" prec="2" />
        <field name="paytype" type="string" width="30"/>
        <field name="ptypes" type="string" width="250"/>
      </add>
    </modify>
    <modify src="Order">
      <add>
        <field name="payType" type="string" width="30" />
        <field name="id" width="50" type="string" />
      </add>
    </modify>
    <modify src="Order$items">
      <add>
        <field name="unit" type="string" data="ID_WU" />
      </add>
    </modify>
    <modify src="Incass">
      <add>
        <field name="payType" type="string" width="30" />
        <field name="agent" type="string" width="30" />
      </add>
    </modify>
    <modify src="Delivery">
      <add>
        <field name="payType" type="string" width="30" />
        <field name="payDate" type="date" />
        <field name="agent" type="string" width="30" />
      </add>
    </modify>
    <modify src="Payment">
      <add>
        <field name="payType" type="string" width="30" />
        <field name="agent" type="string" width="30" />
      </add>
    </modify>
    <modify src="OrgFolder$items">
      <change>
        <field name="name" type="string" data="id" width="50"/>
      </change>
    </modify>
    <modify src="Returns">
      <add>
        <field name="id" width="50" type="string" />
      </add>
    </modify>
    <modify src="OrgRemnants">
      <add>
        <field name="id" width="50" type="string" />
      </add>
    </modify>
    <modify src="Price">
      <add>
        <field name="units" type="collection">
          <data>
            <object name="Units">
              <sources>
                <source name="DBFTableSet">
                  <param name="userTable">"WU"</param>
                  <param name="commonTable">"WUNITS"</param>
                  <param name="filter">"[ID_I] = $parent.id"</param>
                </source>
              </sources>
              <field name="id" type="string" />
              <field name="name" type="string" />
              <field name="inpack" type="number" prec="3" />
            </object>
          </data>
        </field>
      </add>
    </modify>
    <modify src="Folder">
      <add>
        <field name="coeff" type="number" prec="2" />
      </add>
    </modify>

    <modify src="Answer">
      <change>
        <sources>
          <source name="DBFCatalogTable">
            <param name="tableName">$object.table + $user.id</param>
            <param name="catalog">"id"</param>
            <param name="ordered">1</param>
          </source>
          <source name="SQTable" type="internal" />
        </sources>
      </change>

      <add>
        <member name="table">"ANS"</member>
        <event type="put">
          <action name="WriteInternal">$object.type</action>
        </event>
      </add>
    </modify>
    <modify src="Answer$items">
      <change>
        <sources>
          <source name="DBFCatalogItemTable"/>
          <source name="SQTable" type="internal" />
        </sources>
      </change>
    </modify>

    <modify src="OrgRemnants">
      <change>
        <sources>
          <source name="DBFCatalogTable">
            <param name="tableName">"OST" + $user.id</param>
            <param name="catalog">"id"</param>
            <param name="ordered">1</param>
          </source>
          <source name="SQTable" type="internal" />
        </sources>
      </change>
      <add>
        <event type="put">
          <action name="WriteInternal">$object.type</action>
          <action name="WriteToLog">$object.type;$object.date</action>
        </event>
      </add>
    </modify>
    <modify src="OrgRemnants$items">
      <change>
        <sources>
          <source name="DBFCatalogItemTable"/>
          <source name="SQTable" type="internal" />
        </sources>
      </change>
    </modify>
  </objects>
</serverDefs>
