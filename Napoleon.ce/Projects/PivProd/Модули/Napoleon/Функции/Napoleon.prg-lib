функция НаполеонПроверитьФайлАгентов()
#если в папке обмена нет файла USERS.DBFсоздаим его
{
   файлАгентов = НаполеонПапкаОбмена() + "\\USERS.DBF";
   Если(!НайтиФайл(файлАгентов))
      DBFТаблица(файлАгентов, "НаполеонФайлАгентов", "DOS");
}

функция НаполеонПереименоватьФайлы()
#
#переименовывает временные файлы после внесения информации
#
{
   мФайлы = СписокФайлов(НаполеонПапкаОбмена() + "\\*.TMP.DBF");
   ДляВсех(Переменных(мФайлы, индекс))
   {
      имяФайла = мФайлы[индекс];
      новоеИмя = ПодСтрока(имяФайла, 1, Размер(имяФайла)-8) + ".DBF";
      
      Если(НайтиФайл(новоеИмя))
         УдалитьФайл(новоеИмя);
      ПереименоватьФайл(имяФайла, новоеИмя);
   }
}

функция НаполеонПроверитьАгента(оАгенты, кодАгента, имяАгента)
#
# найти агента в файле users.dbf - если нет, добавить
#
{
   тИмяАгента = Win2Dos(имяАгента);
   тКодАгента = Win2Dos(кодАгента);
   
   оАгенты.Очистить();
   Пока(Следующий(оАгенты))
   {
      Если( оАгенты.ID == тКодАгента )
      {
         Если( оАгенты.NAME != тИмяАгента )
         {
            оАгенты.NAME = тИмяАгента;
            оАгенты.Сохранить();
         }
         Вернуть 1;
      }
   }
   
   оАгенты.Очистить();
   оАгенты.NAME = тИмяАгента;
   оАгенты.ID = тКодАгента;
   оАгенты.Добавить();
}

функция НаполеонВыгрузитьКонтрагентов()
{
   ВывестиСтатус("Выгрузка контрагентов..");
   
   оАгенты = Таблица(НаполеонПапкаОбмена() + "\\USERS.DBF");
   оСотрудники = Таблица("СотрудникОрганизации");
   
   перем мКодАгента[], файлКонтрагентов, файлОрганизаций;
   Пока(Следующий(оСотрудники, "СотрудникОрганизация"))
   {
      кодАгента = оСотрудники.СотрудникОрганизация.ТабНомер;
      Если( Есть(мКодАгента[кодАгента]) == Нет )
      {
         мКодАгента[кодАгента] = 1;
         
         НаполеонПроверитьАгента(оАгенты, кодАгента, оСотрудники.СотрудникОрганизация.ФИО);
         
         имяФайлаОрг = НаполеонПапкаОбмена() + "\\O" + кодАгента + ".TMP.DBF";
         DBFТаблица(имяФайлаОрг, "НаполеонФайлОрганизаций", "DOS");
         файлОрганизаций = Таблица(имяФайлаОрг);
      }
      
      файлОрганизаций.Очистить();
      код = Win2Dos(оСотрудники.ОрганизацияСотрудник.ИНН);
      Если( оСотрудники.ОрганизацияСотрудник.КодФилиала != "" )
         код += СимволСКодом(9) + Win2Dos(оСотрудники.ОрганизацияСотрудник.КодФилиала);
         
      файлОрганизаций.ID = код;
      файлОрганизаций.NAME = Win2Dos(оСотрудники.ОрганизацияСотрудник.Название);
      файлОрганизаций.ADDRESS = Win2Dos(оСотрудники.ОрганизацияСотрудник.Адрес);
      файлОрганизаций.Добавить();
   }
}

функция НаполеонВыгрузитьПапкиСТоваром(оТовар, пКорень, файлТоваров, файлПапок)
{
   Если( пКорень != -1 )
   {
      оТовар.УстановитьКорень(пКорень);

      файлПапок.Очистить();

      файлПапок.ID = пКорень.АдресЗаписи();
      файлПапок.NAME = Win2Dos(пКорень.Наименование);
      файлПапок.LEVEL = 0;
      
      файлПапок.Добавить();
   }
   
   оУпаковка = Таблица("Упаковки и штрих-коды");
      
   оТовар.РазвернутьСУзлами();
   Пока(Следующий(оТовар))
   {
      Если( оТовар.ЭтоУзел() )
      {
         файлПапок.Очистить();
         
         Если( оТовар.ЭтоКорень() )
            уровень = 0;
         Иначе
            уровень = 1;
            
         оРаздел = оТовар.Раздел;
         Пока( !оРаздел.ЭтоКорень() )
         {
            оРаздел = оРаздел.Раздел;
            уровень++;
         }
                    
         файлПапок.ID = оТовар.АдресЗаписи();
         файлПапок.NAME = Win2Dos(оТовар.Наименование);
         файлПапок.LEVEL = уровень;
         
         файлПапок.Добавить();
      }
      Иначе
      {
         Если( файлТоваров != -1 и оТовар.Цена1 > 0 и
               (НаполеонВыгружатьНенулувыеОстатки() == 0 или оТовар.Свободно > 0) )
         {
            файлТоваров.Очистить();
            
            цвет = "";
            если( есть(оТовар.ПРИОРИТЕТ) )
            {
               если( оТовар.ПРИОРИТЕТ == 1 )
                  цвет = "F0";
               иначе если( оТовар.ПРИОРИТЕТ == 2 )
                  цвет = "F0F0";
            }
            
            файлТоваров.ID = НаполеонКодТовара(оТовар);
            файлТоваров.FOLDER = оТовар.Раздел.АдресЗаписи();
            файлТоваров.NAME = Win2Dos(оТовар.Наименование);
            файлТоваров.QTY = НаполеонОстаток(оТовар);
            файлТоваров.COST1 = оТовар.Цена1;
            файлТоваров.COST2 = оТовар.Цена2;
            файлТоваров.COST3 = оТовар.Цена3;
            файлТоваров.COLOR = цвет;
            
            файлТоваров.INPACK = 1;
            Если(оТовар.КодУпаковки != 0 )
            {
               оУпаковка.Очистить();
               Связать(оУпаковка.НоменклатураУпаковки, оТовар.НоменклатураСклады)
               оУпаковка.Код = оТовар.КодУпаковки;
               
               Если(Найти(оУпаковка, "НоменклатураУпаковки"))
                  файлТоваров.INPACK = оУпаковка.ВУпаковке;
            }
            
            файлТоваров.Добавить();
         }
      }
   }
}

функция НаполеонВыгрузитьПапкиАгентов()
{
   оАгенты = Таблица(НаполеонПапкаОбмена() + "\\USERS.DBF");
   оСотрудники = Таблица("СотрудникТовар");
   
   оТовар = Выборка("Складская картотека"); 
   
   перем мКодАгента[], файлПапок;
   Пока(Следующий(оСотрудники, "СотрудникТовар"))
   {
      кодАгента = оСотрудники.СотрудникТовар.ТабНомер;
      Если( Есть(мКодАгента[кодАгента]) == Нет )
      {
         мКодАгента[кодАгента] = 1;
         
         имяФайлПапок = НаполеонПапкаОбмена() + "\\F" + кодАгента + ".TMP.DBF";
         DBFТаблица(имяФайлПапок, "НаполеонФайлПапокТовара", "DOS");
         файлПапок = Таблица(имяФайлПапок);
      }
      НаполеонВыгрузитьПапкиСТоваром(оТовар, оСотрудники.ТоварСотрудник, -1, файлПапок);
   }
}
функция НаполеонВыгрузитьТовар()
{   
   ВывестиСтатус("Выгрузка товара..");

   пИмяФайла = НаполеонПапкаОбмена() + "\\WAREHOUS.TMP.DBF";
   DBFТаблица(пИмяФайла, "НаполеонФайлТоваров", "DOS");
   файлТоваров = Таблица(пИмяФайла);
   
   пИмяФайла = НаполеонПапкаОбмена() + "\\FOLDERS.TMP.DBF";
   DBFТаблица(пИмяФайла, "НаполеонФайлПапокТовара", "DOS");
   файлПапок = Таблица(пИмяФайла);

   оТовар = Выборка("Складская картотека"); 
   оПапки = Выборка("НаполеонКорневыеПапки");
 
   выгрузили = 0;
   
   Пока(Следующий(оПапки))
   {
      выгрузили = 1;
      НаполеонВыгрузитьПапкиСТоваром(оТовар, оПапки.СкладскаяКартотека, файлТоваров, файлПапок);
   }
   
   Если( выгрузили == 0 )
      НаполеонВыгрузитьПапкиСТоваром(оТовар, -1, файлТоваров, файлПапок);
}

функция НаполеонНайтиКонтрагента(оДок)
{
   оОрг = Таблица("Организации");

   код = Dos2Win(оДок.ID);
   филиал = "";
   поз = Найти(код, СимволСКодом(9))
   Если( поз != 0 )
   {
      филиал = Подстрока(код, поз+1);
      код = Подстрока(код, 1, поз-1);
   }
   
   оОрг.Очистить();
   оОрг.ИНН = код;

   Пока( Найти(оОрг, "ИНН") )
   {
      если( оОрг.ИНН != код )
         Прервать;
      если( оОрг.КодФилиала == филиал )
         Вернуть оОрг;
   }
   
   Вернуть -1;
}
функция НаполеонСоздатьЗаявку(оЗаявка, кодАгента, счет)
{
   Если( счет != 0 )
      имяВыборки = "Исходящие счета";
   Иначе
      имяВыборки = "Расходные накладные";
   
   оДок1 = Выборка(имяВыборки);

   оДок1.Очистить();
   оДок1.Дата = оЗаявка.DATE;
   
   оОрг = НаполеонНайтиКонтрагента(оЗаявка);
   Если( оОрг == -1 )
   {
      Вернуть -1;
   }
   
   Связать(оДок1.Лицо1, оОрг.Лицо_);
   

   оАгент = НайтиЛицо(кодАгента, "Сотрудники");
   Если( оАгент )
      Связать(оДок1.Лицо3, оАгент);
   
   оДок1.Сумма = 0; #оЗаявка.SUM;
   оДок1.Примечание = Dos2Win(оЗаявка.REMARK);
   
   НаполеонПапкаДокументов(оДок1);
      
   Если( оДок1.Добавить() )
   {
      Вернуть оДок1;
   }
      
   #сообщить("!!");
   #Отладить();
   Вернуть -1;
}

функция НаполеонДобавитьТовар(оДок, оЗаявка, нпп, счет)
{
   Если( счет != 0 )
      имяВыборки = "Наименования счета";
   Иначе
      имяВыборки = "Расход";
   
   оНаим = Выборка(имяВыборки);
   кодТовара = Dos2Win(оЗаявка.ID_I);
   поз = Найти(кодТовара, СимволСКодом(9));
   Если( поз != 0 )
   {
      кодТовара = Подстрока(кодТовара, поз+1);
   }
#   отладить();
   оТовар = НайтиЛицо(кодТовара, "Номенклатура");
   Если( !оТовар )
      Вернуть 0;
      
   оСклад = Выборка("Складская картотека");
   Если( !Следующий(оТовар.Лицо_, оСклад, "НоменклатураСклады"))
      Вернуть 0;
   
   оНаим.Очистить();   
   оНаим.ПорНомер = нпп;
   оНаим.ДатаВремя = оДок.Дата;
   оНаим.Кол_во = оЗаявка.QTY;
   оНаим.КодУпаковки = оТовар.КодУпаковки;
   оНаим.СуммаЦен = оЗаявка.COST * оЗаявка.QTY;
   
   Если( счет != 0 )
      Связать(оНаим.СкладНаименованияСчета, оСклад);
   Иначе
      Связать(оНаим.СкладРасходы, оСклад);
   оНаим.Добавить();
   
   Если( счет != 0 )
      Связать(оНаим.ДокументНаименования, оДок);
   Иначе
      Связать(оНаим.ДокументРасходы, оДок);
      
   оДок.Сумма += оНаим.СуммаЦен;
   оДок.Сохранить();
      
   оНаим.Сохранить();
   
   Вернуть 1;
}

функция НаполеонПриемЗаявок()
#
# функция для приема заявок от торговых агентов
#
{
   # выгружаем заявки в Исходящие счета
   счет = НаполеонСоздаватьСчет();
   
   мФайлы = СписокФайлов(НаполеонПапкаОбмена() + "\\ORD*.DBF");
   ДляВсех(Переменных(мФайлы, индекс))
   {
      пИмяФайла = мФайлы[индекс];
      новоеИмя = ПодСтрока(пИмяФайла, 1, Размер(пИмяФайла)-4) + ".TMP.DBF";
      ПереименоватьФайл(пИмяФайла, новоеИмя);
      
      разд = НайтиСКонца(пИмяФайла, "\\");
      разд2 = Найти(ПодСтрока(пИмяФайла, разд+4), ".");
      кодАгента = ПодСтрока(пИмяФайла, разд+4, разд2-1);
      
      имяПЗ = НаполеонПапкаОбмена() + "\\POD" + кодАгента + ".DBF";
      Если( !НайтиФайл(имяПЗ) )
         DBFТаблица(имяПЗ, "НаполеонФайлПодтвержденияЗаявки", "DOS");
         
      оПЗ = Таблица(имяПЗ);
      оЗаявка = Таблица(новоеИмя);
      
      перем мОбработано[], оДок = -1, нпп;
      Пока(Следующий(оЗаявка))
      {
      #  признак новой заявки
         Если(оЗаявка.ORDFLAG == 1 )
         {
            # проверка на дубль заявки
            Если( Есть(мОбработано[оЗаявка.CREATED]) == Нет )
            {
               мОбработано[оЗаявка.CREATED] = 1;
               оДок = НаполеонСоздатьЗаявку(оЗаявка, кодАгента, счет);
               
               # Добавим информацию о подтверждении заявки
               Если( оДок != -1 )
               {
                  оПЗ.Очистить();
                  оПЗ.CREATED = оЗаявка.CREATED;
                  оПЗ.Добавить();
               }
               нпп = 1;               
            }
            Иначе
               оДок = -1;               
         }
         
         Если(оДок != -1)
         {
            Если( НаполеонДобавитьТовар(оДок, оЗаявка, нпп, счет) )
               нпп++;
         }
      }
      
      УдалитьПерем(оЗаявка);       
      УдалитьФайл(новоеИмя);
            
      ОбновитьВыборки();  
   }
   
}
функция НаполеонНакладныеЗаПериод(пДатНач, пДатКнц, пДолги)
{
   пИмяФайла = НаполеонПапкаОбмена() + "\\DELIVERY.TMP.DBF";
   DBFТаблица(пИмяФайла, "НаполеонФайлНакладных", "DOS");
   файлНакладных = Таблица(пИмяФайла);

   отсрочка = 0;
   ДляВсех(Документов(пДатНач, пДатКнц, "НаклРасх"))
   {
      ВывестиСтатус("Выгрузка накладной " + Документ.Номер + "...");
      
      отсрочка = 1;
      Если( Есть(Документ.Лицо1.Лицо_.ОТСРОЧКА) )
      {
         отсрочка = Документ.Лицо1.Лицо_.ОТСРОЧКА;
      }
      Иначе
      {
         ДляВсех(Документов("Договоры", Документ.Лицо1))
         {
            если(Есть(Документ.Отсрочка) и Документ.ДатНач <= ТекДата и Документ.ДатКнц >= ТекДата)
            {
               отсрочка = Документ.Отсрочка;
               прервать;
            }
         }
      }
      
      пкод = Win2Dos(Документ.Лицо1.Лицо_.ИНН);
      Если( пкод != "" )
      {
         Если( Документ.Лицо1.Лицо_.КодФилиала != "" )
         {
            кодОрг = Документ.Лицо1.Лицо_.КодФилиала;
            пкод += СимволСКодом(9) + Win2Dos(Документ.Лицо1.Лицо_.КодФилиала);
         }
         
         # вычтем документы по которым нет просрочки по платежам
   #      Если( Документ.Дата >= пДатКнц - НаполеонГлубинаКредита(Документ.Лицо1))
   #         пДолги[пкод] -= Документ.Сумма;
         
         записано = 0;
         ДляВсех(Наименований())
         {
            файлНакладных.Очистить();
            
            файлНакладных.ID = пкод;

            файлНакладных.ID_I = НаполеонКодТовара(Наим);
            файлНакладных.NUM = Документ.Номер;
            файлНакладных.DATE = Документ.Дата;
            файлНакладных.PAYDATE = Документ.Дата + отсрочка;
            файлНакладных.QTY = Наим.Кол_во;
            файлНакладных.SUM = Наим.СуммаЦен;
            файлНакладных.SUMD = -Документ.КОплате;
            
            файлНакладных.Добавить();
            записано = 1;
         }
         # вычетаем долг если есть товар в накладных (а не навчальные остатки)
         Если( записано == 1 )
            пДолги[пкод] -= Документ.КОплате;
      }
   }
   
   УдалитьПерем(файлНакладных);
}

функция НаполеонВыгрузкаНакладных()
{
   ВывестиСтатус("Расчет сальдо..");
   
   оСотрудники = Таблица("СотрудникОрганизации");
   
   пДатКнц = ТекДата();
   пДатНач = пДатКнц - НаполеонГлубинаВыборкиДокументов();
 
   перем пДолги[];
   
   ДатКнц = пДатКнц;
   ДатНач = пДатНач;
   ДляВсех(Лиц("62"))
   {
      кодОрг = Win2Dos(Лицо1.Лицо_.ИНН);
      если( кодОрг != "" )
      {
         если(Лицо1.Лицо_.КодФилиала != "" )
            кодОрг += СимволСКодом(9) + Win2Dos(Лицо1.Лицо_.КодФилиала);
      
         долг = (СКД - СКК);
         
         пДолги[кодОрг] = долг;
#         если(Лицо1.Лицо_.ИНН == "7610041988" )
#            отладить();
      }
   }
   НаполеонНакладныеЗаПериод(пДатНач, пДатКнц, пДолги)

   
   # выгрузим долги
   пИмяФайла = НаполеонПапкаОбмена() + "\\PAYMENT.TMP.DBF";
   DBFТаблица(пИмяФайла, "НаполеонФайлОплат", "DOS");
   файлОплат = Таблица(пИмяФайла);
   ДляВсех(Переменных(пДолги, пкод))
   {
      файлОплат.Очистить();
      
      файлОплат.ID = пкод;
      файлОплат.NUM = Win2Dos("нач.сальдо");
      файлОплат.DATE = пДатНач;
      файлОплат.SUM = -пДолги[пкод];
      
#         если(пкод == "7610041988" )
#            отладить();
      файлОплат.Добавить();
   }
   УдалитьПерем(файлОплат);
   
   НаполеонПереименоватьФайлы();
}

функция НаполеонВыгрузкаКартинок()
{
   пкат = НаполеонПапкаОбмена() + "\\pics";
   Если(!НайтиКаталог(пкат))
      СоздатьКаталог(пкат);
         
   пИмяФайла = НаполеонПапкаОбмена() + "\\WAREHOUS.DBF";
   
   пном = 1;
   оП = Таблица(пИмяФайла);
   оТ = Таблица("Номенклатура");
   Пока(Следующий(оП))
   {   
      оТ.Очистить();
      оТ.НомНомер = Dos2Win(оП.ID);

      ВывестиСтатус("Выгрузка фото " + оТ.НомНомер);
      
      оП.PATH = "";
      Если( Найти(оТ, "НомНомер") == 1 )
      {
         Если(Размер(оТ.Фото) > 0)
         {
            пиф = пкат + "\\" + пном + ".jpg";
            пфайл = Файл(пиф);
            оП.PATH = "pics\\" + пном + ".jpg";
            пфайл.СкопироватьИзПоля(оТ.Фото);
            пфайл.Закрыть();
            
            пном++;
         }         
      }
      оП.Сохранить();
   }
}

функция НаполеонВыгрузкаДанных()
#
# функция для выгрузки организаций, складской картотеки и сотрудников в папку обмена
#
{
#  Для начала провери наличие папки обмена, если нет - создадим ее 
   Если(!НайтиКаталог(НаполеонПапкаОбмена()))
      СоздатьКаталог(НаполеонПапкаОбмена());
   
   НаполеонПроверитьФайлАгентов();
   
   НаполеонВыгрузитьКонтрагентов();
   НаполеонВыгрузитьПапкиАгентов();
   НаполеонВыгрузитьТовар();
   
   НаполеонПереименоватьФайлы();
}