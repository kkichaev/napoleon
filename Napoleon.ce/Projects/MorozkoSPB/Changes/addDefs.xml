	<objects>
    <object name="Store">
      <sources>
        <source name="SQLQuery">
          <param name="stmt">
            "select * from Stores where id in (select id from StoresAgents where userid ='" + $user.id + "') order by [index]"
          </param>
        </source>
      </sources>

      <field name="id" type="string" />
      <field name="name" type="string" />
      <field name="index" type="number" />
      <!--<field name="idFirm" type="string" />-->
    </object>

    <object name="Companies">
      <sources>
        <source name="SQLQuery">
