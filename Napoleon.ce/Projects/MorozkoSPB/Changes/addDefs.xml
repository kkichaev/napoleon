            "select * from Companies"
          </param>
        </source>
      </sources>

      <field name="id" type="string" />
      <field name="name" type="string" />
    </object>

    <object name="PriceCost">
      <sources>
        <source name="SQLQuery">
          <param name="stmt">
            "select * from PriceCost order by [idPrice]"
          </param>
        </source>
      </sources>

      <field name="idPrice" type="string" />
      <field name="items" type="collection">
        <data>
