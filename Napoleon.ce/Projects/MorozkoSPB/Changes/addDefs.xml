    <object name="OrgMatrix">
      <sources>
        <source name="SQLQuery">
          <param name="stmt">
            "if exists(select TOP(1) * from [Org] where [userid] = '" + $user.id + "')
            select * from [OrgMatrix] where id in (select id from Org o where o.userid='" + $user.id + "' union select name from OrgFolder$items where OrgFolder$userid = '" + $user.id + "')
            else
            select * from OrgMatrix"</param>
        </source>
      </sources>
      
      <member name="primaryKey">"id,id_i"</member>
      
      <field name="id" type="string" />
      <field name="id_i" type="string" />
      <field name="pos" type="number" />
      <field name="isRival" type="number" />
      <field name="suppl" type="string" />
    </object>

    <object name="Merch">
      <sources>
        <source name="SQTable" type="internal" />
      </sources>

      <member name="primaryKey">"userid,created"</member>
      <memberArray name="created">"date"</memberArray>

      <field name="userid" type="string" execOn="Put">$user.id</field>
      <field name="date" type="timestamp" />
      <field name="created" type="timestamp" />
      <field name="timeZone" type="number" />
      <field name="serverTimeZone" type="number" execOn="Put" feature="USE_TIMEZONE">ServerTimeZone()</field>
      <field name="sended" type="timestamp"  execOn="Put">Now()</field>
      <field name="id" type="string" />
      <field name="suppl" type="string" />
      
      <field name="items" type="collection">
        <data>
          <object name="MerchItem">
            <sources>
              <source name="SQTable" type="internal" />
            </sources>

            <field name="id" type="string"/>
            <field name="qty" type="number" prec="3" />
            <field name="system" type="number" prec="3" />
          </object>
        </data>
      </field>
      
      <field name="folders" type="collection">
        <data>
          <object name="MerchDocFolder">
            <sources>
              <source name="SQTable" type="internal" />
            </sources>

            <field name="id" type="string"/>
            <field name="mine" type="number" prec="3" />
            <field name="their" type="number" prec="3" />
          </object>
        </data>
      </field>

      <field name="latitude" type="number" prec="4" />
      <field name="longitude" type="number" prec="4" />

      <events>
        <event type="put">
          <action name="WriteToLog">$object.type;$object.date</action>
        </event>
      </events>
    </object>

