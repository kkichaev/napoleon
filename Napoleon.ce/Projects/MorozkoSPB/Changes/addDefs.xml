    <modify src="Org">
      <change>
        <sources>
          <source name="SQLQuery">
            <param name="stmt">
              "if exists(select TOP(1) * from [Org] where [userid] = '" + $user.id + "')
              select o.*, c.id as c_id, c.name as c_name, c.phone as c_phone from Org o left join OrgContacts c on o.id = c.id where o.userid='" +
              $user.id + "' or o.id in (select name from OrgFolder$items where OrgFolder$userid = '" + $user.id + "')
              else
              select o.*, c.id as c_id, c.name as c_name, c.phone as c_phone from Org o left join OrgContacts c on o.id = c.id where o.id in (select distinct id from Org)"
            </param>
          </source>
        </sources>
      </change>
      
      <add>
        <field name="idCompany" type="string" />
        <field name="prcType" type="string" />     
      </add>
    </modify>

