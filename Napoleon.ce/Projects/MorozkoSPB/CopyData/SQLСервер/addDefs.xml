<?xml version="1.0" ?>
<serverDefs xmlns="http://grsoft.ru/schemas/serverDefs.xsd">
	<objects>
    <object name="Store">
      <sources>
        <source name="SQLQuery">
          <param name="stmt">
            "select * from Stores where id in (select id from StoresAgents where userid ='" + $user.id + "') order by [index]"
          </param>
        </source>
      </sources>

      <field name="id" type="string" />
      <field name="name" type="string" />
      <field name="index" type="number" />
    </object>

    <object name="Companies">
      <sources>
        <source name="SQLQuery">
          <param name="stmt">
            "select * from Companies"
          </param>
        </source>
      </sources>

      <field name="id" type="string" />
      <field name="name" type="string" />
    </object>

    <object name="PriceCost">
      <sources>
        <source name="SQLQuery">
          <param name="stmt">
            "select * from PriceCost"
          </param>
        </source>
      </sources>

      <field name="idPrice" type="string" />
      <field name="items" type="collection">
        <data>
          <object name="Cost">
            <sources>
              <source name="SQLQuery">
                <param name="keyFields">"idPrice"</param>
              </source>
            </sources>
            <field name="id" type="string" />
            <field name="cost" type="number" prec="2" />
          </object>
        </data>
      </field>
    </object>

    <object name="PriceQty">
      <sources>
        <source name="SQLQuery">
          <param name="stmt">
            "select * from PriceQty where idStore in (select id from StoresAgents where userid ='" + $user.id + "')"
          </param>
        </source>
      </sources>

      <field name="id" type="string" />
      <field name="idStore" type="string" />
      <field name="qty" type="number" prec="3" />
    </object>

    <object name="PriceTypes">
      <sources>
        <source name="SQLQuery">
          <param name="stmt">
            "select * from PriceTypes order by [index]"
          </param>
        </source>
      </sources>

      <field name="id" type="string" />
      <field name="name" type="string" />
      <field name="index" type="number" />
    </object>

    <modify src="Firm">
      <change>
        <sources>
          <source name="SQLQuery">
            <param name="stmt">
              "select * from Firms order by [index]"
            </param>
          </source>
        </sources>
      </change>
      <add>
        <field name="index" type="number" />
      </add>
    </modify>

    <modify src="ManagerFolder">
      <change>
        <sources>
          <source name="SQLFolder" type="internal">
            <param name="parentField">"parent"</param>
            <param name="childField">"fid"</param>
            <param name="readFilter">"[userid] = '" + $user.id + "'"</param>
          </source>
        </sources>
      </change>
      <add>
        <field name="fid" type="string" width="50" />
        <field name="id" type="string" execOn="Get">$object.fid</field>
        <field name="parent" type="string" width="50" />
        <field name="userid" type="string" execOn="Put">$user.id</field>
      </add>
    </modify>

    <modify src="Order">
      <change>
        <sources>
          <source name="SQTable" type="internal" />
        </sources>
      </change>
      <add>
        <field name="idStore" type="string" width="50" />
        <event type="put">
          <action name="WriteToLog">$object.type;$object.created</action>
        </event>
      </add>
    </modify>

    <modify src="Order$items">
      <change>
        <sources>
          <source name="SQTable" type="internal" />
        </sources>
      </change>
    </modify>

    <modify src="Delivery">
      <change>
        <sources>
          <source name="SQLQuery">
            <param name="stmt">
              "select id, number, date, payDate, qty, sum, sumd, id_i from Deliveries where userid = '" + $user.id + "'"
            </param>
          </source>
        </sources>
        <field name="number" type="string"  />
      </change>
    </modify>

    <modify src="Delivery$items">
      <change>
        <sources>
          <source name="SQLQuery">
            <param name="keyFields">"number"</param>
          </source>
        </sources>
      </change>
    </modify>
    
    <modify src="Payment">
      <change>
        <sources>
          <source name="SQLTable" type="internal">
            <param name="readFilter">'userid = '" + $user.id + "'"</param>
          </source>
        </sources>
      </change>
      <add>
        <field name="userid" type="string" />
        <member name="primaryKey">"userid,id,number"</member>
      </add>
    </modify>

    <modify src="Incass">
      <change>
        <sources>
          <source name="SQTable" type="internal" />
        </sources>
      </change>
      <add>
        <event type="put">
          <action name="WriteToLog">$object.type;$object.created</action>
        </event>
      </add>
    </modify>

    <modify src="OrderCommitted">
      <change>
        <sources>
          <source name="SQTable" type="internal">
            <param name="readFilter">'"userid"=' + "'" + $user.id + "'" + ' and "created" &gt;= ToDate(' + "'" + FormatDate(AdjustDate(Now(),-1,"month"),"DD.MM.YYYY") + "')" </param>
          </source>
        </sources>
      </change>
      <add>
        <member name="primaryKey">"userid,created"</member>
      </add>
    </modify>

    <modify src="Folder">
      <change>
        <sources>
          <source name="SQLFolder" type="internal">
            <param name="parentField">"parent"</param>
            <param name="childField">"fid"</param>
            <param name="rowidField">"id"</param>
            <param name="stmt">
              "if exists(select TOP(1) * from [Folder] where [userid] = '" + $user.id + "')
              SELECT * FROM [Folder] where [userid] = '" + $user.id + "'
              else
              SELECT * FROM [Folder] where [userid] is null or [userid] = ''"
            </param>
          </source>
        </sources>
        <field name="id" type="number" />
        <field name="fid" type="string" width="50" />
        <field name="name" type="string" />
        <field name="userid" type="string" />
      </change>
      <add>
        <field name="parent" type="string" width="50" />
      </add>
    </modify>

    <modify src="Price">
      <change>
        <sources>
          <source name="SQLQuery">
            <param name="stmt">"select * from [Price]" </param>
          </source>
        </sources>
      </change>
    </modify>

    <modify src="ManagerPrice">
      <change>
        <sources>
          <source name="SQLQuery">
            <!--readFilter используется для чтения по умолчанию (когда идет команда Get)-->
            <param name="stmt">"select * from [Price]"</param>
          </source>
        </sources>
      </change>
    </modify>

    <modify src="CommonOrgs">
      <change>
        <sources>
          <source name="SQLQuery">
            <param name="stmt">
              "select * from Org o"
            </param>
          </source>
        </sources>
      </change>
    </modify>

    <modify src="Org">
      <change>
        <sources>
          <source name="SQLQuery">
            <param name="stmt">
              "select o.*, c.id as c_id, c.name as c_name, c.phone as c_phone from Org o left join OrgContacts c on o.id = c.id where o.userid='" + 
                $user.id + "' or o.id in (select name from OrgFolder$items where OrgFolder$userid = '" + $user.id + "')"
            </param>
          </source>
        </sources>
      </change>
      <add>
        <field name="idCompany" type="string" />
        <field name="prcType" type="string" />
      </add>
    </modify>

    <modify src="Org$contacts">
      <change>
        <sources>
          <source name="SQLQuery">
            <param name="keyFields">"id"</param>
          </source>
        </sources>
        <field name="name" data="c_name" type="string" width="100" />
        <field name="phone" type="string" width="100" data="c_phone" />
        <field name="id" data="c_id" type="string" width="30" />
      </change>
    </modify>

    <modify src="Agents">
      <change>
        <sources>
          <source name="SQTable" type="internal" />
        </sources>
        <field name="id" type="string" />
        <field name="name" type="string" />
        <field name="login" type="string" width="30" />
        <field name="password" type="string" width="30" />
      </change>
    </modify>

    <modify src="Config">
      <change>
        <sources>
          <source name="SQTable" type="internal" />
        </sources>
        <field name="value" type="string" width="4000" />
      </change>
    </modify>

    <modify src="OrderProceeded">
      <change>
        <sources>
          <source name="SQTable" type="internal">
            <param name="readFilter">'"userid"=' + "'" + $user.id + "'"</param>
          </source>
        </sources>
      </change>
      <add>
        <field name="userid" type="string" />
      </add>
    </modify>
    <modify src="OrgRemnants">
      <change>
        <sources>
          <source name="SQTable" type="internal">
            <param name="readFilter">'"userid"=' + "'" + $user.id + "'"</param>
          </source>
        </sources>
      </change>
    </modify>

    <modify src="MessageArchive">
      <change>
        <field name="message" type="string" width="4000"/>
      </change>
    </modify>

    <modify src="Message">
      <change>
        <sources>
          <source name="SQTable" type="internal">
            <param name="readFilter">'"userid" = ' + "'" + $user.id + "'"</param>
          </source>
        </sources>
        <field name="message" type="string" width="4000"/>
      </change>
      <add>
        <field name="date" type="timestamp" execOn="Put">Now()</field>
        <field name="userid" type="string" execOn="Put">$user.id</field>
      </add>
    </modify>

    <modify src="CommonMatrix">
      <change>
        <sources>
          <source name="SQTable" type="internal" />
        </sources>
      </change>
      <add>
        <member name="primaryKey">"name"</member>
        <field name="userid" type="string" />
      </add>
    </modify>
    <modify src="CommonMatrix$items">
      <change>
        <sources>
          <source name="SQTable" type="internal" />
        </sources>
      </change>
    </modify>

    <modify src="Matrix">
      <change>
        <sources>
          <source name="SQLQuery">
            <param name="stmt">
              "select cm.name as name, i.id as id
              from (CommonMatrix as cm inner join [CommonMatrix$items] as i on cm.name = i.[CommonMatrix$name])
              inner join AgentMatrix as am on cm.name = am.name
              where am.userid = '"+$user.id+"'"
            </param>
          </source>
        </sources>
      </change>
    </modify>
    <modify src="Matrix$items">
      <change>
        <sources>
          <source name="SQLQuery">
            <param name="keyFields">"name"</param>
          </source>
        </sources>
      </change>
    </modify>

    <modify src="Agents" dest="AgentsName">
      <add>
        <field name="userid" type="string" execOn="Get">$user.id</field>
      </add>
    </modify>
    <modify src="Visit$items">
      <add>
        <field name="name" type="string" />
        <field name="id" type="file" src="name" baseFolder="agents\"/>
      </add>
    </modify>


    <modify src="GPSPos" dest="CopyGPSPos">
      <change>
        <field name="userid" type="string" />
      </change>
    </modify>
    <modify src="UserLog" dest="CopyUserLog">
      <change>
        <field name="userid" type="string" />
      </change>
    </modify>
    <modify src="Visit" dest="CopyVisit">
      <change>
        <sources>
          <source name="SQTable" type="internal" />
        </sources>
        <field name="userid" type="string" />
      </change>
    </modify>
    <modify src="Visit$items" dest ="CopyVisit$items">
      <change>
        <sources>
          <source name="SQTable" type="internal" />
        </sources>
      </change>
      <add>
        <field name="name" type="string" />
      </add>
    </modify>
    <modify src="Order" dest="CopyOrder">
      <change>
        <sources>
          <source name="SQTable" type="internal" />
        </sources>
        <field name="userid" type="string" />
      </change>
    </modify>
    <modify src="Order$items" dest ="CopyOrder$items">
      <change>
        <sources>
          <source name="SQTable" type="internal" />
        </sources>
      </change>
    </modify>
    <modify src="Returns" dest="CopyReturns">
      <change>
        <sources>
          <source name="SQTable" type="internal" />
        </sources>
        <field name="userid" type="string" />
      </change>
    </modify>
    <modify src="Returns$items" dest ="CopyReturns$items">
      <change>
        <sources>
          <source name="SQTable" type="internal" />
        </sources>
      </change>
    </modify>
    <modify src="Incass" dest="CopyIncass">
      <change>
        <sources>
          <source name="SQTable" type="internal" />
        </sources>
        <field name="userid" type="string" />
      </change>
    </modify>
    <modify src="OrgRemnants" dest="CopyOrgRemnants">
      <change>
        <sources>
          <source name="SQTable" type="internal" />
        </sources>
        <field name="userid" type="string" />
      </change>
    </modify>
    <modify src="OrgRemnants$items" dest ="CopyOrgRemnants$items">
      <change>
        <sources>
          <source name="SQTable" type="internal" />
        </sources>
      </change>
    </modify>    
  </objects>
</serverDefs>
