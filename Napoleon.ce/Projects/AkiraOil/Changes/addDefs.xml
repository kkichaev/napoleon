    <modify src="Price">
      <change>
        <sources>
          <source name="SQLQuery">
            <!--<param name="stmt">
              "select t.name || ' [' || t.art || ']' as name, t.art as id, t.ves as weight, t.kyp as inpack, t.category as folder, c.cena / 100 as cost, c.price - 1 as ctype,
              case when tbs then 1 else 0 end as noDiscount, kodsait as grpDiscountId, t.descr, t.rang
              from s1c._tovar t left join s1c._price c on t.art = c.art 
              order by t.art, c.price"</param>-->
            <param name="stmt">
              "select t.name || ' [' || t.art || ']' as name, t.art as id, t.ves as weight, t.kyp as inpack, t.category as folder, c.cena / 100 as cost, c.price - 1 as ctype,
              case when tbs then 1 else 0 end as noDiscount, kodsait as grpDiscountId, ost.ost as qty, t.descr, t.rang
              from s1c._tovar t left join s1c._price c on t.art = c.art left join s1c.ost_napoleon ost on t.art = ost.art and ost.podr = '" + $user.division + "'
              order by t.art, c.price"
            </param>
          </source>
        </sources>
      </change>
      <add>
        <field name="noDiscount" type="number" />
        <field name="grpDiscountId" type="string" />
