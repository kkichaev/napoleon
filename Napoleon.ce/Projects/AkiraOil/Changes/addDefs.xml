<?xml version="1.0" ?>
<serverDefs xmlns="http://grsoft.ru/schemas/serverDefs.xsd">
	<objects>
    <object name="LoadedOrders">
      <sources>
        <source name="SQLQuery">
          <param name="stmt">
            "select z.num || ' ' || s.name || '&lt;br/&gt;' || z.pril || ' ' || z.num_vx as orderNumber" + ', z.unum, z.pril as program, z.apart as id, cast((extract(epoch from z.dt) + 11644473600) * 10000000 as bigint) as "date",
            i.qty, i.art as id_i, i.sumt as sum_i, z.komm as remark
            from s1c._zakaz z, s1c._zakaz_th i, s1c._zakaz_state s where z.unum = i.unum and z.zstate = s.id
            --and i.qty > 0
            and z.pril &lt;&gt; ' + "'napoleon' and z.dt &gt;= '$01' and z.apart in (select apart from s1c.apart2 where manag = " + "'" + $user.id + "') order by z.unum"
        </param>
        </source>
      </sources>
      <field name="id" type="string" />
      <field name="unum" type="string" />
      <field name="program" type="string" />
      <field name="orderNumber" type="string" />
      <field name="remark" type="string" />
      <field name="date" type="timestamp" />
      <field name="items" type="collection">
        <data>
          <object name="Item">
            <sources>
              <source name="SQLQuery">
                <param name="keyFields">"unum"</param>
              </source>
            </sources>
            <field name="id" type="string" data="id_i" />
            <field name="qty" type="number" prec="3" />
            <field name="sum" type="number" prec="2" data="sum_i" />
          </object>
        </data>
      </field>
    </object>

    <object name="OrderConfirm">
      <sources>
        <source name="SQLQuery">
          <param name="stmt">
            "select z.num || ' ' || case when z.zstate = 0 then 'Отправлен' when z.zstate = 1 then 'Загружен в 1с' else s.name end || '&lt;br/&gt;' || z.pril || ' ' || z.num_vx as orderNumber" +
            ',z.num as number, z.unum, z.apart as id, z.num_vx as orderTag, cast((extract(epoch from z.dt) + 11644473600) * 10000000 as bigint) as "date",
            case when z.zstate &lt; 2 then i.qty_z else i.qty end as qty, i.art as id_i,
            case when z.zstate &lt; 2 then i.qty_z * i.cena_z else i.sumt end as sum_i
            from s1c._zakaz z, s1c._zakaz_th i, s1c._zakaz_state s where z.unum = i.unum and z.zstate = s.id and (z.zstate &lt; 2 or i.qty &gt; 0)
            and z.pril = ' + "'napoleon' and z.dt &gt;= '$01' and z.apart in (select apart from s1c.apart2 where manag = " + "'" + $user.id + "') order by z.unum"
          </param>
        </source>
      </sources>
      <field name="id" type="string" />
      <field name="unum" type="string" />
      <field name="orderNumber" type="string" />
      <field name="number" type="string" />
      <field name="orderTag" type="string" />
      <field name="date" type="timestamp" />
      <field name="items" type="collection">
        <data>
          <object name="Item">
            <sources>
              <source name="SQLQuery">
                <param name="keyFields">"unum"</param>
              </source>
            </sources>
            <field name="id" type="string" data="id_i" />
            <field name="qty" type="number" prec="3" />
            <field name="sum" type="number" prec="2" data="sum_i" />
          </object>
        </data>
      </field>
    </object>

