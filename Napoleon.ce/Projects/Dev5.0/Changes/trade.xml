<?xml version="1.0" ?>
<serverDefs xmlns="http://grsoft.ru/schemas/serverDefs.xsd">
  <objects>
    <object name="PotenzialOrg">
      <sources>
        <source name="SQTable" type="internal" >
          <param name="readFilter">'"userid" = ' + "'" + $user.id + "'"</param>
        </source>
      </sources>

      <member name="primaryKey">"userid,id"</member>

      <field template="useridPut" />
      <field name="created" type="timestamp" />
      <field template="id"/>
      <field template="name"/>
      <field name="address" type="string" />
      <field name="longitude" type="number" prec="5" />
      <field name="latitude" type="number" prec="5" />
      <field name="stltime" type="number" />
      
      <field name="contacts" type="collection">
        <data>
          <object name="Contact">
            <sources>
              <source name="SQTable" type="internal" />
            </sources>

            <field name="name" type="string" />
            <field name="phone" type="string" />
          </object>
        </data>
      </field>
    </object>

    <!--Удаленные записи из PotenzialOrg-->
    <object name="PODel" >
      <sources>
        <source name="SQTable" type="internal" >
          <param name="readFilter">'"userid" = ' + "'" + $user.id + "'" + ' and "flags" = 0'</param>
        </source>
      </sources>

      <member name="primaryKey">"userid,id"</member>

      <field template="userid" />
      <field template="id" />
      <field name="flags" type="number" />

      <events>
        <event type="readCommit">
          <action name="PODelSended" />
        </event>
      </events>
    </object>

    <object name="OrgMatrix">
      <sources>
        <source name="SQTable" type="internal" />
      </sources>
      
      <member name="primaryKey">"id"</member>
      
      <field name="id" type="string" />
      <field name="items" type="collection">
        <data>
          <object name="Item">
            <sources>
              <source name="SQTable" type="internal" />
            </sources>
            
            <field template="id" />
          </object>
        </data>
      </field>
    </object>
    
    <object name="Stores">
      <sources>
        <source name="SQTable" type="internal">
          <param name="readFilter">AgentDataFilter("id","Store",$01)</param>
          <param name="$01">$user.id</param>
          <param name="ordered" />
        </source>
      </sources>

      <member name="primaryKey">"id"</member>

      <field template="id"/>
      <field template="name"/>
    </object>

    <object name="StoreQty">
      <sources>
        <source name="SQTable" type="internal">
          <param name="readFilter">AgentDataFilter("id","Store",$01) + AgentDataFilter("idItem","Price",$01, "and")</param>
          <param name="$01">$user.id</param>
        </source>
      </sources>

      <member name="primaryKey">"id,idItem"</member>

      <field template="id"/>
      <field template="id" name="idItem"/>
      <field template="qty" />
      <field template="dataVersion" />
    </object>

    <object name="RouteTemplate">
      <sources>
        <source name="SQTable" type="internal">
          <param name="readFilter">'"userid"=\'$01\''</param>
          <param name="$01">$user.id</param>
        </source>
      </sources>
      <member name="primaryKey">"userid,dayOfWeek,weekIndex"</member>
      <field name="items" type="collection">
        <data>
          <object name="OrgFolderItem">
            <sources>
              <source name="SQTable" type="internal" />
            </sources>
            <field template="id" />
            <field name="index" type="number" />
          </object>
        </data>
      </field>
      <!-- 0 - Sunday, 1 - Monday, etc -->
      <field name="dayOfWeek" type="number" />
      <field name="weekIndex" type="number" />
      <field name="maxIndex" type="number" />
      <field name="firstDay" type="date" />
      <field template="userid"/>
    </object>

    <object name="PriceTypes">
      <sources>
        <source name="SQTable" type="internal">
          <param name="readFilter">AgentDataFilter("id","PriceType",$01)</param>
          <param name="$01">$user.id</param>
          <param name="ordered" />
        </source>
      </sources>

      <member name="primaryKey">"id"</member>

      <field template="id"/>
      <field template="name"/>
    </object>

    <object name="PriceCost">
      <sources>
        <source name="SQTable" type="internal">
          <param name="readFilter">AgentDataFilter("id","PriceType",$01) + AgentDataFilter("idItem","Price",$01, "and")</param>
          <param name="$01">$user.id</param>
        </source>
      </sources>
      <member name="primaryKey">"id,idItem"</member>
      <field name="idItem" template="id" />
      <field template="id" />
      <field template="cost"/>
      <field template="dataVersion" />
    </object>
    
    <object name="Order" base="BaseDocument">
      <sources>
        <source name="SQTable" type="internal" />
      </sources>
      
      <field name="prcType" template="id" />
      <field name="sumType" type="number" />
      <field name="firmCode" template="id" />
      <field name="supplyer" type="number" />
      <field name="whCode" template="id" />
      <field name="whIndex" type="number" />
        
      <field name="items" type="collection">
        <data>
          <object name="OrderItem">
            <sources>
              <source name="SQTable" type="internal" />
            </sources>

            <field template="id"/>
            <field name="unit" template="id" />
            <field template="qty" />
            <field name="qtyPack" template="qty" />
            <field template="cost" />

            <field name="flags" type="number" width="9" prec="0" />
          </object>
        </data>
      </field>

      <events>
        <event type="writeCommit">
          <action name="LoadDocScheduler" />
        </event>
      </events>
    </object>
    
    <object name="Incass" base="BaseDocument">
      <sources>
        <source name="SQTable" type="internal" />
      </sources>

      <field name="sum" template="cost" />      
      <field name="autoMode" type="number" />

      <field name="items" type="collection" >
        <data>
          <object name="Item">
            <sources>
              <source name="SQTable" type="internal" />
            </sources>

            <field name="number" type="string"/>
            <field name="date" type="date"  />
            <field name="sum" template="cost" />
            <field name="uid" type="string" />

          </object>
        </data>
      </field>

      <events>
        <event type="writeCommit">
          <action name="LoadDocScheduler" />
        </event>
      </events>
    </object>

    <object name="Returns" base="BaseDocument">
      <sources>
        <source name="SQTable" type="internal" />
      </sources>

      <field name="items" type="collection">
        <data>
          <object name="OrderItem">
            <sources>
              <source name="SQTable" type="internal" />
            </sources>

            <member name="primaryKey">"uid"</member>

            <field template="id"/>
            <field template="qty" />
            <field template="cost" />

            <field name="uid" type="string" />
            <field name="items" type="collection">
              <data>
                <object name="ReturnDlv">
                  <sources>
                    <source name="SQTable" type="internal" />
                  </sources>

                  <field name="number" type="string" />
                  <field name="date" type="date" />
                  <field template="qty" />
                  <field template="cost" />
                  <field name="uid" type="string" />
                </object>
              </data>
            </field>
          </object>
        </data>
      </field>

      <events>
        <event type="writeCommit">
          <action name="LoadDocScheduler" />
        </event>
      </events>
    </object>


    <object name="DocCommitted">
      <sources>
        <source name="SQTable" type="internal">
          <param name="readFilter">'"userid"  = \'$01\' and "created" &gt;= $02'</param>
          <param name="$01">$user.id</param>
          <param name="$02">ToDate(FormatDate(AdjustDate(Now(), -3, "day"),"DD.MM.YYYY"))</param>
        </source>
      </sources>

      <member name="primaryKey">"userid,created"</member>

      <field template="userid" />
      <field name="created" type="timestamp" />
      <field name="type" type="string" />
      <field name="number" type="string" />
      <field name="date" type="date" />
    </object>

    <object name="DocProceeded" removeOnCommit="true" sendAlways="true">
      <sources>
        <source name="SQTable" type="internal">
          <param name="readFilter">'"userid"=\'$01\''</param>
          <param name="$01">$user.id</param>
        </source>
      </sources>

      <member name="primaryKey">"userid,created"</member>

      <field template="userid" />
      <field name="created" type="timestamp" />
      <field name="type" type="string" />
      <field name="remark" type="string" />

      <events>
        <event type="get">
          <action name="ArchiveDocProceeded">$object.created;$object.type;$object.remark</action>
        </event>
      </events>
    </object>
    
    <object name="Delivery">
      <sources>
        <source name="SQTable" type="internal">
          <param name="readFilter">AgentDataFilter("id","Org",$01) + ' and "date" &gt;= $02'</param>
          <param name="$01">$user.id</param>
          <param name="$02">ToDate(FormatDate(AdjustDate(Now(),-3,"month"),"DD.MM.YYYY"))</param>
        </source>
      </sources>

      <field name="items" type="collection">
        <data>
          <object name="DeliveryItem">
            <sources>
              <source name="SQTable" type="internal"/>
            </sources>
            
            <field template="id" />
            <field template="qty"  />
            <field name="sum" template="cost" />
          </object>
        </data>
      </field>
      
      <member name="primaryKey">"date,number,id"</member>

      <field template="id" type="string" />
      <field name="number" type="string"  />
      <field name="date" type="date" />
      <field name="uid" type="string"  />
      
      <field name="created" type="timestamp" />
      <field template="userid" />
    </object>
    
    <object name="Balance">
      <sources>
        <source name="SQTable" type="internal">
          <param name="readFilter">AgentDataFilter("id","Org",$01)</param>
          <param name="$01">$user.id</param>
        </source>
      </sources>

      <member name="primaryKey">"id"</member>

      <field template="id" />
      <field name="sum" template="cost"  />
      
      <field name="documents" type="collection">
        <data>
          <object name="Item">
            <sources>
              <source name="SQTable" type="internal" />
            </sources>
            
              <field name="uid" type="string" />
              <field name="number" type="string"  />
              <field name="date" type="date" />
              <field name="payDate" type="date" />
              <field name="sum" template="cost"  />
              <field name="sumDoc" template="cost"  />
              <field name="title" type="string"  />
              <field name="type" type="string"  />
          </object>
        </data>
      </field>
    </object>

    <object name="ArchiveDocProceeded">
      <sources>
        <source name="SQTable" type="internal" />
      </sources>

      <member name="primaryKey">"userid,type,created"</member>

      <field name="userid" type="string" />
      <field name="created" type="timestamp" />
      <field name="remark" type="string" />
      <field name="type" type="string" />
    </object>
    
    <modify src="Order" dest="NewOrders">
      <change>
        <sources>
          <source name="SQLQuery">
            <param name="stmt">
              'select o.* from "Order" o left join "DocCommitted" dc on o."userid" = dc."userid" and o."created" = dc."created"
              where dc."created" is null and o."created" > $01'
            </param>
            <param name="$01">ToDate(FormatDate(AdjustDate(Now(), -3, "day"),"DD.MM.YYYY"))</param>
          </source>
        </sources>
      </change>
    </modify>

    <modify src="Returns" dest="NewReturns">
      <change>
        <sources>
          <source name="SQLQuery">
            <param name="stmt">
              'select o.* from "Returns" o left join "DocCommitted" dc on o."userid" = dc."userid" and o."created" = dc."created"
              where dc."created" is null and o."created" > $01'
            </param>
            <param name="$01">ToDate(FormatDate(AdjustDate(Now(), -3, "day"),"DD.MM.YYYY"))</param>
          </source>
        </sources>
      </change>
    </modify>

    <modify src="Incass" dest="NewIncass">
      <change>
        <sources>
          <source name="SQLQuery">
            <param name="stmt">
              'select o.* from "Incass" o left join "DocCommitted" dc on o."userid" = dc."userid" and o."created" = dc."created"
              where dc."created" is null and o."created" > $01'
            </param>
            <param name="$01">ToDate(FormatDate(AdjustDate(Now(), -3, "day"),"DD.MM.YYYY"))</param>
          </source>
        </sources>
      </change>
    </modify>
    
    <object name="PricePhoto" sendLimit="1000000" >
      <sources>
