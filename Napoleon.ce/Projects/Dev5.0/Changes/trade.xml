    <object name="TaskDone">
      <sources>
        <source name="SQTable" type="internal" />
      </sources>

      <member name="primaryKey">"userid,created"</member>
      <memberArray name="index">"created"</memberArray>

      <field name="created" type="timestamp" />
      <field name="timeZone" type="number" />
      <field template="useridPut" />
      <field template="id" />
      <field template="id" name="idTask" />
      <field name="remark" type="string" />
      <field name="items" type="collection">
        <data>
          <object name="TaskDoneItem">
            <sources>
              <source name="SQTable" type="internal" />
            </sources>
            <field template="id" />
            <field name="text" type="string"/>
            <field name="done" type="number"/>
          </object>
        </data>
      </field>
    </object>
    
    <object name="NotVisitedOrg">
      <field template="id" />
      <field template="userid" />
      <field name="date" type="date" />
    </object>

    <object name="PicStore">
      <sources>
        <source name="SQTable" type="internal" />
      </sources>

      <member name="primaryKey">"id"</member>
      <memberArray name="index">"created"</memberArray>

      <field template="id" />
      <field name="created" type="timestamp" />
      <field name="date" type="timestamp" />
      <field name="timeZone" type="number" />
      <field name="serverTimeZone" type="number" data="S_TZ" execOn="Put" feature="USE_TIMEZONE">ServerTimeZone()</field>
      <field template="useridPut" />
      <field name="sended" type="timestamp" execOn="Put">Now()</field>

      <field name="name" type="string" execOn="Put">ToFileName($user.id) + "/" + FormatDate(object.created, "YYYYMMDDHHmmSS") + DataExtention($object, "picture") </field>
      <field name="picture" type="file" src="name"  />
      <field name="smallName" type="string" execOn="Put">ToFileName($user.id) + "/" + FormatDate(object.created, "YYYYMMDDHHmmSS") + "_small" + DataExtention($object, "picture") </field>
      <field name="smallSize" type="string" />
      <field name="smallPhoto" type="file" src="smallName" />
      <field name="href" type="string" />
      <events>
        <event type="put">
          <action name="WriteToLog">$object.type;$object.date</action>
        </event>
      </events>
    </object>

    <!-- Ошибка при выполнении питона -->
    <object name="PythonExecError">
      <field name="type" type="string" />
      <field name="text" type="string" />
      <field name="stackTrace" type="string" />
    </object>

    <object name="DocSummaryInfo">
      <sources>
        <source name="SQLQuery">
          <param name="stmt">
            "select '$03' as doc_type," + '
            "id" as id,
            "userid" as userid,
            count(distinct "created") as doc_count,
            sum($04) as doc_sum,
            (((("created" / 10000000) / 3600) / 24) - 134774) * (24* 3600) as doc_date -- unix time
            from "$01" where $02
            group by "userid", "id", ((("created" / 10000000) / 3600) / 24)'
          </param>
        </source>
      </sources>

      <field name="doc_type" type="string" />
      <field name="id" type="string" />
      <field name="userid" type="string" />
      <field name="doc_count" type="number" />
      <field name="doc_date" type="number" />
      <field name="doc_sum" type="number" prec="2" />
    </object>

    <object name="AgentDocumentsTime">
      <sources>
        <source name="SQLQuery">
          <param name="stmt">
            'select "created", "userid" from "Order" where "userid" in ($01) and "created" &gt;= ToDate("$02") and "created" &lt;= ToDate("$03") union all
            select "created", "userid" from "Answer" where "userid" in ($01) and "created" &gt;= ToDate("$02") and "created" &lt;= ToDate("$03") union all
            select "created", "userid" from "Incass" where "userid" in ($01) and "created" &gt;= ToDate("$02") and "created" &lt;= ToDate("$03") union all
            select "created", "userid" from "OrgRemnants" where "userid" in ($01) and "created" &gt;= ToDate("$02") and "created" &lt;= ToDate("$03") union all
            select "created", "userid" from "ScriptDoc" where "userid" in ($01) and "created" &gt;= ToDate("$02") and "created" &lt;= ToDate("$03") union all
            select "date" as "created", "userid" from "Visit" where "userid" in ($01) and "date" &gt;= ToDate("$02") and "date" &lt;= ToDate("$03")
            '
          </param>
        </source>
      </sources>

      <field name="userid" type="string" />
      <field name="created" type="timestamp" />
    </object>


    <!--
    DocChildSummaryInfo Table;Where;DocType;SumExpr 
    Order;"Order$created">ToDate("01/01/2019");Order;cost*qty
    -->
    <modify src="DocSummaryInfo" dest ="DocChildSummaryInfo">
      <change>
        <sources>
          <source name="SQLQuery">
            <param name="stmt">
              "select '$03' as doc_type," + '
              "$01$userid" as userid,
              m."id" as id,
              count(distinct "$01$created") as doc_count,
              sum($04) as doc_sum,
              (((("$01$created" / 10000000) / 3600) / 24) - 134774) * (24* 3600) as doc_date -- unix time
              from "$01$items" s, "$01" m where $02 and s."$01$created" = m."created" and s."$01$userid" = m."userid"
              group by "$01$userid", m."id", ((("$01$created" / 10000000) / 3600) / 24)'
            </param>
          </source>
        </sources>
      </change>
    </modify>

    <modify dest="PicStoreSrc" src="PicStore">
      <remove>
        <field name="picture"/>
      </remove>
    </modify>

    <modify dest="UserLocation" src="GPSPos">
      <change>
        <sources>
          <source name="SQLQuery">
            <param name="stmt">
              'select gp."date", gp."userid", "latitude", "longitude", "speed", "accuracy", "satellite", "stltime", "isMock" from "GPSPos" gp,
              (select max("date") as "date", "userid" from "GPSPos" gp2 where gp2."date" &gt;= $01 group by "userid") gp2 where gp."date" = gp2."date" and gp."userid" = gp2."userid"'
            </param>
            <param name="$01">ToDate(FormatDate(Now(),"DD.MM.YYYY"))</param>
          </source>
        </sources>
        <field name="userid" type="string" />
      </change>
    </modify>


