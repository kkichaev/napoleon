            <field name="curType" type="string"/>
            <field template="name"/>
            <field name="nextDoc" type="number" />
            <field name="condition" type="number" />
            <field name="condParam" type="string"/>
            <field name="pos" type="number" />
            <field template="id"/>
          </object>
        </data>
      </field>
    </object>

    <object name="ScriptDoc" base="BaseDocument">
      <sources>
