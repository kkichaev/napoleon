    <object name="Question">
      <sources>
        <source name="SQTable" type="internal" >
          <param name="readFilter">'"idquest" IN (SELECT "idquest" FROM "AgentQuest" WHERE "userid"=' + "'" + $user.id + "')"</param>
        </source>
      </sources>

      <member name="primaryKey">"idquest"</member>

      <field template="id" name="idquest" />
      <field template="name" />
      <field name="from" type="timestamp" />
      <field name="till" type="timestamp" />
      <field name="text" type="string" />
      <field name="html" type="string" width="4000" />
      <field name="params" type="number" />
      <field name="number" type="number" />
      <field name="category" type="string" />
      <field name="producer" type="string" />

      <field name="items" type="collection">
        <data>
          <object name="QuestionItem">
            <sources>
              <source name="SQTable" type="internal" />
            </sources>
            <member name="primaryKey">"iditem"</member>

            <field template="id" name="iditem" />
            <field template="id" />
            <field name="text" type="string" />
            <!--0-text, 1-number, 2-list, 3-set, 4-boolean, 5-dataset -->
            <field name="type" type="number" />
            <field name="optional" type="number" />
            <field name="values" type="collection">
              <data>
                <object name="QuestionItemValue">
                  <sources>
                    <source name="SQTable" type="internal" />
                  </sources>
                  <field name="value" type="string"/>
                  <field name="pos" type="number"/>
                </object>
              </data>
            </field>
            <field name="number" type="number" />
          </object>
        </data>
      </field>

      <field name="attach" type="collection">
