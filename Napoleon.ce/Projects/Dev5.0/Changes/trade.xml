    </object>

    <object name="AgentScript">
      <sources>
        <source name="SQTable" type="internal" >
          <param name="readFilter">'"userid"=\'$01\''</param>
          <param name="$01">$user.id</param>
        </source>
      </sources>

      <member name="primaryKey">"userid,script"</member>
      <field template="userid"/>
      <field name="script" type="number" />
    </object>

    <object name="ScriptDef">
      <sources>
        <source name="SQTable" type="internal">
          <param name="readFilter">'("rem" != 1 or "rem" is null) and "id" IN (SELECT "script" FROM "AgentScript" WHERE "userid"=\'$01\')'</param>
          <param name="$01">$user.id</param>
        </source>
      </sources>
      <member name="primaryKey">"id"</member>

      <field name="id" type="number" />
