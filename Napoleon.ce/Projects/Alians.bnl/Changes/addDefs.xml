<?xml version="1.0" ?>
<serverDefs xmlns="http://grsoft.ru/schemas/serverDefs.xsd">
	<objects>
      <modify src="Price">
         <add>
         	<field name="units" type="collection">
               <data>
                  <object name="Units">
                     <sources>
                        <source name="DBFTableSet">
                           <param name="userTable">"WU"</param>
                           <param name="commonTable">"UNITS"</param>
                           <param name="filter">"[ID_I] = $parent.id"</param>
                        </source>
                     </sources>
                     <field name="id" type="string" />
                     <field name="name" type="string" />
                     <field name="inpack" type="number" prec="3" />
                  </object>
               </data>
         	</field>
	         <field name="whQty" type="collection">
	            <data>
	               <object name="QtyItem">
	                  <sources>
	                     <source name="Sequence">
	                        <param name="source">$parent.source</param>
	                        <param name="startIndex">2</param>
	                     </source>
	                  </sources>
	                  <field name="qty" type="number" prec="3" />
	               </object>
	            </data>
	         </field>
         </add>
      </modify>
      <modify src="Org">
         <add>
             <field name="prcType" type="string" /> 
             <field name="delay" type="number" />
             <field name="discount" type="number" prec="2" /> 
      	</add>
      </modify>
      <modify src="Order$items">
         <add>
            <field name="unit" type="string" data="ID_WU" />
         </add>
      </modify>
      <modify src="Order">
         <add>
             <field name="prcType" type="string" />
             <field name="firmCode" type="string" /> 
             <field name="whCode" type="string" /> 
      	 </add>
      </modify>
      
		</objects>
</serverDefs>
