IDR_MENU MENU 
BEGIN
    POPUP "Last"
    BEGIN
        MENUITEM "&О программе",                IDC_ABOUT
        MENUITEM "&Регистрация",                IDC_REGISTER
    END
    POPUP "OrgList"
    BEGIN
        MENUITEM "&О программе",                IDC_ABOUT
        MENUITEM "&Настройки",                  IDC_PREFERENCE
        MENUITEM SEPARATOR
        MENUITEM "&Прием остатков",             IDC_RCV_PRICE
        MENUITEM "С&инхронизация",              IDC_SYNC

        POPUP "&Списки"
        BEGIN
           MENUITEM "&Документов",          IDD_ORDER_LIST
#ifdef RCV_MESSAGE
           MENUITEM "С&ообщений",           IDD_MESSAGE_LIST
#endif
           MENUITEM "При&ходы",                 IDD_INCOME
           MENUITEM "Прайс-&лист",                 IDD_PRICE_LIST
        END

        MENUITEM SEPARATOR
        MENUITEM "&Выход",                      IDC_QUIT
    END
    POPUP "ViewStyle"
    BEGIN
        MENUITEM "&Заказы",                     IDC_ORDER_VIEW
        MENUITEM "&Накладные",                  IDC_DELIVERY_VIEW
        MENUITEM "&Баланс",                     IDC_BALANCE_VIEW
    END
END


