FEATURES = VERSION_4 STOP_LIST RCV_MESSAGE VISIT_DOC POD_COMMENT GPS_POS PAY_DELAY
FEATURES+= ORG_COLOR ORG_INFO ORG_NOTE ORG_SKU ORG_REMNANTS ORD_DLV_BIND
FEATURES+= PRICE_MATRIX PRICE_COLOR PRICE_FILTER0 PRESENTATION_EDITOR HAVE_CONFIG_READER
FEATURES+= SCRIPT_DOC SELECT_ORG_LOCATION QUESTION QUESTION_REPORT STD_QUESTION_REPORT QUESTION_IN_SCRIPTS
FEATURES+= NAPOLEON_APPS PYTHON_REPORTER AGENT_ORG_TASK DETAIL_AGENT_TASK_MENU CAN_ADD_ORG_TO_CENSUS

FEATURES+= MAX_PIC_SIZE=220
FEATURES+= HTTP_SERVER FOTO_ON_DISK NO_YANDEX_LOCATION QUESTION_REPORT_PYTHON ORG_DISPOSITION
FEATURES+= USE_CURL 

#FEATURES+= SQL_ORG_ROUTE INCASS_DEBET_DISTRIB

DEBUG_RELEASE=1


NPL_PDA_RESOURCE=

INST_FILES=addDefs.xml

DYNAMIC_RT=1

CS_PLATFORM=x86

#
# если есть WinMobile закомментарить
#
NO_WIN_MOBILE=1

MANAGER_SOURCE=FmDetailEx UserFormEx FmCensusEx DivisionSummaryEx PrjObj MainFormEx FmScriptDesignerEx FmScriptEditEx FmExportPhotoEx RouteEx 
MANAGER_FORMS=FmPtnzMap FacingControl FmAuditReport FmExportPhotoSpb InvEquControl InvFrgControl BarcodeControl

ADMIN_SOURCE=MainFormEx
ADMIN_FORMS=

NEW_CORE=1