      <modify src="Order$items">
         <add>
            <field name="discount" type="number" prec ="1" data="I_DSC" />
            <field name="cType" type="string" data="I_TYPE" execOn="Put">KeyValueReader("order.cfg","ВидЦены",$object.costType)</field>
         </add>
      </modify>
      <modify src="Agents">
         <add>
            <field name="sklad" type="number" />
         </add>
      </modify>
      <modify src="Folder">
         <change>
            <sources>
               <source name="DBFFolderSet">
                  <param name="userTable">"FLD"</param>
                  <param name="commonTable">"FD" + $user.sklad</param>
               </source>
            </sources>
         </change>
      </modify>
      <modify src="Price">
         <add>
            <field name="minNac" type="number" prec="2" data="MINNAC" />
            <field name="flags" type="number" prec="0" />
         </add>
         <change>
            <sources>
               <source name="DBFPriceTable">
                  <param name="userTable">"WHE"</param>
                  <param name="commonTable">"WH" + $user.sklad</param>
                  <param name="filter">"[folder] in $folder.fid"</param>
               </source>
            </sources>
         </change>
      </modify>
      <modify src="PriceRemnants">
         <change>
            <sources>
               <source name="DBFPriceTable">
                  <param name="userTable">"WHE"</param>
                  <param name="commonTable">"WH" + $user.sklad</param>
                  <param name="filter">"[folder] in $folder.fid"</param>
               </source>
            </sources>
         </change>
      </modify>
      <modify src="ManagerFolder" dest="SkladFolder">
         <change>
            <sources>
               <source name="DBFTable">
                  <param name="tableName">"FD" + $user.sklad</param>
               </source>
            </sources>
         </change>
      </modify>
