            </sources>
         </change>
      </modify>
      <modify src="ManagerPrice">
         <change>
            <sources>
               <source name="DBFTableSet">
                  <param name="userTable">"WHE"</param>
                  <param name="commonTable">"WH" + $user.sklad</param>
