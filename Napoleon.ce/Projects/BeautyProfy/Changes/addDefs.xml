    <modify src="MessageArchive">
      <add>
        <member name="primaryKey">"userid,date"</member>
      </add>
      <change>
        <field name="message" type="string" width="4000"/>
      </change>
    </modify>

    <modify src="Message">
      <change>
        <sources>
          <source name="SQTable" type="internal">
            <param name="readFilter">'"userid" = ' + "'" + $user.id + "'"</param>
          </source>
        </sources>
        <field name="message" type="string" width="4000"/>
      </change>
      <add>
        <member name="primaryKey">"userid,date"</member>
        <field name="date" type="timestamp" execOn="Put">Now()</field>
        <field name="userid" type="string" execOn="Put">$user.id</field>
      </add>
    </modify>

    <modify src="Payment">
      <change>
        <sources>
          <source name="SQLQuery">
            <param name="stmt">
              'SELECT p.ID, p.BALANCE as "sum", '+"'Долг' as num, (DATEDIFF(second, timestamp '1/1/1970 00:00:00', current_timestamp) + 11644473600) * 10000000 as " +'"date" ' +
              "FROM NP_GET_ORG('D:\Works\Napoleon.ce\Projects\BeautyProfy\!\CBD10032015.FDB', 'sysdba', 'masterkey') p where p.userid = '" + $user.id + "'"
            </param>
          </source>
        </sources>
      </change>
    </modify>

  </objects>

  <actions>
    <action name="OrdersWrited">
      <do>
        <execute>"SELECT * FROM NP_GET_ORDER('D:\Works\Napoleon.ce\Projects\BeautyProfy\!\CBD10032015.FDB', 'sysdba', 'masterkey', 211)"</execute>
      </do>
    </action>
    <action name="ReturnsWrited">
      <do>
        <execute>"SELECT * FROM NP_GET_RETURNS('D:\Works\Napoleon.ce\Projects\BeautyProfy\!\CBD10032015.FDB', 'sysdba', 'masterkey', 211)"</execute>
      </do>
    </action>
  </actions>
</serverDefs>
