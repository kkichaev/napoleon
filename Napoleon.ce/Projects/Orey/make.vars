FEATURES = VERSION_3_5 STOP_LIST RCV_MESSAGE VISIT_DOC POD_COMMENT GPS_POS PAY_DELAY
FEATURES+= ORG_COLOR ORG_INFO ORG_NOTE ORG_SKU ORG_REMNANTS ORD_DLV_BIND
