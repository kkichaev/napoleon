#
# установить имя проекта
#
PROJECT=EcoLineGroup

FEATURES = STOP_LIST RCV_MESSAGE VISIT_DOC POD_COMMENT GPS_POS PAY_DELAY
FEATURES+= ORG_COLOR ORG_INFO ORG_NOTE ORG_SKU ORG_REMNANTS ORD_DLV_BIND
FEATURES+= PRICE_MATRIX PRICE_COLOR PRICE_FILTER0 SQL_ORG_ROUTE
#PRESENTATION_EDITOR 
FEATURES+= NAPOLEON_APPS SCRIPT_DOC COST_MANAGER SELECT_ORG_LOCATION AGENT_ORG_TASK VISIT_CAUSE PYTHON_REPORTER
FEATURES+= QUESTION QUESTION_IN_SCRIPTS QUESTION_REPORT STD_QUESTION_REPORT 

NPL_PDA_RESOURCE=

INST_FILES=addDefs.xml

#
# если есть WinMobile закомментарить
#
NO_WIN_MOBILE=1

NEW_CORE=1

MANAGER_SOURCE=ProjectObjects FmDetailEx 
MANAGER_FORMS=FmOneDayReport OrgMatrixEditor 
