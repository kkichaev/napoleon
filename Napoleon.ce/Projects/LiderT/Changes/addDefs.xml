<?xml version="1.0" ?>
<serverDefs xmlns="http://grsoft.ru/schemas/serverDefs.xsd">
   <objects>
      <object name="Org">
         <sources>
            <source name="DBFTableSet">
               <param name="userTable">"O"</param>
               <param name="commonTable">"ORGS"</param>
            </source>
         </sources>

         <field name="id" type="string" />
         <field name="name" type="string" />
         <field name="address" type="string" />
         <field name="color" type="number" execOn="Get">GetColor($object.id,"org","face",0)</field>
         <field name="contacts" type="collection">
            <data>
               <object name="Contact">
                  <sources>
                     <source name="DBFTableSet">
                        <param name="userTable">"C"</param>
                        <param name="commonTable">"CONTACTS"</param>
                        <param name="filter">"[ID] = $parent.id"</param>
                     </source>
                  </sources>

                  <field name="name" data="FIO" type="string" />
                  <field name="phone" type="string" />
               </object>
            </data>
         </field>
         <field name="cards" type="collection">
            <data>
               <object name="Cards">
                  <sources>
                     <source name="DBFTableSet">
                        <param name="userTable">"CDS"</param>
                        <param name="commonTable">"CARDS"</param>
                        <param name="filter">"[IDO] = $parent.id"</param>
                     </source>
                  </sources>

                  <field name="id" type="string" />
                  <field name="name" type="string" />
                  <field name="costype" type="string" data="IDCT" />
               </object>
            </data>
         </field>
         <field name="longitude" type="number" prec="5" data="LONG" />
         <field name="latitude" type="number" prec="5" data="LAT" />
         <field name="type" type="number" />
         <field name="userid" type="string" />
      </object>

      <object name="Discount">
         <sources>
            <source name="DBFTableSet">
               <param name="userTable">"DSC"</param>
               <param name="commonTable">"DISCOUNT"</param>
               <param name="catalog">"id;items;0"</param>
            </source>
         </sources>

         <field name="items" type="collection">
            <data>
               <object name="DscItem">
                  <field name="discount" type="number" prec="1" />
                  <field name="idf" type="string" hidden="true" />
                  <field name="id" type="number" execOn="Get">FolderID($object.idf)</field>
               </object>
            </data>
         </field>
         <field name="id" type="string" data="IDO" />
      </object>

      <object name="Cost">
         <sources>
            <source name="DBFCostReader">
               <param name="cost">"COST"</param>
               <param name="costType">"CTYPE"</param>
            </source>
         </sources>

         <field name="data" type="binary" />
      </object>

      <object name="Order">
         <sources>
            <source name="DBFCatalogTable">
               <param name="tableName">$object.table + $user.id</param>
               <param name="catalog">"id"</param>
               <param name="ordered">1</param>
            </source>
            <source name="SQTable" type="internal" />
         </sources>
         
         <member name="table">"ORD"</member>
         <member name="primaryKey">"userid,created"</member>

         <field name="userid" type="string" data="USER_ID" execOn="Put">$user.id</field>
         <field name="created" type="timestamp" data="CREATED,NUM"/>
         <field name="sended" type="timestamp" data="S_DATE" execOn="Put">Now()</field>
         <field name="date" type="date" />
         <field name="delay" type="number" prec="0" />
         <field name="paydate" type="date" execOn="Put">AdjustDate($object.date, $object.delay, "day")</field>

         <field name="id" width="20" type="string" />
         <field name="card" width="20" type="string" data="IDC" />

         <field name="remark" type="string" />
         <field name="items" type="collection">
            <data>
               <object name="OrderItem">
                  <sources>
                     <source name="DBFCatalogItemTable"/>
                     <source name="SQTable" type="internal" />
                  </sources>

                  <field name="id" width="20" type="string" data="ID_I"/>
                  <field name="qty" type="number" prec="3" />
                  <field name="cost" type="number" prec="2" />
                  <field name="pack" type="number" width="1" execOn="Put">DecodeFlag($object.flags, 1, "", "1")</field>
                  <field name="ordflag" width="1" type="number" execOn="Put">FirstItem($object)</field>
               </object>
            </data>
         </field>

         <field name="ctype" type="string" width="30" execOn="Put">KeyValueReader("order.cfg","ВидЦены",$object.sumType)</field>
         <field name="firma" type="string" width="30" execOn="Put">KeyValueReader("order.cfg","Организация",$object.supplyer)</field>

         <field name="latitude" type="number" prec="5" />
         <field name="longitude" type="number" prec="5" />

         <events>
            <event type="put">
               <!--<action name="WriteOrder" /> !-->
               <action name="RunBat" />
               <action name="WriteInternal">$object.type</action>
               <action name="WriteToLog">$object.type;$object.created</action>
            </event>
         </events>
      </object>

   </objects>
</serverDefs>
