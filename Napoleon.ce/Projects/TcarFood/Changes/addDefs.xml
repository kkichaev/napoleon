<?xml version="1.0" ?>
<serverDefs xmlns="http://grsoft.ru/schemas/serverDefs.xsd">
	<objects>
        <object name="Fridge">
            <sources>
                <source name="DBFTableSet">
                    <param name="userTable">"FRD"</param>
                    <param name="commonTable">"FRDS"</param>
                </source>
            </sources>

            <field name="id" type="string" />
            <field name="number" type="string" />
        </object>
        
        <object name="InvFrg">
            <sources>
                <source name="SQTable" type="internal" />
            </sources>

            <member name="primaryKey">"userid,created"</member>

            <field name="userid" type="string" data="USER_ID" execOn="Put">$user.id</field>
            <field name="created" type="timestamp" data="CREATED,NUM"/>
            <field name="timeZone" type="number" />
            <field name="serverTimeZone" type="number" data="S_TZ" execOn="Put" feature="USE_TIMEZONE">ServerTimeZone()</field>
            <field name="sended" type="timestamp" data="S_DATE" execOn="Put">Now()</field>
            <field name="date" type="date" />
            <field name="id" width="55" type="string" />
            <field name="remark" type="string" />
            <field name="st1" type="timestamp"/>
            <field name="st2" type="timestamp"/>
            <field name="st3" type="timestamp"/>
      
            <field name="items" type="collection">
                <data>
                    <object name="InvFrgrItem">
                        <sources>
                            <source name="SQTable" type="internal" />
                        </sources>

                        <field name="number" type="string" />
                        <field name="prez" type="number" />
                    </object>
                </data>
            </field>

            <events>
                <event type="put">
                    <action name="RunBat" />
                    <action name="WriteInternal">$object.type</action>
                    <action name="WriteToLog">$object.type;$object.created</action>
                </event>
            </events>
        </object>
        
        <object name="Entity">
            <sources>
                <source name="DBFTable">
                    <param name="tableName">"ENTITY"</param>
                </source>
            </sources>

            <field name="id" type="string" />
            <field name="name" type="string" />
        </object>

        <object name="OrderCreated"> 
            <sources>
                <source name="SQLQuery">
                    <param name="stmt">
                        'select max("created") as "created", "id", "userid" from [order] group by "id","userid"'
                    </param>
                </source>
            </sources>
            <field name="id" type="string" />
            <field name="userid" type="string" />
            <field name="created" type="timestamp"/>
        </object>
    
        <modify src="Visit" dest="InvFrgSt1" table="InvFrgSt1">
            <add>
                <field name="invfrg" type="timestamp" />
            </add>
        </modify>
    
        <modify src="Visit" dest="InvFrgSt2" table="InvFrgSt2">
            <add>
                <field name="invfrg" type="timestamp" />
            </add>
        </modify>
    
        <modify src="Visit" dest="InvFrgSt3" table="InvFrgSt3">
            <add>
                <field name="invfrg" type="timestamp" />
            </add>
        </modify>
        
        <modify src="Org">
            <add>
                <field name="suppl" type="number" />
                <field name="entity" type="string" />
                <field name="due" type="number" prec="2" />
                <field name="postdue" type="number" prec="2" data="PDUE"/>                
                <field name="limitsum" type="number" data="DSUM" prec="2"/>
            </add>
        </modify>
        
        <modify src="Price">
            <add>
                <field name="boxed" type="number" />
            </add>
        </modify>
        
        <modify src="Returns">
            <add>
                <field name="firma" type="string" width="30" execOn="Put" feature="!SALES_MODULE &amp; !HAVE_CONFIG_READER">KeyValueReader("order.cfg","Организация",$object.supplyer)</field>
                <field name="firma" type="string" width="30" execOn="Put" feature="!SALES_MODULE &amp; HAVE_CONFIG_READER">ConfigReader("Организация",$object.supplyer)</field>
            </add>
        </modify>
        
        <modify src="Order" dest="Bonus" table="bonus">
        	<change>
            	<member name="table">"BNS"</member>
         	</change>

	        <add>
	            <field name="order" type="timestamp"/>
	            <field name="ordersum" type="number" prec="2" />
	        </add>
        </modify>
        
        <modify src="OrgLocation">
            <change>
                  <sources>
                    <source name="DBFTable">
                      <param name="tableName">"OL" + $user.id</param>
                    </source>
                    <source name="SQTable" type="internal" />
                </sources>
            </change>
          <add>
            <event type="put">
              <action name="WriteInternal">$object.type</action>
            </event>
          </add>
        </modify>
	</objects>
</serverDefs>
