<?xml version="1.0" ?>
<serverDefs xmlns="http://grsoft.ru/schemas/serverDefs.xsd">
  <objects>
    <object name="Cost" feature="COST_MANAGER">
      <sources>
        <source name="DBFCostReader">
          <param name="cost">"CS" + $user.id</param>
          <param name="costType">"CTP" + $user.id</param>
        </source>
      </sources>

      <field name="data" type="binary" />
    </object>

    <object name="MinCost">
      <sources>
        <source name="DBFTable">
          <param name="tableName">"MINCOST"</param>
        </source>
      </sources>

      <field name="id" type="string" width="30" />
      <field name="id_i" type="string" width="30" />
      <field name="minCost" type="number" prec="2" />
    </object>

    <modify src="Agents">
      <add>
        <field name="region" type="string" />
      </add>
    </modify>
    
