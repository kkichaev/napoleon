<?xml version="1.0" ?>
<serverDefs xmlns="http://grsoft.ru/schemas/serverDefs.xsd">
	<objects>
      <object name="OrdConfig">
         <sources>
            <source name="KeyValueTable">
               <param name="fileName">"ord"+$user.id+".cfg"</param>
            </source>
            <source name="KeyValueTable">
               <param name="fileName">"order.cfg"</param>
            </source>
         </sources>

         <field name="key" type="string" />
         <field name="value" type="string" />
      </object>

      <object name="Skalds">
         <sources>
            <source name="KeyValueDBFTable">
               <param name="fileName">"SKLADS"+$user.id</param>
               <param name="key">"Склады"</param>
               <param name="itemName">"NAME"</param>
               <param name="itemKey">"ID"</param>
            </source>
            <source name="KeyValueDBFTable">
               <param name="fileName">"SKLADS"</param>
               <param name="key">"Склады"</param>
               <param name="itemName">"NAME"</param>
               <param name="itemKey">"ID"</param>
            </source>
         </sources>
      
         <field name="key" type="string" />
         <field name="value" type="string" />
      </object>

      <object name="Config">
         <sources>
            <source name="ObjectUnion">
               <param>"OrdConfig"</param>
               <param>"Skalds"</param>
            </source>
         </sources>
         
         <field name="key" type="string" />
         <field name="value" type="string" />
      </object>

    <modify src="Incass">
      <add>
        <field name="whCode" type="string" width="30" />
      </add>
    </modify>

    <modify src="Delivery">
      <add>
        <field name="whCode" type="string" width="30" />
      </add>
    </modify>
      
      <modify src="Price">
         <add>
            <field name="whQty" type="collection">
               <data>
                  <object name="QtyItem">
                     <sources>
                        <source name="Sequence">
                           <param name="source">$parent.source</param>
                           <param name="startIndex">2</param>
                        </source>
                     </sources>
                     
                     <field name="qty" type="number" prec="2" />
                  </object>
               </data>
            </field>
         </add>
      </modify>
    <modify src="Org">
      <add>
        <field name="sklads" type="string" />
        <field name="ordsum" type="number" prec="2" />
      </add>
    </modify>
    <modify src="Order">
      <add>
        <field name="whCode" type="string" width="30" />
        <field name="dlvText" type="string" width="100" />
        <field name="dlvDate" type="date" />
        <field name="discount" type="string" width="50" />
        <field name="pr" type="number" width="1" />
      </add>
    </modify>
  </objects>
</serverDefs>
