NO_WIN_MOBILE=1

NEW_CORE=1

MANAGER_SOURCE=FmDetailEx MainFormEx ProjectObjects DivisionsEx UserFormEx FmScriptEditEx FmCoverAreaEx QuestionExcelReportEx FmMatrixDesignerEx 
MANAGER_SOURCE+=FmReportsEx FmGoodsMatrixDesigner ScriptTimeRpt2 ScriptTimeRpt3 DivisionFormEx ScriptTimeRpt4 EdBooleanEx FmQuestionReportEx
MANAGER_SOURCE+=FmQuestItemEditEx FmQuestEditEx

MANAGER_FORMS=ContractOverview FmCity FmCityEdit FmContract FmContractEdit FmOrg FmOrgAssign FmOrgEdit FmPriceEdit FmScrAssign FmSlsnet 
MANAGER_FORMS+=FmSlsnetEdit FmPartShelf ContractParams
