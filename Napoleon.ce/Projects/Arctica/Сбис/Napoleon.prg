Функция НаполеонЗагрузитьОплаты()
{       
   чНакладных = 0;
   нпп = 1;

   папкаОбмена = НаполеонКаталогОбмена();
   папкаПрограмм = НаполеонКаталогОбмена() + "src\\";

   #Объединим файлы заявок
   параметры = "\"" + папкаОбмена + "pkos.dbf\" " + 
               "\"" + папкаОбмена + "Incass*.dbf\"";
   программа = папкаПрограмм + "NplCombine.exe " + параметры;
   Запустить( программа, 1);

   #создаем накладные
   оНакладная = Объект(папкаОбмена + "pkos.dbf");
     
   Очистить(оНовыйДок);
   документСоздан = 0;

   Пока(Следующий(оНакладная))
   {
      оНовыйДок = НаполеонСоздатьОплату(оНакладная);

      Если( Есть(оНовыйДок) )
      {
         документСоздан = 1;

         #сохраним тэг принятой накладной для отправки на КПК
         параметры = папкаОбмена + " " + 
                     оНакладная.USERID + " " + 
                     папкаПрограмм;

         программа = папкаПрограмм + "cppod.bat " + параметры;
         Запустить(программа, 1);

         оПН = Объект(папкаОбмена + "pod" + оНакладная.USERID + ".DBF");
         оПН.CREATED = оНакладная.CREATED;
         оПН.TYPE = "Incass";
         Добавить(оПН);
         Очистить(оПН);
         чНакладных++;
      }
      Удалить(оНакладная);
   }

   Очистить(оНакладная);
   вернуть чНакладных;
}

Функция НаполеонЗагрузитьДокументы()
{       
   НаполеонЗагрузитьЗаявки();
   НаполеонЗагрузитьОплаты();
}

Функция НаполеонЗагрузитьЗаявки()
{       
   чНакладных = 0;
   нпп = 1;

   папкаОбмена = НаполеонКаталогОбмена();
   папкаПрограмм = НаполеонКаталогОбмена() + "src\\";

   #Объединим файлы заявок
   параметры = "\"" + папкаОбмена + "invoice.dbf\" " + 
               "\"" + папкаОбмена + "ord*.dbf\"";
   программа = папкаПрограмм + "NplCombine.exe " + параметры;
   Запустить( программа, 1);

   #создаем накладные
   оНакладная = Объект(папкаОбмена + "invoice.dbf");
     
   Очистить(оНовыйДок);
   документСоздан = 0;

   Пока(Следующий(оНакладная))
   {
      Если(Число(оНакладная.ORDFLAG) != 0)
      {
         нпп = 1;
 
         оНовыйДок = НаполеонСоздатьНакладную(оНакладная);

         Если( Есть(оНовыйДок) == 1 )
         {
            документСоздан = 1;

            #сохраним тэг принятой накладной для отправки на КПК
            параметры = папкаОбмена + " " + 
                        оНакладная.USER_ID + " " + 
                        папкаПрограмм;

            программа = папкаПрограмм + "cppod.bat " + параметры;
            Запустить(программа, 1);

            оПН = Объект(папкаОбмена + "pod" + оНакладная.USER_ID + ".DBF");
            оПН.CREATED = оНакладная.CREATED;
            Добавить(оПН);
            Очистить(оПН);

            чНакладных++;
         } Иначе
         {
            документСоздан = 0;
         }
      }

      Если( документСоздан == 1 )
      {
         Если( НаполеонДобавитьТовар(оНакладная, оНовыйДок, нпп) == 1 )
            нпп++;
      }
      Удалить(оНакладная);
   }

   Очистить(оНакладная);
   вернуть чНакладных;
}