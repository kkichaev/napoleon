<?xml version="1.0" ?>
<serverDefs xmlns="http://grsoft.ru/schemas/serverDefs.xsd">
  <objects>
    <object name="FolderDiscount">
      <sources>
        <source name="DBFTable">
          <param name="tableName">"FDSC"</param>
        </source>
      </sources>

      <field name="fid" data="ID_I" type="string" />
      <field name="category" type="string" />
      <field name="discount" data="DISC" type="number" prec="2"/>
      <field name="folderID" type="number" execOn="Get">FolderID($object.fid)</field>
    </object>

    <object name="PayType" >
      <sources>
        <source name="DBFTable">
          <param name="tableName">"PAYTYPE"</param>
        </source>
      </sources>

      <field name="id" type="string" />
      <field name="name" type="string" />
      <field name="category" type="string" />
      <field name="discount" data="DISC" type="number" prec="2"/>
    </object>

    <object name="OrdConfig">
      <sources>
        <source name="KeyValueTable">
          <param name="fileName">"ord"+$user.id+".cfg"</param>
        </source>
        <source name="KeyValueTable">
          <param name="fileName">"order.cfg"</param>
        </source>
      </sources>

      <field name="key" type="string" />
      <field name="value" type="string" />
    </object>

    <object name="Skalds">
      <sources>
        <source name="KeyValueDBFTable">
          <param name="fileName">"SKLADS"+$user.id</param>
          <param name="key">"Склады"</param>
          <param name="itemName">"NAME"</param>
          <param name="itemKey">"ID"</param>
        </source>
        <source name="KeyValueDBFTable">
          <param name="fileName">"SKLADS"</param>
          <param name="key">"Склады"</param>
          <param name="itemName">"NAME"</param>
          <param name="itemKey">"ID"</param>
        </source>
      </sources>

      <field name="key" type="string" />
      <field name="value" type="string" />
    </object>

    <object name="Config">
      <sources>
        <source name="ObjectUnion">
          <param>"OrdConfig"</param>
          <param>"Skalds"</param>
        </source>
      </sources>

      <field name="key" type="string" />
      <field name="value" type="string" />
    </object>

    <object name="Incomes">
      <sources>
        <source name="DBFCatalogTable">
          <param name="tableName">"INCOM"</param>
          <param name="catalog">"date"</param>
          <param name="ordered">0</param>
        </source>
      </sources>

      <field name="date" type="date" />
      <field name="items" type="collection">
        <data>
          <object name="IncomeItems">
            <sources>
              <source name="DBFCatalogItemTable" />
            </sources>

            <field name="id" type="string" />
            <field name="qty" type="number" />
            <field name="remark" type="string" />
          </object>
        </data>
      </field>
    </object>

    <modify src="Price">
      <add>
        <field name="minCost" type="number" prec="2" />
        <field name="whQty" type="collection">
          <data>
            <object name="QtyItem">
              <sources>
                <source name="Sequence">
                  <param name="source">$parent.source</param>
                  <param name="startIndex">2</param>
                </source>
              </sources>

              <field name="qty" type="number" prec="2" />
            </object>
          </data>
        </field>
        <field name="units" type="collection">
          <data>
            <object name="Units">
              <sources>
                <source name="DBFTableSet">
                  <param name="userTable">"WU"</param>
                  <param name="commonTable">"WUNITS"</param>
                  <param name="filter">"[ID_I] = $parent.id"</param>
                </source>
              </sources>
              <field name="id" type="string" />
              <field name="name" type="string" />
              <field name="inpack" type="number" prec="3" />
            </object>
          </data>
        </field>
      </add>
    </modify>

    <modify src="Org" >
      <add>
        <field name="dogovors" type="collection">
          <data>
            <object name="OrgDogovor">
              <sources>
                <source name="DBFTableSet">
                  <param name="userTable">"DG"</param>
                  <param name="commonTable">"DOGOVORS"</param>
                  <param name="filter">"[ID] = $parent.id"</param>
                </source>
              </sources>
              <field name="id" type="string" data="ID_D" />
              <field name="name" type="string" />
              <field name="costype" type="number" />
            </object>
          </data>
        </field>
        <field name="fldDsc" type="collection">
          <data>
            <object name="FldDsc">
              <sources>
                <source name="DBFTableSet">
                  <param name="userTable">"OFD"</param>
                  <param name="commonTable">"OFD_DSC"</param>
                  <param name="filter">"[ID] = $parent.id"</param>
                </source>
              </sources>
              <field name="id" type="string" data="ID_I" />
              <field name="folderID" type="number" execOn="Get">FolderID($object.id)</field>
              <field name="discount" type="number" prec="2" data="DSC" />
            </object>
          </data>
        </field>
        <field name="prcCost" type="collection">
          <data>
            <object name="FldDsc">
              <sources>
                <source name="DBFTableSet">
                  <param name="userTable">"OPC"</param>
                  <param name="commonTable">"OPC_DSC"</param>
                  <param name="filter">"[ID] = $parent.id"</param>
                </source>
              </sources>
              <field name="id" type="string" data="ID_I" />
              <field name="cost" type="number" prec="2" />
            </object>
          </data>
        </field>
        <field name="paytype" type="string"/>
        <field name="category" type="string" />
        <field name="discount" type="number" prec="2" data="DISC" />
      </add>
    </modify>

    <modify src="Order">
      <add>
        <field name="whCode" type="string" width="50" />
        <field name="idDog" type="string" width="50" data="ID_D" />
      </add>
    </modify>
    <modify src="Order$items">
      <add>
        <field name="unit" type="string" data="ID_WU" />
      </add>
    </modify>

    <modify src="Returns$items">
      <add>
        <field name="uid" type="string" data="" />
        <field name="cause" type="string" />
        <field name="items" type="collection">
          <data>
            <object name="ReturnDlv">
              <sources>
                <source name="DBFCatalogItemTable"/>
                <source name="SQTable" type="internal" />
              </sources>

              <field name="number" width="40" type="string" data="NUM_I"/>
              <field name="date" type="date" data="DATE_I"/>
              <field name="qty" type="number" prec="3" data="QTY_I"/>
              <field name="cost" type="number" prec="2" data="COST_I"/>
              <field name="docflag" width="1" type="number" execOn="Put">FirstItem($object)</field>
            </object>
          </data>
        </field>
        <member name="primaryKey">"uid"</member>
      </add>
    </modify>
  </objects>
</serverDefs>
