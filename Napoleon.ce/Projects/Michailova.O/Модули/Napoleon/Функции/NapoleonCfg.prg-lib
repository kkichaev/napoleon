{
#   Вернуть Число('оТовар.НомерСклада') + СимволСКодом(9) + Win2Dos(оТовар.НомНомер);
   Вернуть Win2Dos(оТовар.НомНомер);
}

функция НаполеонСкладДляВозвратов(оДок)
{
   Если(ОсновнаяОрганизация().ИНН == "760200945247")
      вернуть НайтиСклад(15);
   иначе
   Если(ОсновнаяОрганизация().ИНН == "760200089275")   
     вернуть НайтиСклад(4);
   иначе
     вернуть НайтиСклад(20);
}

функция НаполеонПравилоДляВозвратов()
{
   оОбъект = Таблица("Правила операций");
   Найти(оОбъект, "Имя", "ВОЗВРАТЫ#ВПРИХОД");
   вернуть оОбъект;
}