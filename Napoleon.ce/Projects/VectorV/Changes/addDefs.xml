<?xml version="1.0" ?>
<serverDefs xmlns="http://grsoft.ru/schemas/serverDefs.xsd">
   <objects>
      <object name="Cost">
         <sources>
            <source name="DBFCostReader">
               <param name="cost">"CS" + $user.id</param>
               <param name="costType">"CTP" + $user.id</param>
            </source>
         </sources>
         <field name="data" type="binary" />
      </object>
      <modify src="Org">
          <add>
              <field name="prcType" type="string" />
          </add>
      </modify>
      <modify src="Price">
          <add>
              <field name="color" type="hex" />
          </add>
      </modify>
   </objects>
</serverDefs>
