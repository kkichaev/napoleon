<?xml version="1.0" ?>
<serverDefs xmlns="http://grsoft.ru/schemas/serverDefs.xsd">
  <objects>
    <modify src="Org">
      <add>
        <field name="discount" type="collection">
          <data>
            <object name="Item">
              <sources>
                <source name="DBFTableSet">
                  <param name="userTable">"ODSP"</param>
                  <param name="commonTable">"__"</param>
                  <param name="filter">"[ID] = $parent.id"</param>
                </source>
              </sources>
              <field name="id" data="ID_I" type="string" />
              <field name="discount" data="DSC" type="number" prec="2" />
            </object>
          </data>
        </field>
      </add>
    </modify>
  </objects>
</serverDefs>
