<?xml version="1.0" ?>
<serverDefs xmlns="http://grsoft.ru/schemas/serverDefs.xsd">
  <objects>
    <object name="AgentPlan">
      <sources>
        <source name="SQTable" type="internal">
          <param name="readFilter">
            '"userid"=' + "'" + $user.id + "' and " +
            '"begin" &lt;= ToDate("' + FormatDate(Now(),"DD.MM.YYYY") + '") and ' +
            '"end" &gt;= ToDate("' + FormatDate(Now(),"DD.MM.YYYY") + '")'
          </param>
        </source>
      </sources>

      <member name="primaryKey">"userid,begin"</member>

      <field name="userid" type="string" />
      <field name="begin" type="date" />
      <field name="end" type="date" />

      <field name="groups" type="collection">
        <data>
          <object name="AgemtPlanGroups">
            <sources>
              <source name="SQTable" type="internal" />
            </sources>
            <field name="id" type="string" />
            <field name="type" type="number"/>
            <field name="valueSum" type="number" prec="2" />
            <field name="valueQty" type="number" prec="3" />
          </object>
        </data>
      </field>
    </object>

    <object name="RouteTemplate">
      <sources>
        <source name="SQTable" type="internal" />
      </sources>
      <member name="primaryKey">"name"</member>

      <field name="items" type="collection">
        <data>
          <object name="RouteItem">
            <sources>
              <source name="SQTable" type="internal" />
            </sources>

            <field name="weekDay" type="string" />
            <field name="weekMask" type="number" />
            <field name="id" type="string" />
            <field name="pos" type="number" />
          </object>
        </data>
      </field>
      <field name="name" type="string" width="20" />
    </object>

    <object  name="PrezentData">
      <sources>
        <source name="SQTable" type="internal" />
      </sources>

      <member name="primaryKey">"id"</member>
      <field name="id" type="string" />
      <field name="remark" type="string" />
      <field name="color" type="number" />
    </object>

    <object name="TypeOrgMatrix">
      <sources>
        <source name="DBFTableSet">
          <param name="userTable">"TMX"</param>
          <param name="commonTable">"TYPEMTX"</param>
          <param name="catalog">"id;items;0"</param>
        </source>
      </sources>

      <field name="id" type="string" />

      <field name="items" type="collection">
        <data>
          <object name="TypeOrgMatrixItem">
            <field name="id" type="string" data="id_i"/>
          </object>
        </data>
      </field>
    </object>

    <object name="OrgCoord">
      <sources>
        <source name="DBFTable">
          <param name="tableName">"CRD" + $user.id</param>
        </source>
      </sources>

      <member name="primaryKey">"id"</member>

      <field name="id" type="string" width="20" />
      <field name="created" type="timestamp" />
      <field name="longitude" type="number" prec="5" />
      <field name="latitude" type="number" prec="5" />
    </object>

    <modify src="OrgRemnants$items">
      <add>
        <field name="cost" type="number" prec="2" />
      </add>
    </modify>

    <modify src="Org">
      <add>
        <field name="mid" type="string" />
        <field name="stop" type="number" />
        <field name="flags" type="number" execOn="Get">EncodeFlag($object.stop,2)</field>
        <field name="balance" type="number" prec="2" />
        <field name="retLimit" type="number" prec="2" />
      </add>
    </modify>

    <modify src="Returns">
      <add>
        <field name="cause" type="string" />
        <field name="causeText" type="string" />
      </add>
    </modify>
    <modify src="Order">
      <add>
        <field name="dst" type="number"/>
      </add>
    </modify>
  </objects>
</serverDefs>
