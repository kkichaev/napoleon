    <object name="OrderDriverRouteInfo">
      <sources>
        <source name="SQLQuery">
          <param name="stmt">
            "select d.*, ri.route from DriverRouteActions d, RouteItem ri where d.routeItemId = ri.itemid and ri.route in
            (select route from RouteItem ri, RouteItem$docs rd where ri.itemid = rd.RouteItem$itemid and rd.userid = '" + $user.id +
