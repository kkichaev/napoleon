    <object name="AgentManagerMemo" >
      <sources>
        <source name="SQLQuery">
          <param name="stmt">
            "SELECT DISTINCT am.[created], am.deliveries, o.[id], o.[name] as orgName, o.[address] as orgAddress ,[orgColor],[remark],[sended],am.[userid],am.[till],am.[sum], am.[sumD],
            am.[overdueSum], am.[overdue],am.[topic],am.[idDog],am.[orgColor],am.[dogColor], ob.name as dogName, ob.dueDays as dogDue, ob.limit as dogLimit
            FROM (select am.* from AgentMemo am, MemoType mt where am.topic = mt.id and mt.acceptManager = 1) am left join
            (select userid, created from ArchiveOrderProceeded where [type] = 'AgentMemo' and created &gt;= ToDate('$01')
          union all select userid, created from OrderProceeded where [type] = 'AgentMemo') prc
          on am.userid = prc.userid and am.created = prc.created, Org o, OrgBalance ob, Agents a
          where prc.userid is null  and o.id = am.id and a.id = am.userid and ob.idDog = am.idDog and am.userid in ($02) and am.created &gt;= ToDate('$01')"
          </param>
        </source>
      </sources>

      <field name="userid" type="string" />
      <field name="created" type="timestamp" />
      <field name="sended" type="timestamp" />
      <field name="id" type="string" />
      <field name="remark" type="string" />


      <field name="till" type="date"  />
      <field name="sum" type="number" prec="2" />
      <field name="sumD" type="number" prec="2" />
      <field name="overdueSum" type="number" prec="2" />
      <field name="overdue" type="number" />
      <field name="topic" width="55" type="string" />
      <field name="idDog" width="55" type="string" />
      <field name="orgColor" type="number" />
      <field name="dogColor" type="number" />
      <field name="deliveries" type="string" width="4000" />

      <field name="dogDue" type="number" />
      <field name="dogLimit" type="number" prec="2" />


      <field name="agentName" type="string" />
      <field name="orgName" type="string" />
      <field name="orgAddress" type="string" />
      <field name="dogName" type="string" />

    </object>

