<?xml version="1.0" ?>
<serverDefs xmlns="http://grsoft.ru/schemas/serverDefs.xsd">
	<objects>
	<object name="VisitWithPhoto">
      <sources>
        <source name="SQLQuery">
          <param name="stmt">
            "select id, date, userid from Visit as v where date &gt;= ToDate('$01') and date &lt; ToDate('$02') and (select count(*) from visit$items as vi where v.date=vi.visit$date and v.userid = vi.visit$userid ) > 0"
          </param>
          <param name="debug" />
        </source>
      </sources>
        
      <field name="id" type="string" />
      <field name="userid" type="string" />
      <field name="date" type="timestamp" />
    </object>
	
    <object name="ActionDef">
      <sources>
        <source name="SQTable" type="internal">
          <param name="readFilter">'"start" &gt;= ToDate("' + FormatDate(AdjustDate(Now(),-7,"day"),"DD.MM.YYYY") + '")'</param>
        </source>
      </sources>

      <member name="primaryKey">"id"</member>

      <field name="id" type="string" />-
      <field name="start" type="date" />
      <field name="till" type="date" />
      <field name="iditem" type="string" />
      <field name="qty" type="number" />
    </object>
    
    <!--<object name="Reports" removeOnCommit="true" >
