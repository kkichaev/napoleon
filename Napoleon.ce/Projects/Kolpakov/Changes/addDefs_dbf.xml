<?xml version="1.0" ?>
<serverDefs xmlns="http://grsoft.ru/schemas/serverDefs.xsd">
	<objects>
    <object name="Sklads">
      <sources>
        <source name="DBFTable">
          <param name="tableName">"SKL" + $user.id</param>
        </source>
      </sources>
      <field name="id" type="string" />
      <field name="name" type="string" />
    </object>

    <object name="PriceType">
      <sources>
        <source name="DBFTable">
          <param name="tableName">"CTP" + $user.id</param>
        </source>
      </sources>
      <field name="id" type="string" />
      <field name="name" type="string" />
    </object>

    <object name="PriceCost">
      <sources>
        <source name="DBFTableSet">
          <param name="userTable">"PRC"</param>
          <param name="commonTable">"PRICE"</param>
          <param name="filter">"[PRICEID] in $PriceType.id"</param>
        </source>
      </sources>
      <field name="ido" type="string" />
      <field name="priceid" type="string" />
      <field name="cost" type="number" prec="2" />
    </object>


    <modify src="Price">
      <add>
        <field name="ido" type="string" />
        <field name="storeid" type="string" />
      </add>
    </modify>
    <modify src="Org">
      <add>
        <field name="priceid" type="string" />
      </add>
    </modify>

    <modify src="Order">
      <change>
        <field name="userid" type="string" data="USER_ID" execOn="Put" width="15">$user.id</field>
      </change>
      <add>
        <field name="storeid" type="string" width="30" />
        <field name="priceid" type="string" width="30" />
      </add>
    </modify>
    <modify src="Order$items">
      <add>
        <field name="ido" type="string" width="30" />
      </add>
    </modify>
	</objects>
</serverDefs>
