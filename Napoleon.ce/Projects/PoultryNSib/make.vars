#
# установить имя проекта
#
VariantBase=PoultryNSib

FEATURES = STOP_LIST RCV_MESSAGE VISIT_DOC POD_COMMENT GPS_POS PAY_DELAY
FEATURES+= ORG_COLOR ORG_INFO ORG_NOTE ORG_SKU ORG_REMNANTS ORD_DLV_BIND
FEATURES+= PRICE_MATRIX PRICE_COLOR PRICE_FILTER0 PRESENTATION_EDITOR SQL_ORG_ROUTE
FEATURES+= NAPOLEON_APPS QUESTION QUESTION_REPORT ORG_STOP_EDITOR STD_QUESTION_REPORT SCRIPT_DOC PYTHON_REPORTER AGENT_ORG_TASK 
FEATURES+= QUESTION_IN_SCRIPTS USE_ONLY_ORDER_IN_SUM
FEATURES+= RETURN_DOC CAN_ADD_ORG_TO_CENSUS FOCUSED_GROUP FOCUSED_ITEMS LOCAL_CONFIG_STORE SCRIPT_TIME_REPORT

NPL_PDA_RESOURCE=

INST_FILES=addDefs.xml

#
# если есть WinMobile закомментарить
#
NO_WIN_MOBILE=1

NEW_CORE=1

MANAGER_FORMS=FmOrgMatrixDesigner FmOrgMatrix FmAgentPlan FmReturnsReport FmForsakeReturns FmRetMatrix
MANAGER_SOURCE=FmDetailEx ProjectObjects