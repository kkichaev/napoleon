PROJECT=LukasN

FEATURES = STOP_LIST RCV_MESSAGE VISIT_DOC POD_COMMENT GPS_POS PAY_DELAY
FEATURES+= ORG_COLOR ORG_INFO ORG_NOTE ORG_SKU ORG_REMNANTS ORD_DLV_BIND
FEATURES+= PRICE_MATRIX PRICE_COLOR PRICE_FILTER0 PRESENTATION_EDITOR SQL_ORG_ROUTE PYTHON_REPORTER
FEATURES+= NAPOLEON_APPS FOCUSED_ITEMS FOCUSED_GROUP QUESTION QUESTION_REPORT STD_QUESTION_REPORT SCRIPT_DOC AGENT_ORG_TASK QUESTION_IN_SCRIPTS COVER_IN_ORDER_REPORT

NPL_PDA_RESOURCE=

INST_FILES=addDefs.xml

#
# если есть WinMobile закомментарить
#
NO_WIN_MOBILE=1

NEW_CORE=1

MANAGER_FORMS=FmAgentPlan
MANAGER_SOURCE = ProjectObjects