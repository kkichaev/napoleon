<?xml version="1.0" ?>
<serverDefs xmlns="http://grsoft.ru/schemas/serverDefs.xsd">
  <objects>
    <modify src="Org">
      <add>
        <field name="price" type="collection">
          <data>
            <object name="Price">
              <sources>
                <source name="DBFTableSet">
                  <param name="userTable">"PRC"</param>
                  <param name="commonTable">"PRICES"</param>
                  <param name="filter">"[ID] = $parent.id"</param>
                </source>
              </sources>
              <field name="id" type="string" width="25" data="ID_I" />
            </object>
          </data>
        </field>
		<field name="debt" type="number" prec="2"/>
      </add>
    </modify>
    <modify src="Order">
      <field name="checkedItems" type="collection">
        <data>
          <object name="CheckedItems">
            <sources>
              <sources>
                <source name="SQTable" type="internal" />
              </sources>
            </sources>
            <field name="id" type="string" width="25" />
          </object>
        </data>
      </field>
    </modify>
    <modify src="Folder">
      <add>
        <field name="color" type="hex" />
      </add>
    </modify>
  </objects>
</serverDefs>
