    BEGIN
        MENUITEM "&О программе",                IDC_ABOUT
        MENUITEM SEPARATOR
        MENUITEM "&Настройки",                  IDC_PREFERENCE
        MENUITEM "С&инхронизация",              IDC_SYNC
        MENUITEM SEPARATOR
        MENUITEM "Д&окументы",                  IDC_DOC_LIST
        MENUITEM SEPARATOR
        MENUITEM "&Выход",                      IDC_QUIT
    END
END

IDC_DEL MENU 
BEGIN
    POPUP "LocalMenu"
    BEGIN
        MENUITEM "&Удалить",                    IDC_DEL
    END
END


