#
# установить имя проекта
#
PROJECT=MilkRiver

FEATURES = VERSION_3_5 STOP_LIST RCV_MESSAGE VISIT_DOC POD_COMMENT GPS_POS PAY_DELAY
FEATURES+= ORG_COLOR ORG_INFO ORG_NOTE ORG_SKU ORG_REMNANTS ORD_DLV_BIND
FEATURES+= PRICE_MATRIX PRICE_COLOR PRICE_FILTER0 PRESENTATION_EDITOR SQL_ORG_ROUTE HAVE_CONFIG_READER
FEATURES+= NAPOLEON_APPS SCRIPT_DOC PRICE_MONITORING QUESTION STD_QUESTION_REPORT STD_MONITOR_REPORT QUESTION_REPORT
FEATURES+= FOCUSED_ITEMS STD_MONITORING_REPORT RETURN_DOC QUESTION_IN_SCRIPTS
FEATURES+= SELECT_ORG_LOCATION PYTHON_REPORTER AGENT_ORG_TASK DETAIL_AGENT_TASK_MENU CAN_ADD_ORG_TO_CENSUS

NPL_PDA_RESOURCE=

INST_FILES=addDefs.xml

#
# если есть WinMobile закомментарить
#
NO_WIN_MOBILE=1

NEW_CORE=1

MANAGER_SOURCE=FmDetailEx MainFormEx
MANAGER_FORMS=FmAgentPlan FmReturnReport