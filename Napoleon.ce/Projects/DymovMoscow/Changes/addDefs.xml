<?xml version="1.0" ?>
<serverDefs xmlns="http://grsoft.ru/schemas/serverDefs.xsd">
  <objects>
    <object name="PriceColor">
      <sources>
        <source name="DBFTable">
          <param name="tableName">"PRCCLR" + $user.id</param>
        </source>
      </sources>

      <field name="id" type="string" />
      <field name="color" type="hex" />
    </object>

    <object name="DymovTask">
      <sources>
        <source name="DBFTable">
          <param name="tableName">"TSK" + $user.id</param>
        </source>
      </sources>

      <field name="date" type="date" data="END" />
      <field name="start" type="date" />
      <field name="id" type="string" />
      <field name="idTask" type="string" />
      <field name="task" type="string" />
      <field name="manager" type="string" />
      <field name="isPeriod" type="number" />
    </object>

    <object name="DymovTaskResult">
      <sources>
        <source name="DBFTable">
          <param name="tableName">"TDN" + $user.id</param>
        </source>
      </sources>

      <field name="done" type="timestamp" />
      <field name="created" type="timestamp" />
      <field name="idTask" type="string" width="50" />
      <field name="id" type="string" width="25" />
      <field name="task" type="string" />
      <field name="remark" type="string" />
    </object>

    <object name="DistribDef">
      <sources>
        <source name="DBFTable">
          <param name="tableName">"DIDEF"</param>
        </source>
      </sources>

      <field name="id" type="string" />
      <field name="pos" type="number" />
      <field name="name" type="string" />
      <field name="type" type="string" />
      <field name="loadPrev" type="number" />
      <field name="weight" type="number" />
    </object>

    <object name="Distrib">
      <sources>
        <source name="DBFCatalogTable">
          <param name="tableName">$object.table + $user.id</param>
          <param name="catalog">"id"</param>
          <param name="ordered">1</param>
        </source>
        <source name="SQTable" type="internal" />
      </sources>

      <member name="table">"DSP"</member>
      <member name="primaryKey">"userid,created"</member>

      <field name="userid" type="string" data="USER_ID" execOn="Put">$user.id</field>
      <field name="created" type="timestamp" data="CREATED,NUM"/>
      <field name="timeZone" type="number" />
      <field name="serverTimeZone" type="number" data="S_TZ" execOn="Put" feature="USE_TIMEZONE">ServerTimeZone()</field>
      <field name="sended" type="timestamp" data="S_DATE" execOn="Put">Now()</field>
      <field name="id" width="55" type="string" />
      <field name="items" type="collection">
        <data>
          <object name="DistribItem">
            <sources>
              <source name="DBFCatalogItemTable"/>
              <source name="SQTable" type="internal" />
            </sources>

            <field name="id" width="40" type="string" data="ID_I"/>
            <field name="iddef" width="40" type="string" data="ID_DEF"/>
            <field name="val" width="40" type="string"/>
          </object>
        </data>
      </field>

      <field name="latitude" type="number" prec="5" />
      <field name="longitude" type="number" prec="5" />

      <events>
        <event type="put">
          <!--<action name="WriteOrder" /> !-->
          <action name="RunBat" />
          <action name="WriteInternal">$object.type</action>
          <action name="WriteToLog">$object.type;$object.created</action>
        </event>
      </events>
    </object>

    <modify src="Org">
      <add>
        <field name="matrix" type="collection">
          <data>
            <object name="OrgMatrix">
              <sources>
                <source name="DBFTableSet">
                  <param name="userTable">"OMX"</param>
                  <param name="commonTable">"ORGMTX"</param>
                  <param name="filter">"[ID] = $parent.id"</param>
                </source>
              </sources>

              <field name="id" data="ID_I" type="string" />
            </object>
          </data>
        </field>
      </add>
    </modify>

    <modify src="Returns$items">
      <add>
        <field name="uid" type="string" data="" />
        <field name="cause" type="string" />
        <field name="items" type="collection">
          <data>
            <object name="ReturnDlv">
              <sources>
                <source name="DBFCatalogItemTable"/>
                <source name="SQTable" type="internal" />
              </sources>

              <field name="number" width="40" type="string" data="NUM_I"/>
              <field name="date" type="date" data="DATE_I"/>
              <field name="qty" type="number" prec="3" data="QTY_I"/>
              <field name="cost" type="number" prec="2" data="COST_I"/>
              <field name="docflag" width="1" type="number" execOn="Put">FirstItem($object)</field>
            </object>
          </data>
        </field>
        <member name="primaryKey">"uid"</member>
      </add>
    </modify>

    <!--<modify src="Visit">
      <change>
        <sources>
          <source name="DBFCatalogTable">
            <param name="tableName">"VIS" + $user.id</param>
            <param name="catalog">"id"</param>
            <param name="ordered">1</param>
          </source>
          <source name="SQTable" type="internal" />
        </sources>

        <event type="put">
          <action name="WriteInternal">$object.type</action>
          <action name="WriteToLog">$object.type;$object.created</action>
        </event>
      </change>
    </modify>-->

    <modify src="Visit$items">
      <add>
        <field name="itemId" type="string" width="60" />
        <field name="orgId" type="string" width ="60" />
      </add>
    </modify>

    <modify src="VisitItemDoc">
      <change>
        <sources>
          <source name="DBFCatalogTable">
            <param name="tableName">"VS" + $user.id</param>
            <param name="catalog">"id"</param>
            <param name="ordered">1</param>
          </source> 
          <source name="SQTable" type="internal" />
        </sources>
      </change>
      <change name="smallName" data="s_name" />
      <change name="Visit$date" data="date" />
      <change name="Visit$userid" data="userid" />
      <change name="smallSize" data="s_size" />
      <change name="date" data="date_i" />
      <add>
        <event type="put">
          <action name="WriteInternal">$object.type</action>
        </event>
      </add>
    </modify>
  
  </objects>


</serverDefs>
