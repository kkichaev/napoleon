<?xml version="1.0" ?>
<serverDefs xmlns="http://grsoft.ru/schemas/serverDefs.xsd">
   <objects>
      <object name="Org">
         <sources>
            <source name="DBFTableSet">
               <param name="userTable">"O"</param>
               <param name="commonTable">"ORGS"</param>
            </source>
         </sources>

         <field name="id" type="string" />
         <field name="name" type="string" />
         <field name="address" type="string" />
         <field name="color" type="number" execOn="Get">GetColor($object.id,"org","face",0)</field>
         <field name="contacts" type="collection">
            <data>
               <object name="Contact">
                  <sources>
                     <source name="DBFTableSet">
                        <param name="userTable">"C"</param>
                        <param name="commonTable">"CONTACTS"</param>
                        <param name="filter">"[ID] = $parent.id"</param>
                     </source>
                  </sources>

                  <field name="name" data="FIO" type="string" />
                  <field name="phone" type="string" />
               </object>
            </data>
         </field>
         <field name="longitude" type="number" prec="5" data="LONG" />
         <field name="latitude" type="number" prec="5" data="LAT" />
         <field name="costype" type="string" width="2" data="COSTTYPE"  />
         <field name="payType" type="string" width="2" data="COSTTYPE"  />
         <field name="payDelay" type="number" prec="0" width="2" data="P_DELAY" />
         <field name="stopMsg" type="string" />
         <field name="limit" type="number" prec="2" width="10" />
         <field name="userid" type="string" />
      </object>

      <object name="Sklad">
         <sources>
            <source name="DBFTable">
               <param name="tableName">"SKLAD"</param>
            </source>
         </sources>

         <field name="id" type="string" />
         <field name="name" type="string" />
         <field name="checkPack" type="number" hidden="true" data="CHECK_PACK" />
         <field name="flags" type="number" execOn="Get" >EncodeFlag($object.checkPack,1)</field>
      </object>

      <object name="ManagerPrice">
         <sources>
            <source name="DBFTableSet">
               <param name="userTable">"W"</param>
               <param name="commonTable">"WAREHOUS"</param>
            </source>
         </sources>

         <field name="id" type="string" />
         <field name="fid" type="string" data="folder" />
         <field name="folderID" type="number" execOn="Get">FolderID($object.fid)</field>
         <field name="qtyInPack" type="number" prec="3" data="inpack" />
         <field name="name" type="string" />
         <field name="qty" type="number" prec="3" />
         <field name="weight" type="number" prec="3" />
         <field name="color" type="number" execOn="Get">GetColor($object.id,"price","face",0)</field>
         <field name="cost" type="collection">
            <data>
               <object name="CostItem">
                  <sources>
                     <source name="Sequence">
                        <param name="source">$parent.source</param>
                     </source>
                  </sources>
                  <field name="cost" type="number" prec="2" />
               </object>
            </data>
         </field>
      </object>

      <object name="Price">
         <sources>
            <!-- таблица со включенным фильтром qty > 0  выключать/включать SetFilter(False/True) -->
            <source name="DBFTableSet">
               <param name="userTable">"W"</param>
               <param name="commonTable">"WAREHOUS"</param>
               <param name="filter">"[folder] in $folder.fid"</param>
            </source>
         </sources>

         <field name="id" type="string" />
         <field name="fid" type="string" data="folder" hidden="true" />
         <field name="folderID" type="number" execOn="Get">FolderID($object.fid)</field>
         <field name="qtyInPack" type="number" prec="3" data="inpack" />
         <field name="name" type="string" />
         <field name="qty" type="number" prec="3" />
         <field name="weight" type="number" prec="3" />
         <field name="color" type="number" execOn="Get">GetColor($object.id,"price","face",0)</field>
         <field name="tax1" type="number" prec="0" data="TAX1" />
         <field name="cost" type="collection">
            <data>
               <object name="CostItem">
                  <sources>
                     <source name="Sequence">
                        <param name="source">$parent.source</param>
                     </source>
                  </sources>
                  <field name="cost" type="number" prec="2" />
               </object>
            </data>
         </field>
         <field name="packs" type="collection">
            <data>
               <object name="PackItem">
                  <sources>
                     <source name="DBFTableSet">
                        <param name="userTable">"Pack"</param>
                        <param name="commonTable">"Pack"</param>
                        <param name="filter">"[ID] = $parent.id"</param>
                     </source>
                  </sources>
                  <field name="pack" type="string" data="ID_P" />
                  <field name="warehouse" type="string" data="ID_W" />
                  <field name="inPack" type="number" prec="3" />
                  <field name="qty" type="number" prec="3" />
                  <field name="isMain" type="number" hidden="true" data="IS_MAIN" />
                  <field name="flags" type="number" execOn="Get" >EncodeFlag($object.isMain,1)</field>
               </object>
            </data>
         </field>
      </object>

      <object name="Cost">
         <sources>
            <!-- 
            читает данные по ценам. Внутрь функции зашит фильтр по товарам - 
            выгружаются цены только на товары доступные агенту. (LoadObject(L"Price"))
            -->
            <source name="DBFCostReader">
               <param name="cost">"CST" + $user.id</param>
               <param name="costType">"CTP" + $user.id</param>
            </source>
         </sources>

         <field name="data" type="binary" />
      </object>

      <object name="Delivery">
         <sources>
            <source name="DBFTableSet">
               <param name="userTable">"DLV"</param>
               <param name="commonTable">"DELIVERY"</param>
               <param name="catalog">"number;items;1"</param>
               <param name="filter">"[id] in $Org.id"</param>
            </source>
         </sources>

         <member name="table">"DLV"</member>

         <field name="items" type="collection">
            <data>
               <object name="DeliveryItem">
                  <field name="id" type="string" data="ID_I"/>
                  <field name="qty" type="number" />
                  <field name="sum" type="number" prec="2" />
               </object>
            </data>
         </field>
         <field name="id" type="string" />
         <field name="sumD" type="number" prec="2" />
         <field name="number" type="string" data="NUM" />
         <field name="date" type="date" />
         <field name="payDate" type="date" />
         <field name="created" type="timestamp" />
         <field name="userid" type="string" />
      </object>

      <object name="Order">
         <sources>
            <source name="DBFCatalogTable">
               <param name="tableName">$object.table + $user.id</param>
               <param name="catalog">"id"</param>
               <param name="ordered">1</param>
            </source>
            <source name="SQTable" type="internal" />
         </sources>

         <member name="table">"ORD"</member>
         <member name="primaryKey">"userid,created"</member>

         <field name="userid" type="string" data="USER_ID" execOn="Put">$user.id</field>
         <field name="created" type="timestamp" data="CREATED,NUM"/>
         <field name="sended" type="timestamp" data="S_DATE" execOn="Put">Now()</field>
         <field name="date" type="date" />
         <field name="delay" type="number" prec="0" />
         <field name="id" width="20" type="string" />
         <field name="remark" type="string" />
         <field name="items" type="collection">
            <data>
               <object name="OrderItem">
                  <sources>
                     <source name="DBFCatalogItemTable"/>
                     <source name="SQTable" type="internal" />
                  </sources>

                  <field name="id" width="20" type="string" data="ID_I"/>
                  <field name="pack" width="20" type="string" data="ID_P"/>
                  <field name="qty" type="number" prec="3" />
                  <field name="cost" type="number" prec="2" />
                  <field name="offTakeDiff" type="number" data="" />
                  <field name="ordflag" width="1" type="number" execOn="Put">FirstItem($object)</field>
               </object>
            </data>
         </field>

         <field name="costType" type="string" width="20" data="CTYPE" />
         <field name="supplCode" type="string" width="20" data="FIRM" />
         <field name="whCode" type="string" width="20" data="ID_W" />
         <field name="ordType" type="string" width="20" data="TYPE" />

         <field name="latitude" type="number" prec="5" />
         <field name="longitude" type="number" prec="5" />

         <field name="survay" type="collection">
            <data>
               <object name="Survay">
                  <sources>
                     <source name="DBFTable">
                        <param name="tableName">"OF" + $user.id</param>
                     </source>
                     <source name="SQTable" type="internal" />
                  </sources>

                  <field name="fid" type="string" width="20" data="FOLDER" />
                  <field name="choice" type="string" width="50" />
                  <field name="id" type="string" width="20">$parent.id</field>
                  <field name="date" type="timestamp" width="20">$parent.created</field>
                  <field name="ordflag" width="1" type="number" execOn="Put">FirstItem($object)</field>
               </object>
            </data>
         </field>

         <events>
            <event type="put">
               <!--<action name="WriteOrder" /> !-->
               <action name="RunBat" />
               <action name="WriteInternal">$object.type</action>
               <action name="WriteToLog">$object.type;$object.created</action>
            </event>
         </events>
      </object>
   </objects>
</serverDefs>
