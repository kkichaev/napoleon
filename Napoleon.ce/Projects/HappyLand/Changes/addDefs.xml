<?xml version="1.0" ?>
<serverDefs xmlns="http://grsoft.ru/schemas/serverDefs.xsd">
	<objects>
	    <object name="SmartTaskStart">
        	<sources>
            	<source name="SQTable" type="internal" />
         	</sources>

         	<member name="primaryKey">"userid,created"</member>
         	
         	<field name="id" type="string" />
         	<field name="created" type="timestamp"/>
         	<field name="userid" type="string" data="USER_ID" execOn="Put">$user.id</field>
      	</object>
      	
		<object name="SmartTaskEnd">
        	<sources>
            	<source name="SQTable" type="internal" />
         	</sources>

         	<member name="primaryKey">"userid,created"</member>
         	
         	<field name="id" type="string" />
         	<field name="created" type="timestamp"/>
         	<field name="userid" type="string" data="USER_ID" execOn="Put">$user.id</field>
      	</object>
      	
		<object name="TaskInfo">
        	<sources>
            	<source name="SQTable" type="internal" />
         	</sources>

         	<member name="primaryKey">"id,date,idgr,userid"</member>
         
         	
         	<field name="id" type="string" />
         	<field name="text" type="string" />
         	<field name="idgr" type="string" />
         	<field name="done" type="number" />
         	<field name="date" type="date"/>
         	<field name="donedate" type="date"/>
         	<field name="userid" type="string" data="USER_ID" execOn="Put">$user.id</field>
      	</object>
	</objects>
</serverDefs>
