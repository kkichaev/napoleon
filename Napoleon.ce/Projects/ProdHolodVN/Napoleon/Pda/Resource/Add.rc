IDD_BONUS DIALOG 0, 0, 186, 90
STYLE DS_SETFONT | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Параметры бонуса"
FONT 8, "MS Shell Dlg"
BEGIN
    CONTROL         "",IDC_ORDER_DATE,"SysDateTimePick32",DTS_RIGHTALIGN | WS_TABSTOP,36,2,40,15
    RTEXT           "Доставка",IDC_STATIC,1,5,34,8    

    CONTROL         "Отгрузка",IDD_DELIVERY,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,80,4,48,10

    COMBOBOX        IDC_SUPPL,36,17,80,46,CBS_DROPDOWN | CBS_SORT | WS_VSCROLL | WS_TABSTOP
    RTEXT           "Фирма",IDC_STATIC,1,18,34,8

    COMBOBOX        IDC_DOGOVORS,36,31,80,46,CBS_DROPDOWN | CBS_SORT | WS_VSCROLL | WS_TABSTOP
    RTEXT           "Договор",IDC_STATIC,1,32,34,8

    CONTROL         "",IDC_UNIT_LIST,"SysListView32",LVS_ALIGNLEFT | WS_TABSTOP | LVS_OWNERDRAWFIXED | WS_BORDER | NOT WS_VISIBLE ,43,30,110,87
    RTEXT           "Адрес",IDC_UNIT_TEXT_LABEL,1,44,34,8
    LTEXT           "",IDC_UNIT_TEXT,36,44,40,8,SS_NOTIFY

    EDITTEXT        IDC_REMARK,2,54,182,44,ES_MULTILINE | ES_AUTOVSCROLL | ES_AUTOHSCROLL | ES_WANTRETURN
    DEFPUSHBUTTON   "OK",IDOK,136,76,50,14
    PUSHBUTTON      "Отмена",IDCANCEL,0,76,50,14
END

