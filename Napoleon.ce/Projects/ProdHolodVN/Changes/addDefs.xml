      </object>-->
      <object name="Otgruzka">
         <sources>
            <source name="DBFTableSet">
               <param name="userTable">"OTG"</param>
               <param name="commonTable">"OTG"</param>
               <param name="catalog">"number;items;0"</param>
               <param name="filter">"[id] in $Org.id"</param>
            </source>
         </sources>

         <field name="items" type="collection">
            <data>
               <object name="DeliveryItem">
                  <field name="id" type="string" data="ID_I"/>
                  <field name="qty" type="number" />
                  <field name="sum" type="number" prec="2" data="SUM" />
               </object>
            </data>
         </field>
         <field name="id" type="string" />
         <field name="number" type="string" data="NUM" />
         <field name="date" type="date" />
         <field name="supplyer" type="string" data="FIRM" />
         <field name="fiscal" type="number" prec="1" />
         <field name="dogId" type="string" data="DOG_ID" />
         <field name="type" type="string" data="DOC_TYPE" />
      </object>

      <object name="Oplata">
         <sources>
            <source name="DBFTable">
               <param name="tableName">$object.table + $user.id</param>
            </source>
            <source name="DBFTable">
               <param name="tableName">$object.altTable</param>
               <param name="filter">"[id] in $Org.id"</param>
            </source>
         </sources>

         <member name="table">"SALDO"</member>
         <member name="altTable">"SALDO"</member>

         <field name="id" type="string" />
         <field name="date" type="date" />
         <field name="sum" type="number" prec="2" />
         <field name="supplyer" type="string" data="FIRM" />
         <field name="number" type="string" data="DOC_NUM" />
         <field name="fiscal" type="number" prec="1" />
         <field name="dogId" type="string" data="DOG_ID" />
      </object>

      <object name="PayProceeded" removeOnCommit="true" sendAlways="true">
         <sources>
            <source name="DBFTable">
               <param name="tableName">"PDN" + $user.id</param>
            </source>
         </sources>

         <!--имена полей "зашиты" в функцию-->
         <field name="created" type="timestamp" />
         <field name="remark" type="string" />
         <field name="status" type="number" />
      </object>
      
      <object name="PKO">
         <sources>
            <source name="DBFCatalogTable">
               <param name="tableName">$object.table + $user.id</param>
               <param name="catalog">"id"</param>
               <param name="ordered">1</param>
            </source>
            <source name="SQTable" type="internal" />
         </sources>

         <member name="table">"PKO"</member>
         <member name="primaryKey">"userid,created"</member>

         <field name="userid" type="string" data="USER_ID" execOn="Put">$user.id</field>
         <field name="created" type="timestamp" data="CREATED"/>
         <field name="dogId" type="string" width="30" data="DOG_ID" />
         <field name="supplyer" type="string" width="15" data="FIRM" />
         <field name="doc_id" type="string" width="30" execOn="Put">$user.id + $object.created</field>

         <field name="sended" type="timestamp" width="20" execOn="Put">Now()</field>
         <field name="fiscal" type="number" width="1"/>

         <field name="id" width="20" type="string" />

         <field name="number" width="20" type="string" data="DOC_NUM"/>
         <field name="date" width="20" type="date" data="DOC_DATE"/>
         <field name="sum" type="number" prec="2" />

         <field name="latitude" type="number" prec="5" />
