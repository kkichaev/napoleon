<?xml version="1.0" ?>
<serverDefs xmlns="http://grsoft.ru/schemas/serverDefs.xsd">
  <objects>
    <object name="DistribGroup">
      <sources>
        <source name="SQTable" type="internal">
          <param name="readFilter">'"id" in (select "id" from "DistrGroupsAssign" where "userid"=' + "'" + $user.id + "')"</param>
        </source>
      </sources>

      <member name="primaryKey">"id"</member>
      <field name="name" type="string"/>
      <field name="id" type="string"/>
      <field name="pos" type="number" />
      <field name="items" type="collection">
        <data>
          <object name="DistrItem">
            <sources>
              <source name="SQTable" type="internal" />
            </sources>

            <field name="id" type="string" />
          </object>
        </data>
      </field>
    </object>

    <object name="DistrGroupsAssign">
      <sources>
        <source name="SQTable" type="internal" />
      </sources>
      <member name="primaryKey">"userid,id"</member>
      <field name="id" type="string" />
      <field name="userid" type="string" />
    </object>


    <object name="DistribGroupDoc">
      <sources>
        <source name="SQTable" type="internal" />
      </sources>

      <member name="primaryKey">"userid,created"</member>

      <field name="userid" type="string" data="USER_ID" execOn="Put">$user.id</field>
      <field name="created" type="timestamp" data="CREATED,NUM"/>
      <field name="timeZone" type="number" />
      <field name="serverTimeZone" type="number" data="S_TZ" execOn="Put" features="USE_TIMEZONE">ServerTimeZone()</field>
      <field name="sended" type="timestamp" data="S_DATE" execOn="Put">Now()</field>
      <field name="date" type="date" />
      <field name="id" width="30" type="string" />
      <field name="remark" type="string" />
      <field name="items" type="collection">
        <data>
          <object name="DistrItem">
            <sources>
              <source name="SQTable" type="internal" />
            </sources>

            <field name="id" width="30" type="string"/>
            <field name="exists" type="number"  />
          </object>
        </data>
      </field>

      <events>
        <event type="put">
          <action name="WriteInternal">$object.type</action>
          <action name="WriteToLog">$object.type;$object.created</action>
        </event>
      </events>
    </object>


    <object name="OrgGroup">
      <sources>
        <source name="DBFTableSet">
          <param name="userTable">"OG"</param>
          <param name="commonTable">"ORGGROUP"</param>
        </source>
      </sources>

      <field name="id" type="string"/>
      <field name="level" type="number"/>
      <field name="name" type="string"/>
    </object>

    <object name="TypeOrgMatrix">
      <sources>
        <source name="DBFTableSet">
          <param name="userTable">"TMX"</param>
          <param name="commonTable">"TYPEMTX"</param>
          <param name="catalog">"id;items;0"</param>
        </source>
      </sources>

      <field name="id" type="string" />

      <field name="items" type="collection">
        <data>
          <object name="TypeOrgMatrixItem">
            <field name="id" type="string" data="id_i"/>
          </object>
        </data>
      </field>
    </object>

    <object name="DistrDoc">
      <sources>
        <source name="DBFCatalogTable">
          <param name="tableName">$object.table + $user.id</param>
          <param name="catalog">"id"</param>
          <param name="ordered">1</param>
        </source>
        <source name="SQTable" type="internal" />
      </sources>

      <member name="table">"DISTR"</member>
      <member name="primaryKey">"userid,created"</member>

      <field name="userid" type="string" data="KOD_TP" width="8" execOn="Put">$user.id</field>
      <field name="created" type="timestamp" data="CREATED"/>
      <field name="date" type="date" data="DEN" />
      <field name="super" type="string" width="100" />
      <field name="userName" type="string" data="TP" width="100" execOn="Put">$user.name</field>
      <field name="id" width="30" type="string" data="KODKONTR" />
      <field name="name" width="100" type="string" data="KONTR" />
      <field name="sended" type="timestamp" data="S_DATE" execOn="Put">Now()</field>
      <field name="items" type="collection">
        <data>
          <object name="DistrItem">
            <sources>
              <source name="DBFCatalogItemTable"/>
              <source name="SQTable" type="internal" />
            </sources>

            <field name="id" width="30" type="string" data="KONTOV"/>
            <field name="number" width="8" type="number" data="NOMER"/>
            <field name="name" width="100" type="string" data="TOVDISTR"/>
            <field name="exists" type="number" widht="1" data="SUMMA" />
            <field name="ordflag" width="1" type="number" execOn="Put">FirstItem($object)</field>
          </object>
        </data>
      </field>

      <events>
        <event type="put">
          <action name="WriteInternal">$object.type</action>
          <action name="WriteToLog">$object.type;$object.created</action>
        </event>
      </events>
    </object>
    
    <object name="Terminal">
      <sources>
        <source name="DBFTableSet">
          <param name="userTable">"TRM"</param>
          <param name="commonTable">"TRMS"</param>
        </source>
      </sources>

      <field name="id" type="string"/>
      <field name="number" type="string"/>
    </object>

    <modify src="Price">
      <add>
        <!--<field name="color" type="hex" />-->
        <field name="units" type="collection">
          <data>
            <object name="Units">
              <sources>
                <source name="DBFTableSet">
                  <param name="userTable">"WU"</param>
                  <param name="commonTable">"UNITS"</param>
                  <param name="filter">"[ID_I] = $parent.id"</param>
                </source>
              </sources>
              <field name="id" type="string" />
              <field name="name" type="string" />
              <field name="inpack" type="number" prec="3" />
            </object>
          </data>
        </field>
      </add>
    </modify>
    <modify src="Order$items">
      <add>
        <field name="unit" type="string" data="ID_WU" />
      </add>
    </modify>

    <modify src="Org">
      <add>
        <field name="group" type="string" />
        <field name="mid" type="string" />
        <field name="top" type="collection">
          <data>
            <object name="Top40">
              <sources>
                <source name="DBFTableSet">
                  <param name="userTable">"TOP"</param>
                  <param name="commonTable">"TOP40"</param>
                  <param name="filter">"[ID] = $parent.id"</param>
                </source>
              </sources>
              <field name="id" type="string" data="ID_I" />
            </object>
          </data>
        </field>
        <field name="refregerators" type="collection">
          <data>
            <object name="Rfrg">
              <sources>
                <source name="DBFTableSet">
                  <param name="userTable">"RFG"</param>
                  <param name="commonTable">"RFGRS"</param>
                  <param name="filter">"[ID] = $parent.id"</param>
                </source>
              </sources>
              <field name="id" type="string" data="NUMBER" />
              <field name="name" type="string" />
            </object>
          </data>
        </field>
        <field name="matrix" type="collection">
          <data>
            <object name="Item">
              <sources>
                <source name="DBFTableSet">
                  <param name="userTable">"PCO"</param>
                  <param name="commonTable">"PCOS"</param>
                  <param name="filter">"[ID] = $parent.id"</param>
                </source>
              </sources>
              <field name="id" type="string" data="ID_I" />
              <field name="cost" type="number" prec="2"  />
            </object>
          </data>
        </field>
      </add>
    </modify>
    
    <modify src="Incass">
      <add>
        <field name="dlvNumber" type="string" />
        <field name="dlvDate" type="date" />
        <field name="noncash" type="number" />
        <field name="tid" type="string" width="50"/>
        <field name="tnm" type="string" width="50" />
      </add>
    </modify>

    <modify src="GPSPos" dest="CopyGPSPos">
      <change>
        <field name="userid" type="string" />
      </change>
    </modify>
    <modify src="UserLog" dest="CopyUserLog">
      <change>
        <field name="userid" type="string" />
      </change>
    </modify>
    <modify src="Visit" dest="CopyVisit">
      <change>
        <sources>
          <source name="SQTable" type="internal" />
        </sources>
        <field name="userid" type="string" />
      </change>
    </modify>
    <modify src="Visit$items" dest ="CopyVisit$items">
      <change>
        <sources>
          <source name="SQTable" type="internal" />
        </sources>
      </change>
    </modify>
    <modify src="Order" dest="CopyOrder">
      <change>
        <sources>
          <source name="SQTable" type="internal" />
        </sources>
        <field name="userid" type="string" />
      </change>
    </modify>
    <modify src="Order$items" dest ="CopyOrder$items">
      <change>
        <sources>
          <source name="SQTable" type="internal" />
        </sources>
      </change>
    </modify>
    <modify src="Incass" dest="CopyIncass">
      <change>
        <sources>
          <source name="SQTable" type="internal" />
        </sources>
        <field name="userid" type="string" />
      </change>
    </modify>
    <modify src="OrgRemnants" dest="CopyOrgRemnants">
      <change>
        <sources>
          <source name="SQTable" type="internal" />
        </sources>
        <field name="userid" type="string" />
      </change>
    </modify>
    <modify src="OrgRemnants$items" dest ="CopyOrgRemnants$items">
      <change>
        <sources>
          <source name="SQTable" type="internal" />
        </sources>
      </change>
    </modify>

    <modify src="DistribGroupDoc" dest="CopyDistribGroupDoc">
      <change>
        <sources>
          <source name="SQTable" type="internal" />
        </sources>
        <field name="userid" type="string" />
      </change>
    </modify>
    <modify src="DistribGroupDoc$items" dest ="CopyDistribGroupDoc$items">
      <change>
        <sources>
          <source name="SQTable" type="internal" />
        </sources>
      </change>
    </modify>

    <modify src="DistrDoc" dest="CopyDistrDoc">
      <change>
        <sources>
          <source name="SQTable" type="internal" />
        </sources>
        <field name="userid" type="string" />
      </change>
    </modify>
    <modify src="DistrDoc$items" dest ="CopyDistrDoc$items">
      <change>
        <sources>
          <source name="SQTable" type="internal" />
        </sources>
      </change>
    </modify>
    

  </objects>
</serverDefs>
