MANAGER_FORMS = FmCertificateEdit FmCounter FmCertificate FmProtocol FmProtocolEdit FmCounterEdit FmOrderDBF FmPlanning FmSMSTemplate
MANAGER_SOURCE = FmUserOrderEx FmOrderEx ObjectEx FmRouteEx