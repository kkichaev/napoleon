<?xml version="1.0" ?>
<serverDefs xmlns="http://grsoft.ru/schemas/serverDefs.xsd">
  <objects>
	    <modify src="Order">
	        <add>
         		<field name="unitCode" width="20" type="string" data="IDU" />
	        </add>
	    </modify>
	   	<modify src="Org">
	        <add>
		         <field name="units" type="collection">
		            <data>
		               <object name="Units">
		                  <sources>
		                     <source name="DBFTableSet">
		                        <param name="userTable">"units"</param>
		                        <param name="commonTable">"units"</param>
		                        <param name="filter">"[IDO] = $parent.id"</param>
		                        <param name="userFieldName">"group"</param>
		                     </source>
		                  </sources>
		                  <field name="id" type="string" />
		                  <field name="name" type="string" />
		               </object>
		            </data>
	         </field>
	         </add>
         </modify>
		</objects>
</serverDefs>
