<serverDefs xmlns="http://grsoft.ru/schemas/serverDefs.xsd">
  <objects>
    <object name="PhotoCount">
      <sources>
        <source name="SQLQuery">
          <param name="stmt">
            "select count(id) as count_id, visit$date as date, visit$userid as userid from Visit$items where $01 group by visit$userid, visit$date"
          </param>

          <!--<param name="debug"/>-->
        </source>
      </sources>

      <field name="count" type="number" data="count_id" />
      <field name="date" type="timestamp" />
      <field name="userid" type="string" />
    </object>

    <object name="PricePhoto" sendLimit="1000000" >
      <sources>
        <source name="SQLQuery">
          <param name="stmt">
            "SELECT path as name, id  FROM [Price] p where p.id in (select id from [AgentPrice] where userid ='" + $user.id + "') order by name"
          </param>
        </source>
      </sources>

      <member name="primaryKey">"name"</member>

      <field name="items" type="collection">
        <data>
          <object name="PhotoPriceItem">
            <sources>
              <source name="SQLQuery">
                <param name="keyFields">"name"</param>
              </source>
            </sources>
            <field name="id" type="string"/>
          </object>
        </data>
      </field>

      <field name="name" type="string" />
      <field name="photo" type="file" src="name" />
    </object>

