<?xml version="1.0" ?>
<serverDefs xmlns="http://grsoft.ru/schemas/serverDefs.xsd">
	<objects>
      <object name="OrgNotes">
         <sources>
            <source name="SQTable" type="internal" />
         </sources>
         <member name="primaryKey">"id"</member>
         <field name="id" type="string" />
         <field name="text" type="string" />
         <field name="userid" type="string" execOn="Put">$user.id</field>
      </object>
	    	    
      <modify src="Agents">
         <change>
            <sources>
               <source name="SQTable" type="internal" />
            </sources>
         </change>
      </modify>
      
      <modify src="Folder">
         <change>
            <sources>
               <source name="SQTable" type="internal" />
            </sources>
         </change>
         <add>
            <member name="primaryKey">"id"</member>
            <field name="userid" type="string" />
         </add>
      </modify>
      
      <modify src="ManagerFolder">
         <change>
            <sources>
               <source name="SQTable" type="internal" />
            </sources>
         </change>
      </modify>
      
      <modify src="Price">
         <change>
            <sources>
               <source name="SQTable" type="internal" />
            </sources>
         </change>
         <remove>
                  <field name="cost" />
         </remove>
         <add>
            <member name="primaryKey">"id"</member>
            <field name="userid" type="string" />
            <field name="folderID" type="number" />
         </add>
      </modify>
      
      <modify src="ManagerPrice" table="Price">
         <change>
            <sources>
               <source name="SQTable" type="internal" />
            </sources>
         </change>
         <remove>
                  <field name="cost" />
         </remove>
         <add>
            <member name="primaryKey">"id"</member>
            <field name="userid" type="string" />
            <field name="folderID" type="number" />
         </add>
      </modify>
      
      <modify src="Org">
         <change>
            <sources>
               <source name="SQTable" type="internal">
                   <param name="readFilter">"userid='" + $user.id + "'"</param>
               </source>
            </sources>
            <member name="primaryKey">"id"</member>
         </change>
      </modify>
      
       <modify src="Org" dest="CommonOrgs">
         <change>
            <sources>
               <source name="SQTable" type="internal" />
            </sources>
            <member name="primaryKey">"id"</member>
         </change>
      </modify>
      
      <modify src="Org$contacts">
         <change>
            <sources>
               <source name="SQTable" type="internal">
               </source>
            </sources>
         </change>
      </modify>
      
      <modify src="CommonOrgs$contacts">
         <change>
            <sources>
               <source name="SQTable" type="internal">
               </source>
            </sources>
         </change>
      </modify>
      
      <modify src="OrgRemnants">
           <change>
	         <sources>
	            <source name="SQTable" type="internal" />
	         </sources>
           </change>
           <add>
               <field name="remark" type="string"/>
           </add>
      </modify>

      <modify src="OrgRemnants$items">
           <add>
                <field name="shelf" type="number" prec="3" /> 
           </add>
      </modify>

     <modify src="OrgFolder">
        <add>
            <field name="date" type="timestamp"/>
            <field name="modify" type="timestamp"/>
        </add>
        <change>
            <field name="userid" type="string" execOn="Put">$user.id</field>
        </change>
     </modify>
    <modify src="OrgFolder$items">
      <add>
        <field name="comment" type="string" />
      </add>
    </modify>
   </objects>
</serverDefs>
