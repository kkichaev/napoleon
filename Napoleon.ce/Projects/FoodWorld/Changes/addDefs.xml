<?xml version="1.0" ?>
<serverDefs xmlns="http://grsoft.ru/schemas/serverDefs.xsd">
   <objects>
      <modify src="Org">
         <add>
            <field name="orgCost" type="string" />
         </add>
      </modify>
      <modify src="Order">
         <add>
            <field name="costCode" type="string" width="20" />
            <field name="firmCode" type="string" width="20" />
            <field name="id" width="55" type="string" />
         </add>
      </modify>
      <modify dest="ManagerFolder" src="Folder">
         <change>
            <field name="id" type="string" width="100" />
         </change>
      </modify>
      <modify src="OrgFolder$items">
         <change>
            <field name="name" type="string" data="ID" width="55" />
         </change>
      </modify>
   </objects>
</serverDefs>
