<?xml version="1.0" ?>
<serverDefs xmlns="http://grsoft.ru/schemas/serverDefs.xsd">
  <objects>
    <object name="PlanRichard">
      <sources>
        <source name="DBFTableSet">
          <param name="userTable">"PLAN"</param>
          <param name="commonTable">"PLANS"</param>
        </source>
      </sources>
      <field name="title" type="string" />
      <field name="text" type="string" />
    </object>
    <object name="Move">
      <sources>
        <source name="DBFCatalogTable">
          <param name="tableName">$object.table + $user.id</param>
          <param name="catalog">"id"</param>
          <param name="ordered">1</param>
        </source>
        <source name="SQTable" type="internal" />
      </sources>

      <member name="table">"MVE"</member>
      <member name="primaryKey">"userid,created"</member>

      <field name="userid" type="string" data="USER_ID" execOn="Put">$user.id</field>
      <field name="date" type="timestamp" />
      <field name="created" type="timestamp" />
      <field name="remark" type="string" />
      <field name="sended" type="timestamp" data="S_DATE" execOn="Put">Now()</field>
      <field name="id" width="30" type="string" />
      <field name="src" width="30" type="string" />
      <field name="dst" width="30" type="string" />
      <field name="remark" width="200" type="string" />
      <field name="items" type="collection">
        <data>
          <object name="MoveItem">
            <sources>
              <source name="DBFCatalogItemTable"/>
              <source name="SQTable" type="internal" />
            </sources>

            <field name="id" width="30" type="string" data="ID_I"/>
            <field name="qty" type="number" prec="3" />
            <field name="flags" type="number" prec="0" />
            <field name="ordflag" width="1" type="number" execOn="Put">FirstItem($object)</field>
          </object>
        </data>
      </field>

      <field name="latitude" type="number" prec="4" />
      <field name="longitude" type="number" prec="4" />
      <field name="frmsrc" type="string" width="30" execOn="Put">KeyValueReader("order.cfg","Организация",$object.fsrc)</field>
      <field name="frmdst" type="string" width="30" execOn="Put">KeyValueReader("order.cfg","Организация",$object.fdst)</field>
      <field name="ctype" type="string" width="30" execOn="Put">KeyValueReader("order.cfg","ВидЦены",$object.sumType)</field>

      <events>
        <event type="put">
          <action name="WriteInternal">$object.type</action>
          <action name="WriteToLog">$object.type;$object.date</action>
        </event>
      </events>
    </object>

    <object name="OrdConfig">
      <sources>
        <source name="KeyValueTable">
          <param name="fileName">"ord"+$user.id+".cfg"</param>
        </source>
        <source name="KeyValueTable">
          <param name="fileName">"order.cfg"</param>
        </source>
      </sources>

      <field name="key" type="string" />
      <field name="value" type="string" />
    </object>

    <object name="Skalds">
      <sources>
        <source name="KeyValueDBFTable">
          <param name="fileName">"SKLADS"+$user.id</param>
          <param name="key">"Склады"</param>
          <param name="itemName">"NAME"</param>
          <param name="itemKey">"ID"</param>
        </source>
        <source name="KeyValueDBFTable">
          <param name="fileName">"SKLADS"</param>
          <param name="key">"Склады"</param>
          <param name="itemName">"NAME"</param>
          <param name="itemKey">"ID"</param>
        </source>
      </sources>
      <field name="key" type="string" />
      <field name="value" type="string" />
    </object>

    <object name="Config">
      <sources>
        <source name="ObjectUnion">
          <param>"OrdConfig"</param>
          <param>"Skalds"</param>
        </source>
      </sources>
      <field name="key" type="string" />
      <field name="value" type="string" />
    </object>

    <object name="AgentPlan">
      <sources>
        <source name="SQTable" type="internal">
          <param name="readFilter">
            '"userid"=' + "'" + $user.id + "' and " +
            '"begin" &lt;= ToDate("' + FormatDate(Now(),"DD.MM.YYYY") + '") and ' +
            '"end" &gt;= ToDate("' + FormatDate(Now(),"DD.MM.YYYY") + '")'
          </param>
        </source>
      </sources>

      <member name="primaryKey">"userid,begin"</member>

      <field name="userid" type="string" />
      <field name="begin" type="date" />
      <field name="end" type="date" />

      <field name="groups" type="collection">
        <data>
          <object name="AgemtPlanGroups">
            <sources>
              <source name="SQTable" type="internal" />
            </sources>
            <field name="id" type="string" />
            <field name="valueSum" type="number" prec="2" />
            <field name="valueWeight" type="number" prec="3" />
          </object>
        </data>
      </field>
    </object>

    <modify src="Org">
      <add>
        <field name="due" type="number" prec="2" />
        <field name="postdue" type="number" prec="2" data="PDUE"/>
        <field name="pers" type="string" />
        <field name="back" type="hex" />
        <field name="color" type="hex" />
        <field name="costTypes" type="collection">
          <data>
            <object name="Item">
              <sources>
                <source name="DBFTableSet">
                  <param name="userTable">"FMO"</param>
                  <param name="commonTable">"__NO_"</param>
                  <param name="filter">"[IDO] = $parent.id"</param>
                </source>
              </sources>

              <field name="costype" type="number" />
              <field name="id" type="string" width="55" />
            </object>
          </data>
        </field>
        <field name="limitsum" type="number" prec="2" data="LIMIT"/>
        <field name="delay" type="number"/>
      </add>
    </modify>

    <modify src="Price">
      <add>
        <field name="tabak" type="number"  />
        <field name="alp" type="number"  />
        <field name="barcode" type="string" />
        <field name="mrc" type="number" prec ="2" />

        <field name="whQty" type="collection">
          <data>
            <object name="QtyItem">
              <sources>
                <source name="Sequence">
                  <param name="source">$parent.source</param>
                  <param name="startIndex">2</param>
                </source>
              </sources>
              <field name="qty" type="number" prec="2" />
            </object>
          </data>
        </field>
      </add>
    </modify>
    <modify src="Price">
      <add>
        <field name="units" type="collection">
          <data>
            <object name="Units">
              <sources>
                <source name="DBFTableSet">
                  <param name="userTable">"WU"</param>
                  <param name="commonTable">"WUNITS"</param>
                  <param name="filter">"[ID_I] = $parent.id"</param>
                </source>
              </sources>
              <field name="id" type="string" />
              <field name="name" type="string" />
              <field name="inpack" type="number" prec="3" />
            </object>
          </data>
        </field>
        <field name="piece" type="number"/>
        <field name="kgCost" type="number" prec="2" />
      </add>
    </modify>

    <modify src="Firm">
      <add>
        <field name="costype" type="number" />
      </add>
    </modify>

    <modify src="Order">
      <add>
        <field name="whCode" type="string" width="20" data="ID_WH" />
        <field name="tabak" type="number" width="1" />
        <field name="alp" type="number"  />
      </add>
    </modify>

    <modify src="Order$items">
      <add>
        <member name="primaryKey">"uid"</member>

        <field name="uid" type="string" />

        <field name="unit" type="string" width="55" />
        <field name="unitInpack" type="number" prec="3"/>
        <field name="barcodes" type="collection">
          <data>
            <object name="ScanData">
              <sources>
                <source name="DBFCatalogItemTable"/>
                <source name="SQTable" type="internal" />
              </sources>

              <field name="barcode" type="string" />
              <field name="docflag" width="1" type="number" execOn="Put">FirstItem($object)</field>
            </object>
          </data>
        </field>
      </add>
    </modify>

    <modify src="Order" dest="Bonus" table="bonus">
      <change>
        <member name="table">"BNS"</member>
      </change>

      <add>
        <field name="order" type="timestamp"/>
        <field name="ordersum" type="number" prec="2" />
      </add>
    </modify>

    <modify src="Question$items">
      <add>
        <field name="optional" type="number" />
      </add>
    </modify>

    <modify src="Delivery">
      <add>
        <field name="firma" type="string" />
      </add>
    </modify>

    <modify src="Delivery$items">
      <add>
        <field name="cost" type="number" prec="2" />
      </add>
    </modify>

    <modify src="Returns">
      <add>
        <field name="firma" type="string" width="30" execOn="Put" feature="!SALES_MODULE &amp; !HAVE_CONFIG_READER">KeyValueReader("order.cfg","Организация",$object.supplyer)</field>
        <field name="firma" type="string" width="30" execOn="Put" feature="!SALES_MODULE &amp; HAVE_CONFIG_READER">ConfigReader("Организация",$object.supplyer)</field>
      </add>
      <remove>
        <field name="tabak" />
      </remove>
    </modify>

    <modify src="Order" dest="WhRequest" table="WhRequest">
      <change>
        <sources>
          <source name="DBFCatalogTable">
            <param name="tableName">"RQO" + $user.id</param>
            <param name="catalog">"id"</param>
            <param name="ordered">1</param>
          </source>
          <source name="SQTable" type="internal" />
        </sources>
      </change>
    </modify>
    
    <modify src="WhRequest$items">
      <remove>
        <field name="barcodes"/>
      </remove>
    </modify>

    <modify src="Returns$items">
      <add>
        <field name="uid" type="string" data="" />
        <field name="cause" type="string" />
        <field name="items" type="collection">
          <data>
            <object name="ReturnDlv">
              <sources>
                <source name="DBFCatalogItemTable"/>
                <source name="SQTable" type="internal" />
              </sources>

              <field name="number" width="40" type="string" data="NUM_I"/>
              <field name="date" type="date" data="DATE_I"/>
              <field name="qty" type="number" prec="3" data="QTY_I"/>
              <field name="cost" type="number" prec="2" data="COST_I"/>
              <field name="docflag" width="1" type="number" execOn="Put">FirstItem($object)</field>
            </object>
          </data>
        </field>
        <member name="primaryKey">"uid"</member>
      </add>
    </modify>
  </objects>
</serverDefs>
