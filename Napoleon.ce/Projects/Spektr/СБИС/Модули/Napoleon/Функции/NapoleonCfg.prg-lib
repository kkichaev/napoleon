функция НаполеонПапкаОбмена()
#
# возвращает папку обмена
#
{
   вернуть "\\\\Server\\Exp";
}

функция НаполеонСоздаватьСчет()
#
# если возвращает 1 - то докуенты создаются в исходящих счетах
# если 0 то в расходных накладных
#
{
#   вернуть 1;
  вернуть 0;
}

функция НаполеонВыгружатьНенулувыеОстатки()
#
# если возвращает 1 - то выгружются только товары с ненулевыми остатками
#
{
   вернуть 0;
}

функция НаполеонОстаток(оТовар)
#
# возвращает кол-во товара, которое будет показываться а КПК
#
{
#   вернуть оТовар.Свободно;
   вернуть оТовар.Остаток;
}

функция НаполеонГлубинаВыборкиДокументов()
#
# возвращает в днях период для выгрузки накладных
#
{
   вернуть 60;
}

функция НаполеонГлубинаКредита(Контрагент)
#
# возвращает числое дней кредита по накладным
#
{
   вернуть 5;
}
функция НаполеонПапкаДокументов(оДок)
#
# устанавливает в оДок раздел, в который экспортируются документы (обычно папка КПК)
#
{
   оРаздел = оДок.НайтиРаздел("КПК");
   Если( оРаздел )
      Связать(оДок.Раздел, оРаздел);
   Иначе
      оДок.ПерейтиВКорень();
}