<?xml version="1.0" ?>
<serverDefs xmlns="http://grsoft.ru/schemas/serverDefs.xsd">
   <objects>
      <object name="StartWork">
        <sources>
          <source name="SQTable" type="internal"/>
        </sources>

        <member name="primaryKey">"userid,day"</member>

        <field name="userid" type="string" />
        <field name="day" type="number" />
        <field name="time" type="string" />
      </object>
    
      <object name="Boards">
         <sources>
            <source name="DBFTable">
               <param>"BOARDS"</param>
            </source>
         </sources>

         <field name="id" type="string" />
         <field name="name" type="string" />
      </object>

      <object name="Partner">
         <sources>
            <source name="DBFTable">
               <param>"ORGS"</param>
            </source>
         </sources>

         <field name="id" type="string" />
         <field name="name" type="string" />
      </object>

      <object name="Sklad">
         <sources>
            <source name="DBFTable">
               <param>"WAREHOUS"</param>
            </source>
         </sources>

         <field name="id" type="string" />
         <field name="name" type="string" />
         <field name="unit" type="string" />
         <field name="qty" type="number" prec="3" />
         <field name="cost" type="number" prec="2" />
      </object>

      <object name="Cost">
         <sources>
            <source name="1C-Source" />
         </sources>

         <field name="id" type="string" />
         <field name="id_o" type="string" />
         <field name="name" type="string" />
         <field name="unit" type="string" />
         <field name="qty" type="number" prec="3" />
         <field name="cost" type="number" prec="2" />
         
         <!--<field name=":result" type="number" prec="0" />
         <field name=":response" type="string" />-->
      </object>

      <object name="WHDoc">
         <sources>
            <source name="1C-Source" />
            <source name="SQTable" type="internal" />
         </sources>

         <member name="table">"WHD"</member>
         <member name="primaryKey">"userid,created"</member>

         <field name="userid" type="string" execOn="Put">$user.id</field>
         <field name="user" type="string" />
         <field name="created" type="timestamp" />
         <field name="sended" type="timestamp" execOn="Put">Now()</field>
         <field name="remark" type="string" data="REMARK" />
         
         <field name="items" type="collection">
            <data>
               <object name="WHDocItem">
                  <sources>
                     <source name="DBFCatalogItemTable"/>
                     <source name="SQTable" type="internal" />
                  </sources>

                  <field name="id" width="20" type="string" />
                  <field name="board" width="20" type="string" />
                  <field name="qty" type="number" prec="3" />
               </object>
            </data>
         </field>

         <!--<field name=":result" type="number" prec="0" />
         <field name=":response" type="string" />-->

         <events>
            <event type="put">
               <!--<action name="WriteOrder" /> !-->
               <!--<action name="RunBat" />-->
               <action name="WriteInternal">$object.type</action>
               <action name="WriteToLog">$object.type;$object.created</action>
            </event>
         </events>
      </object>

        <object name="NETMtx">
            <sources>
                <source name="DBFTableSet">
                    <param name="userTable">"NMX"</param>
                    <param name="commonTable">"NTXS"</param>
                    <param name="catalog">"id;items;0"</param>
                </source>
            </sources>
      
            <field name="id" type="string"/>
            
            <field name="items" type="collection">
                <data>
                    <object name="MatrixItem">
                        <field name="id" type="string" data="ID_I"/>
                        <field name="cost" type="number" prec="2"/>
                    </object>
                </data>
            </field>
        </object>
        
      <object name="MatrixOrder">
        <sources>
          <source name="SQTable" type="internal">
            <param name="readFilter">'"userid"=' + "'" + $user.id + "'"</param>
          </source>
        </sources>

        <member name="primaryKey">"userid"</member>

        <field name="userid" type="string" execOn="Put">$user.id</field>
        <field name="items" type="collection">
          <data>
            <object name="MatrixName">
              <sources>
                <source name="SQTable" type="internal" />
              </sources>
              <field name="name" type="string" />
              <field name="order" type="number" />
            </object>
          </data>
        </field>
      </object>
    
        <modify src="Org">
          <add>
            <field name="netid" type="string" />
            <field name="whCodes" type="string" data="WHC"/>
          </add>
        </modify>
        
        <modify src="Returns$items">
            <add>
                <field name="uid" type="string" data="" />
                <field name="cause" type="string" />
                <field name="items" type="collection">
                    <data>
                        <object name="ReturnDlv">
                            <sources>
                                <source name="DBFCatalogItemTable"/>
                                <source name="SQTable" type="internal" />
                            </sources>

                            <field name="number" width="40" type="string" data="NUM_I"/>
                            <field name="date" type="date" data="DATE_I"/>
                            <field name="qty" type="number" prec="3" data="QTY_I"/>
                            <field name="cost" type="number" prec="2" data="COST_I"/>
                            <field name="docflag" width="1" type="number" execOn="Put">FirstItem($object)</field>
                        </object>
                    </data>
                </field>
                <member name="primaryKey">"uid"</member>
            </add>
        </modify>
    
      <modify src="Price">
        <change>
          <field name="color" type="hex" />
        </change>
        <add>
          <field name="action" type="number" />
        </add>
      </modify>
      
      <modify src="DivisionManager">
        <add>
          <field name="email" type="string" />
        </add>
      </modify>

     <modify src="Order$items">
       <add>
         <member name="primaryKey">"uid"</member>
         <field name="uid" type="string" data="" />

         <field name="qtys" type="collection">
           <data>
             <object name="Item">
               <sources>
                 <source name="DBFCatalogItemTable"/>
                 <source name="SQTable" type="internal" />
               </sources>
               <field name="whCode" type="string" width="55" data="ID_WHI"/>
               <field name="qty" type="number" data="QTY_I"/>
               <field name="docflag" width="1" type="number" execOn="Put">FirstItem($object)</field>
             </object>
           </data>
         </field>
       </add>
     </modify>
   </objects>
</serverDefs>
