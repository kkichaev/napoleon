PROJECT=Falcon

#DEBUG_RELEASE=1

FEATURES = STOP_LIST RCV_MESSAGE VISIT_DOC POD_COMMENT GPS_POS PAY_DELAY
FEATURES+= ORG_COLOR ORG_INFO ORG_NOTE ORG_SKU ORG_REMNANTS ORD_DLV_BIND
FEATURES+= PRICE_MATRIX PRICE_COLOR PRICE_FILTER0 QUESTION AGENT_ORG_TASK
FEATURES+= SCRIPT_DOC STD_QUESTION_REPORT
FEATURES+= NAPOLEON_APPS PYTHON_REPORTER RETURN_DOC DISABLE_MATRIX SALES_MODULE

NPL_PDA_RESOURCE=

INST_FILES=addDefs.xml

#
# если есть WinMobile закомментарить
#
NO_WIN_MOBILE=1

NEW_CORE=1
MANAGER_SOURCE=FmDetailEx