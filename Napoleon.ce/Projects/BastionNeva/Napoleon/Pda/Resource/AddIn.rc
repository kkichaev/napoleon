    LTEXT           "ADDRESS",IDC_ADDRESS_LABEL,0,3,120,10
    CONTROL         "",IDC_CONTACTS,"SysListView32",LVS_ALIGNLEFT | LVS_OWNERDATA | WS_TABSTOP | LVS_OWNERDRAWFIXED,0,10,120,110
