<?xml version="1.0" ?>
<serverDefs xmlns="http://grsoft.ru/schemas/serverDefs.xsd">
	<objects>
    <object name="MatrixOrder">
      <sources>
        <source name="SQTable" type="internal">
          <param name="readFilter">'"userid"=' + "'" + $user.id + "'"</param>
        </source>
      </sources>

      <member name="primaryKey">"userid"</member>

      <field name="userid" type="string" execOn="Put">$user.id</field>
      <field name="items" type="collection">
        <data>
          <object name="MatrixName">
            <sources>
              <source name="SQTable" type="internal" />
            </sources>
            <field name="name" type="string" />
            <field name="order" type="number" />
          </object>
        </data>
      </field>
    </object>

    <modify src="Price">
      <add>
        <field name="baseCost" type="number" prec="2" />
        <field name="segment" type="string" />
      </add>
    </modify>

    <modify src="Org">
      <add>
        <field name="segments" type="collection">
          <data>
            <object name="Item">
              <sources>
                <source name="DBFTableSet">
                  <param name="userTable">"SG"</param>
                  <param name="commonTable">"__"</param>
                  <param name="filter">"[ID] = $parent.id"</param>
                </source>
              </sources>

              <field name="id" type="string" data="ID_SEG" width="55" />
              <field name="tarif" type="number" prec="2" />
              <field name="nac" type="number" prec="2" />
            </object>
          </data>
        </field>
      </add>
    </modify>
	</objects>
</serverDefs>
