<?xml version="1.0" ?>
<serverDefs xmlns="http://grsoft.ru/schemas/serverDefs.xsd">
	<objects>
	  <modify src="Order$items">
         <add>
 			<field name="discount" type="number" prec="2" />
         </add>
      </modify>
      
	  <modify src="Pko">
         <add>
 			<field name="remark" type="string" width="250" />
         </add>
      </modify>
	
	  <modify src="Sales$items">
         <add>
 			<field name="discount" type="number" prec="2" />
         </add>
      </modify>
      
	  <modify src="Firm">
         <add>
 			<field name="nds" type="number" prec="0" />
 			<field name="fullName" type="string" data="FNAME"/>		
			<field name="shipApprove" type="string" data="SHIPAP"/>
			<field name="okpo" type="string" />
			<field name="shipment" type="string" data="SHIP"/>
         </add>
      </modify>
      
	  <modify src="Order" dest="OrderW">
        <change>
	       <member name="table">"ORDW"</member>
        </change>
     </modify>
	</objects>
</serverDefs>
