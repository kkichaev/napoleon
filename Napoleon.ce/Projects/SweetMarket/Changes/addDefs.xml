<?xml version="1.0" ?>
<serverDefs xmlns="http://grsoft.ru/schemas/serverDefs.xsd">
  <objects>
    <object name="ReturnResponse">
      <sources>
        <source name="SQTable" type="internal" />
      </sources>

      <member name="primaryKey">"userid,created"</member>

      <field name="id" type="string" />
      <field name="userid" type="string" />
      <field name="created" type="timestamp" />
      <field name="remark" type="string" />

      <field name="response" type="number" />
      <field name="sum" type="number" prec="2" />
    </object>

    <object name="MatrixOrder">
      <sources>
        <source name="SQTable" type="internal">
          <param name="readFilter">'"userid"=' + "'" + $user.id + "'"</param>
        </source>
      </sources>

      <member name="primaryKey">"userid"</member>

      <field name="userid" type="string" execOn="Put">$user.id</field>
      <field name="items" type="collection">
        <data>
          <object name="MatrixName">
            <sources>
              <source name="SQTable" type="internal" />
            </sources>
            <field name="name" type="string" />
            <field name="order" type="number" />
          </object>
        </data>
      </field>
    </object>

    <modify src="Price">
      <add>
        <field name="idGroup" data="ID_G" type="string" />
      </add>
    </modify>
    
    <modify src="Org">
      <add>
        <field name="income" type="number" prec="2" />
        <field name="debet" type="number" prec="2" />
        <field name="overdue" type="number" prec="2" />
        <field name="limit" type="number" prec="2" />

        <field name="groupDiscount" type="collection">
          <data>
            <object name="Discount">
              <sources>
                <source name="DBFTableSet">
                  <param name="userTable">"OGD"</param>
                  <param name="commonTable">"ORG_DSC"</param>
                  <param name="filter">"[ID] = $parent.id"</param>
                </source>
              </sources>

              <field name="discount" type="number" prec="2" data="DSC" />
              <field name="id" type="string" width="55" data="ID_G" />
            </object>
          </data>
        </field>
        <field name="itemCost" type="collection">
          <data>
            <object name="Cost">
              <sources>
                <source name="DBFTableSet">
                  <param name="userTable">"OPC"</param>
                  <param name="commonTable">"ORG_COST"</param>
                  <param name="filter">"[ID] = $parent.id"</param>
                </source>
              </sources>

              <field name="cost" type="number" prec="2" />
              <field name="id" type="string" width="55" data="ID_I" />
            </object>
          </data>
        </field>
      </add>
    </modify>

    <modify src="Returns$items">
      <add>
        <field name="uid" type="string" />
        <field name="cause" type="string" />
        <member name="primaryKey">"uid"</member>
        

        <field name="items" type="collection">
          <data>
            <object name="ReturnDlv">
              <sources>
                <source name="DBFCatalogItemTable"/>
                <source name="SQTable" type="internal" />
              </sources>

              <field name="number" width="40" type="string" data="NUM_I"/>
              <field name="date" type="date" data="DATE_I"/>
              <field name="qty" type="number" prec="3" data="QTY_I" />
              <field name="cost" type="number" prec="2" data="COST_I"/>
              <field name="docflag" width="1" type="number" execOn="Put">FirstItem($object)</field>
            </object>
          </data>
        </field>
      </add>
    </modify>

    <modify src="Returns" dest="ReturnRequest" table="ReturnRequest">
      <change>
        <sources>
          <source name="SQTable" type="internal" />
        </sources>
      </change>
    </modify>

    <modify src="ReturnRequest$items">
      <change>
        <sources>
          <source name="SQTable" type="internal" />
        </sources>
      </change>
    </modify>

    <modify src="ReturnRequest$items$items">
      <change>
        <sources>
          <source name="SQTable" type="internal" />
        </sources>
      </change>
    </modify>

    <modify src="Delivery$items">
      <add>
        <field name="retQty" type="number" prec="3"/>
      </add>
    </modify>

    <object name="AgentInfo">
      <sources>
        <source name="DBFTable">
          <param name="tableName">"AINFO"</param>
        </source>
      </sources>
      <field name="userid" type="string" />
      <field name="income" type="number" prec="2" />
      <field name="debet" type="number" prec="2" />
      <field name="overdue" type="number" prec="2" />
      <field name="limit" type="number" prec="2" />
      <field name="id" type="string" execOn="Get">$user.id</field>
    </object>
  </objects>
</serverDefs>
