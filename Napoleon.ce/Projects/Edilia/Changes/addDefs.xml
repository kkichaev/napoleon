    </modify>

    <modify src="Delivery">
      <change>
        <sources>
          <source name="SQTable" type="internal">
            <param name="readFilter">"id in (select id from Org where [userid] = '$01') and [division] = '$02'"</param>
            <param name="$01">$user.id</param>
