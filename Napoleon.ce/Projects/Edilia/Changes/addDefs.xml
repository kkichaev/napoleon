    <modify src="CommonMatrix">
      <change>
        <sources>
          <source name="SQTable" type="internal" />
        </sources>
      </change>
      <add>
        <member name="primaryKey">"name"</member>
        <field name="userid" type="string" />
      </add>
    </modify>

    <modify src="CommonMatrix$items">
      <change>
        <sources>
          <source name="SQTable" type="internal" />
        </sources>
      </change>
    </modify>

    <modify src="Matrix">
      <change>
        <sources>
          <source name="SQLQuery">
            <param name="stmt">
              "select cm.name as name, i.id as id
              from (CommonMatrix as cm inner join [CommonMatrix$items] as i on cm.name = i.[CommonMatrix$name])
              inner join AgentMatrix as am on cm.name = am.name
              where am.userid = '"+$user.id+"'"
            </param>
          </source>
        </sources>
      </change>
    </modify>

    <modify src="Matrix$items">
      <change>
        <sources>
          <source name="SQLQuery">
            <param name="keyFields">"name"</param>
          </source>
        </sources>
      </change>
    </modify>

    <modify src="Returns$items">
      <change>
        <sources>
          <source name="SQTable" type="internal" />
        </sources>
      </change>
      <add>
        <field name="uid" type="string" data="" />
        <field name="cause" type="string" />
        <field name="mfrDate" type="date" />
        <field name="items" type="collection">
          <data>
            <object name="ReturnDlv">
              <sources>
                <source name="SQTable" type="internal" />
              </sources>

              <field name="number" width="40" type="string" data="NUM_I"/>
              <field name="date" type="date" data="DATE_I"/>
              <field name="qty" type="number" prec="3" data="QTY_I"/>
              <field name="cost" type="number" prec="2" data="COST_I"/>
              <field name="docflag" width="1" type="number" execOn="Put">FirstItem($object)</field>
            </object>
          </data>
        </field>
        <member name="primaryKey">"uid"</member>
      </add>
    </modify>

    <modify src="Returns">
      <change>
        <sources>
          <source name="SQTable" type="internal" />
        </sources>
      </change>
      <add>
        <field name="retNumber" type="string" width="30" />
        <event type="put">
          <action name="WriteToLog">$object.type;$object.created</action>
        </event>
        <event type="writeCommit">
          <action name="CommitOrders" />
        </event>
      </add>
    </modify>

    <modify src="DeliveryBalanceData" dest="DailyDeliveryBalanceData">
      <change>
        <sources>
          <source name="SQLQuery" >
            <param name="stmt">"select * from DeliveryBalanceDataInt where id in (select id from Org where [userid] = '$01') and [date] &gt;= $02 and [division] = '$03' order by [id],[num]"</param>
            <param name="$01">$user.id</param>
            <param name="$02">ToDate(FormatDate(Now(),"DD.MM.YYYY"))</param>
            <param name="$03">$user.division</param>
          </source>
        </sources>
      </change>
    </modify>

  </objects>

  <actions>
    <action name="CommitOrders">
      <do>
        <runReport name="order_handler" />
      </do>
    </action>
  </actions>
