          </source>
        </sources>
      </change>
      <add>
        <member name="primaryKey">"id,number,date"</member>
        <field name="modified" type="timestamp" />
        <field name="division" type="string" />
      </add>
    </modify>

    <modify src="Delivery$items">
      <change>
        <change>
          <sources>
            <source name="SQTable" type="internal" />
          </sources>
        </change>
      </change>
      <add>
        <field name="retQty" type="number" prec="3" />
      </add>
    </modify>

    <modify src="DeliveryDay" table="Delivery">
      <change>
        <sources>
          <source name="SQTable" type="internal">
            <param name="readFilter">"id in (select id from Org where [userid] = '$01') and ([date] &gt;= $02 or [modified] &gt;= $02) and [division] = '$03'"</param>
            <param name="$02">ToDate(FormatDate(AdjustDate(Now(),-2,"day"),"DD.MM.YYYY"))</param>
            <param name="$01">$user.id</param>
            <param name="$03">$user.division</param>
          </source>
        </sources>
      </change>
      <add>
        <member name="primaryKey">"id,number,date"</member>
        <field name="modified" type="timestamp" />
      </add>
    </modify>
    <modify src="DeliveryDay$items" table="Delivery$items">
      <change>
        <sources>
          <source name="SQTable" type="internal" />
        </sources>
      </change>
      <add>
        <field name="retQty" type="number" prec="3" />
