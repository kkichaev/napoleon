<?xml version="1.0" ?>
<serverDefs xmlns="http://grsoft.ru/schemas/serverDefs.xsd">
  <objects>
    <object name="RemovedDocuments" removeOnCommit="true">
      <sources>
        <source name="SQTable" type="internal">
          <param name="readFilter">'"userid"=' + "'" + $user.id + "'"</param>
        </source>
      </sources>
      <field name="userid" type="string" />
      <field name="number" type="string" />
      <field name="type" type="string" />
    </object>
    
    <object name="OrderIncass">
      <sources>
        <source name="SQTable" type="internal">
        </source>
      </sources>

      <memberArray name="index">"userid,created"</memberArray>

      <field name="created" type="timestamp" />
      <field name="userid" type="string" />
      <field name="num" type="string" />
    </object>

    <object name="ReturnFolders">
      <sources>
        <source name="SQTable" type="internal">
          <!--readFilter используется для чтения по умолчанию (когда идет команда Get)-->
          <param name="readFilter">'"userid"=' + "'" + $user.id + "'"</param>
        </source>
      </sources>
      <member name="primaryKey">"userid,fid"</member>
      <field name="userid" type="string" />
      <field name="fid" type="string" />
    </object>

    <object name="DeliveryBalanceData" >
      <sources>
        <source name="SQLQuery" >
          <param name="stmt">"select * from DeliveryBalanceDataInt where id in (select id from Org where [userid] = '$01') and [date] &gt;= $02 and [division] = '$03' order by [id],[num]"</param>
          <param name="$01">$user.id</param>
          <param name="$02">ToDate(FormatDate(AdjustDate(Now(), -3, "month"),"DD.MM.YYYY"))</param>
          <param name="$03">$user.division</param>
        </source>
      </sources>

      <field name="id" type="string" width="40" />
      <field name="num" type="string" width="20" />
      <field name="docDate" type="date"  />

      <field name="items" type="collection" >
        <data>
          <object name="DeliveryBalanceDataItem">
            <sources>
              <source name="SQLQuery" >
                <param name="keyFields">"id,num"</param>
              </source>
            </sources>

            <field name="type" type="string" width="20" />
            <field name="num" type="string" data="NUM_I" width="20"/>
            <field name="date" type="date" />
            <field name="sum" type="number" prec="2" />
            <field name="created" type="timestamp" />
          </object>
        </data>
      </field>
    </object>

    <object name="DeliveryBalanceDataInt">
      <sources>
        <source name="SQTable" type="internal" />
      </sources>

      <memberArray name="index">"id,division,date"</memberArray>

      <field name="id" type="string" width="40" />
      <field name="num" type="string" width="20" />
      <field name="docDate" type="date"  />
      <field name="type" type="string" width="20" />
      <field name="num_i" type="string" width="20"/>
      <field name="date" type="date"  />
      <field name="sum" type="number" prec="2" />
      <field name="created" type="timestamp" />
      <field name="division" type="string" />
    </object>

    <object name="OrgBalance" >
      <sources>
        <source name="SQTable" type="internal">
          <param name="readFilter">"id in (select id from Org where [userid] = '$01') and [division] = '$02'"</param>
          <param name="$01">$user.id</param>
          <param name="$02">$user.division</param>
        </source>
      </sources>

      <memberArray name="index">"id,division"</memberArray>

      <field name="id" type="string" width="40" />
      <field name="sum" type="number" prec="2" />
      <field name="num" type="string" width="20" />
      <field name="date" type="date" />
      <field name="sumd" type="number" prec="2" />
      <field name="division" type="string" />
    </object>

    <object name="PriceCost">
      <sources>
        <source name="SQTable" type="internal" />
      </sources>

      <memberArray name="index">"userid,id"</memberArray>

      <field name="id" type="string" />
      <field name="userid" type="string" />
      <field name="cost" type="number" prec="2" />
      <field name="index" type="number" />
    </object>

    <object name="PriceCostRcv">
      <sources>
        <source name="SQLQuery">
          <param name="stmt">"SELECT [id],[index],cost from [PriceCost] where [userid] = '$01' order by [index]"</param>
          <param name="$01">$user.id</param>
        </source>
      </sources>

      <field name="index" type="number" />
      <field name="items" type="collection">
        <data>
          <object>
            <sources>
              <source name="SQLQuery">
                <param name="keyFields">"index"</param>
              </source>
            </sources>
            <field name="id" type="string" />
            <field name="cost" type="number" prec="2" />
          </object>
        </data>
      </field>
    </object>

    <modify src="ManagerFolder">
      <change>
        <sources>
          <source name="SQLFolder" type="internal">
            <param name="parentField">"parent"</param>
            <param name="childField">"fid"</param>
            <param name="readFilter">"[userid] = '" + $user.id + "'"</param>
          </source>
        </sources>
      </change>
      <add>
        <field name="fid" type="string" width="50" />
        <field name="id" type="string" execOn="Get">$object.fid</field>
        <field name="parent" type="string" width="50" />
        <field name="userid" type="string" execOn="Put">$user.id</field>
      </add>
    </modify>

    <modify src="Order">
      <change>
        <sources>
          <source name="SQTable" type="internal" />
        </sources>
      </change>
      <add>
        <field name="incass" type="number" prec="2" />
        <field name="willPay" type="number" />
        <field name="willSum" type="number" prec="2" />
        <field name="incassNum" type="string" width="20" />
        <field name="factPay" type="number" />
        <field name="thinkInOffice" type="number" />
        <field name="expeditorRemark" type="string" />

        <event type="writeCommit">
          <action name="CommitOrders" />
        </event>
        <event type="put">
          <action name="WriteToLog">$object.type;$object.created</action>
        </event>
      </add>
    </modify>

    <modify src="Order$items">
