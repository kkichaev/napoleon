  <objects>
    <object name="MoneyProxy">
      <sources>
        <source name="SQTable" type="internal" />
      </sources>
      <member name="primaryKey">"userid,created"</member>
      <memberArray name="index">"created"</memberArray>

      <field name="created" type="timestamp" />
      <field name="timeZone" type="number" />
      <field name="serverTimeZone" type="number" data="S_TZ" execOn="Put" feature="USE_TIMEZONE">ServerTimeZone()</field>
      <field name="userid" type="string" execOn="Put">$user.id</field>
      <field name="id" type="string" width="55" />
      <field name="date" type="date" />
      <field name="sended" type="timestamp" data="S_DATE" execOn="Put">Now()</field>
      <field name="sum" type="number" prec="2" />
      <field name="remark" type="string" width="100" />
      <field name="latitude" type="number" prec="5" />
      <field name="longitude" type="number" prec="5" />
      <field name="stltime" type="number" />

      <events>
        <event type="put">
          <action name="WriteToLog">$object.type;$object.created</action>
        </event>
      </events>
    </object>
    
    <object name="PriceCost">
      <sources>
        <source name="SQLQuery">
          <param name="stmt">
            "select t.code as shortName, t.name as name, to_char(t.rn) as id, p.nomen as id_i, pi.price,
            ((pi.pricedate - to_date('01-01-1970','DD-MM-YYYY')) * 86400 + 11644473600) * 10000000 as st_date,
            NVL(((pi.enddate - to_date('01-01-1970','DD-MM-YYYY')) * 86400 + 11644473600) * 10000000,0) as e_date
            from parus.dictarif t, parus.rlprices p, parus.rlpricespecs pi
            where p.tarif = t.rn and p.rn = pi.prn and (pi.enddate is null or pi.enddate > current_date) order by id, id_i"
          </param>
        </source>
      </sources>
      <field name="shortName" type="string" />
      <field name="id" type="string" />
      <field name="name" type="string" />
      <field name="items" type="collection">
        <data>
          <object name="Items">
            <sources>
              <source name="SQLQuery">
                <param name="keyFields">"id"</param>
              </source>
            </sources>
            <field name="id" type="string" data="id_i" />
            <field name="items" type="collection">
              <data>
                <object name="Item">
                  <sources>
                    <source name="SQLQuery">
                      <param name="keyFields">"id"</param>
                    </source>
                  </sources>
                  <field name="cost" type="number" prec="2" data="price" />
                  <field name="start" type="date" data="st_date" />
                  <field name="finish" type="date" data="e_date" />
                </object>
              </data>
            </field>
          </object>
        </data>
      </field>
    </object>
