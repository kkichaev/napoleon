    <modify src="Org">
      <change>
        <sources>
          <source name="SQLQuery">
            <!--readFilter используется для чтения по умолчанию (когда идет команда Get)-->
            <param name="stmt">
              "select a.agnabbr as name, to_char(a.rn) as id, to_char(f.tarif) as pricetype, f.discount, f.current_sum as balance,
              a.phone as phone, 'Телефон' as fio,
              concat(concat(concat('г.',g_c.geogrname),concat(', ул.',g_s.geogrname)),concat(',',a.ADDR_HOUSE)) as address
              from parus.agnlist a left join parus.geografy g_s on a.addr_street_rn = g_s.rn left join parus.geografy g_c on a.addr_city_rn = g_c.rn, parus.faceacc f
              where a.rn = f.agent
              and f.executive = to_number('" + $user.id + "')"</param>
          </source>
        </sources>
      </change>
      <add>
        <field name="priceType" type="string" />
        <field name="discount" type="number" prec="2" />
        <field name="balance" type="number" prec="2" />
      </add>
    </modify>

