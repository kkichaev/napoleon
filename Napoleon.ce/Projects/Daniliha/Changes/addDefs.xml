    <modify src="Price">
      <change>
        <sources>
          <source name="SQLQuery">
            <param name="stmt">
              "select p.nomen_name as name, to_char(p.rn) as id, to_char(p.crn) as folder,
              p.weight / 1000 as weight, nvl(pk.inpack, 1) as inpack, qt.qty as qty
              from parus.dicnomns p left join
              (select min(quant) as inpack, np.prn from parus.nomnpack np, parus.nomnmodifpack pk where quant > 1 and np.rn = pk.nomenpack group by np.prn) pk on p.rn = pk.prn
              left join (select sum(s.restfact) as qty, n.prn as id from parus.goodssupply s, parus.goodsparties p, parus.nommodif n
              where s.prn = p.rn and s.restfact > 0 and n.rn = p.nommodif and s.store = (select rn from parus.AZSAZSLISTMT where azs_number = 'ГХ')
              group by n.prn) qt on qt.id = p.rn
              where p.rn in (select distinct nomen from parus.rlprices c, parus.rlpricespecs pi where c.rn = pi.prn and (pi.enddate is null or pi.enddate > current_date))"
            </param>
          </source>
        </sources>
      </change>
    </modify>
    
    <modify src="ManagerPrice">
      <change>
        <sources>
          <source name="SQLQuery">
            <!--readFilter используется для чтения по умолчанию (когда идет команда Get)-->
            <param name="stmt">
              "select p.nomen_name as name, to_char(p.rn) as id, to_char(p.crn) as folder,
              p.weight / 1000 as weight, nvl(pk.inpack, 1) as inpack, qt.qty as qty
              from parus.dicnomns p left join (select min(quant) as inpack, prn from parus.nomnpack where quant > 1 group by prn) pk on p.rn = pk.prn
              left join (select sum(s.restfact) as qty, n.prn as id from parus.goodssupply s, parus.goodsparties p, parus.nommodif n
              where s.prn = p.rn and s.restfact > 0 and n.rn = p.nommodif and s.store = (select rn from parus.AZSAZSLISTMT where azs_number = 'ГХ')
              group by n.prn) qt on qt.id = p.rn
              where p.rn in (select distinct nomen from parus.rlprices c, parus.rlpricespecs pi where c.rn = pi.prn and (pi.enddate is null or pi.enddate > current_date))"
            </param>
          </source>
        </sources>
      </change>
    </modify>

