<?xml version="1.0" ?>
<serverDefs xmlns="http://grsoft.ru/schemas/serverDefs.xsd">
  <objects>
    <object name="Monitor">
      <sources>
        <source name="SQTable" type="internal" />
      </sources>
      
      <field name="userid" type="string" />

      <field name="folders" type="collection">
        <data>
          <object name="Item">
            <sources>
              <source name="SQTable" type="internal" />
            </sources>
            <field name="id" type="string" />
          </object>
        </data>
      </field>

      <field name="scripts" type="collection">
        <data>
          <object name="Item">
            <sources>
              <source name="SQTable" type="internal" />
            </sources>
            <field name="id" type="number" />
          </object>
        </data>
      </field>

      <member name="primaryKey">"userid"</member>
    </object>
    
    <object name="ReturnCommit">
      <sources>
        <source name="SQTable" type="internal">
          <param name="readFilter">'"userid"=' + "'" + $user.id + "' and" + '"created" &gt;= ToDate("' + FormatDate(Now(),"DD.MM.YYYY") + '")'</param>
        </source>
      </sources>
      <member name="primaryKey">"userid,created"</member>
      <field name="userid" type="string" />
      <field name="created" type="timestamp"/>
      <field name="id" type="string"  />

      <field name="items" type="collection">
        <data>
          <object name="ReturnItem">
            <sources>
              <source name="SQTable" type="internal" />
            </sources>
            <field name="id" type="string" />
            <field name="qty" type="number" prec="3" />
            <field name="cost" type="number" prec="2" />
            <field name="bestBefore" type="date" />
            <field name="remark" type="string" />
          </object>
        </data>
      </field>
      <events>
        <event type="beforeRead">
          <action name="UpdateReturnCommit" />
        </event>
      </events>
    </object>

    <object name="ReturnCommitKIS" removeOnCommit="true">
      <sources>
        <source name="DBFTableSet">
          <param name="userTable">"AZT"</param>
          <param name="commonTable">"AAZT"</param>
          <param name="catalog">"created;items;1"</param>
        </source>
      </sources>

      <field name="items" type="collection">
        <data>
          <object name="ReturnItem">
            <field name="id" type="string" data="ID_I" width="40"/>
            <field name="qty" type="number" prec="3" />
            <field name="cost" type="number" prec="2" />
            <field name="bestBefore" type="date" data="BEST_BFR" />
            <field name="remark" type="string" />
          </object>
        </data>
      </field>

      <field name="id" type="string" width="40" />
      <field name="created" type="timestamp" />
    </object>

    <object name="OrdConfig">
      <sources>
        <source name="KeyValueTable">
          <param name="fileName">"ord"+$user.id+".cfg"</param>
        </source>
        <source name="KeyValueTable">
          <param name="fileName">"order.cfg"</param>
        </source>
      </sources>

      <field name="key" type="string" />
      <field name="value" type="string" />
    </object>

    <object name="Skalds">
      <sources>
        <source name="KeyValueDBFTable">
          <param name="fileName">"SKLADS"+$user.id</param>
          <param name="key">"Склады"</param>
          <param name="itemName">"NAME"</param>
          <param name="itemKey">"ID"</param>
        </source>
        <source name="KeyValueDBFTable">
          <param name="fileName">"SKLADS"</param>
          <param name="key">"Склады"</param>
          <param name="itemName">"NAME"</param>
          <param name="itemKey">"ID"</param>
        </source>
      </sources>

      <field name="key" type="string" />
      <field name="value" type="string" />
    </object>

    <object name="Config">
      <sources>
        <source name="ObjectUnion">
          <param>"OrdConfig"</param>
          <param>"Skalds"</param>
        </source>
      </sources>

      <field name="key" type="string" />
      <field name="value" type="string" />
    </object>

    <object name="BankIncass">
      <sources>
        <source name="DBFCatalogTable">
          <param name="tableName">"BIC" + $user.id</param>
          <param name="catalog">"id"</param>
          <param name="ordered">1</param>
        </source>
        <source name="SQTable" type="internal" />
      </sources>

      <member name="primaryKey">"userid,created"</member>
      <memberArray name="index">"created"</memberArray>

      <field name="created" type="timestamp" />
      <field name="timeZone" type="number" />
      <field name="serverTimeZone" type="number" data="S_TZ" execOn="Put" feature="USE_TIMEZONE">ServerTimeZone()</field>
      <field name="userid" type="string" execOn="Put">$user.id</field>
      <field name="id" type="string" width="55" />
      <field name="date" type="date" />
      <field name="sended" type="timestamp" data="S_DATE" execOn="Put">Now()</field>
      <field name="sum" type="number" prec="2" />
      <field name="remark" type="string" width="100" />
      <field name="latitude" type="number" prec="5" />
      <field name="longitude" type="number" prec="5" />

      <field name="visitDoc" type="timestamp" />

      <events>
        <event type="put">
          <action name="WriteInternal">$object.type</action>
        </event>
      </events>
    </object>
    <object name="DoverNumber">
      <sources>
        <source name="DBFTable">
          <param name="tableName">"DVR" + $user.id</param>
        </source>
      </sources>

      <field name="number" type="string" />
    </object>

    <object name="AgentBalance">
      <sources>
        <source name="DBFTable">
          <param name="tableName">"balance"</param>
        </source>
      </sources>

      <field name="userid" type="string" />
      <field name="balance" type="number" prec="2" />
      <field name="uid" type="string" execOn="Get">$user.id</field>
    </object>

    <object name="Cost" feature="COST_MANAGER">
      <sources>
        <source name="DBFCostReader">
          <param name="cost">"CS" + $user.id</param>
          <param name="costType">"O" + $user.id</param>
        </source>
      </sources>

      <field name="data" type="binary" />
    </object>

    <object name="CostNew" feature="COST_MANAGER">
      <sources>
        <source name="DBFCostReader">
          <param name="cost">"CS" + $user.id</param>
          <param name="costType">"O" + $user.id</param>
          <param name="dataFields">"COST,MINCOST"</param>
        </source>
      </sources>

      <field name="data" type="binary" />
    </object>

    <object name="OrgDistrib">
      <sources>
        <source name="SQTable" type="internal" />
      </sources>

      <member name="primaryKey">"userid,created"</member>
      <memberArray name="index">"created"</memberArray>

      <field name="userid" type="string" data="USER_ID" execOn="Put">$user.id</field>
      <field name="date" type="timestamp" data="NUM"/>
      <field name="created" type="timestamp" />
      <field name="timeZone" type="number" />
      <field name="serverTimeZone" type="number" data="S_TZ" execOn="Put" feature="USE_TIMEZONE">ServerTimeZone()</field>
      <field name="sended" type="timestamp" data="S_DATE" execOn="Put">Now()</field>
      <field name="id" type="string" />
      <field name="remark" type="string" />
      <field name="items" type="collection">
        <data>
          <object name="OrgDistribItem">
            <sources>
              <source name="SQTable" type="internal" />
            </sources>
            
            <field name="id" width="40" type="string" data="ID_I"/>
            <field name="qty" type="number" prec="3" />
            <field name="cost" type="number" prec="2" />
            <field name="flags" type="number" prec="0" />
            <field name="remark" type="string" />
            <field name="ordflag" width="1" type="number" execOn="Put">FirstItem($object)</field>
            <field name="action" type="number" />
          </object>
        </data>
      </field>

      <field name="latitude" type="number" prec="4" />
      <field name="longitude" type="number" prec="4" />

      <events>
        <event type="put">
          <action name="WriteToLog">$object.type;$object.date</action>
        </event>
      </events>
    </object>

    <modify src="Incass">
      <add>
        <field name="dover" type="string" width="50" />
      </add>
    </modify>

    <modify src="Org">
      <add>
        <field name="discounts" type="collection">
          <data>
            <object name="FDsc">
              <sources>
                <source name="DBFTableSet">
                  <param name="userTable">"FDSC"</param>
                  <param name="commonTable">"FDSC"</param>
                  <param name="filter">"[ID] = $parent.id"</param>
                </source>
              </sources>

              <field name="fid" type="string" data="ID_F" />
              <field name="discount" type="number" prec="2" />
            </object>
          </data>
        </field>
        <field name="actions" type="collection">
          <data>
            <object name="actions">
              <sources>
                <source name="DBFTableSet">
                  <param name="userTable">"ACS"</param>
                  <param name="commonTable">"ACTCOST"</param>
                  <param name="filter">"[ID] = $parent.id"</param>
                </source>
              </sources>

              <field name="cost" type="number" prec="2" />
              <field name="id" type="string" width="25" data="ID_I" />
            </object>
          </data>
        </field>
        <field name="retPrc" type="collection">
          <data>
            <object name="ReturnProcent">
              <sources>
                <source name="DBFTableSet">
                  <param name="userTable">"RPC"</param>
                  <param name="commonTable">"RET_PRC"</param>
                  <param name="filter">"[ID] = $parent.id"</param>
                </source>
              </sources>

              <field name="prc" type="number" prec="0" />
              <field name="id" type="string" width="25" data="ID_I" />
            </object>
          </data>
        </field>

        <field name="matrix" type="collection">
          <data>
            <object name="Matrix">
              <sources>
                <source name="DBFTableSet">
                  <param name="userTable">"OMX"</param>
                  <param name="commonTable">"ORG_MATRIX"</param>
                  <param name="filter">"[ID] = $parent.id"</param>
                </source>
              </sources>
              <field name="id" type="string" width="55" data="ID_I" />
              <field name="order" type="number" data="rowid" />
            </object>
          </data>
        </field>
        <field name="dlvinfo" type="string" />
        <field name="day" type="number" />
        <field name="day2" type="number" />
      </add>
    </modify>

    <modify src="Price">
      <add>
        <field name="freeQty" type="number" prec="3" />
        <field name="quant" type="number" prec="3" />
        <field name="barcode" type="string" data="BC" />
        
        <field name="whQty" type="collection">
          <data>
            <object name="QtyItem">
              <sources>
                <source name="Sequence">
                  <param name="source">$parent.source</param>
                  <param name="startIndex">2</param>
                </source>
              </sources>

              <field name="qty" type="number" prec="3" />
              <field name="freeQty" type="number" prec="3" data="FQTY" />
            </object>
          </data>
        </field>
        <field name="outStock" type="number"/>
      </add>
    </modify>

    <modify src="DivisionManager">
      <add>
        <field name="guid" type="string" />
      </add>
    </modify>
    
    <modify src="Order">
      <add>
        <field name="whCode" type="string" width="30" />
        <field name="sert" type="number" />
        <field name="dateRemark" type="string" width="200" data="DREM"/>
      </add>
    </modify>
    
    <modify src="Order$items">
      <add>
        <field name="discount" type="number" prec="2" />
        <field name="costWODsc" type="number" prec="2" data="COST_WDS" />
        <field name="manualCost" type="number" width="1" data="MNL_CST" />
      </add>
    </modify>
    <modify src="Returns$items">
      <add>
        <field name="bestBefore" type="date" data="BEST_BFR" />
      </add>
    </modify>
    <modify src="Delivery$items">
      <add>
        <field name="remark" type="string"/>
      </add>
    </modify>
  </objects>
  <actions>
    <action name="UpdateReturnCommit">
      <do>
        <runReport name="update_return_commit" />
      </do>
    </action>
  </actions>
</serverDefs>
