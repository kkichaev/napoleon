функция НаДиалогОткрыть()
#
# Загружаем конфигурацию
#
{
   мЗаписи = ПрочитатьКонфигурацию("НаполеонКонфигурация");

   оПапка = Выборка("НаполеонКорневыеПапки");
   
   оНоменклатура = Таблица("Номенклатура");
   оСклад = Таблица("Складская картотека");

   ДляВсех(Переменных(мЗаписи, пНомНомер))
   {
      Если(Найти(оНоменклатура, "НомНомер", пНомНомер))
      {
         адрес = оНоменклатура.АдресЗаписи();
         нсклад = мЗаписи[пНомНомер];
         
         оСклад.Очистить();
         Связать(оСклад.НоменклатураСклады, оНоменклатура);
         оСклад.НомерСклада = нсклад;
         Если(Найти(оСклад, "НоменклатураСклады"))
         {
            Связать(оПапка.СкладскаяКартотека, оСклад);
            оПапка.Добавить();
         }
      }
   }
   
#   ОбновитьВыборки("НаполеонКорневыеПапки");
   
   вернуть СледФункция();
}

функция НаДиалогСохранить()
#
# Вызывается при нажатии кнопки "Сохранить" в диалоге.
# Возвращает: пустую строку - диалог может быть закрыт;
#             не пустую строку - диалог не может быть закрыт, 
#					      в этом случае возвращённая строка трактуется, как имя поля 
#                    и это поле становится активным
#
{
   оПапка = Выборка("НаполеонКорневыеПапки");
   
   Перем мЗаписи[];
   
   Пока( Следующий(оПапка) )
      мЗаписи[оПапка.НомНомер] = оПапка.НомерСклада;

   ЗаписатьКонфигурацию("НаполеонКонфигурация", мЗаписи)

   вернуть СледФункция();
}

