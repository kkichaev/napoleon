<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  android:orientation="vertical"
  android:layout_width="fill_parent"
  android:background="#FFFFFF"
  android:layout_height="fill_parent" android:weightSum="1">
    <Spinner 
    	android:layout_width="fill_parent"
    	android:layout_height="wrap_content"
    	android:id="@+id/spFolders" 
    	/>
    	
    <ListView 
    	android:layout_height="wrap_content" 
    	android:id="@+id/lvGoods" 
    	android:layout_width="fill_parent" android:layout_weight="0.6"/>
    <TextView 
    	android:id="@+id/tvName" 
    	android:layout_width="fill_parent" 
    	android:text="" 
    	android:layout_height="wrap_content"
    	android:maxLines="3"
    	android:padding="3dp"
    	android:textColor="#000000"
		android:background="@color/table_caption" 
		/>
    <LinearLayout 
    	android:layout_width="fill_parent" 
    	android:layout_height="wrap_content" 
    	android:id="@+id/linearLayout1" 
    	android:background="@color/black"
    	android:baselineAligned="false">
        <TextView 
        	android:id="@+id/tvDate" 
        	android:layout_weight="1" 
        	android:layout_width="wrap_content" 
        	android:text="Дата изготовления" 
	    	android:textColor="#000000"
        	android:layout_height="wrap_content"
			android:gravity="center"
			android:background="@color/table_caption" 
			android:layout_marginLeft="1dp" 
			android:layout_marginTop="1dp" 
			android:layout_marginBottom="1dp" 
			/>
        <TextView 
        	android:text="Витрина" 
        	android:id="@+id/tvQtyV"
	    	android:textColor="#000000"
        	android:layout_width="wrap_content" 
        	android:layout_height="wrap_content" 
			android:gravity="center"
			android:background="@color/table_caption" 
			android:layout_marginLeft="1dp" 
			android:layout_marginTop="1dp" 
			android:layout_marginBottom="1dp" 
			android:width="85dp"
			/>
        <TextView 
        	android:id="@+id/tvQty" 
        	android:layout_width="wrap_content" 
        	android:text="Запасы" 
	    	android:textColor="#000000"
        	android:layout_height="wrap_content" 
			android:width="85dp"
			android:gravity="center"
			android:background="@color/table_caption" 
			android:layout_margin="1dp" 
			/>
    </LinearLayout>
    <ListView 
    	android:layout_height="wrap_content" 
    	android:id="@+id/lvParty" 
    	android:layout_width="fill_parent" 
    	android:layout_weight="0.4" 
    	/>
    
	<LinearLayout android:layout_height="wrap_content" 
		android:layout_width="fill_parent" 
		android:id="@+id/linearLayout1" 
		android:background="@color/footer" 
		android:orientation="horizontal" 
		android:padding="7dp">
		
		<ImageButton android:layout_width="wrap_content" 
			android:layout_height="wrap_content" 
			android:src="@drawable/send" 
			android:id="@+id/btnSend" 
			android:layout_marginRight="7dp"/>
			
	</LinearLayout>
</LinearLayout>
