PROJECT=MasloDom

FEATURES = STOP_LIST RCV_MESSAGE VISIT_DOC POD_COMMENT GPS_POS PAY_DELAY
FEATURES+= ORG_COLOR ORG_INFO ORG_NOTE ORG_SKU ORG_REMNANTS ORD_DLV_BIND
FEATURES+= PRICE_MATRIX PRICE_COLOR PRICE_FILTER0 PRESENTATION_EDITOR SQL_ORG_ROUTE
FEATURES+= NAPOLEON_APPS QUESTION STD_QUESTION_REPORT QUESTION_REPORT ORG_STOP_EDITOR AGENT_ORG_TASK
FEATURES+= QUESTION_IN_SCRIPTS SCRIPT_DOC CAN_ADD_ORG_TO_CENSUS PRICE_MONITORING USE_ONLY_ORDER_IN_SUM STD_MONITOR_REPORT
 
NPL_PDA_RESOURCE=

INST_FILES=addDefs.xml

#
# если есть WinMobile закомментарить
#
NO_WIN_MOBILE=1

NEW_CORE=1

MANAGER_SOURCE=FmDetailEx
MANAGER_FORMS=FmSpancopTable OrgDiscountEditor