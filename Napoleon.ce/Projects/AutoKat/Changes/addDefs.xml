  <modify src="PurchaseDoc" dest="NewPurchase">
      <change>
        <sources>
          <source name="SQLQuery">
            <param name="stmt">"select pd.*,sd.fio,sd.phone,sd.passportSeria,sd.passportNumber,sd.passportIssue, sd.birthday, sd.passportType, sd.VisitDoc
              ,sd.issueOrg,sd.issueCode,sd.clientType,sd.address,sd.finish,sd.payType, a.name as agent, a.kisID, sdi.type, org.orgFormat, sd.pstatus
                from
                (select pd.* from PurchaseDoc pd left join OrderCommitted oc on pd.created = oc.created and pd.userid = oc.userid
	                where oc.created is null and pd.created &gt;= $01 and pd.created &lt; $02) pd, ScriptDoc$items sdi, ScriptDoc sd, Agents a, Org 
                where 
	                org.id = sd.id and sdi.type = 'PurchaseDoc' and
                  pd.userid = sdi.ScriptDoc$userid and pd.created = sdi.date and sd.created = sdi.ScriptDoc$created and sd.userid = pd.userid and sd.userid = a.id"</param>
            <param name="$01">ToDate(FormatDate(AdjustDate(Now(),-1,"day"),"DD.MM.YYYY"))</param>
            <param name="$02">ToDate(FormatDate(AdjustDate(Now(),1,"day"),"DD.MM.YYYY"))</param>
          </source>
        </sources>
      </change>
      <add>
        <field name="fio" type="string" />
        <field name="phone" type="string" />
        <field name="passportSeria" type="string" />
        <field name="passportNumber" type="string" />
        <field name="passportIssue" type="date" />
        <field name="issueOrg" type="string" />
        <field name="issueCode" type="string" />  
        <field name="clientType" type="string" />
        <field name="address" type="string" />
        <field name="finish" type="timestamp" />
        <field name="payType" type="string" />
        <field name="agent" type="string" />
        <field name="kisID" type="string" />
        <field name="type" type="string" />
        <field name="orgFormat" type="string" />
        <field name="birthday" type="date" />
        <field name="visitDoc" type="timestamp" />
        <field name="passportType" type="number" />
        <!-- 0 - не проверен, 1 - DaData, 2 - оператор -->
        <field name="pstatus" type="number" />
      </add>
    </modify>

    <modify src="SellingDoc" dest="NewSales">
      <change>
        <sources>
          <source name="SQLQuery">
            <param name="stmt">
              "select pd.*,sd.fio,sd.phone,sd.passportSeria,sd.passportNumber,sd.passportIssue, sd.birthday, sd.passportType
              ,sd.issueOrg,sd.issueCode,sd.clientType,sd.address,sd.finish,sd.payType, a.name as agent, a.kisID, sdi.type, org.orgFormat
              from
              (select pd.* from SellingDoc pd left join OrderCommitted oc on pd.created = oc.created and pd.userid = oc.userid
              where oc.created is null and pd.created &gt;= $01 and pd.created &lt; $02) pd, ScriptDoc$items sdi, ScriptDoc sd, Agents a, Org
              where
              org.id = sd.id and sdi.type like '%SellingDoc' and
              pd.userid = sdi.ScriptDoc$userid and pd.created = sdi.date and sd.created = sdi.ScriptDoc$created and sd.userid = pd.userid and sd.userid = a.id"
            </param>
            <param name="$01">ToDate(FormatDate(AdjustDate(Now(),-1,"day"),"DD.MM.YYYY"))</param>
            <param name="$02">ToDate(FormatDate(AdjustDate(Now(),1,"day"),"DD.MM.YYYY"))</param>
          </source>
        </sources>
      </change>
      <add>
        <field name="fio" type="string" />
        <field name="phone" type="string" />
        <field name="passportSeria" type="string" />
        <field name="passportNumber" type="string" />
        <field name="passportIssue" type="date" />
        <field name="issueOrg" type="string" />
        <field name="issueCode" type="string" />
        <field name="clientType" type="string" />
        <field name="address" type="string" />
        <field name="finish" type="timestamp" />
        <field name="payType" type="string" />
        <field name="agent" type="string" />
        <field name="kisID" type="string" />
        <field name="type" type="string" />
        <field name="orgFormat" type="string" />
        <field name="birthday" type="date" />
        <field name="passportType" type="number" />
      </add>
    </modify>
