    <modify src="AgentPrefix">
      <change>
        <sources>
          <source name="SQLQuery">
            <param name="stmt">
              "select a.*, f.fullName as firm_name, f.address as firm_address, f.ogrn as firm_ogrn, f.inn as firm_inn, f.name as firm_short_name,
              f.okpo as firm_okpo, f.region as region
              from Agents a left join Firm f on a.firm = f.id"</param>
          </source>
        </sources>
      </change>
      <add>
