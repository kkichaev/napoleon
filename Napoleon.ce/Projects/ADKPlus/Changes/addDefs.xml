<?xml version="1.0" ?>
<serverDefs xmlns="http://grsoft.ru/schemas/serverDefs.xsd">
	<objects>
    <modify src="Incass">
      <add>
        <field name="supplyer" type="number" />
      </add>
    </modify>
    <modify src="Price">
      <add>
        <field name="base" type="number" />
        <field name="units" type="collection">
          <data>
            <object name="Units">
              <sources>
                <source name="DBFTableSet">
                  <param name="userTable">"WU"</param>
                  <param name="commonTable">"WUNITS"</param>
                  <param name="filter">"[ID] = $parent.id"</param>
                </source>
              </sources>

              <field name="name" type="string" width="100" />
              <field name="inPack" type="number" prec="3" />
              <field name="id" type="string" width="30" data="ID_UNIT" />
            </object>
          </data>
        </field>
      </add>
    </modify>
    <modify src="Order$items">
      <add>
        <field name="unitId" type="string" width="30" data="ID_UNIT" />
      </add>
    </modify>
	</objects>
</serverDefs>
