  <objects>
    <object name="PriceCost">
      <sources>
        <source name="SQLQuery">
          <param name="stmt">
            'select id, idc, cost from pricecost
            where id in
            (select id from Price where project in (
            select "id" from "AgentProjects" where "userid" = ' + "'"  + $user.id + "'))
            and idc in
            (select idc from orgcosttypes where id in (
            select id from orgdivision where iddivision = '" + $user.division + "' union all " +
            'select "name" from "OrgFolder$items" where "OrgFolder$userid" = ' + "'" + user.id + "')) order by idc"
          </param>
        </source>
      </sources>
      <field name="idc" type="string" />
      <field name="items" type="collection">
        <data>
          <object name="Item">
            <sources>
              <source name="SQLQuery">
                <param name="keyFields">"idc"</param>
              </source>
            </sources>
            <field name="id" type="string"/>
            <field name="cost" type="number" prec="2" />
          </object>
        </data>
      </field>
    </object>

