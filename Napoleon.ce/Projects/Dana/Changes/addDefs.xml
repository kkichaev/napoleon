    <object name="UsedActionCount">
      <sources>
        <source name="SQLQuery">
          <param name="stmt">
            'select sum("qty") as used, "id" from "Order$actions" oi where "id" in ($01) group by "id"'
          </param>
        </source>
      </sources>

      <field name="used" type="number" prec="3" />
      <field name="id" type="string" />
    </object>

    <modify src="Action" dest="RcvActions" table="Action">
      <change>
        <sources>
          <source name="SQTable">
            <param name="stmt">
              'select a.*, coalesce(oi.used, 0) as "used" from
              (select a.* from "Action" a , "AgentActions" aa where a."id" = aa."actionid" and aa."userid"=' + "'$01'" +
              ' and a."finish" &gt;= $02) a left join
              (select sum("qty") as used, "id" from "Order$actions" oi where "Order$created" &gt;= $02 group by "id") oi
              on a."id" = oi."id"'
            </param>
            <param name="$01">$user.id</param>
            <param name="$02">ToDate(FormatDate(AdjustDate(Now(),-14,"day"),"DD.MM.YYYY"))</param>
          </source>
        </sources>
      </change>
      <add>
        <field name="used" type="number" prec="3" />
      </add>
    </modify>

