<?xml version="1.0" ?>
<serverDefs xmlns="http://grsoft.ru/schemas/serverDefs.xsd">
  <objects>
    <object name="Claim">
      <sources>
        <source name="DBFCatalogTable">
          <param name="tableName">"CLAIM" + $user.id</param>
          <param name="catalog">"id"</param>
          <param name="ordered">1</param>
        </source>
        <source name="SQTable" type="internal" />
      </sources>

      <member name="primaryKey">"userid,created"</member>
      <memberArray name="index">"created"</memberArray>

      <field name="userid" type="string" data="USER_ID" execOn="Put">$user.id</field>
      <field name="created" type="timestamp" data="CREATED,NUM"/>
      <field name="timeZone" type="number" />
      <field name="serverTimeZone" type="number" data="S_TZ" execOn="Put" feature="USE_TIMEZONE">ServerTimeZone()</field>
      <field name="sended" type="timestamp" data="S_DATE" execOn="Put">Now()</field>
      <field name="date" type="date" />
      <field name="id" width="55" type="string" />
      <field name="remark" type="string" />

      <events>
        <event type="put">
          <action name="WriteInternal">$object.type</action>
          <action name="WriteToLog">$object.type;$object.created</action>
        </event>
      </events>
    </object>
    <object name="VisitWithPhoto">
      <sources>
        <source name="SQLQuery">
          <param name="stmt">
            "select id, date, userid from Visit as v where date &gt;= ToDate('$01') and date &lt; ToDate('$02') and v.userid  in ($03) and (select count(*) from visit$items as vi where v.date=vi.visit$date and v.userid = vi.visit$userid ) > 0"
          </param>
          <param name="debug" />
        </source>
      </sources>
        
      <field name="id" type="string" />
      <field name="userid" type="string" />
      <field name="date" type="timestamp" />
    </object>

    <object name="WHouses">
      <sources>
        <source name="DBFTable">
          <param name="tableName">"WHUnload"</param>
        </source>
      </sources>

      <field name="id" type="number" prec="0" data="N" />
      <field name="name" type="string" />
    </object>

    <object name="PriceRemnants" sendAlways="true">
      <sources>
        <source name="DBFTableSet">
          <param name="userTable">"W"</param>
          <param name="commonTable">"WAREHOUS"</param>
          <param name="filter">"[folder] in $folder.fid"</param>
        </source>
      </sources>

      <field name="id" type="string" />
      <field name="qty" type="number" prec="3" />
      <field name="whQty" type="collection">
        <data>
          <object name="QtyItem">
            <sources>
              <source name="Sequence">
                <param name="source">$parent.source</param>
                <param name="startIndex">1</param>
              </source>
            </sources>
            <field name="qty" type="number" prec="3" />
          </object>
        </data>
      </field>
    </object>
    
    <object name="Action">
        <sources>
            <source name="DBFTableSet">
                <param name="userTable">"ACT"</param>
                <param name="commonTable">"ACTION"</param>
            </source>
        </sources>
      
        <field name="id" type="string"/>
        <field name="name" type="string"/>
        <field name="bonus" type="number"/>
    </object>
    
    <object name="Bonus">
      <sources>
        <source name="DBFCatalogTable">
          <param name="tableName">$object.table + $user.id</param>
          <param name="catalog">"id"</param>
          <param name="ordered">1</param>
        </source>
        <source name="SQTable" type="internal" />
      </sources>

      <member name="table">"BNS"</member>
      <member name="primaryKey">"userid,created"</member>
      <memberArray name="index">"created"</memberArray>

      <field name="userid" type="string" data="USER_ID" execOn="Put">$user.id</field>
      <field name="created" type="timestamp" data="CREATED,NUM"/>
      <field name="order" type="timestamp" />
      <field name="action" type="string" width="55"/>
      <field name="timeZone" type="number" />
      <field name="serverTimeZone" type="number" data="S_TZ" execOn="Put" feature="USE_TIMEZONE">ServerTimeZone()</field>
      <field name="sended" type="timestamp" data="S_DATE" execOn="Put">Now()</field>
      <field name="date" type="date" />
      <field name="discount" type="number" prec="1" feature="ORDER_DISCOUNT" />
      <field name="delay" type="number" prec="0" />
      <field name="paydate" type="date" execOn="Put">AdjustDate($object.date, $object.delay, "day")</field>
      <field name="id" width="55" type="string" />
      <field name="remark" type="string" />
      
      <field name="items" type="collection">
        <data>
          <object name="OrderItem">
            <sources>
              <source name="DBFCatalogItemTable"/>
              <source name="SQTable" type="internal" />
            </sources>

            <field name="id" width="40" type="string" data="ID_I"/>
            <field name="qty" type="number" prec="3" />
            <field name="discount" type="number" width="6" prec="1" feature="ORD_ITEM_DISCOUNT" />
            <field name="cost" type="number" prec="2" />
            <field name="flags" type="number" width="9" prec="0" data="" />
            <field name="pack" type="number" width="1" execOn="Put">DecodeFlag($object.flags, 1, "", "1")</field>
            <field name="ordflag" width="1" type="number" execOn="Put">FirstItem($object)</field>
          </object>
        </data>
      </field>

      <field name="ctype" type="string" width="30" feature="!HAVE_CONFIG_READER" execOn="Put">KeyValueReader("order.cfg","ВидЦены",$object.sumType)</field>
      <field name="ctype" type="string" width="30" feature="HAVE_CONFIG_READER" execOn="Put">ConfigReader("ВидЦены",$object.sumType)</field>
      <field name="params" type="number" width="9" prec="0" data="" />
      <field name="cash"  type="number" width="1" execOn="Put">DecodeFlag($object.params, 2, "", "1")</field>

      <field name="firma" type="string" width="30" execOn="Put" feature="!SALES_MODULE &amp; !HAVE_CONFIG_READER">KeyValueReader("order.cfg","Организация",$object.supplyer)</field>
      <field name="firma" type="string" width="30" execOn="Put" feature="!SALES_MODULE &amp; HAVE_CONFIG_READER">ConfigReader("Организация",$object.supplyer)</field>
      <field name="firmCode" type="string" width="55" />
      <field name="prcType" type="string" width="55"/>
      <field name="sumType" type="number" />

      <field name="latitude" type="number" prec="5" />
      <field name="longitude" type="number" prec="5" />

      <events>
        <event type="put">
          <!--<action name="WriteOrder" /> !-->
          <action name="RunBat" />
          <action name="WriteInternal">$object.type</action>
          <action name="WriteToLog">$object.type;$object.created</action>
        </event>
      </events>
    </object>

    <modify src="Org">
      <add>
        <field name="egais" type="string" />
        <field name="info" type="string" />
        <field name="address" type="string" data="ADR" />
      </add>
    </modify>

    <modify src="Price">
      <change>
        <sources>
          <source name="DBFTableSet">
            <param name="userTable">"W"</param>
            <param name="commonTable">"WAREHOUS"</param>
            <param name="filter">"[folder] in $folder.fid"</param>
          </source>
        </sources>
      </change>
      <add>
        <field name="partExpr" type="string" data="P_EXPR" />
        <field name="canMinus" type="number" />
        <field name="qty" type="number" prec="3" />
        <field name="color" type="hex" />
        <field name="whQty" type="collection">
          <data>
            <object name="QtyItem">
              <sources>
                <source name="Sequence">
                  <param name="source">$parent.source</param>
                  <param name="startIndex">1</param>
                </source>
              </sources>
              <field name="qty" type="number" prec="3" />
            </object>
          </data>
        </field>
        <field name="quant" type="number" prec="3"/>
      </add>
    </modify>

    <modify src="Order">
      <add>
        <field name="sdate" type="date" execOn="Put">Now()</field>
        <field name="stime" type="time" execOn="Put">Now()</field>
        <field name="wdate" type="date" execOn="Put">$object.created</field>
        <field name="wtime" type="time" execOn="Put">$object.created</field>

        <field name="logistic" type="string" data="LOGIST" width="100" />
        <field name="fcontrol" type="string" data="FIN" width="100" />
        <field name="collectNum" type="string" data="TTN" width="20" />
        <field name="collectSum" type="number" prec="2" data="INCSUM" />
        <field name="collectDate" type="date" data="TTN_DATE" />
        <field name="sert" width="1" type="string" data="SERT" execOn="Put">DecodeFlag($object.params, 4, "", "1")</field>
        <field name="dats" width="1" type="string" data="DATES" execOn="Put">DecodeFlag($object.params, 16, "", "1")</field>
        <field name="qual" width="1" type="string" data="QUAL" execOn="Put">DecodeFlag($object.params, 8, "", "1")</field>
        <field name="payBefore" width="1" type="string" data="PAYBFR" execOn="Put">DecodeFlag($object.params, 32, "", "1")</field>
        <field name="fact" width="1" type="string" data="FACT" execOn="Put">DecodeFlag($object.params, 64, "", "1")</field>
        <field name="userid" type="string" execOn="Put" >$user.id</field>

        <field name="whIndex" type="number" prec="0" data="WHNUM" />
        
        <field name="discact" type="collection" feature="FOCUSED_ITEMS">
            <data>
              <object name="DiscountAction">
                <sources>
                  <source name="DBFTable">
                    <param name="tableName">"DSC" + $user.id</param>
                  </source>
                  <source name="SQTable" type="internal" />
                </sources>

                <field name="id" type="string" width="40" data="ID_I" />
                <field name="pid" type="string" width="30" data="ID">$parent.id</field>
                <field name="date" type="timestamp" width="20">$parent.created</field>
                <field name="ordflag" width="1" type="number" execOn="Put">FirstItem($object)</field>
              </object>
            </data>
        </field>
      </add>
    </modify>

    <modify src="Delivery">
      <add>
        <field name="payType" type="string" width="30" />
      </add>
    </modify>
    <modify src="Payment">
      <add>
        <field name="payType" type="string" width="30" />
      </add>
    </modify>

  </objects>
</serverDefs>
