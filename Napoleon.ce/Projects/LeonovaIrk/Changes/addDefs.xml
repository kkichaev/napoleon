<?xml version="1.0" ?>
<serverDefs xmlns="http://grsoft.ru/schemas/serverDefs.xsd">
	<objects>
    <object name="RouteSaveInfo">
      <sources>
        <source name="SQTable" type="internal" />
        <param name="readFilter">'"userid"=' + "'" + $user.id</param>
      </sources>
      
      <member name="primaryKey">"userid"</member>
      <field name="userid" type="string" />
      <field name="date" type="timestamp" />
    </object>
    
    <object name="PhotoCount">
      <sources>
        <source name="SQLQuery">
          <param name="stmt">
            "select v.userid, v.date, v.id, vi.count_id
             from Visit v, (select Visit$userid as userid, Visit$date as date, count(name) as count_id from Visit$items group by Visit$userid, Visit$date) vi
              where v.date = vi.date and v.userid = vi.userid and v.date &gt;= ToDate('$01') and v.date &lt;= ToDate('$02') and v.userid = "  + "'" + $user.id + "'"
          </param>
        </source>
      </sources>

      <field name="count" type="number" data="count_id" />
      <field name="date" type="timestamp" />
      <field name="userid" type="string" />
      <field name="id" type="string" />
    </object>

    <object name="AgentPlan">
      <sources>
        <source name="SQTable" type="internal">
          <param name="readFilter">
            '"userid"=' + "'" + $user.id + "' and " +
            '"begin" &lt;= ToDate("' + FormatDate(Now(),"DD.MM.YYYY") + '") and ' +
            '"end" &gt;= ToDate("' + FormatDate(Now(),"DD.MM.YYYY") + '")'
          </param>
        </source>
      </sources>

      <member name="primaryKey">"userid,begin"</member>

      <field name="userid" type="string" />
      <field name="begin" type="timestamp" />
      <field name="end" type="timestamp" />

      <field name="groups" type="collection">
        <data>
          <object name="AgemtPlanGroups">
            <sources>
              <source name="SQTable" type="internal" />
            </sources>
            <field name="id" type="string" />
            <field name="type" type="number" />
            <field name="valueSum" type="number" prec="2" />
            <field name="valueQty" type="number" prec="3" />
          </object>
        </data>
      </field>
      
    </object>
    
    <object name="OrgType">
      <sources>
        <source name="DBFTable">
          <param name="tableName">"ORGTYPE"</param>
        </source>
      </sources>
      
      <field name="id" type="string"/>
      <field name="name" type="string"/>
    </object>
    
    <modify src="Org">
      <add>
        <field name="orgtype" type="string" data="OT"/>
        <field name="sku" type="number"/>
        <field name="merc" type="number" />
        <field name="chznak" type="number" />
      </add>
    </modify>
    
    <modify src="OrgFolder">
      <add>
        <event type="put">
          <action name="RouteChanged"/>
        </event>
      </add>
    </modify>

    <modify src="Price">
      <add>
        <field name="merc" type="number" />
        <field name="chznak" type="number" />
      </add>
    </modify>
  </objects>
  
  <actions>
    <action name="RouteChanged">
      <do>
        <put object="RouteSaveInfo" sourceType="internal">$object.userid=$user.id;$object.date=Now()</put>
      </do>
    </action>
  </actions>
</serverDefs>
