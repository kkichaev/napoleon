IDD_SETTINGS DIALOGEX 22, 17, 273, 82
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_CAPTION | WS_SYSMENU
CAPTION "Настройки программы ""Наполеон"""
FONT 8, "Tahoma", 400, 0, 0xCC
BEGIN
    EDITTEXT        IDC_EXCHANGE,75,21,174,14,ES_AUTOHSCROLL
    LTEXT           "Папка обмена",IDC_STATIC,25,23,48,8
    EDITTEXT        IDC_PORT,76,38,55,14,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "Порт",IDC_STATIC,55,40,18,8
    PUSHBUTTON      "...",IDC_BROWSE,251,21,18,14
    PUSHBUTTON      "Отмена",IDCANCEL,4,65,50,14
    PUSHBUTTON      "OK",IDOK,217,65,50,14
    PUSHBUTTON      "Пользователи",IDC_USERS,103,65,65,14
    EDITTEXT        IDC_SBIS,75,4,174,14,ES_AUTOHSCROLL
    LTEXT           "Папка СБИС",IDC_STATIC,25,6,42,8
    PUSHBUTTON      "...",IDC_SBIS_BROWSE,251,4,18,14
END

IDD_USERS DIALOGEX 0, 0, 317, 175
STYLE DS_SETFONT | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
CAPTION "Пользователи"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
