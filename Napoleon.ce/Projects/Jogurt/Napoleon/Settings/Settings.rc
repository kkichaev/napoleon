    PUSHBUTTON      "Назначить логин",IDC_ADD,6,155,70,14
    PUSHBUTTON      "Удалить логин",IDC_DEL,79,155,70,14
END

IDD_LOGIN DIALOGEX 0, 0, 187, 94
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Назначить логин"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    EDITTEXT        IDC_LOGIN,63,7,117,14,ES_AUTOHSCROLL
    EDITTEXT        IDC_PASSWORD,63,25,117,14,ES_PASSWORD | ES_AUTOHSCROLL
    EDITTEXT        IDC_PASSWORD2,63,42,117,14,ES_PASSWORD | ES_AUTOHSCROLL
