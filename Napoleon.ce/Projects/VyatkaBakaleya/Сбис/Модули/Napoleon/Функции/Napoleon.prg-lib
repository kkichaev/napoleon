         Ќаполеонѕроверитьјгента(ојгенты, кодјгента, о—отрудники.—отрудникќрганизаци€.‘»ќ);
         
         им€‘айлаќрг = Ќаполеонѕапкаќбмена() + "\\O" + кодјгента + ".TMP.DBF";
         DBF“аблица(им€‘айлаќрг, "Ќаполеон‘айлќрганизаций", "DOS");
         файлќрганизаций = “аблица(им€‘айлаќрг);
      }
      
      файлќрганизаций.ќчистить();
      код = Win2Dos(о—отрудники.ќрганизаци€—отрудник.»ЌЌ);
      ≈сли( о—отрудники.ќрганизаци€—отрудник. од‘илиала != "" )
         код += —имвол— одом(9) + Win2Dos(о—отрудники.ќрганизаци€—отрудник. од‘илиала);
         
      файлќрганизаций.ID = код;
      файлќрганизаций.NAME = Win2Dos(о—отрудники.ќрганизаци€—отрудник.Ќазвание);
      файлќрганизаций.ADDRESS = Win2Dos(о—отрудники.ќрганизаци€—отрудник.јдрес);
      файлќрганизаций.ƒобавить();
   }
}

функци€ Ќаполеон¬ыгрузитьѕапки—“оваром(о“овар, п орень, файл“оваров, файлѕапок)
{
   ≈сли( п орень != -1 )
   {
      о“овар.”становить орень(п орень);

      файлѕапок.ќчистить();

      файлѕапок.ID = п орень.јдрес«аписи();
      файлѕапок.NAME = Win2Dos(п орень.Ќаименование);
      файлѕапок.LEVEL = 0;
      
      файлѕапок.ƒобавить();
   }
   
   о”паковка = “аблица("”паковки и штрих-коды");
      
   о“овар.–азвернуть—”злами();
   ѕока(—ледующий(о“овар))
   {
      ≈сли( о“овар.Ёто”зел() )
      {
         файлѕапок.ќчистить();
         
         ≈сли( о“овар.Ёто орень() )
            уровень = 0;
         »наче
            уровень = 1;
            
         о–аздел = о“овар.–аздел;
         ѕока( !о–аздел.Ёто орень() )
         {
            о–аздел = о–аздел.–аздел;
            уровень++;
         }
                    
         файлѕапок.ID = о“овар.јдрес«аписи();
         файлѕапок.NAME = Win2Dos(о“овар.Ќаименование);
         файлѕапок.LEVEL = уровень;
         
         файлѕапок.ƒобавить();
      }
      »наче
      {
         ≈сли( файл“оваров != -1 и о“овар.÷ена1 > 0 и
               (Ќаполеон¬ыгружатьЌенулувыеќстатки() == 0 или о“овар.—вободно > 0) )
         {
            файл“оваров.ќчистить();
            
            цвет = "";
            если( есть(о“овар.ѕ–»ќ–»“≈“) )
            {
               если( о“овар.ѕ–»ќ–»“≈“ == 1 )
                  цвет = "F0";
               иначе если( о“овар.ѕ–»ќ–»“≈“ == 2 )
                  цвет = "F0F0";
            }
            
            файл“оваров.ID = Win2Dos(о“овар.ЌомЌомер);
            файл“оваров.FOLDER = о“овар.–аздел.јдрес«аписи();
            файл“оваров.NAME = Win2Dos(о“овар.Ќаименование);
            файл“оваров.QTY = Ќаполеонќстаток(о“овар);
            файл“оваров.COST1 = о“овар.÷ена1;
            файл“оваров.COST2 = о“овар.÷ена2;
            файл“оваров.COST3 = о“овар.÷ена3;
            файл“оваров.COLOR = цвет;
            
            файл“оваров.INPACK = 1;
            ≈сли(о“овар. од”паковки != 0 )
            {
               о”паковка.ќчистить();
               —в€зать(о”паковка.Ќоменклатура”паковки, о“овар.Ќоменклатура—клады)
               о”паковка. од = о“овар. од”паковки;
               
               ≈сли(Ќайти(о”паковка, "Ќоменклатура”паковки"))
                  файл“оваров.INPACK = о”паковка.¬”паковке;
            }
            
            файл“оваров.ƒобавить();
         }
      }
   }
}

