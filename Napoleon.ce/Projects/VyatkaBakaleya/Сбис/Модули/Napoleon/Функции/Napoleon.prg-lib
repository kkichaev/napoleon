}

функци€ Ќаполеонѕереименовать‘айлы()
#
#переименовывает временные файлы после внесени€ информации
#
{
   м‘айлы = —писок‘айлов(Ќаполеонѕапкаќбмена() + "\\*.TMP.DBF");
   ƒл€¬сех(ѕеременных(м‘айлы, индекс))
   {
      им€‘айла = м‘айлы[индекс];
      новое»м€ = ѕод—трока(им€‘айла, 1, –азмер(им€‘айла)-8) + ".DBF";
      
      ≈сли(Ќайти‘айл(новое»м€))
         ”далить‘айл(новое»м€);
      ѕереименовать‘айл(им€‘айла, новое»м€);
   }
}

функци€ Ќаполеонѕроверитьјгента(ојгенты, кодјгента, им€јгента)
#
# найти агента в файле users.dbf - если нет, добавить
#
{
   т»м€јгента = Win2Dos(им€јгента);
   т одјгента = Win2Dos(кодјгента);
   
   ојгенты.ќчистить();
   ѕока(—ледующий(ојгенты))
   {
      ≈сли( ојгенты.ID == т одјгента )
      {
         ≈сли( ојгенты.NAME != т»м€јгента )
         {
            ојгенты.NAME = т»м€јгента;
            ојгенты.—охранить();
         }
         ¬ернуть 1;
      }
   }
   
   ојгенты.ќчистить();
   ојгенты.NAME = т»м€јгента;
   ојгенты.ID = т одјгента;
   ојгенты.ƒобавить();
}

функци€ Ќаполеон¬ыгрузить онтрагентов()
{
   ¬ывести—татус("¬ыгрузка контрагентов..");
   
   ојгенты = “аблица(Ќаполеонѕапкаќбмена() + "\\USERS.DBF");
   о—отрудники = “аблица("—отрудникќрганизации");
   
   перем м одјгента[], файл онтрагентов, файлќрганизаций;
   ѕока(—ледующий(о—отрудники, "—отрудникќрганизаци€"))
   {
      кодјгента = о—отрудники.—отрудникќрганизаци€.“абЌомер;
      ≈сли( ≈сть(м одјгента[кодјгента]) == Ќет )
      {
