функци€ Ќаполеон¬ыгрузить“овар()
{   
   ¬ывести—татус("¬ыгрузка товара..");

   п»м€‘айла = Ќаполеонѕапкаќбмена() + "\\WAREHOUS.TMP.DBF";
   DBF“аблица(п»м€‘айла, "Ќаполеон‘айл“оваров", "DOS");
   файл“оваров = “аблица(п»м€‘айла);
   
   п»м€‘айла = Ќаполеонѕапкаќбмена() + "\\FOLDERS.TMP.DBF";
   DBF“аблица(п»м€‘айла, "Ќаполеон‘айлѕапок“овара", "DOS");
   файлѕапок = “аблица(п»м€‘айла);

   о“овар = ¬ыборка("—кладска€ картотека"); 
   оѕапки = ¬ыборка("Ќаполеон орневыеѕапки");
 
   выгрузили = 0;
   
   ѕока(—ледующий(оѕапки))
   {
      выгрузили = 1;
      Ќаполеон¬ыгрузитьѕапки—“оваром(о“овар, оѕапки.—кладска€ артотека, файл“оваров, файлѕапок);
   }
   
   ≈сли( выгрузили == 0 )
      Ќаполеон¬ыгрузитьѕапки—“оваром(о“овар, -1, файл“оваров, файлѕапок);
}

функци€ Ќаполеон—оздать«а€вку(о«а€вка, кодјгента, счет)
{
   ≈сли( счет != 0 )
      им€¬ыборки = "»сход€щие счета";
   »наче
      им€¬ыборки = "–асходные накладные";
   
   оƒок1 = ¬ыборка(им€¬ыборки);

   оƒок1.ќчистить();
   оƒок1.ƒата = о«а€вка.DATE;
   
   оќрг = “аблица("ќрганизации");
   код = Dos2Win(о«а€вка.ID);
   филиал = "";
   поз = Ќайти(код, —имвол— одом(9))
   ≈сли( поз != 0 )
   {
      филиал = ѕодстрока(код, поз+1);
      код = ѕодстрока(код, 1, поз-1);
   }
   
   оќрг.ќчистить();
   оќрг.»ЌЌ = код;
   #оќрг. од‘илиала = филиал;
   нашли = 0;   
   ѕока( Ќайти(оќрг, "»ЌЌ") )
   {
      если( оќрг.»ЌЌ != код )
         ѕрервать;
      если( оќрг. од‘илиала == филиал )
      {
         нашли = 1;
         ѕрервать;
      }
   }
   ≈сли( нашли == 0 )
   {
      #сообщить("!");
      #ќтладить();
      ¬ернуть -1;
   }

   —в€зать(оƒок1.Ћицо1, оќрг.Ћицо_);
   
   #ојгент = ЌайтиЋицо(кодјгента, "—отрудники");
   #если( ојгент )
   #   —в€зать(оƒок.Ћицо2, ојгент);
   
   оƒок1.—умма = о«а€вка.SUM;
   оƒок1.ѕримечание = Dos2Win(о«а€вка.REMARK);
   
   Ќаполеонѕапкаƒокументов(оƒок1);
      
   ≈сли( оƒок1.ƒобавить() )
   {
      ¬ернуть оƒок1;
   }
      
   #сообщить("!!");
   #ќтладить();
   ¬ернуть -1;
}

функци€ Ќаполеонƒобавить“овар(оƒок, о«а€вка, нпп, счет)
{
   ≈сли( счет != 0 )
      им€¬ыборки = "Ќаименовани€ счета";
   »наче
      им€¬ыборки = "–асход";
   
   оЌаим = ¬ыборка(им€¬ыборки);
   о“овар = ЌайтиЋицо(Dos2Win(о«а€вка.ID_I), "Ќоменклатура");
   ≈сли( !о“овар )
      ¬ернуть 0;
      
   о—клад = ¬ыборка("—кладска€ картотека");
   ≈сли( !—ледующий(о“овар.Ћицо_, о—клад, "Ќоменклатура—клады"))
      ¬ернуть 0;
   
   оЌаим.ќчистить();   
   оЌаим.ѕорЌомер = нпп;
   оЌаим.ƒата¬рем€ = оƒок.ƒата;
   оЌаим. ол_во = о«а€вка.QTY;
   оЌаим. од”паковки = о“овар. од”паковки;
   оЌаим.—умма÷ен = о«а€вка.COST * о«а€вка.QTY;
   
   ≈сли( счет != 0 )
      —в€зать(оЌаим.—кладЌаименовани€—чета, о—клад);
   »наче
      —в€зать(оЌаим.—клад–асходы, о—клад);
   оЌаим.ƒобавить();
   
   ≈сли( счет != 0 )
      —в€зать(оЌаим.ƒокументЌаименовани€, оƒок);
   »наче
      —в€зать(оЌаим.ƒокумент–асходы, оƒок);
      
   оЌаим.—охранить();
   
   ¬ернуть 1;
}
функци€ Ќаполеонѕрием«а€вок()
#
# функци€ дл€ приема за€вок от торговых агентов
#
{
   # выгружаем за€вки в »сход€щие счета
   счет = Ќаполеон—оздавать—чет();
   
   м‘айлы = —писок‘айлов(Ќаполеонѕапкаќбмена() + "\\ORD*.DBF");
   ƒл€¬сех(ѕеременных(м‘айлы, индекс))
   {
      п»м€‘айла = м‘айлы[индекс];
      новое»м€ = ѕод—трока(п»м€‘айла, 1, –азмер(п»м€‘айла)-4) + ".TMP.DBF";
      ѕереименовать‘айл(п»м€‘айла, новое»м€);
      
      разд = Ќайти— онца(п»м€‘айла, "\\");
      разд2 = Ќайти(ѕод—трока(п»м€‘айла, разд+4), ".");
      кодјгента = ѕод—трока(п»м€‘айла, разд+4, разд2-1);
      
      им€ѕ« = Ќаполеонѕапкаќбмена() + "\\POD" + кодјгента + ".DBF";
      ≈сли( !Ќайти‘айл(им€ѕ«) )
         DBF“аблица(им€ѕ«, "Ќаполеон‘айлѕодтверждени€«а€вки", "DOS");
         
      оѕ« = “аблица(им€ѕ«);
      о«а€вка = “аблица(новое»м€);
      
      перем мќбработано[], оƒок = -1, нпп;
      ѕока(—ледующий(о«а€вка))
      {
      #  признак новой за€вки
         ≈сли(о«а€вка.ORDFLAG == 1 )
         {
            # проверка на дубль за€вки
            ≈сли( ≈сть(мќбработано[о«а€вка.CREATED]) == Ќет )
            {
               мќбработано[о«а€вка.CREATED] = 1;
               оƒок = Ќаполеон—оздать«а€вку(о«а€вка, кодјгента, счет);
               
               # ƒобавим информацию о подтверждении за€вки
               ≈сли( оƒок != -1 )
               {
                  оѕ«.ќчистить();
                  оѕ«.CREATED = о«а€вка.CREATED;
                  оѕ«.ƒобавить();
               }
               нпп = 1;               
            }
            »наче
               оƒок = -1;               
         }
         
         ≈сли(оƒок != -1)
         {
            ≈сли( Ќаполеонƒобавить“овар(оƒок, о«а€вка, нпп, счет) )
               нпп++;
         }
      }
      
      ”далитьѕерем(о«а€вка);       
      ”далить‘айл(новое»м€);
      
      ќбновить¬ыборки();  
   }
}
функци€ ЌаполеонЌакладные«аѕериод(пƒатЌач, пƒат нц, пƒолги)
{
   п»м€‘айла = Ќаполеонѕапкаќбмена() + "\\DELIVERY.TMP.DBF";
   DBF“аблица(п»м€‘айла, "Ќаполеон‘айлЌакладных", "DOS");
   файлЌакладных = “аблица(п»м€‘айла);

   отсрочка = 0;
   ƒл€¬сех(ƒокументов(пƒатЌач, пƒат нц, "Ќакл–асх"))
   {
      ¬ывести—татус("¬ыгрузка накладной " + ƒокумент.Ќомер + "...");
      
      отсрочка = 1;
      ≈сли( есть(ƒокумент.Ћицо1.Ћицо_.ќ“—–ќ„ ј) )
      {
         отсрочка = ƒокумент.Ћицо1.Ћицо_.ќ“—–ќ„ ј;
         #отладить();
      }
      иначе
      {
         ƒл€¬сех(ƒокументов("ƒоговоры", ƒокумент.Ћицо1))
         {
            если(≈сть(ƒокумент.ќтсрочка) и ƒокумент.ƒатЌач <= “екƒата и ƒокумент.ƒат нц >= “екƒата)
            {
               отсрочка = ƒокумент.ќтсрочка;
               прервать;
            }
         }
      }
      
      пкод = Win2Dos(ƒокумент.Ћицо1.Ћицо_.»ЌЌ);
      ≈сли( пкод != "" )
      {
         ≈сли( ƒокумент.Ћицо1.Ћицо_. од‘илиала != "" )
         {
            кодќрг = ƒокумент.Ћицо1.Ћицо_. од‘илиала;
            пкод += —имвол— одом(9) + Win2Dos(ƒокумент.Ћицо1.Ћицо_. од‘илиала);
         }
         
         # вычтем документы по которым нет просрочки по платежам
   #      ≈сли( ƒокумент.ƒата >= пƒат нц - Ќаполеон√лубина редита(ƒокумент.Ћицо1))
   #         пƒолги[пкод] -= ƒокумент.—умма;
         
         записано = 0;
         ƒл€¬сех(Ќаименований())
         {
            файлЌакладных.ќчистить();
            
            файлЌакладных.ID = пкод;
            файлЌакладных.ID_I = Win2Dos(Ќаим.ЌомЌомер);
            файлЌакладных.NUM = ƒокумент.Ќомер;
            файлЌакладных.DATE = ƒокумент.ƒата;
            файлЌакладных.PAYDATE = ƒокумент.ƒата + отсрочка;
            файлЌакладных.QTY = Ќаим. ол_во;
            файлЌакладных.SUM = Ќаим.—умма÷ен;
            файлЌакладных.SUMD = -ƒокумент. ќплате;
            
            файлЌакладных.ƒобавить();
            записано = 1;
         }
         # вычетаем долг если есть товар в накладных (а не навчальные остатки)
         ≈сли( записано == 1 )
            пƒолги[пкод] -= ƒокумент. ќплате;
      }
   }
   
   ”далитьѕерем(файлЌакладных);
}

функци€ Ќаполеон¬ыгрузкаЌакладных()
{
   ¬ывести—татус("–асчет сальдо..");
   
   о—отрудники = “аблица("—отрудникќрганизации");
   
   пƒат нц = “екƒата();
   пƒатЌач = пƒат нц - Ќаполеон√лубина¬ыборкиƒокументов();
 
   перем пƒолги[];
   
   ƒат нц = пƒат нц;
   ƒатЌач = пƒатЌач;
   ƒл€¬сех(Ћиц("62"))
   {
      кодќрг = Win2Dos(Ћицо1.Ћицо_.»ЌЌ);
      если( кодќрг != "" )
      {
         если(Ћицо1.Ћицо_. од‘илиала != "" )
            кодќрг += —имвол— одом(9) + Win2Dos(Ћицо1.Ћицо_. од‘илиала);
      
         долг = (— ƒ - —  );
         
         пƒолги[кодќрг] = долг;
#         если(Ћицо1.Ћицо_.»ЌЌ == "7610041988" )
#            отладить();
      }
