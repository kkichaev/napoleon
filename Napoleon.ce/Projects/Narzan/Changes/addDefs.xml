<?xml version="1.0" ?>
<serverDefs xmlns="http://grsoft.ru/schemas/serverDefs.xsd">
	<objects>
		<modify src="Org">
			<add>
                <field name="matrix" type="collection">
    				<data>
    					<object name="OrgMatrix">
    			        	<sources>
    			            	<source name="DBFTableSet">
    			                	<param name="userTable">"OMX"</param>
    			                    <param name="commonTable">"ORGMTX"</param>
                              <param name="filter">"[ORGID] = $parent.id"</param>
                           </source>
    			            </sources>
    			            
    			            <field name="orgid" type="string" />
                        <field name="id" type="string" />
                        <field name="qty" type="number" prec="3" />
                        <field name="face" type="number" prec="3" />
    			        </object>
    			    </data>
                </field>
			</add>
		</modify>
        
        <modify src="OrgRemnants$items">
            <add>
                <field name="face" type="number" prec="3" />
            </add>
        </modify>
	</objects>
</serverDefs>
