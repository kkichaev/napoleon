#
# установить имя проекта
#
PROJECT=Narzan

FEATURES = STOP_LIST RCV_MESSAGE VISIT_DOC POD_COMMENT GPS_POS PAY_DELAY
FEATURES+= ORG_COLOR ORG_INFO ORG_NOTE ORG_SKU ORG_REMNANTS ORD_DLV_BIND
FEATURES+= PRICE_MATRIX PRICE_COLOR PRICE_FILTER0 SQL_ORG_ROUTE CAN_ADD_ORG_TO_CENSUS
FEATURES+= NAPOLEON_APPS PYTHON_REPORTER

NPL_PDA_RESOURCE=

INST_FILES=addDefs.xml

#
# если есть WinMobile закомментарить
#
NO_WIN_MOBILE=1

DYNAMIC_RT=1
NEW_CORE=1

MANAGER_RESOURCE = FmEditItem FmFaceReport FmOrgMatrixDesigner
MANAGER_SOURCE= FmEditItem FmEditItem.Designer FmFaceReport FmFaceReport.Designer FmOrgMatrixDesigner FmOrgMatrixDesigner.Designer UserFormEx
