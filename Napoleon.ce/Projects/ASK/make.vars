#
# установить имя проекта
#
VariantBase=ASK

FEATURES = STOP_LIST RCV_MESSAGE VISIT_DOC POD_COMMENT GPS_POS PAY_DELAY
FEATURES+= ORG_COLOR ORG_INFO ORG_NOTE ORG_SKU ORG_REMNANTS ORD_DLV_BIND
FEATURES+= PRICE_MATRIX PRICE_COLOR PRICE_FILTER0 PRESENTATION_EDITOR SQL_ORG_ROUTE
FEATURES+= SCRIPT_DOC QUESTION_IN_SCRIPTS USE_ONLY_ORDER_IN_SUM QUESTION QUESTION_REPORT
FEATURES+= FOCUSED_ITEMS FOCUSED_GROUP STD_QUESTION_REPORT AGENT_ORG_TASK
FEATURES+= NAPOLEON_APPS PYTHON_REPORTER

NPL_PDA_RESOURCE=

INST_FILES=addDefs.xml

#
# если есть WinMobile закомментарить
#
NO_WIN_MOBILE=1

MANAGER_SOURCE = ProjectObjects
MANAGER_FORMS = FmAgentPlan FmQty2Report FmOrgMatrix

NEW_CORE=1