    <modify src="ManagerFolder">
      <change>
        <sources>
          <source name="SQLFolder" type="internal">
            <param name="parentField">"parent"</param>
            <param name="childField">"fid"</param>
            <param name="stmt">
              "if exists(SELECT * FROM INFORMATION_SCHEMA.TABLES  WHERE TABLE_SCHEMA = 'dbo' AND  TABLE_NAME = 'F" + user.id + "')
              select * from [F" + $user.id + "]
              else
              select * from  Folders"
            </param>
            <!--<param name="readFilter">"[userid] = '" + $user.id + "'"</param>-->
          </source>
        </sources>
      </change>
      <add>
        <field name="fid" type="string" width="300" />
        <field name="id" type="string" execOn="Get">$object.fid</field>
        <field name="parent" type="string" width="300" />
        <field name="userid" type="string" execOn="Put">$user.id</field>
      </add>
    </modify>

    <modify src="Folder">
      <change>
        <sources>
          <source name="SQLFolder" type="internal">
            <param name="parentField">"parent"</param>
            <param name="childField">"fid"</param>
            <param name="rowidField">"id"</param>
            <param name="stmt">
              "if exists(SELECT * FROM INFORMATION_SCHEMA.TABLES  WHERE TABLE_SCHEMA = 'dbo' AND  TABLE_NAME = 'F" + user.id + "')
              select * from [F" + $user.id + "]
              else
              select * from  Folders"
            </param>
          </source>
        </sources>
        <field name="id" type="number" />
        <field name="fid" type="string" width="300" />
        <field name="name" type="string" />
        <field name="userid" type="string" />
      </change>
      <add>
        <field name="parent" type="string" width="300" />
      </add>
    </modify>

    <modify src="ManagerPrice">
      <change>
        <sources>
          <source name="SQLQuery">
            <param name="stmt">
              "if exists(SELECT * FROM INFORMATION_SCHEMA.TABLES  WHERE TABLE_SCHEMA = 'dbo' AND  TABLE_NAME = 'WH" + user.id + "')
              select * from [WH" + $user.id + "]
              else
              select * from  Warehouse"
            </param>
          </source>
        </sources>
      </change>
      <add>
        <field name="mark" type="number" />
        <field name="quant" type="number" />
      </add>
    </modify>

    <modify src="Price">
