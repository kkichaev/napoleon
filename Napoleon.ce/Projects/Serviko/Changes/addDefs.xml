          </source>
        </sources>
      </change>
      <add>
        <field name="mark" type="number" />
        <field name="quant" type="number" />
        <field name="whQty" type="collection">
          <data>
            <object name="QtyItem">
              <sources>
                <source name="Sequence">
                  <param name="source">$parent.source</param>
                </source>
              </sources>
              <field name="qty" type="number" prec="3" />
            </object>
          </data>
        </field>
      </add>
    </modify>

