    <modify src="Matrix">
      <change>
        <sources>
          <source name="SQLQuery">
            <param name="stmt">
              "select i.CommonMatrix$name as name, i.id as id from [CommonMatrix$items] as i
              where i.[CommonMatrix$name] in (select name from  AgentMatrix where userid = '"+$user.id+"') or
              i.[CommonMatrix$name] in (select matrix from AgentAssortMtx where userid = '"+$user.id+"')
              order by name"
            </param>
          </source>
        </sources>
      </change>
    </modify>

    <modify src="Matrix$items">
