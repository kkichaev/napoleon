<?xml version="1.0" ?>
<serverDefs xmlns="http://grsoft.ru/schemas/serverDefs.xsd">
   <objects>
     <object name="Incass">
       <sources>
         <source name="DBFCatalogTable">
           <param name="tableName">"Incass" + $user.id</param>
           <param name="catalog">"id"</param>
           <param name="ordered">1</param>
         </source>
         <source name="SQTable" type="internal" />
       </sources>

       <member name="primaryKey">"userid,created"</member>

       <field name="created" type="timestamp" />
       <field name="userid" type="string" execOn="Put">$user.id</field>
       <field name="id" type="string" width="30" />
       <field name="date" type="date" />
       
       <field name="dovNumber" type="string" width="12" data="NUM_D" />
       <field name="dovDate" type="date" data="DATE_D" />
              
       <field name="sended" type="timestamp" data="S_DATE" execOn="Put">Now()</field>
       <field name="sum" type="number" prec="2" />
       <field name="remark" type="string" width="100" />
       <field name="latitude" type="number" prec="5" />
       <field name="longitude" type="number" prec="5" />

       <field name="items" type="collection">
         <data>
           <object name="DocPayItem">
             <sources>
               <source name="DBFCatalogItemTable"/>
               <source name="SQTable" type="internal" />
             </sources>

             <field name="number" width="20" type="string" data="NUM_I"/>
             <field name="date" type="date" data="DATE_I" />
             <field name="sum" type="number" data="SUM_I" width="10" prec="2" />
             <field name="ordflag" width="1" type="number" execOn="Put">FirstItem($object)</field>
           </object>
         </data>
       </field>

       <events>
         <event type="put">
           <action name="WriteInternal">$object.type</action>
         </event>
       </events>
     </object>

     <modify src="Org" >
         <add>
            <field name="do15" type="number" hidden="true" />
            <field name="stop" type="number" hidden="true" />
            <field name="flags" type="number" execOn="Get">EncodeFlag($object.do15,1,$object.stop,2)</field>
            <field name="phone" type="string" />
         </add>
      </modify>

      <modify src="Price">
         <add>
            <field name="do15" type="number" hidden="true" />
            <field name="flags" type="number" execOn="Get">EncodeFlag($object.do15,1)</field>
            
            <field name="qtys" type="collection">
               <data>
                  <object name="PQty">
                     <sources>
                        <source name="Sequence">
                           <param name="source">$parent.source</param>
                        </source>
                     </sources>
                     <field name="qty" type="number" prec="3" />
                  </object>
               </data>
            </field>
         </add>
      </modify>

      <modify src="Order">
        <add>
          <field name="whCode" type="string" width="10" data="SKLAD" />
          <field name="prcCode" type="string" width="10" data="PRCCODE" />
         </add>
      </modify>

      <modify src="Payment">
         <add>
            <field name="dlvSum" type="number" prec="2" data="DLV_SUM" />
            <field name="payDelay" type="number" data="DELAY" />
            <field name="overDelay" type="number" data="P_DAY" />
            <field name="manager" type="string" data="MGR" />
         </add>
      </modify>

   </objects>
</serverDefs>
