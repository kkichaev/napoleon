<?xml version="1.0" ?>
<serverDefs xmlns="http://grsoft.ru/schemas/serverDefs.xsd">
	<objects>
    <modify src="Price">
      <add>
        <field name="base" type="number" />
        <field name="units" type="collection">
          <data>
            <object name="Units">
              <sources>
                <source name="DBFTableSet">
                  <param name="userTable">"WU"</param>
                  <param name="commonTable">"WUNITS"</param>
                  <param name="filter">"[ID_I] = $parent.id"</param>
                </source>
              </sources>

              <field name="name" type="string" width="100" />
              <field name="inPack" type="number" prec="3" />
              <field name="id" type="string" width="30" />
            </object>
          </data>
        </field>
      </add>
    </modify>
    <modify src="Order">
      <add>
        <field name="costCode" type="string" width="20" />
        <field name="firmCode" type="string" width="20" />
      </add>
    </modify>
    <modify src="Order$items">
      <add>
        <field name="unitId" type="string" width="30" data="ID_UNIT" />
        <field name="remark" type="string" data="REM_I" />
      </add>
    </modify>
    <modify src="Org">
      <add>
        <field name="discount" type="number" prec="2" />
      </add>
    </modify>
    <modify src="Returns">
      <add>
        <field name="cause" type="string" width="20" />
      </add>
    </modify>
    <modify src="Returns$items">
      <add>
        <field name="unitId" type="string" width="30" data="ID_UNIT" />
      </add>
    </modify>
  </objects>
</serverDefs>
