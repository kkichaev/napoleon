    </modify>
    <modify src="CommonMatrix$items">
      <change>
        <sources>
          <source name="SQTable" type="internal" />
        </sources>
      </change>
    </modify>

    <modify src="Matrix">
      <change>
        <sources>
          <source name="SQLQuery">
            <param name="stmt">
              "select cm.name as name, i.id as id
              from (CommonMatrix as cm inner join [CommonMatrix$items] as i on cm.name = i.[CommonMatrix$name])
              inner join AgentMatrix as am on cm.name = am.name
              where am.userid = '"+$user.id+"'"
            </param>
          </source>
        </sources>
      </change>
    </modify>
    <modify src="Matrix$items">
      <change>
        <sources>
          <source name="SQLQuery">
            <param name="keyFields">"name"</param>
          </source>
        </sources>
      </change>
    </modify>

    <modify src="ManagerFolder">
      <change>
        <sources>
          <source name="SQLFolder" type="internal">
            <param name="parentField">"parent"</param>
            <param name="childField">"fid"</param>
            <param name="stmt">
              "if exists(select TOP(1) * from [Folder] where [userid] = '" + $user.id + "')
              SELECT * FROM [Folder] where [userid] = '" + $user.id + "'
              else
              SELECT * FROM [Folder] where [userid] is null"
            </param>
          </source>
        </sources>
      </change>
      <add>
        <field name="fid" type="string" width="15" />
        <field name="id" type="string" execOn="Get">$object.fid</field>
      </add>
    </modify>


    <modify src="Folder">
      <change>
        <sources>
          <source name="SQLFolder" type="internal">
            <param name="parentField">"parent"</param>
            <param name="childField">"fid"</param>
            <param name="rowidField">"id"</param>
            <param name="stmt">
              "if exists(select TOP(1) * from [Folder] where [userid] = '" + $user.id + "')
              SELECT * FROM [Folder] where [userid] = '" + $user.id + "'
              else
              SELECT * FROM [Folder] where [userid] is null"
            </param>
          </source>
        </sources>
        <field name="id" type="number" />
        <field name="fid" type="string" width="15" />
        <field name="userid" type="string" />
      </change>
      <add>
        <field name="parent" type="string" width="15" />
      </add>
    </modify>

    <modify src="Price">
      <change>
        <sources>
          <source name="SQLQuery">
            <param name="stmt">
              "SELECT Price.id as id, folder, inpack, name, qty, [weight], cost, isNew, isHit, idMfr, filterMask, idCat, idOwr
              FROM Price, PriceCost where Price.id = PriceCost.id ORDER BY Price.id, PriceCost.Num"
            </param>
          </source>
        </sources>
      </change>
      <add>
        <field name="isNew" type="number" />
        <field name="isHit" type="number" />
        <field name="idMfr" type="string" />
        <field name="idOwr" type="string" />
        <field name="idCat" type="string" />
        <field name="filterMask" type="number" />
      </add>
    </modify>

