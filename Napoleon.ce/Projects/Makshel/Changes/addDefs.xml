    <modify src="Org">
      <change>
        <sources>
          <source name="SQTable" type="internal">
            <param name="readFilter">"userid = '" + $user.id + "'"</param>
          </source>
        </sources>
      </change>
      <add>
        <member name="primaryKey">"userid,id"</member>
        <field name="stop" type="number" hidden="true" />
        <field name="balance" type="number" prec="2" />
        <field name="discount" type="number" prec="2" />
        <field name="limit" type="number" prec="2" />
        <field name="flags" type="number" execOn="Get" >EncodeFlag($object.stop,2)</field>
        <field name="mfr" type="string"/>
        <field name="cid" type="string"/>
        <field name="pidx" type="number"/>

        <field name="groups" type="collection">
          <data>
            <object name="OrgGroups">
              <sources>
                <source name="SQTable" type="internal" />
              </sources>
              <field name="id" type="string" />
            </object>
          </data>
        </field>
      </add>
    </modify>

