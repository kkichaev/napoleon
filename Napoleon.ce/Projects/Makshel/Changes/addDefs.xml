<?xml version="1.0" ?>
<serverDefs xmlns="http://grsoft.ru/schemas/serverDefs.xsd">
  <objects>
    <object name="TrdPromo">
      <sources>
        <source name="SQTable" type="internal">
          <param name="readFilter">
            '"start" &lt;= ToDate("' + FormatDate(Now(),"DD.MM.YYYY") + '") and ' +
            '"end" &gt;= ToDate("' + FormatDate(Now(),"DD.MM.YYYY") + '") and ("userid" is null or "userid"=' + "''" + ' or "userid"=' + "'" + $user.id + "')"
          </param>
        </source>
      </sources>

      <member name="primaryKey">"id"</member>
      <field name="id" type="number" />
      <field name="name" type="string" />
      <field name="start" type="date" />
      <field name="end" type="date" />
      <field name="userid" type="string" />

      <field name="orgs" type="collection">
        <data>
          <object name="PromoOrg">
            <sources>
              <source name="SQTable" type="internal" />
            </sources>

            <field name="rel" type="number" />
            <!-- Тип связи 0 = все, 1 = группа, 2 = клиент -->
            <field name="code" type="string" />
          </object>
        </data>
      </field>

      <field name="items" type="collection">
        <data>
          <object name="PromoItems">
            <sources>
              <source name="SQTable" type="internal" />
            </sources>
            <member name="primaryKey">"id"</member>

            <field name="id" type="number" />
            <field name="name" type="string" />

            <field name="val" type="number" prec="2" />
            <!-- 0 = цена, 1 = процент скидки -->
            <field name="valType" type="number" />
            <!-- проверять ассортимент: 0 = нет, 1 = да -->
            <field name="valCnd" type="number" />
            <!-- объект проверки: 0 = количество, 1 = сумма -->
            <field name="valSbj" type="number" />
            <field name="start" type="number" prec="2" />
            <field name="end" type="number" prec="2" />

            <field name="items" type="collection">
              <data>
                <object name="PromoItemRng">
                  <sources>
                    <source name="SQTable" type="internal" />
                  </sources>

                  <field name="id" type="string" />
                  <field name="idMfr" type="string" />
                  <field name="idOwr" type="string" />
                  <field name="idCat" type="string" />
                  <field name="cost" type="number" prec="2" />
                </object>
              </data>
            </field>
          </object>
        </data>
      </field>
    </object>

    <object name="PriceFilterMask">
      <sources>
        <source name="SQTable" type="internal" />
      </sources>

      <member name="primaryKey">"id"</member>
      <field name="id" type="number" />
      <field name="name" type="string" />
    </object>

    <object name="Actions" sendAlways="true">
      <sources>
        <source name="SQTable" type="internal">
          <param name="readFilter">
            '"start" &lt;= ToDate("' + FormatDate(Now(),"DD.MM.YYYY") + '") and ' +
            '"finish" &gt;= ToDate("' + FormatDate(Now(),"DD.MM.YYYY") + '")'
          </param>
        </source>
      </sources>

      <member name="primaryKey">"id"</member>

      <field name="id" type="string" />
      <field name="name" type="string" />
      <field name="descr" type="string" />
      <field name="start" type="date" />
      <field name="finish" type="date" />

      <field name="files" type="collection">
        <data>
          <object name="ActionFilesInfo" tableName="ActionFiles">
            <sources>
              <source name="SQTable" type="internal" />
            </sources>

            <field name="file" type="string" />
          </object>
        </data>
      </field>

      <field name="items" type="collection">
        <data>
          <object name="ActionItem">
            <sources>
              <source name="SQTable" type="internal" />
            </sources>

            <field name="id" type="string" />
            <field name="cost" type="number" prec="2" />
            <field name="qty" type="number" prec="3" />
          </object>
        </data>
      </field>
    </object>

    <object name="Gift">
      <sources>
        <source name="SQTable" type="internal">
          <param name="readFilter">
            '"start" &lt;= ToDate("' + FormatDate(Now(),"DD.MM.YYYY") + '") and ' +
            '"finish" &gt;= ToDate("' + FormatDate(Now(),"DD.MM.YYYY") + '")'
          </param>
        </source>
      </sources>

      <member name="primaryKey">"giftid"</member>

      <field name="giftid" type="string" />
      <field name="id" type="string" />
      <field name="id_i" type="string" />
      <field name="descr" type="string" />
      <field name="start" type="date" />
      <field name="finish" type="date" />
      <field name="qty" type="number" prec="3" />

      <field name="items" type="collection">
        <data>
          <object name="GiftItem">
            <sources>
              <source name="SQTable" type="internal" />
            </sources>

            <field name="id" type="string" />
          </object>
        </data>
      </field>
    </object>

    <object name="ActionFiles" sendLimit="3000000">
      <sources>
        <source name="SQTable" type="internal"/>
      </sources>

      <field name="Actions$id" type="string" />
      <field name="file" type="string" />
      <field name="data" type="file" src="file" />
    </object>

