<?xml version="1.0" ?>
<serverDefs xmlns="http://grsoft.ru/schemas/serverDefs.xsd">
	<objects>
    <object name="PriceMonItems">
      <sources>
        <source name="DBFTable">
          <param name="tableName">"PRCMONIT"</param>
        </source>
      </sources>

      <field name="id" type="string" width="20" />
    </object>
    <object name="PriceMonOrgs">
      <sources>
        <source name="DBFTable">
          <param name="tableName">"MRG" + $user.id</param>
        </source>
      </sources>

      <field name="id" type="string" width="20" />
      <field name="userid" type="string" execOn="Get">$user.id</field>
    </object>

    <object name="PriceMonOrgDoc">
      <sources>
        <source name="SQTable" type="internal" />
      </sources>

      <member name="primaryKey">"userid,created"</member>

      <field name="userid" type="string" execOn="Put">$user.id</field>
      <field name="date" type="timestamp" />
      <field name="created" type="timestamp" />
      <field name="timeZone" type="number" />
      <field name="serverTimeZone" type="number" data="S_TZ" execOn="Put" features="USE_TIMEZONE">ServerTimeZone()</field>
      <field name="sended" type="timestamp" data="S_DATE" execOn="Put">Now()</field>
      <field name="id" width="30" type="string" />
      <field name="items" type="collection">
        <data>
          <object name="OrgRemnantsItem">
            <sources>
              <source name="DBFCatalogItemTable"/>
              <source name="SQTable" type="internal" />
            </sources>

            <field name="id" width="30" type="string" />
            <field name="cost" type="number" prec="3" />
          </object>
        </data>
      </field>

      <field name="latitude" type="number" prec="4" />
      <field name="longitude" type="number" prec="4" />

      <events>
        <event type="put">
          <action name="WriteToLog">$object.type;$object.date</action>
        </event>
      </events>
    </object>

  </objects>
</serverDefs>
