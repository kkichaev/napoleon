#
#
# MAKE для VC
#
#

SHELL=$(ROOT)/shell

DEBUG_RELEASE=1

ifdef VS14
	MS_CRT=Microsoft.VC140.CRT
	MS_INCLUDE=c:\Program Files (x86)\Microsoft Visual Studio\2017\Community\VC\Tools\MSVC\14.16.27023\ATLMFC\include;c:\Program Files (x86)\Microsoft Visual Studio\2017\Community\VC\Tools\MSVC\14.16.27023\include;C:\Program Files (x86)\Windows Kits\NETFXSDK\4.6.1\include\um;C:\Program Files (x86)\Windows Kits\10\include\10.0.17763.0\ucrt;C:\Program Files (x86)\Windows Kits\10\include\10.0.17763.0\shared;C:\Program Files (x86)\Windows Kits\10\include\10.0.17763.0\um;C:\Program Files (x86)\Windows Kits\10\include\10.0.17763.0\winrt;C:\Program Files (x86)\Windows Kits\10\include\10.0.17763.0\cppwinrt;$(ADD_INCLUDE);
	ifdef X64
		MS_LIB_PATH=c:\Program Files (x86)\Microsoft Visual Studio\2017\Community\VC\Tools\MSVC\14.16.27023\ATLMFC\lib\x64;c:\Program Files (x86)\Microsoft Visual Studio\2017\Community\VC\Tools\MSVC\14.16.27023\lib\x64;C:\Program Files (x86)\Windows Kits\NETFXSDK\4.6.1\lib\um\x64;C:\Program Files (x86)\Windows Kits\10\lib\10.0.17763.0\ucrt\x64;C:\Program Files (x86)\Windows Kits\10\lib\10.0.17763.0\um\x64;$(ADD_LIB)
		VC_PATH=c:\Program Files (x86)\Microsoft Visual Studio\2017\Community\VC\Tools\MSVC\14.16.27023\bin\HostX86\x64;c:\Program Files (x86)\Microsoft Visual Studio\2017\Community\Common7\IDE\VC\VCPackages;C:\Program Files (x86)\Microsoft SDKs\TypeScript\3.1;c:\Program Files (x86)\Microsoft Visual Studio\2017\Community\Common7\IDE\CommonExtensions\Microsoft\TestWindow;c:\Program Files (x86)\Microsoft Visual Studio\2017\Community\Common7\IDE\CommonExtensions\Microsoft\TeamFoundation\Team Explorer;c:\Program Files (x86)\Microsoft Visual Studio\2017\Community\MSBuild\15.0\bin\Roslyn;c:\Program Files (x86)\Microsoft Visual Studio\2017\Community\Team Tools\Performance Tools;C:\Program Files (x86)\Microsoft Visual Studio\Shared\Common\VSPerfCollectionTools\;C:\Program Files (x86)\Microsoft SDKs\Windows\v10.0A\bin\NETFX 4.6.1 Tools\;C:\Program Files (x86)\HTML Help Workshop;c:\Program Files (x86)\Microsoft Visual Studio\2017\Community\Common7\IDE\CommonExtensions\Microsoft\FSharp\;C:\Program Files (x86)\Windows Kits\10\bin\10.0.17763.0\x64;C:\Program Files (x86)\Windows Kits\10\bin\x64;c:\Program Files (x86)\Microsoft Visual Studio\2017\Community\\MSBuild\15.0\bin;C:\Windows\Microsoft.NET\Framework\v4.0.30319;c:\Program Files (x86)\Microsoft Visual Studio\2017\Community\Common7\IDE\;c:\Program Files (x86)\Microsoft Visual Studio\2017\Community\Common7\Tools\;C:\Program Files (x86)\Intel\iCLS Client\;C:\Program Files\Intel\iCLS Client\;C:\Windows\system32;C:\Windows;C:\Windows\System32\Wbem;
	else
		MS_LIB_PATH=c:\Program Files (x86)\Microsoft Visual Studio\2017\Community\VC\Tools\MSVC\14.16.27023\ATLMFC\lib\x86;c:\Program Files (x86)\Microsoft Visual Studio\2017\Community\VC\Tools\MSVC\14.16.27023\lib\x86;C:\Program Files (x86)\Windows Kits\NETFXSDK\4.6.1\lib\um\x86;C:\Program Files (x86)\Windows Kits\10\lib\10.0.17763.0\ucrt\x86;C:\Program Files (x86)\Windows Kits\10\lib\10.0.17763.0\um\x86;$(ADD_LIB)
		VC_PATH=c:\Program Files (x86)\Microsoft Visual Studio\2017\Community\VC\Tools\MSVC\14.16.27023\bin\HostX86\x86;c:\Program Files (x86)\Microsoft Visual Studio\2017\Community\Common7\IDE\VC\VCPackages;C:\Program Files (x86)\Microsoft SDKs\TypeScript\3.1;c:\Program Files (x86)\Microsoft Visual Studio\2017\Community\Common7\IDE\CommonExtensions\Microsoft\TestWindow;c:\Program Files (x86)\Microsoft Visual Studio\2017\Community\Common7\IDE\CommonExtensions\Microsoft\TeamFoundation\Team Explorer;c:\Program Files (x86)\Microsoft Visual Studio\2017\Community\MSBuild\15.0\bin\Roslyn;c:\Program Files (x86)\Microsoft Visual Studio\2017\Community\Team Tools\Performance Tools;C:\Program Files (x86)\Microsoft Visual Studio\Shared\Common\VSPerfCollectionTools\;C:\Program Files (x86)\Microsoft SDKs\Windows\v10.0A\bin\NETFX 4.6.1 Tools\;C:\Program Files (x86)\HTML Help Workshop;c:\Program Files (x86)\Microsoft Visual Studio\2017\Community\Common7\IDE\CommonExtensions\Microsoft\FSharp\;C:\Program Files (x86)\Windows Kits\10\bin\10.0.17763.0\x86;C:\Program Files (x86)\Windows Kits\10\bin\x86;c:\Program Files (x86)\Microsoft Visual Studio\2017\Community\\MSBuild\15.0\bin;C:\Windows\Microsoft.NET\Framework\v4.0.30319;c:\Program Files (x86)\Microsoft Visual Studio\2017\Community\Common7\IDE\;c:\Program Files (x86)\Microsoft Visual Studio\2017\Community\Common7\Tools\;C:\Program Files (x86)\Common Files\Oracle\Java\javapath;C:\ProgramData\Oracle\Java\javapath;C:\Program Files (x86)\Intel\iCLS Client\;C:\Program Files\Intel\iCLS Client\;C:\Windows\system32;C:\Windows;C:\Windows\System32\Wbem;C:\Windows\System32\WindowsPowerShell\v1.0\;C:\Program Files\Intel\Intel(R) Management Engine Components\DAL;C:\Program Files\Intel\Intel(R) Management Engine Components\IPT;C:\Program Files (x86)\Intel\Intel(R) Management Engine Components\DAL;C:\Program Files (x86)\Intel\Intel(R) Management Engine Components\IPT;C:\Program Files\Acer\Remote Files\;C:\Program Files (x86)\Windows Kits\8.1\Windows Performance Toolkit\;C:\Program Files (x86)\Microsoft SDKs\TypeScript\1.0\;C:\Program Files\TortoiseSVN\bin;C:\Program Files (x86)\Calibre2\;C:\Program Files\Microsoft SQL Server\Client SDK\ODBC\110\Tools\Binn\;C:\Program Files (x86)\Microsoft SQL Server\120\Tools\Binn\;C:\Program Files\Microsoft SQL Server\120\Tools\Binn\;C:\Program Files\Microsoft SQL Server\120\DTS\Binn\;C:\Program Files\OpenVPN\bin;C:\Program Files (x86)\Microsoft SQL Server\120\Tools\Binn\ManagementStudio\;C:\Program Files (x86)\Microsoft SQL Server\120\DTS\Binn\;C:\Program Files (x86)\NVIDIA Corporation\PhysX\Common;C:\Program Files\dotnet\;C:\Program Files\Microsoft SQL Server\130\Tools\Binn\;C:\Program Files\Microsoft SQL Server\Client SDK\ODBC\130\Tools\Binn\;C:\Program Files (x86)\Microsoft SQL Server\140\Tools\Binn\;C:\Program Files\Microsoft SQL Server\140\Tools\Binn\;C:\Program Files\Microsoft SQL Server\140\DTS\Binn\;C:\Program Files (x86)\Microsoft SQL Server\Client SDK\ODBC\130\Tools\Binn\;C:\Program Files (x86)\Microsoft SQL Server\140\DTS\Binn\;C:\Program Files (x86)\Microsoft SQL Server\140\Tools\Binn\ManagementStudio\;;c:\Program Files (x86)\Microsoft Visual Studio\2017\Community\Common7\IDE\CommonExtensions\Microsoft\CMake\CMake\bin;c:\Program Files (x86)\Microsoft Visual Studio\2017\Community\Common7\IDE\CommonExtensions\Microsoft\CMake\Ninja;
	endif
else
ifdef VS12
	STUDIO_BASE=C:\Program Files (x86)\Microsoft Visual Studio 12.0
	MS_CRT=Microsoft.VC120.CRT
	ifdef X64
		MS_LIB_PATH=$(STUDIO_BASE)\VC\lib\amd64;$(STUDIO_BASE)\VC\atlmfc\lib\amd64;C:\Program Files (x86)\Windows Kits\8.1\Lib\winv6.3\um\x64;$(ADD_LIB)
	else
		MS_LIB_PATH=$(STUDIO_BASE)\VC\lib;$(STUDIO_BASE)\VC\atlmfc\lib;C:\Program Files (x86)\Windows Kits\8.1\Lib\winv6.3\um\x86;$(ADD_LIB)
	endif
	MS_INCLUDE=$(STUDIO_BASE)\VC\include;$(STUDIO_BASE)\VC\atlmfc\include;C:\Program Files (x86)\Windows Kits\8.1\Include\um;C:\Program Files (x86)\Windows Kits\8.1\Include\shared;$(ADD_INCLUDE);
else
	STUDIO_BASE=C:\Program Files (x86)\Microsoft Visual Studio 9.0
	MS_CRT=Microsoft.VC90.CRT
	MS_LIB_PATH=$(STUDIO_BASE)\VC\lib;$(STUDIO_BASE)\VC\atlmfc\lib;C:\Program Files\Microsoft SDKs\Windows\v6.0A\lib;$(ADD_LIB)
	MS_INCLUDE=$(STUDIO_BASE)\VC\include;$(STUDIO_BASE)\VC\atlmfc\include;c:\Program Files\Microsoft SDKs\Windows\v6.0A\Include;$(ADD_INCLUDE);
endif #VS12
	ifndef X64
		VC_PATH=$(STUDIO_BASE)\VC\redist\x86\$(MS_CRT);$(STUDIO_BASE)\VC\bin;c:\Program Files\Microsoft SDKs\Windows\v6.0A\Bin;
	else
		VC_PATH=$(STUDIO_BASE)\VC\redist\amd64\$(MS_CRT);$(STUDIO_BASE)\VC\bin\amd64;c:\Program Files\Microsoft SDKs\Windows\v6.0A\Bin\x64;
	endif
endif #VS14


CC=cl
RC=rc
LINK=link
CCLIB=lib

MS_CFLAGS=/FD /EHa /W3 /c /Zi /nologo $(MS_CFLAGS_ADD)

ifdef VS12
MS_CFLAGS+=/FS 
#MS_CFLAGS+=/D "_WIN32_WINNT=0x0602"
endif

ifdef VS14
MS_CFLAGS+=/FS /D "VS14" /D "Python3" /D "_CRT_NON_CONFORMING_SWPRINTFS" 
endif

ifdef NEW_CORE
MS_CFLAGS+=/D "_UNICODE" /D "UNICODE"
else
MS_CFLAGS+=/D "_MBCS" /D "_CRT_NON_CONFORMING_SWPRINTFS"
endif
MS_CFLAGS+=/D "WIN32" /D "_WINDOWS" /D "_USRDLL" /D "SYNCPC_EXPORTS" /D "_CRT_SECURE_NO_DEPRECATE" /D "SQLITE_ENABLE_COLUMN_METADATA"

MS_LIBS:=kernel32.lib user32.lib gdi32.lib winspool.lib comdlg32.lib advapi32.lib shell32.lib ole32.lib oleaut32.lib uuid.lib odbc32.lib odbccp32.lib comctl32.lib Version.lib $(MS_LIBS)


ifdef CONSOLE
MS_LFLAGS=/SUBSYSTEM:CONSOLE
else
MS_LFLAGS=/SUBSYSTEM:WINDOWS
endif

ifdef X64
MACHINE_FLAG= /MACHINE:X64
else
MACHINE_FLAG= /MACHINE:X86
endif

ifdef VS14
ifndef DEBUG
	MS_LFLAGS+=/LTCG
endif
endif

MS_LFLAGS+=/OPT:REF /OPT:ICF $(MACHINE_FLAG) /nologo 

ifdef DEF
MS_LFLAGS += /DEF:"$(subst $(CYG_DRIVE),$(WIN_DRIVE),$(OUT_DIR)/$(DEF))"
endif

ifdef DYNAMIC_RT
  RT := /MD
  RTD := /MDd
  GEN_MANIFEST = 1
else 
  RT := /MT
  RTD := /MTd
  undefine GEN_MANIFEST
endif

ifdef DEBUG
RT:=$(RTD)
MS_CFLAGS += /Od /D "_DEBUG" $(RT) /RTC1
MS_LFLAGS += /DEBUG
else
ifdef NO_FPO
MS_CFLAGS += /GL /Oi /Ot /Ob2 /GF /Gy $(RT) /D "NDEBUG"
else
MS_CFLAGS += /GL /O2 $(RT) /D "NDEBUG"
endif

ifdef DEBUG_RELEASE
MS_LFLAGS += /DEBUG
else
MS_LFLAGS += /INCREMENTAL:NO /LTCG
endif
endif

ifndef PROG_MANIFEST
ifdef MANIFEST
MS_LFLAGS += /MANIFEST /MANIFESTFILE:$(MANIFEST)
endif
endif
MS_LFLAGS += $(MS_LIBS)

ifdef NO_CHECK_LIBS
MS_LFLAGS += $(foreach lib,$(NO_CHECK_LIBS),$(lib).lib)
endif

ifdef ADD_OPTS
MS_CFLAGS += $(ADD_OPTS)
endif


BaseProject = $(PROJECT)
ifdef VariantBase
BaseProject = $(VariantBase)
endif

ifneq ($(BaseProject),Core)
ifndef MODULE
addPath = $(foreach vpth,$(VPATH),$(PROJECT_DIR)/$(BaseProject)/$(vpth))
addPath += $(PROJECT_DIR)/$(BaseProject)

else
addPath = $(foreach vpth,$(VPATH),$(PROJECT_DIR)/$(BaseProject)/$(MODULE)/$(vpth))
addPath += $(PROJECT_DIR)/$(BaseProject)/$(MODULE)

endif

ifneq ($(Variant),)
varPath = $(foreach vpth,$(VPATH),$(PROJECT_DIR)/$(BaseProject)/Variants/$(Variant)/$(vpth))
addPath := $(varPath) $(addPath)
endif

ifneq ($(RefProject),)
addPath = $(foreach vpth,$(VPATH),$(PROJECT_DIR)/$(RefProject)/$(vpth))
addPath += $(PROJECT_DIR)/$(RefProject)
endif

VPATH := $(addPath) $(VPATH)
endif

export INCLUDE=$(subst $(CYG_DRIVE),$(WIN_DRIVE),$(subst ; ,;,$(foreach  cp,$(VPATH),$(cp);))$(MS_INCLUDE);$(SOURCE_ROOT)/Include)
export LIB=$(MS_LIB_PATH);$(subst $(CYG_DRIVE),$(WIN_DRIVE),$(INT_DIR));$(subst $(CYG_DRIVE),$(WIN_DRIVE),$(OUT_DIR))

T_PATH:=$(VC_PATH);$(STUDIO_BASE)\Common7\IDE;$(subst /,\,$(subst $(CYG_DRIVE),$(WIN_DRIVE),$(ROOT)));C:\Works\Cygwin\bin

export PATH:=$(subst ;,:,$(subst D:,/cygdrive/d,$(subst d:,/cygdrive/d,$(subst C:,/cygdrive/c,$(subst c:,/cygdrive/c,$(T_PATH))))))

CFLAGS=$(MS_CFLAGS)

ifdef PROG_MANIFEST
MF_FILE=$(INT_DIR)/$(PROG_MANIFEST)
MS_LFLAGS += /MANIFEST:NO
#MS_LFLAGS += /MANIFEST /MANIFESTFILE:"$(subst $(CYG_DRIVE),$(WIN_DRIVE),$(MF_FILE))"
else
ifdef GEN_MANIFEST
MF_FILE=$(INT_DIR)/$(PROGRAM).dll.intermediate.manifest
MS_LFLAGS += /MANIFEST /MANIFESTFILE:"$(subst $(CYG_DRIVE),$(WIN_DRIVE),$(MF_FILE))"
CFLAGS+=/D "_BIND_TO_CURRENT_VCLIBS_VERSION=1"
else
MS_LFLAGS += /MANIFEST:NO
endif
endif

include $(ROOT)/make.def

dummy := $(shell mkdir -p "$(subst $(CYG_DRIVE),$(WIN_DRIVE),$(INT_DIR))")

$(INT_DIR)/%.obj: %.cpp
	@$(CC) $(CFLAGS) /TP /Yu"stdafx.h" /Fo"$(subst $(CYG_DRIVE),$(WIN_DRIVE),$@)" /Fd"$(subst $(CYG_DRIVE),$(WIN_DRIVE),$(INT_DIR)/$(PROGRAM).pdb)" /Fp"$(subst $(CYG_DRIVE),$(WIN_DRIVE),$(INT_DIR)/$(PROGRAM).pch)" $(subst $(CYG_DRIVE),$(WIN_DRIVE),$+)

$(INT_DIR)/%.obj: %.c
	@$(CC) $(CFLAGS) /Fo"$(subst $(CYG_DRIVE),$(WIN_DRIVE),$@)" /Fd"$(subst $(CYG_DRIVE),$(WIN_DRIVE),$(INT_DIR)/$(PROGRAM).pdb)" $(subst $(CYG_DRIVE),$(WIN_DRIVE),$+)

$(INT_DIR)/%.res: %.rc
	@$(RC) /l 0x419 $(RC_FLAGS) /I "$(subst $(CYG_DRIVE),$(WIN_DRIVE),$(INT_DIR))" /fo"$(subst $(CYG_DRIVE),$(WIN_DRIVE),$@)" $(subst $(CYG_DRIVE),$(WIN_DRIVE),$<)

$(OUT_DIR)/$(PROGRAM).dll : $(foreach fileName,$(SOURCE),$(INT_DIR)/$(fileName).obj)\
$(foreach fileName,$(RESOURCE),$(INT_DIR)/$(fileName).res) \
$(foreach libName,$(LIBS),$(OUT_DIR)/$(libName).lib)
	@$(LINK) /MAP:"$(subst $(CYG_DRIVE),$(WIN_DRIVE),$(OUT_DIR)/$(PROGRAM).map)" /OUT:"$(subst $(CYG_DRIVE),$(WIN_DRIVE),$@)" /DLL /PDB:"$(subst $(CYG_DRIVE),$(WIN_DRIVE),$(INT_DIR)/$(PROGRAM).pdb)" $(MS_LFLAGS) $(filter-out %.manifest,$(+F)) stdafx.obj
ifdef GEN_MANIFEST
	@mt -nologo -outputresource:"$(subst $(CYG_DRIVE),$(WIN_DRIVE),$@);#2" -manifest "$(subst $(CYG_DRIVE),$(WIN_DRIVE),$(MF_FILE))"
endif
ifdef PROG_MANIFEST
	mt -nologo -outputresource:"$(subst $(CYG_DRIVE),$(WIN_DRIVE),$@);#2" -manifest "$(subst $(CYG_DRIVE),$(WIN_DRIVE),$(MF_FILE))"
endif

$(OUT_DIR)/$(PROGRAM).exe : $(foreach fileName,$(SOURCE),$(INT_DIR)/$(fileName).obj)\
$(foreach fileName,$(RESOURCE),$(INT_DIR)/$(fileName).res) \
$(foreach libName,$(LIBS),$(OUT_DIR)/$(libName).lib)
	$(LINK) /MAP:"$(subst $(CYG_DRIVE),$(WIN_DRIVE),$(OUT_DIR)/$(PROGRAM).map)" $(ADD_LINK_FLAGS) /OUT:"$(subst $(CYG_DRIVE),$(WIN_DRIVE),$@)" /PDB:"$(subst $(CYG_DRIVE),$(WIN_DRIVE),$(INT_DIR)/$(PROGRAM).pdb)" $(MS_LFLAGS) $(filter-out %.manifest,$(+F)) stdafx.obj
ifdef GEN_MANIFEST
	@mt -nologo -outputresource:"$(subst $(CYG_DRIVE),$(WIN_DRIVE),$@);#2" -manifest "$(subst $(CYG_DRIVE),$(WIN_DRIVE),$(MF_FILE))"
endif
ifdef PROG_MANIFEST
	mt -nologo -outputresource:"$(subst $(CYG_DRIVE),$(WIN_DRIVE),$@);#2" -manifest "$(subst $(CYG_DRIVE),$(WIN_DRIVE),$(MF_FILE))"
endif

ifdef PROG_MANIFEST
$(OUT_DIR)/$(PROGRAM).dll : $(MF_FILE)
$(OUT_DIR)/$(PROGRAM).exe : $(MF_FILE)
$(MF_FILE): $(PROG_MANIFEST)
	cp $< $@
endif

$(OUT_DIR)/$(PROGRAM).lib : MS_CFLAGS+=/D "_LIB" 
$(OUT_DIR)/$(PROGRAM).lib : $(foreach fileName, $(SOURCE), $(INT_DIR)/$(fileName).obj)
	@$(CCLIB) /nologo /LTCG /OUT:$(subst $(CYG_DRIVE),$(WIN_DRIVE),$@) /LIBPATH:"$(subst $(CYG_DRIVE),$(WIN_DRIVE),$(INT_DIR))" $(+F) stdafx.obj

$(INT_DIR)/stdafx.obj: stdafx.cpp
	$(CC) $(CFLAGS) /TP /Yc"stdafx.h" /Fo"$(subst $(CYG_DRIVE),$(WIN_DRIVE),$@)" /Fd"$(subst $(CYG_DRIVE),$(WIN_DRIVE),$(INT_DIR)/$(PROGRAM).pdb)" /Fp"$(subst $(CYG_DRIVE),$(WIN_DRIVE),$(INT_DIR)/$(PROGRAM).pch)" $(subst $(CYG_DRIVE),$(WIN_DRIVE),$+)
