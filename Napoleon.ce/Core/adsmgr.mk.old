include ../make.vars
include make.vars

PROGRAM=Ads

FORMS=Login FmBrigade FmBrigadeEdit FmCalendar FmClient FmClientContactEdit FmClientCreate FmClientEdit FmClientFind \
FmDatePeriod FmDistrict FmDistrictEdit \
FmFolderEdit FmGsmReport FmJobsType FmJobsTypeEdit FmKladr FmMain FmMessage FmMessageHistory \
FmOrder FmOrderEdit FmOrderPrepareReport FmPdaPasw FmPrice FmPriceEdit FmProfession FmProfessionEdit \
FmRoute FmSchedule FmSetting FmStuff FmStuffEdit FmUserOrder FmWait FmWelcome FmBrigadeAddress FmOrderMap FmWorkType FmWorkTypeEdit \
FmUserOrderPrepareReport $(MANAGER_FORMS)

ifneq ($(findstring FOCUSED_GROUP, $(FEATURES)),)
FORMS+=FocusedGroupEditor
endif


F_SRC=$(foreach file,$(FORMS),$(file) $(file).Designer)

SOURCE=AssemblyInfo DatePickerCtrl Resources.Designer Settings.Designer Excel OrderReport MapEngine BaseFormSetting  Coordutils DataUtils StringUtil \
Config LocalDataBase Objects OpenLink Program Entries Decorator $(F_SRC)

RESOURCE=Properties.Resources DatePickerCtrl $(FORMS)

REFERENCE=System.Xml System.Data System System.Windows.Forms System.Drawing System.Design $(subst /,\,$(subst $(CYG_DRIVE),$(WIN_DRIVE),$(OUT_DIR)/GRPacket)) $(subst /,\,$(subst $(CYG_DRIVE),$(WIN_DRIVE),$(OUT_DIR)/System.Data.SQLite))

STARTED_NAMESPACE=GRSoft.Ads

PRG_ROOT=Ads/Ads.Net

PROG_ICO=$(PRG_ROOT)/Resources/napoleon.ico

ProgBase = $(PROJECT)
ifdef VariantBase
ProgBase = $(VariantBase)
endif

SRC_DIR:=Maps UILib Utils Properties Report View

variantPath:=$(PRG_ROOT)/Variants/$(ProgBase) $(foreach srcPath,$(SRC_DIR),$(PRG_ROOT)/Variants/$(ProgBase)/$(srcPath))
sourcePath:=$(PRG_ROOT) $(foreach srcPath,$(SRC_DIR),$(PRG_ROOT)/$(srcPath))

VPATH:=$(variantPath) $(sourcePath)

#$(error $(VPATH))

SOURCE_PATH=$(ROOT)/$(PCORE)/$(PRG_ROOT)/Resources

ifdef MANAGER_SOURCE
  SOURCE += $(MANAGER_SOURCE)
endif

ifdef MANAGER_RESOURCE
  RESOURCE += $(MANAGER_RESOURCE)
endif

all: $(OUT_DIR)/System.Data.SQLite.dll $(OUT_DIR)/SQLite.Interop_32.dll $(OUT_DIR)/SQLite.Interop_64.dll $(OUT_DIR)/$(PROGRAM).exe

$(INT_DIR)/Properties.Resources.resources: Properties/Resources.resx
	resgen /useSourcePath $(subst /,\,$(subst $(CYG_DRIVE),$(WIN_DRIVE),$+)) $(subst /,\,$(subst $(CYG_DRIVE),$(WIN_DRIVE),$@))

$(OUT_DIR)/SQLite.Interop_32.dll: ref/x86/SQLite.Interop.dll
	cp $+ $@

$(OUT_DIR)/SQLite.Interop_64.dll: ref/x64/SQLite.Interop.dll
	cp $+ $@

$(OUT_DIR)/System.Data.SQLite.dll: ref/System.Data.SQLite.dll
	cp $+ $@

include ../make.cs
