<UserControl x:Class="Ads2017.TaskJournalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Ads2017"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300"
             MouseLeftButtonDown="UserControl_MouseLeftButtonDown"
             SizeChanged="UserControl_SizeChanged">
    
    <Border BorderBrush="Blue" BorderThickness="0,0,0,1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <TextBlock 
                    Grid.Column="0"
                    Grid.Row="0" 
                    Text="Исполнитель:"
                    Padding="0,0,3,0"/>

                <TextBlock 
                    Grid.Column="1"
                    Grid.Row="0" 
                    Text="{Binding Path=User, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"/>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <TextBlock 
                    Grid.Column="0"
                    Grid.Row="0" 
                    Text="Создана:"
                    Padding="0,0,10,0"/>

                <TextBlock 
                    Grid.Column="1"
                    Grid.Row="0" 
                    Text="{Binding Path=Created, 
                    RelativeSource={RelativeSource AncestorType={x:Type UserControl}},
                    StringFormat=\{0:dd.MM.yy HH:mm\}}"/>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <TextBlock 
                    Grid.Column="0"
                    Grid.Row="0" 
                    Text="Время план:"
                    Padding="0,0,3,0"/>

                <TextBlock 
                    Grid.Column="1"
                    Grid.Row="0" 
                    Text="{Binding Path=TimePlan, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"/>
            </Grid>

            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <TextBlock 
                    Grid.Column="0"
                    Grid.Row="0" 
                    Text="Время факт:"
                    Padding="0,0,3,0"
                    Foreground="Red"/>

                <TextBlock 
                    Grid.Column="1"
                    Grid.Row="0" 
                    Foreground="Red"
                    Text="{Binding Path=TimeFact, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"/>
            </Grid>

            <TextBlock 
                Grid.Row="4"
                TextWrapping="Wrap"
                Text="{Binding Path=Text, 
                RelativeSource={RelativeSource AncestorType={x:Type UserControl}},
                StringFormat=Содержание: \{0\}}"/>
            
            <Grid Grid.Row="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <TextBlock 
                    Grid.Column="0"
                    Grid.Row="0" 
                    Text="Клиент:"
                    Padding="0,0,3,0"/>

                <TextBlock 
                    Grid.Column="1"
                    Grid.Row="0" 
                    Text="{Binding Path=Client, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"/>
            </Grid>

            <Grid Grid.Row="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <TextBlock 
                    Grid.Column="0"
                    Grid.Row="0" 
                    Text="Адрес:"
                    Padding="0,0,3,0"/>

                <TextBlock 
                    Grid.Column="1"
                    Grid.Row="0" 
                    Text="{Binding Path=Address, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"/>
            </Grid>

            <Grid Grid.Row="7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <TextBlock 
                    Grid.Column="0"
                    Grid.Row="0" 
                    Text="Статус:"
                    Padding="0,0,3,0"/>

                <TextBlock 
                    Grid.Column="1"
                    Grid.Row="0" 
                    Text="{Binding Path=Status, 
                        RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                    Foreground="{Binding Path=StatusColor, 
                        RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"/>
            </Grid>

            <Grid Grid.Row="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <TextBlock 
                    Grid.Column="0"
                    Grid.Row="0" 
                    Text="Фототчет:"
                    Padding="0,0,3,0"/>

                <ItemsControl 
                    x:Name="imagesControl"
                    ItemsSource="{Binding Path=Images, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel>

                            </WrapPanel>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Image 
                            Margin="30" 
                            Source="{Binding}" 
                            Width="100" 
                            Height="200"
                            MouseLeftButtonDown="Image_MouseLeftButtonDown"></Image>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

            <Grid Grid.Row="9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <TextBlock 
                    Grid.Column="0"
                    Grid.Row="0" 
                    Text="Отчет:"
                    Padding="0,0,3,0"/>

                <TextBlock 
                    Grid.Column="1"
                    Grid.Row="0" 
                    Text="{Binding Path=Remark, 
                        RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
