<UserControl x:Class="Ads2017.BandProgressItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Ads2017"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300">
   <Grid Margin="0,3,0,3">
      <Rectangle 
         x:Name="progress" 
         Height="20" 
         Width="{Binding Path=BandWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
         HorizontalAlignment="Left"
         Fill="{Binding Path=ProgressColor, RelativeSource={RelativeSource AncestorType=UserControl}}"
         
         />
       
      <TextBlock 
         x:Name="title" 
         Text="{Binding Path=Title, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
   </Grid>
</UserControl>
