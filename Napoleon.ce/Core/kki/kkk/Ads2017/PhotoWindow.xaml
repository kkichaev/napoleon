<Window x:Class="Ads2017.PhotoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:p = "clr-namespace:Ads2017.Properties"
        mc:Ignorable="d"
        Title="{x:Static p:Resources.photo_report}" 
        Height="800" 
        Width="600">
    <Grid>
        <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Path=Images, RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel>
                        </WrapPanel>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Image Margin="20" 
                            Source="{Binding}" 
                            Width="200" 
                            Height="150"
                            MouseLeftButtonDown="Image_MouseLeftButtonDown"></Image>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
