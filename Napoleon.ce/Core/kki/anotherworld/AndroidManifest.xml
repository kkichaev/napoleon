<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.ksoft.anotherworld"
    android:versionCode="1"
    android:versionName="1.0" xmlns:tools="http://schemas.android.com/tools">

    <uses-sdk
        android:minSdkVersion="8"
        android:targetSdkVersion="18"
        tools:ignore="OldTargetApi"/>

    <uses-permission android:name="android.permission.INTERNET"/>
    
    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/AppTheme" 
        android:name="com.ksoft.anotherworld.App">
        <activity
            android:name="com.ksoft.anotherworld.MainActivity"
            android:label="@string/app_name" 
            android:configChanges="keyboard|keyboardHidden|orientation"
            android:screenOrientation="portrait">
            
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        
        <activity android:name="CreateUser" 
            android:label="@string/create_user"
            android:configChanges="keyboard|keyboardHidden|orientation"
            android:windowSoftInputMode="stateHidden"/>
        <activity android:name="Login" 
            android:label="@string/create_user"
            android:configChanges="keyboard|keyboardHidden|orientation"
            android:windowSoftInputMode="stateHidden"/>
        <activity android:name="SelectAvatar"
            android:label="@string/select_awatar_label"
            android:configChanges="keyboard|keyboardHidden|orientation">
            
            <intent-filter>
                <action android:name="com.ksoft.anotherworld.action.SELECT_AVATAR"/>
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>/
    </application>

</manifest>
