<resources xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Base application theme, dependent on API level. This theme is replaced
        by AppBaseTheme from res/values-vXX/styles.xml on newer devices.
    -->
    <style name="AppBaseTheme" parent="android:Theme.Light">
        <!--
            Theme customizations available in newer API levels can go in
            res/values-vXX/styles.xml, while customizations related to
            backward-compatibility can go here.
        -->
    </style>

    <!-- Application theme. -->
    <style name="AppTheme" parent="AppBaseTheme">
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="InputLink" parent="@android:style/Widget.TextView">
        <item name="android:textSize">19sp</item>
        <item name="android:textColor">#0000ff</item>
    </style>
    
    <style name="AppTitle" parent="@android:style/Widget.TextView">
        <item name="android:textSize">19sp</item>
        <item name="android:textColor">#000000</item>
    </style>
    
    <style name="BaseCaptions" parent="@android:style/Widget.TextView">
        <item name="android:textColor">#000000</item>
    </style>
    
    <style name="Captions" parent="BaseCaptions">
        <item name="android:textSize">19sp</item>
    </style>    
    
    <style name="SmallCaptions" parent="BaseCaptions">
        <item name="android:textSize">14sp</item>
    </style> 
    
    <style name="MiddleBox">
        <item name="android:layout_width">45dp</item>
        <item name="android:layout_height">45dp</item>
    </style>
    
    <style name="EdgeButton">
       <item name="android:layout_width">45dp</item>
        <item name="android:layout_height">wrap_content</item>
    </style>
</resources>
