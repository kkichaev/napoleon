<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content" >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:orientation="vertical"
        android:layout_marginLeft="5dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RelativeLayout
                android:id="@+id/iv_img_container"
                android:layout_width="@dimen/univ_ab_height"
                android:layout_height="@dimen/univ_ab_height">

                <ImageView
                    android:id="@+id/image_view"
                    android:background="@drawable/selector_menu_item"
                    android:layout_width="@dimen/univ_ab_height"
                    android:layout_height="@dimen/univ_ab_height"
                    android:layout_alignParentRight="true"
                    android:layout_alignParentTop="true"
                    android:src="@drawable/comm_phone"

                    android:padding="8dp" />

            </RelativeLayout>

        <RelativeLayout
            android:background="@drawable/selector_menu_item"
            android:layout_width="match_parent"
            android:layout_height="@dimen/univ_ab_height"
            android:layout_alignParentLeft="true"
            android:layout_alignParentTop="true"
            android:layout_toLeftOf="@+id/image_view"
            android:layout_weight="1"
            android:layout_marginLeft="10dp"
            android:ellipsize="end"
            android:gravity="center_vertical">

        <TextView
            android:id="@+id/text_view_main"
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:ellipsize="end"
            android:textSize="18dp"
            android:singleLine="true"
            android:layout_alignParentTop="true"/>

        <TextView
            android:id="@+id/text_view"
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:ellipsize="end"
            android:textColor="@color/gray"
            android:textSize="14dp"
            android:layout_alignParentBottom="true"
            android:singleLine="true" />

        </RelativeLayout>

        <ImageView
            android:id="@+id/image_view_remove"
            android:background="@drawable/selector_menu_item"
            android:layout_width="@dimen/univ_ab_height"
            android:layout_height="@dimen/univ_ab_height"
            android:layout_alignParentRight="true"
            android:layout_alignParentTop="true"
            android:src="@drawable/file_remove_gray"
            android:padding="@dimen/univ_padding_small" />

        </LinearLayout>

    <View
        android:layout_height="@dimen/divider_small"
        android:layout_width="match_parent"/>

    </LinearLayout>

</merge>