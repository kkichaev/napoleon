<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical" >

    <LinearLayout
        android:id="@+id/linear_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        style="@style/mainSelectableItemBackground" >

        <RelativeLayout
            android:id="@+id/iv_feature_img_container"
            android:layout_width="@dimen/univ_ab_height"
            android:layout_height="@dimen/univ_ab_height"
            android:layout_marginLeft="@dimen/univ_padding"
            android:layout_gravity="center">

            <ImageView
                android:id="@+id/iv_feature_img"
                android:layout_width="@dimen/univ_ab_height"
                android:layout_height="@dimen/univ_ab_height"/>

            <ImageView
                android:id="@+id/iv_feature_img_custom"
                android:layout_width="@dimen/univ_ab_height"
                android:layout_height="@dimen/univ_ab_height"
                android:visibility="gone"/>

        </RelativeLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:minHeight="@dimen/univ_ab_height"
            android:orientation="vertical"
            android:layout_marginTop="@dimen/univ_padding_small"
            android:layout_marginBottom="@dimen/univ_padding_small"
            android:paddingLeft="@dimen/univ_padding_small">

            <TextView
                android:id="@+id/tv_feature_name"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:paddingRight="@dimen/univ_padding_small"
                android:scrollHorizontally="false"
                android:singleLine="true"
                android:textSize="@dimen/text_size_normalSP" />

            <TextView
                android:id="@+id/tv_feature_sub_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:paddingRight="@dimen/univ_padding_small"
                android:singleLine="true"
                android:textColor="@android:color/black"
                android:textSize="@dimen/text_size_lessSP"
                android:visibility="gone" />
        </LinearLayout>


    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider_small"
        android:layout_marginLeft="@dimen/univ_padding"
        android:layout_marginRight="@dimen/univ_padding"
        android:background="@color/properties_color_divider"/>

</LinearLayout>