                            android:text="@string/contact_details"
                            android:textColor="@color/white"
                            android:textSize="12dp"
                            android:textAllCaps="false"
                            style="?android:attr/borderlessButtonStyle" />

                    </RelativeLayout>

                </RelativeLayout>

            </LinearLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="@dimen/univ_padding">

                <ImageView
                    android:layout_width="68dp"
                    android:layout_height="100dp"
                    android:src="@drawable/market6"/>

                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="110dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="15dp"
                            android:gravity="left|top"
                            android:text="@string/market_name6"
                            android:textStyle="bold"
                            android:paddingLeft="@dimen/univ_padding_small"
                            android:layout_gravity="center"
                            android:textSize="12dp"
                            android:textColor="@color/intro_text_color"/>

                        <TextView
                            android:id="@+id/textView2"
                            android:layout_width="match_parent"
                            android:layout_height="75dp"
                            android:layout_gravity="center"
                            android:gravity="left|top"
                            android:paddingLeft="@dimen/univ_padding_small"
                            android:paddingRight="@dimen/univ_padding_small"
                            android:text="@string/market_subname6"
                            android:textColor="@color/intro_text_color"
                            android:textSize="10dp"/>

                    </LinearLayout>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="115dp"
                        android:orientation="horizontal"
                        android:layout_gravity="bottom"
                        android:gravity="right|bottom">

                        <Button
                            android:id="@+id/product6"
                            android:layout_width="80dp"
                            android:layout_height="25dp"
                            android:layout_centerHorizontal="true"
                            android:background="@drawable/selector_bg_btn_orange"
                            android:text="@string/contact_details"
                            android:textColor="@color/white"
                            android:textSize="12dp"
                            android:textAllCaps="false"
                            style="?android:attr/borderlessButtonStyle" />

                    </RelativeLayout>

                </RelativeLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="@dimen/univ_padding">

                <ImageView
                    android:layout_width="68dp"
                    android:layout_height="100dp"
                    android:src="@drawable/market7"/>

                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="110dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="15dp"
                            android:gravity="left|top"
                            android:text="Практикум 'Ахиллесова пята'"
                            android:textStyle="bold"
                            android:paddingLeft="@dimen/univ_padding_small"
                            android:layout_gravity="center"
                            android:textSize="12dp"
                            android:textColor="@color/intro_text_color"/>

                        <TextView
                            android:id="@+id/textView2"
                            android:layout_width="match_parent"
                            android:layout_height="75dp"
                            android:layout_gravity="center"
                            android:gravity="left|top"
                            android:paddingLeft="@dimen/univ_padding_small"
                            android:paddingRight="@dimen/univ_padding_small"
                            android:text="Пошаговое руководство по выявлению сильных и слабых сторон человека/проекта. Включает в себя инструкции с описанием действий для преимуществ и недостатков. Они применимы как в бизнесе, так и в личной жизни."
                            android:textColor="@color/intro_text_color"
                            android:textSize="10dp"/>

                    </LinearLayout>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="115dp"
                        android:orientation="horizontal"
                        android:layout_gravity="bottom"
                        android:gravity="right|bottom">

                        <Button
                            android:id="@+id/product7"
                            android:layout_width="80dp"
                            android:layout_height="25dp"
                            android:layout_centerHorizontal="true"
                            android:background="@drawable/selector_bg_btn_orange"
                            android:text="@string/contact_details"
                            android:textColor="@color/white"
                            android:textSize="12dp"
                            android:textAllCaps="false"
                            style="?android:attr/borderlessButtonStyle" />

                    </RelativeLayout>

                </RelativeLayout>

