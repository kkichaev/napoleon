<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:orientation="vertical"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:background="@android:color/white">

    <LinearLayout
        android:id="@+id/main_pref"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/selector_menu_item_white"
        android:layout_marginTop="10dp"
        android:paddingRight="10dp"
        android:paddingLeft="10dp"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="@dimen/univ_ab_height"
            android:layout_height="@dimen/univ_ab_height"
            android:padding="7dp"
            android:layout_gravity="center"
            android:src="@drawable/general"
            android:layout_alignParentLeft="true"
            android:layout_alignParentStart="true"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:singleLine="true"
            android:layout_marginLeft="3dp"
            android:textColor="@color/primary_color"
            android:textSize="@dimen/text_size"
            android:text="@string/settings_basic"
            android:layout_gravity="center"
            android:layout_centerVertical="true"/>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/input_pref"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/selector_menu_item_white"
        android:paddingRight="10dp"
        android:paddingLeft="10dp"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="@dimen/univ_ab_height"
            android:layout_height="@dimen/univ_ab_height"
            android:padding="7dp"
            android:layout_gravity="center"
            android:src="@drawable/general"
            android:layout_alignParentLeft="true"
            android:layout_alignParentStart="true"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:singleLine="true"
            android:layout_marginLeft="3dp"
            android:textColor="@color/primary_color"
            android:textSize="@dimen/text_size"
            android:text="@string/pass_at_start"
            android:layout_gravity="center"
            android:layout_centerVertical="true"/>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/nav_pref"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/selector_menu_item_white"
        android:paddingRight="10dp"
        android:paddingLeft="10dp"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="@dimen/univ_ab_height"
            android:layout_height="@dimen/univ_ab_height"
            android:padding="7dp"
            android:layout_gravity="center"
            android:src="@drawable/nav"
            android:layout_alignParentLeft="true"
            android:layout_alignParentStart="true"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:singleLine="true"
            android:layout_marginLeft="3dp"
            android:textColor="@color/primary_color"
            android:textSize="@dimen/text_size"
            android:text="@string/settings_navigator"
            android:layout_gravity="center"
            android:layout_centerVertical="true"/>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/notif_pref"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/selector_menu_item_white"
        android:paddingRight="10dp"
        android:paddingLeft="10dp"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="@dimen/univ_ab_height"
            android:layout_height="@dimen/univ_ab_height"
            android:padding="7dp"
            android:layout_gravity="center"
            android:src="@drawable/notif"
            android:layout_alignParentLeft="true"
            android:layout_alignParentStart="true"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:singleLine="true"
            android:layout_marginLeft="3dp"
            android:textColor="@color/primary_color"
            android:textSize="@dimen/text_size"
            android:text="@string/notify_settings"
            android:layout_gravity="center"
            android:layout_centerVertical="true"/>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/data_pref"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/selector_menu_item_white"
        android:paddingRight="10dp"
        android:paddingLeft="10dp"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="@dimen/univ_ab_height"
            android:layout_height="@dimen/univ_ab_height"
            android:padding="7dp"
            android:layout_gravity="center"
            android:src="@drawable/data"
            android:layout_alignParentLeft="true"
            android:layout_alignParentStart="true"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:singleLine="true"
            android:layout_marginLeft="3dp"
            android:textColor="@color/primary_color"
            android:textSize="@dimen/text_size"
            android:text="@string/settings_basic_data"
            android:layout_gravity="center"
            android:layout_centerVertical="true"/>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/info_pref"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/selector_menu_item_white"
        android:paddingRight="10dp"
        android:paddingLeft="10dp"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="@dimen/univ_ab_height"
            android:layout_height="@dimen/univ_ab_height"
            android:padding="7dp"
            android:layout_gravity="center"
            android:src="@drawable/info"
            android:layout_alignParentLeft="true"
            android:layout_alignParentStart="true"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:singleLine="true"
            android:layout_marginLeft="3dp"
            android:textColor="@color/primary_color"
            android:textSize="@dimen/text_size"
            android:text="@string/settings_about_program"
            android:layout_gravity="center"
            android:layout_centerVertical="true"/>

    </LinearLayout>

</LinearLayout>