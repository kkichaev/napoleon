<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content" >


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical" >


        <TextView
            android:id="@+id/factTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="24dp"
            android:paddingTop="20dp"
            android:text="@string/fact"
            android:layout_marginBottom="10dp"
            android:textColor="@color/black"
            android:textSize="22dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:paddingRight="10dp"
            android:paddingLeft="10dp">

            <TextView
                android:id="@+id/fact"
                style="@style/mainSelectableItemBackground"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:textSize="16dp"
                android:textColor="@color/black"
                android:autoText="false"
                android:padding="10dp"
                android:gravity="center"/>

            <FrameLayout
                android:id="@+id/btn_without_fact"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true"
                android:layout_gravity="right" >

                <ImageView
                    style="@style/mainSelectableItemBackground"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/back"
                    android:padding="8dp"
                    android:layout_gravity="center"/>

            </FrameLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/comment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16dp"
            android:textColor="@color/navigator_text_color"
            android:text="@string/chronometry_comment"
            android:gravity="center"
            android:paddingRight="20dp"
            android:paddingLeft="20dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="22dp"
            android:paddingTop="20dp"
            android:text="@string/paln"
            android:textColor="@color/black"
            android:paddingLeft="24dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="10dp"
            android:paddingTop="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <NumberPicker
                    android:id="@+id/count_days"
                    android:layout_width="30dp"
                    android:layout_height="110dp"
                    android:layout_gravity="center_horizontal"
                    android:scaleX="1.1"
                    android:scaleY="1.1"
                    android:descendantFocusability="blocksDescendants"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12dp"
                    android:textColor="@color/navigator_text_color"
                    android:text="@string/chronometry3"
                    android:layout_marginRight="20dp"/>



                <NumberPicker
                    android:id="@+id/count_hour"
                    android:layout_width="30dp"
                    android:layout_height="110dp"
                    android:layout_gravity="center_horizontal"
                    android:scaleX="1.1"
                    android:scaleY="1.1"
                    android:descendantFocusability="blocksDescendants"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12dp"
                    android:textColor="@color/navigator_text_color"
                    android:text="@string/chronometry2"
                    android:layout_marginRight="20dp"/>


                <NumberPicker
                    android:id="@+id/count_min"
                    android:layout_width="30dp"
                    android:layout_height="110dp"
                    android:layout_gravity="center_horizontal"
                    android:scaleX="1.1"
                    android:scaleY="1.1"
                    android:descendantFocusability="blocksDescendants"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12dp"
                    android:textColor="@color/navigator_text_color"
                    android:text="@string/chronometry1"/>


                </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>