<?xml version="1.0" encoding="utf-8"?>
<LinearLayout  xmlns:android="http://schemas.android.com/apk/res/android"
               xmlns:tools="http://schemas.android.com/tools"
               android:layout_width="match_parent"
               android:layout_height="match_parent"
               android:orientation="vertical"
               tools:context="com.ashberrysoft.leadertask.modern.activity.LoadingScreenActivity"
               android:background="@color/login_background">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/login_background">

        <ImageView
            android:id="@+id/right_bg"
            android:layout_width="250dp"
            android:layout_height="150dp"
            android:background="@drawable/right"
            android:layout_alignParentTop="true"
            android:layout_alignParentRight="true"/>

        <ImageView
            android:id="@+id/left_bg"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:background="@drawable/left"
            android:layout_alignParentTop="true"
            android:layout_alignParentLeft="true"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="170dp"
            android:gravity="center"
            android:layout_centerHorizontal="true"
            android:layout_alignParentBottom="true" >


            <ImageView
                android:id="@+id/bottom_bg"
                android:layout_width="510dp"
                android:layout_height="170dp"
                android:layout_gravity="center"
                android:background="@drawable/bottom"/>

        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:overScrollMode="never"
            android:id="@+id/scrollView2">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="@dimen/univ_padding" >

                    <ImageView
                        android:id="@+id/leadertask_logo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:src="@drawable/icon_lt_new_login"
                        android:layout_gravity="center_horizontal|bottom" />

                    <ImageView
                        android:id="@+id/logo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:src="@drawable/leadertask"
                        android:layout_marginBottom="@dimen/univ_padding" />

                    <ProgressBar
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/scrollView2"
                        android:layout_centerHorizontal="true"
                        android:progressDrawable="@drawable/progress_bar_drawable"
                        android:id="@+id/progressBar"/>

                    <TextView
                        android:id="@+id/profile_email"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/univ_padding"
                        android:gravity="center"
                        android:foregroundGravity="center"
                        android:textSize="@dimen/text_size_about"
                        android:text="@string/data_loading"
                        android:textColor="@color/navigator_calendar_text_color"
                        android:layout_gravity="center_horizontal"/>

                    <TextView
                        android:id="@+id/text_prop"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:foregroundGravity="center"
                        android:textSize="@dimen/text_size_less"
                        android:text="@string/loading_text2"
                        android:textColor="@color/navigator_calendar_text_color"
                        android:layout_gravity="center_horizontal"/>


                </LinearLayout>

            </LinearLayout>

        </ScrollView>


    </RelativeLayout>

</LinearLayout>