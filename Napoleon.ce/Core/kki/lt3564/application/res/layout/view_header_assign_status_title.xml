<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical" >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/univ_ab_height"
        android:orientation="horizontal" >

        <ImageView
            android:id="@+id/status"
            style="@style/mainSelectableItemBackground"
            android:layout_width="@dimen/univ_ab_height"
            android:layout_height="@dimen/univ_ab_height"
            android:layout_gravity="top"
            android:padding="@dimen/univ_padding"
            android:src="@drawable/status0" />

        <EditText
            android:id="@+id/title"
            style="@style/etAssignTaskEdit"
            android:layout_gravity="center_vertical"
            android:hint="@string/task_new" />

        <TextView
            android:id="@+id/tv_title"
            style="@style/etAssignTaskText"
            android:layout_gravity="center_vertical"
            android:hint="@string/task_new" />
    </LinearLayout>

    <View style="@style/dividerSmall" />

</LinearLayout>