<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content" >

    <LinearLayout
        style="@style/mainSelectableItemBackground"
        android:layout_width="match_parent"
        android:layout_height="@dimen/univ_ab_height"
        android:orientation="horizontal" >

        <ImageView
            android:id="@+id/image_view"
            android:layout_width="@dimen/univ_ab_height"
            android:layout_height="@dimen/univ_ab_height"
            android:padding="@dimen/univ_padding_small"
            android:scaleType="center" />

        <TextView
            android:id="@+id/text_view"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:padding="@dimen/univ_padding_small"
            android:singleLine="true"
            android:textSize="@dimen/text_size_simple" />
    </LinearLayout>

    <View
        android:id="@+id/divider"
        style="@style/dividerSmall" />

</merge>