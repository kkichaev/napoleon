<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content" >

    <ImageView
        android:id="@+id/img_drop_down"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/arrow_down"
        android:paddingLeft="@dimen/univ_padding_dialog_item" />

    <ImageView
        android:id="@+id/icon"
        android:layout_width="@dimen/univ_ab_height"
        android:layout_height="@dimen/univ_ab_height"
        android:padding="@dimen/univ_padding_small"
        android:src="@drawable/project" />

    <TextView
        android:id="@+id/txt_title"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:paddingLeft="@dimen/univ_padding_small"
        android:scrollHorizontally="false"
        android:singleLine="true"
        android:textColor="@android:color/black"
        android:textSize="@dimen/text_size_about" />
    
    <CheckBox
        android:id="@+id/check_box"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingRight="@dimen/univ_padding_dialog_item" />
    <!-- android:clickable="false" -->
    <!-- android:focusable="false" -->
    <!-- android:focusableInTouchMode="false" -->

</merge>