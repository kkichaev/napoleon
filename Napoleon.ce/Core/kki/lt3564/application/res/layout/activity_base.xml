<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#fff"
    android:orientation="vertical">

    <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:background="#fff"
          android:orientation="vertical">

    <include layout="@layout/toolbar_day_calendar"/>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:background="@drawable/shadow_tobottom"/>

    <com.ashberrysoft.leadertask.day_calendar.custom_calendar.WeekView
        android:id="@+id/weekView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:textSize="12sp"
        app:hourHeight="60dp"
        app:headerColumnPadding="8dp"
        app:headerRowPadding="7dp"
        app:noOfVisibleDays="3"
        app:dayBackgroundColor="#05000000"
        app:headerColumnBackground="#ffffffff"
        app:headerColumnTextColor="@color/toolbar_prop_color_text"
        app:todayHeaderTextColor="@color/primary_color"
        app:todayBackgroundColor="@color/checked_menu_color2"

        app:eventCornerRadius="5dp"
        app:eventPadding="5dp"
        app:minHourHeight="48dp"
        app:verticalFlingEnabled="false"
        />

    </LinearLayout>

    <com.software.shell.fab.ActionButton
        xmlns:fab="http://schemas.android.com/apk/res-auto"
        style="@style/fab_action_button_style"
        android:id="@+id/add_task_button"
        android:layout_marginRight="@dimen/fab_margin"
        android:layout_marginBottom="@dimen/fab_margin"
        fab:type="DEFAULT"
        fab:size="42dp"
        fab:button_color="@color/primary_color"
        fab:button_colorPressed="@color/primary_color"
        fab:image="@drawable/ic_add_white_48dp"
        fab:image_size="22dp"
        fab:stroke_color="@color/primary_color"
        fab:stroke_width="1.0dp"
        fab:button_colorRipple="@color/primary_color_lite"
        fab:rippleEffect_enabled="true"
        fab:shadowResponsiveEffect_enabled="false"
        fab:show_animation="@anim/fab_roll_to_down"
        fab:hide_animation="@anim/fab_roll_to_down"
        fab:shadow_radius="0.0dp"
        fab:shadow_xOffset="4dp"
        fab:shadow_yOffset="3dp"
        />

</RelativeLayout>
