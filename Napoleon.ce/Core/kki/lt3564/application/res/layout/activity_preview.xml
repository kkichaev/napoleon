<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/sliding_menu_background">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/login_background">

        <ImageView
            android:id="@+id/right_bg"
            android:layout_width="250dp"
            android:layout_height="150dp"
            android:background="@drawable/right"
            android:layout_alignParentTop="true"
            android:layout_alignParentRight="true"/>

        <ImageView
            android:id="@+id/left_bg"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:background="@drawable/left"
            android:layout_alignParentTop="true"
            android:layout_alignParentLeft="true"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="170dp"
            android:gravity="center"
            android:layout_centerHorizontal="true"
            android:layout_alignParentBottom="true" >


            <ImageView
                android:id="@+id/bottom_bg"
                android:layout_width="510dp"
                android:layout_height="170dp"
                android:layout_gravity="center"
                android:background="@drawable/bottom"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="bottom">

            <View
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:visibility="invisible"/>

            <com.ashberrysoft.leadertask.modern.view.NonSwipeableViewPager
                android:id="@+id/view_pager_intro"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="90dp"
                android:persistentDrawingCache="animation"
                android:layout_alignParentBottom="true"
                android:layout_alignParentLeft="true"
                android:overScrollMode="never">

            </com.ashberrysoft.leadertask.modern.view.NonSwipeableViewPager>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:gravity="top|center_horizontal"
            android:orientation="vertical">

            <Button
                android:id="@+id/btn_next"
                android:layout_width="150dp"
                android:layout_marginTop="10dp"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:background="@drawable/selector_bg_btn_orange"
                android:text="@string/intro_forward"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_aboutX"
                android:textAllCaps="false"
                style="?android:attr/borderlessButtonStyle" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp">

                <com.astuetz.PagerSlidingTabStrip
                    android:id="@+id/tabs_intro"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:background="@color/sliding_menu_background"
                    app:pstsTabTextSize ="@dimen/text_size_large"
                    app:pstsIndicatorHeight="4sp"
                    app:pstsTabTextColor="@color/intro_page_no_opened_color"
                    app:pstsIndicatorColor="@color/intro_page_opened_color"/>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center">

                    <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:layout_toLeftOf="@+id/linearLayout3"
                        android:layout_marginRight="4dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="4dp"
                        android:layout_alignParentLeft="true"
                        android:layout_alignParentStart="true">

                    </RelativeLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:id="@+id/linearLayout3"
                        android:layout_centerHorizontal="true"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/text1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="28dp"
                            android:text="&#8226;"
                            android:textColor="@color/intro_page_no_opened_color"/>

                        <TextView
                            android:id="@+id/text2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="28dp"
                            android:text="&#8226;"
                            android:textColor="@color/intro_page_no_opened_color"/>

                        <TextView
                            android:id="@+id/text3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="28dp"
                            android:text="&#8226;"
                            android:textColor="@color/intro_page_no_opened_color"/>

                        <TextView
                            android:id="@+id/text4"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="28dp"
                            android:text="&#8226;"
                            android:textColor="@color/intro_page_no_opened_color"/>

                        <TextView
                            android:id="@+id/text5"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="28dp"
                            android:text="&#8226;"
                            android:textColor="@color/intro_page_no_opened_color"/>

                        <TextView
                            android:id="@+id/text6"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="28dp"
                            android:text="&#8226;"
                            android:textColor="@color/intro_page_no_opened_color"/>

                        <TextView
                            android:id="@+id/text7"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="28dp"
                            android:text="&#8226;"
                            android:textColor="@color/intro_page_no_opened_color"/>

                        <TextView
                            android:id="@+id/text8"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="28dp"
                            android:text="&#8226;"
                            android:textColor="@color/intro_page_no_opened_color"/>

                    </LinearLayout>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:layout_marginRight="4dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="4dp"
                        android:layout_toRightOf="@+id/linearLayout3"
                        android:layout_toEndOf="@+id/linearLayout3">

                    </RelativeLayout>

                </RelativeLayout>

            </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </RelativeLayout>

</LinearLayout>