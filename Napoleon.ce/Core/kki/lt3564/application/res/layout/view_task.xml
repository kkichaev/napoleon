<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content" >

    <FrameLayout
        android:id="@+id/frame"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_gravity="top"
        android:focusable="false"
        android:focusableInTouchMode="false" >

        <ImageView
            android:id="@+id/img_status"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingBottom="10dp"
            android:paddingLeft="5dp"
            android:paddingRight="5dp"
            android:paddingTop="10dp" />
    </FrameLayout>

    <RelativeLayout
        android:id="@+id/relative"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:orientation="vertical" >

        <!-- android:layout_toRightOf="@+id/frame" -->

        <TextView
            android:id="@+id/text_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="18sp" />

        <com.ashberrysoft.leadertask.views.PredicateLayout
            android:id="@+id/predicate"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/text_name" >

            <LinearLayout
                android:id="@+id/user"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical" >

                <ImageView
                    android:id="@+id/img_user"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
                <!-- android:layout_marginRight="5dp" -->

                <TextView
                    android:id="@+id/text_user"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="middle"
                    android:paddingBottom="4dp"
                    android:singleLine="true" />
                <!-- android:layout_marginRight="5dp" -->
            </LinearLayout>

            <LinearLayout
                android:id="@+id/term_client"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical" >

                <ImageView
                    android:id="@+id/img_term_client"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/term_red_small" />
                <!-- android:layout_marginRight="5dp" -->

                <TextView
                    android:id="@+id/text_term_client"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
                <!-- android:layout_marginRight="5dp" -->
            </LinearLayout>

            <LinearLayout
                android:id="@+id/term"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical" >

                <ImageView
                    android:id="@+id/img_term"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
                <!-- android:layout_marginRight="5dp" -->

                <TextView
                    android:id="@+id/text_term"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <ImageView
                android:id="@+id/attached_files"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingTop="2dp"
                android:src="@drawable/attached_files" />
            <!-- android:paddingLeft="5dp" -->
            <!-- android:paddingRight="0dp" -->

            <LinearLayout
                android:id="@+id/comments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical" >

                <ImageView
                    android:id="@+id/img_comments_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
                <!-- android:layout_marginLeft="5dp" -->

                <ImageView
                    android:id="@+id/img_comments"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
                <!-- android:layout_marginLeft="5dp" -->

                <TextView
                    android:id="@+id/text_comments"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </com.ashberrysoft.leadertask.views.PredicateLayout>

        <com.ashberrysoft.leadertask.views.PredicateLayout
            android:id="@+id/label"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/predicate"
            android:layout_marginTop="2dp" >
        </com.ashberrysoft.leadertask.views.PredicateLayout>
    </RelativeLayout>

</RelativeLayout>