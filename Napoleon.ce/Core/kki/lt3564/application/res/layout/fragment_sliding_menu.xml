<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white" >

    <ScrollView
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:scrollbars="none"
        android:divider="@null">

        <LinearLayout
            android:id="@+id/main"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <ListView
                android:id="@+id/slm_list_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:cacheColorHint="@android:color/transparent"
                android:scrollbars="none"
                android:divider="@null"
                android:visibility="visible"
                android:layout_weight="1"/>

            <ListView
                android:id="@+id/slm_list_view1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:cacheColorHint="@android:color/transparent"
                android:scrollbars="none"
                android:divider="@null"
                android:visibility="visible" />

            <ListView
                android:id="@+id/slm_list_view2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:cacheColorHint="@android:color/transparent"
                android:scrollbars="none"
                android:divider="@null"
                android:visibility="visible" />

            <ListView
                android:id="@+id/slm_list_view3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:cacheColorHint="@android:color/transparent"
                android:scrollbars="none"
                android:divider="@null"
                android:visibility="visible" />

            <ListView
                android:id="@+id/slm_list_view4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:cacheColorHint="@android:color/transparent"
                android:scrollbars="none"
                android:divider="@null"
                android:visibility="visible" />

            <ListView
                android:id="@+id/slm_list_view5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:cacheColorHint="@android:color/transparent"
                android:scrollbars="none"
                android:divider="@null"
                android:visibility="visible" />

            <ListView
                android:id="@+id/slm_list_view6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:cacheColorHint="@android:color/transparent"
                android:scrollbars="none"
                android:divider="@null"
                android:visibility="visible" />

            <ListView
                android:id="@+id/slm_list_view7"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:cacheColorHint="@android:color/transparent"
                android:scrollbars="none"
                android:divider="@null"
                android:visibility="visible" />



        </LinearLayout>

    </ScrollView>

</RelativeLayout>