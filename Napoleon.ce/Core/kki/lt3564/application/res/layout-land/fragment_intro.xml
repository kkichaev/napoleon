                    android:textColor="@color/intro_text_color"
                    android:hint="@string/reg_name"
                    android:layout_marginLeft="@dimen/univ_padding_norm"
                    android:layout_marginRight="@dimen/univ_padding_norm"
                    android:layout_marginBottom="@dimen/univ_padding"
