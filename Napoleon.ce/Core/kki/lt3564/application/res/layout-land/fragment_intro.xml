                    android:text="@string/preview_slide6_text"
                    android:textColor="@color/intro_text_color"
                    android:layout_marginLeft="@dimen/univ_padding_norm"
                    android:layout_marginRight="@dimen/univ_padding_norm"
                    android:layout_marginBottom="20dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="40dp"
                    android:layout_marginLeft="@dimen/univ_padding_norm"
                    android:layout_marginRight="@dimen/univ_padding_norm"
                    android:layout_marginBottom="@dimen/univ_padding_small">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:background="@color/intro_subtext_color">

                        <ImageView
                            android:layout_width="45dp"
                            android:layout_height="45dp"
                            android:src="@drawable/calendar_preview"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:text="@string/preview_slide6_everyday"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:textSize="14dp"
                            android:paddingRight="@dimen/univ_padding_small"
                            android:textColor="@color/white"/>

                    </LinearLayout>

                    <EditText
                        android:id="@+id/container6edittext"
                        android:layout_width="match_parent"
                        android:layout_height="45dp"
                        android:textSize="14dp"
                        android:inputType="textCapSentences"
                        android:paddingLeft="@dimen/univ_padding_small"
                        android:textColor="@color/intro_text_color"
                        android:hint="@string/error_empty_task_title"
                        android:background="@color/white"/>

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/container7"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone"
                android:layout_marginBottom="@dimen/univ_padding">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:textSize="28dp"
                    android:fontFamily="sans-serif"
                    android:text="@string/preview_slide7_text"
                    android:textColor="@color/intro_text_color"
                    android:layout_marginLeft="@dimen/univ_padding_norm"
                    android:layout_marginRight="@dimen/univ_padding_norm"
                    android:layout_marginBottom="20dp"/>


            </LinearLayout>

        </RelativeLayout>

    </ScrollView>

</RelativeLayout>