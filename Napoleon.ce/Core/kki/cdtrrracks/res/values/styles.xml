<resources xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Base application theme, dependent on API level. This theme is replaced
        by AppBaseTheme from res/values-vXX/styles.xml on newer devices.
    -->
    <style name="AppBaseTheme" parent="android:Theme.Light">
        <!--
            Theme customizations available in newer API levels can go in
            res/values-vXX/styles.xml, while customizations related to
            backward-compatibility can go here.
        -->
    </style>

    <!-- Application theme. -->
    <style name="AppTheme" parent="AppBaseTheme">
       <item name="android:windowNoTitle">true</item>
    </style>
    
    <style name="Menustreak">
        <item name="android:layout_height">4dp</item>
        <item name="android:layout_width">match_parent</item>
    </style>
    
    <style name="HostTab" parent="@android:style/Widget.TextView">
        <item name="android:textSize">22sp</item>
        <!--  <item name="android:textStyle">bold</item> -->
    </style>

    <style name="GridItem" parent="@android:style/Widget.TextView">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/blue</item>
    </style>    
    
    <style name="AlbumArtist" parent="@android:style/Widget.TextView">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/black</item>
    </style> 
    
    <style name="AlbumName" parent="@android:style/Widget.TextView">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/black</item>
    </style> 
    
    <style name="AlbumYear" parent="@android:style/Widget.TextView">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/black</item>
    </style>
    
    <style name="AlbumRating" parent="@android:style/Widget.TextView">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/black</item>
    </style>
</resources>
