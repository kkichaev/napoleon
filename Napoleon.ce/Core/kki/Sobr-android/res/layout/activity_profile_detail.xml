<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_holo_light"
    android:orientation="vertical" >

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/padding_16" >

            <TextView
                android:id="@+id/profile_name_title"
                style="@style/TextViewTitleProfile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:text="@string/profile_name" />

            <EditText
                android:id="@+id/profile_name_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_top_2"
                android:hint="@string/profile_name_hint"
                android:inputType="text|textCapWords"
                android:singleLine="true"
                android:textAppearance="?android:attr/textAppearanceMedium"
                    />

            <TextView
                android:id="@+id/profile_systemtype_title"
                style="@style/TextViewTitleProfile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/profile_systemtype_title" />

            <Spinner
                android:id="@+id/profile_systemtype_spinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:entries="@array/entries_system_type"
                android:prompt="@string/profile_systemtype_title" />

            <TextView
                android:id="@+id/profile_phone_number_title"
                style="@style/TextViewTitleProfile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/profile_phone_number" />

            <EditText
                android:id="@+id/profile_phone_number_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_top_2"
                android:hint="@string/profile_phone_number_hint"
                android:inputType="phone"
                android:singleLine="true"
                android:textAppearance="?android:attr/textAppearanceMedium" />

            <TextView
                android:id="@+id/profile_password_title"
                style="@style/TextViewTitleProfile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/profile_password" />

            <EditText
                android:id="@+id/profile_password_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_top_2"
                android:hint="@string/profile_password_hint"
                android:inputType="number"
                android:maxLength="5"
                android:password="true"
                android:singleLine="true"
                android:textAppearance="?android:attr/textAppearanceMedium" />

            <CheckBox
                android:id="@+id/profile_password_show_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/profile_show_pass_hint" />

            <Button
                android:id="@+id/profile_change_password_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_top_2"
                android:text="@string/profile_change_password" />

            <TextView
                style="@style/TextViewTitleProfile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/profile_get_settings_info" />

            <Button
                android:id="@+id/profile_get_settings_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_top_2"
                android:text="@string/profile_get_settings_info_button" />

            <TextView
                    android:id="@+id/sobr_assist_title"
                    style="@style/TextViewTitleProfile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/sobr_assist_title" />

            <TextView
                    android:id="@+id/sobr_assist_small_text"
                    style="@style/TextViewSmall"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:text="@string/sobr_assist_small" />

            <TextView
                    android:id="@+id/sobr_assist_registration"
                    style="@style/TextViewSmall"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:text="@string/sobr_assist_registration_link" />

            <EditText
                    android:id="@+id/sobr_assist_login"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_top_2"
                    android:hint="@string/sobr_assist_login_hint"
                    android:inputType="text"
                    android:singleLine="true"
                    android:textAppearance="?android:attr/textAppearanceMedium" />

            <EditText
                    android:id="@+id/sobr_assist_password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_top_2"
                    android:hint="@string/sobr_assist_password_hint"
                    android:inputType="text"
                    android:singleLine="true"
                    android:password="true"
                    android:textAppearance="?android:attr/textAppearanceMedium" />

            <CheckBox
                    android:id="@+id/sobr_assist_show_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_show_pass_hint" />


            <TextView
                android:id="@+id/profile_unlock_code_title"
                style="@style/TextViewTitleProfile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/profile_unlock_code" />

            <LinearLayout
                android:id="@+id/profile_unlock_code_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" >

                <EditText
                    android:id="@+id/profile_unlock_code_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_top_2"
                    android:layout_weight="1"
                    android:hint="@string/profile_unlock_code_hint"
                    android:inputType="number"
                    android:maxLength="3"
                    android:password="true"
                    android:singleLine="true"
                    android:textAppearance="?android:attr/textAppearanceMedium" />

                <Button
                    android:id="@+id/profile_unlock_code_btn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Отправить" />
            </LinearLayout>

            <CheckBox
                android:id="@+id/profile_unlock_code_show_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/profile_show_pass_hint" />

            <TextView
                android:id="@+id/profile_pin_code_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/TextViewTitleProfile"
                android:text="@string/profile_pin_code" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content" >

                <EditText
                    android:id="@+id/profile_pin_code_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_top_2"
                    android:layout_weight="1"
                    android:hint="@string/profile_pin_code_hint"
                    android:inputType="number"
                    android:maxLength="4"
                    android:password="true"
                    android:singleLine="true"
                    android:textAppearance="?android:attr/textAppearanceMedium" />

                <Button
                    android:id="@+id/profile_pin_code_btn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Отправить" />
            </LinearLayout>

            <CheckBox
                android:id="@+id/profile_pin_code_show_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/profile_show_pass_hint" />

            <CheckBox
                android:id="@+id/profile_pin_code_on_start"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/profile_pin_code_on_start_hint" />
            
            <TextView
                android:id="@+id/tvPhoneStatusTitle"
                style="@style/TextViewTitleProfile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/profile_user_phone_status_title" />

            <Spinner
                android:id="@+id/phone_status_spinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:entries="@array/entries_phone_status"
                android:prompt="@string/profile_user_phone_status_title" />

            <TextView
                android:id="@+id/profile_base_phone_number_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/TextViewTitleProfile"
                android:text="@string/profile_base_phone_number" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content" >

                <EditText
                    android:id="@+id/profile_base_phone_number_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_top_2"
                    android:layout_weight="1"
                    android:hint="@string/profile_base_phone_number_hint"
                    android:inputType="phone"
                    android:maxLength="15"
                    android:singleLine="true"
                    android:textAppearance="?android:attr/textAppearanceMedium" />

                <Button
                    android:id="@+id/profile_base_phone_number_btn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Отправить" />
            </LinearLayout>

            <TextView
                android:id="@+id/profile_second_phone_number_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/TextViewTitleProfile"
                android:text="@string/profile_second_phone_number" />

            <LinearLayout
                android:id="@+id/profile_second_phone_number_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" >

                <EditText
                    android:id="@+id/profile_second_phone_number_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_top_2"
                    android:layout_weight="1"
                    android:hint="@string/profile_second_phone_number_hint"
                    android:inputType="phone"
                    android:maxLength="15"
                    android:singleLine="true"
                    android:textAppearance="?android:attr/textAppearanceMedium" />

                <Button
                    android:id="@+id/profile_second_phone_number_btn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Отправить" />
            </LinearLayout>

            <TextView
                android:id="@+id/profile_third_phone_number_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/TextViewTitleProfile"
                android:text="@string/profile_third_phone_number" />

            <LinearLayout
                android:id="@+id/profile_third_phone_number_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" >

                <EditText
                    android:id="@+id/profile_third_phone_number_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_top_2"
                    android:layout_weight="1"
                    android:hint="@string/profile_third_phone_number_hint"
                    android:inputType="phone"
                    android:maxLength="15"
                    android:singleLine="true"
                    android:textAppearance="?android:attr/textAppearanceMedium" />

                <Button
                    android:id="@+id/profile_third_phone_number_btn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Отправить" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/TextViewTitleProfile"
                android:text="@string/profile_max_balance" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content" >

                <EditText
                    android:id="@+id/profile_max_balance_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_top_2"
                    android:layout_weight="1"
                    android:hint="@string/profile_max_balance_hint"
                    android:inputType="phone"
                    android:maxLength="10"
                    android:singleLine="true"
                    android:textAppearance="?android:attr/textAppearanceMedium" />

                <Button
                    android:id="@+id/profile_max_balance_btn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Отправить" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/TextViewTitleProfile"
                android:text="@string/profile_get_balance_code" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content" >

                <EditText
                    android:id="@+id/profile_balance_query_code_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_top_2"
                    android:layout_weight="1"
                    android:hint="@string/profile_get_balance_code_hint"
                    android:inputType="phone"
                    android:maxLength="10"
                    android:singleLine="true"
                    android:textAppearance="?android:attr/textAppearanceMedium" />

                <Button
                    android:id="@+id/profile_balance_query_code_btn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Отправить" />
            </LinearLayout>

