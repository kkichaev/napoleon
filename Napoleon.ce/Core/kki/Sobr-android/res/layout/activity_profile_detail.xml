            <Button
                android:id="@+id/profile_detail_custom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_top_2"
                android:layout_marginTop="@dimen/margin_top_3"
                android:text="@string/profile_user_settings_button" />
        </LinearLayout>
    </ScrollView>

</LinearLayout>