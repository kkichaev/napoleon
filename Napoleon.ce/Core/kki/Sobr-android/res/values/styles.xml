<resources xmlns:android="http://schemas.android.com/apk/res/android">

    <style name="AppTheme" parent="android:Theme.Holo.Light" />

    <style name="Theme.SobrTheme_Light_NO_TITLEBAR" parent="Theme.Sherlock.Light.DarkActionBar">
        <item name="windowActionBar">false</item>
        <item name="title">Sobr</item>
    </style>

    <style name="Theme.SobrTheme_Light" parent="Theme.Sherlock.Light.DarkActionBar">
        <item name="title">Sobr</item>
        <item name="android:listViewStyle">@style/ListViewStyle</item>
        <item name="android:buttonStyle">@style/ButtonHoloLight</item>
        <item name="android:editTextStyle">@style/EditTextHoloLight</item>
        <item name="android:checkboxStyle">@style/CheckBoxHoloLight</item>
        <item name="android:spinnerStyle">@style/SpinnerLight</item>
        <item name="android:windowBackground">@drawable/background_gary_holo_light</item>
    </style>

    <style name="TextViewTitle">
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:layout_marginLeft">4dp</item>
        <item name="android:textColor">#000000</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAppearance">?android:attr/textAppearanceMedium</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="TextViewTitleProfile" parent="TextViewTitle">
        <item name="android:layout_marginTop">25dp</item>
    </style>
    
    <style name="TextViewTitlePrompt" parent="TextViewTitle">
        <item name="android:layout_marginTop">25dp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:singleLine">false</item>
    </style>
    
    <style name="TextViewSmall">
        <item name="android:layout_marginLeft">4dp</item>
        <item name="android:textColor">#777777</item>
        <item name="android:textAppearance">?android:attr/textAppearanceSmall</item>
    </style>

    <style name="ButtonHoloLight" parent="android:style/Widget.Button">
        <item name="android:background">@drawable/btn_default_holo_light</item>
        <item name="android:textColor">#000000</item>
        <item name="android:textAppearance">?android:attr/textAppearanceMedium</item>
        <item name="android:singleLine">true</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <style name="EditTextHoloLight" parent="android:style/Widget.EditText">
        <item name="android:background">@drawable/edit_text_holo_light</item>
        <item name="android:textColor">#000000</item>
    </style>

    <style name="SpinnerLight" parent="android:Widget.Spinner">
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:background">@drawable/spinner_background_holo_light</item>
        <item name="android:dropDownSelector">@drawable/list_selector_holo_light</item>
        <item name="android:popupBackground">@drawable/menu_dropdown_panel_holo_light</item>
        <item name="android:dropDownVerticalOffset">0dip</item>
        <item name="android:dropDownHorizontalOffset">0dip</item>
        <item name="android:dropDownWidth">wrap_content</item>
        <item name="android:gravity">left|center_vertical</item>
    </style>

    <style name="CheckBoxHoloLight" parent="android:style/Widget.CompoundButton.CheckBox">
        <item name="android:button">@drawable/btn_checkbox_holo_light</item>
        <item name="android:textColor">#000000</item>
    </style>

    <style name="AlertDialogHoloLight">
        <item name="android:fullDark">@drawable/dialog_full_holo_light</item>
        <item name="android:topDark">@drawable/dialog_top_holo_light</item>
        <item name="android:centerDark">@drawable/dialog_middle_holo_light</item>
        <item name="android:bottomDark">@drawable/dialog_bottom_holo_light</item>
        <item name="android:fullBright">@drawable/dialog_full_holo_light</item>
        <item name="android:centerBright">@drawable/dialog_middle_holo_light</item>
        <item name="android:bottomBright">@drawable/dialog_bottom_holo_light</item>
        <item name="android:bottomMedium">@drawable/dialog_bottom_holo_light</item>
        <item name="android:centerMedium">@drawable/dialog_middle_holo_light</item>
    </style>
    
    <style name="DialogHoloLight" parent="android:style/Theme.Dialog">
		<item name="android:windowBackground">@drawable/dialog_full_holo_light</item>
	</style>
	
    <style name="ListViewStyle" parent="android:Widget.ListView">
		<item name="android:cacheColorHint">@android:color/transparent</item>
		<item name="android:listSelector">@drawable/list_selector_holo_light</item>
		
	</style>

</resources>