<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/common_bkg"
    android:orientation="vertical"
    android:paddingLeft="5dp"
    android:paddingRight="5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingLeft="5dp"
        android:paddingRight="5dp">

        <TextView
            android:id="@+id/tvRadInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="right"
            android:text="@string/rad"
            android:textColor="@color/angles"
            android:textSize="22sp" />
    </LinearLayout>

    <EditText
        android:id="@+id/input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="5dp"
        android:layout_marginRight="5dp"
        android:background="@null"
        android:minLines="2"
        android:textSize="@dimen/input_txt_sz" />

    <TextView
        android:id="@+id/tvRes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="right"
        android:minLines="1"
        android:textColor="@android:color/black"
        android:textSize="@dimen/result_txt_sz" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@android:color/black" />

    <TextView
        android:id="@+id/tvDegree"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:gravity="right"
        android:minLines="1"
        android:textColor="@color/angles"
        android:textSize="@dimen/result_txt_sz" />

    <TextView
        android:id="@+id/tvRadRes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="right"
        android:minLines="1"
        android:textColor="@color/saddlebrown"
        android:textSize="@dimen/result_txt_sz" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@android:color/black" />

    <TableLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:paddingBottom="10dp">

        <TableRow
            android:gravity="center_vertical"
            android:paddingTop="7dp">

            <TextView
                android:id="@+id/tv1"
                style="@style/NumberButton"
                android:layout_width="@dimen/btn_sz"
                android:layout_height="@dimen/btn_sz"
                android:background="@drawable/button_bkg"
                android:gravity="center"
                android:tag="1"
                android:text="1" />

            <TextView
                android:id="@+id/tv2"
                style="@style/NumberButton"
                android:layout_width="@dimen/btn_sz"
                android:layout_height="@dimen/btn_sz"
                android:background="@drawable/button_bkg"
                android:gravity="center"
                android:tag="2"
                android:text="2" />

            <TextView
                android:id="@+id/tv3"
                style="@style/NumberButton"
                android:layout_width="@dimen/btn_sz"
                android:layout_height="@dimen/btn_sz"
                android:background="@drawable/button_bkg"
                android:gravity="center"
                android:tag="3"
                android:text="3" />

            <TextView
                android:id="@+id/tvPlus"
                style="@style/OperButton"
                android:layout_width="@dimen/btn_sz"
                android:layout_height="@dimen/btn_sz"
                android:background="@drawable/button_bkg"
                android:gravity="center"
                android:tag="+"
                android:text="+" />

            <TextView
                android:id="@+id/tvC"
                style="@style/RemButton"
                android:layout_width="@dimen/btn_sz"
                android:layout_height="@dimen/btn_sz"
                android:background="@drawable/button_bkg"
                android:gravity="center"
                android:tag="c"
                android:text="C" />

            <TextView
                android:id="@+id/tvDMS"
                style="@style/AngleButton"
                android:layout_width="@dimen/btn_sz"
                android:layout_height="@dimen/btn_sz"
                android:background="@drawable/button_bkg"
                android:gravity="center"
                android:tag="dms"
                android:text="@string/dmstitle"
                android:textSize="14sp"/>

            <TextView
                android:id="@+id/tvRad"
                style="@style/AngleButton"
                android:layout_width="@dimen/btn_sz"
                android:layout_height="@dimen/btn_sz"
                android:background="@drawable/button_bkg"
                android:gravity="center"
                android:tag=""
                android:text="@string/deg" />
        </TableRow>

        <TableRow
            android:gravity="center_vertical"
            android:paddingTop="7dp">

            <TextView
                android:id="@+id/tv4"
                style="@style/NumberButton"
                android:layout_width="@dimen/btn_sz"
                android:layout_height="@dimen/btn_sz"
                android:background="@drawable/button_bkg"
                android:gravity="center"
                android:tag="4"
                android:text="4" />

            <TextView
                android:id="@+id/tv5"
                style="@style/NumberButton"
                android:layout_width="@dimen/btn_sz"
                android:layout_height="@dimen/btn_sz"
                android:background="@drawable/button_bkg"
                android:gravity="center"
                android:tag="5"
                android:text="5" />

            <TextView
                android:id="@+id/tv6"
                style="@style/NumberButton"
                android:layout_width="@dimen/btn_sz"
                android:layout_height="@dimen/btn_sz"
                android:background="@drawable/button_bkg"
                android:gravity="center"
                android:tag="6"
                android:text="6" />

            <TextView
                android:id="@+id/tvMinus"
                style="@style/OperButton"
                android:layout_width="@dimen/btn_sz"
                android:layout_height="@dimen/btn_sz"
                android:background="@drawable/button_bkg"
                android:gravity="center"
                android:tag="-"
                android:text="-" />

            <TextView
                android:id="@+id/tvRem"
                style="@style/RemButton"
                android:layout_width="@dimen/btn_sz"
                android:layout_height="@dimen/btn_sz"
                android:background="@drawable/button_bkg"
                android:gravity="center"
                android:tag="+"
                android:text="DEL" />

            <com.ksoft.dms.StateButton
                android:id="@+id/tvSin"
                style="@style/AngleStateButton"
                android:layout_width="@dimen/btn_sz"
                android:layout_height="@dimen/btn_sz"
                app:mainTag="sin("
                app:mainText="@string/sin_title"
                app:topTag="asin("
                app:topText="@string/asin_title" />

            <com.ksoft.dms.StateButton
                android:id="@+id/tvCos"
                style="@style/AngleStateButton"
                android:layout_width="@dimen/btn_sz"
                android:layout_height="@dimen/btn_sz"
                app:mainTag="cos("
                app:mainText="@string/cos_title"
                app:topTag="acos("
                app:topText="@string/acos_title" />
        </TableRow>

        <TableRow
            android:gravity="center_vertical"
            android:paddingTop="7dp">

            <TextView
                android:id="@+id/tv7"
                style="@style/NumberButton"
                android:layout_width="@dimen/btn_sz"
                android:layout_height="@dimen/btn_sz"
                android:background="@drawable/button_bkg"
                android:gravity="center"
                android:tag="7"
                android:text="7" />

            <TextView
                android:id="@+id/tv8"
                style="@style/NumberButton"
                android:layout_width="@dimen/btn_sz"
                android:layout_height="@dimen/btn_sz"
                android:background="@drawable/button_bkg"
                android:gravity="center"
                android:tag="8"
                android:text="8" />

            <TextView
                android:id="@+id/tv9"
                style="@style/NumberButton"
                android:layout_width="@dimen/btn_sz"
                android:layout_height="@dimen/btn_sz"
                android:background="@drawable/button_bkg"
                android:gravity="center"
                android:tag="9"
                android:text="9" />

            <TextView
                android:id="@+id/tvMul"
                style="@style/OperButton"
                android:layout_width="@dimen/btn_sz"
                android:layout_height="@dimen/btn_sz"
                android:background="@drawable/button_bkg"
                android:gravity="center"
                android:tag="*"
                android:text="*" />

            <com.ksoft.dms.RichButton
                android:id="@+id/tvMr"
                style="@style/RemRichButton"
                android:layout_width="@dimen/btn_sz"
                android:layout_height="@dimen/btn_sz"
                android:background="@drawable/button_bkg"
                android:gravity="center"
                android:tag="mr"
                app:mainTag="mr"
                app:mainText="="
                app:topText="@string/number"
                app:topTextSize = "12sp"/>

            <com.ksoft.dms.StateButton
                android:id="@+id/tvTan"
                style="@style/AngleStateButton"
                android:layout_width="@dimen/btn_sz"
                android:layout_height="@dimen/btn_sz"
                app:mainTag="tan("
                app:mainText="@string/tan_title"
                app:topTag="atan("
                app:topText="@string/atan_title" />

            <TextView
                android:id="@+id/tvResult"
                style="@style/ResultButton"
                android:layout_width="@dimen/btn_sz"
                android:layout_height="@dimen/btn_sz"
                android:background="@drawable/button_bkg"
                android:gravity="center"
                android:text="ОК" />
        </TableRow>

        <TableRow
            android:gravity="center_vertical"
            android:paddingTop="7dp">

            <TextView
                android:id="@+id/tv0"
                style="@style/NumberButton"
                android:layout_width="@dimen/btn_sz"
                android:layout_height="@dimen/btn_sz"
                android:background="@drawable/button_bkg"
                android:gravity="center"
                android:tag="0"
                android:text="0" />

            <TextView
                android:id="@+id/tvComma"
                style="@style/NumberButton"
                android:layout_width="@dimen/btn_sz"
                android:layout_height="@dimen/btn_sz"
                android:background="@drawable/button_bkg"
                android:gravity="center"
                android:tag="."
                android:text="." />

            <TextView
                android:id="@+id/tvScope"
                style="@style/OperButton"
                android:layout_width="@dimen/btn_sz"
                android:layout_height="@dimen/btn_sz"
                android:background="@drawable/button_bkg"
                android:gravity="center"
                android:tag="-"
                android:text="( )" />

            <TextView
                android:id="@+id/tvDiv"
                style="@style/OperButton"
                android:layout_width="@dimen/btn_sz"
                android:layout_height="@dimen/btn_sz"
                android:background="@drawable/button_bkg"
                android:gravity="center"
                android:tag="/"
                android:text="/" />

            <com.ksoft.dms.RichButton
                android:id="@+id/tvMrd"
                style="@style/RemRichButton"
                android:layout_width="@dimen/btn_sz"
                android:layout_height="@dimen/btn_sz"
                android:background="@drawable/button_bkg"
                android:gravity="center"
                android:tag="mrd"
                android:text="MRD"
                app:mainText="="
                app:topText="@string/dmstitle1"
                app:topTextSize = "22sp"/>

            <TextView
                android:id="@+id/tvPow"
                style="@style/NumberButton"
                android:layout_width="@dimen/btn_sz"
                android:layout_height="@dimen/btn_sz"
                android:background="@drawable/button_bkg"
                android:gravity="center"
                android:tag="^("
                android:text="@string/pow_title" />
        </TableRow>
    </TableLayout>
</LinearLayout>