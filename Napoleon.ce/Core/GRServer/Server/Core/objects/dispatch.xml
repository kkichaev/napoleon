<?xml version="1.0" ?>
<serverDefs xmlns="http://grsoft.ru/schemas/serverDefs.xsd">
  <objects>
    <!-- Доставка -->
    <object name="Dispatch">
      <sources>
        <source name="SQTable" type="internal" />
      </sources>

      <member name="primaryKey">"created,userid"</member>
      <memberArray name="index">"itemid"</memberArray>

      <field name="userid" type="string" execOn="Put">$user.id</field>
      <field name="date" type="timestamp"/>
      <field name="created" type="timestamp" />
      <field name="timeZone" type="number" />
      <field name="serverTimeZone" type="number" data="S_TZ" execOn="Put" feature="USE_TIMEZONE">ServerTimeZone()</field>
      <field name="sended" type="timestamp" data="S_DATE" execOn="Put">Now()</field>
      <field name="id" type="string" />
      <field name="latitude" type="number" prec="5" />
      <field name="longitude" type="number" prec="5" />
      <field name="itemid" type="string" />
      <field name="visit" type="timestamp" />

      <field name="times" type="collection">
        <data>
          <object name="DispatchTime">
            <sources>
              <source name="SQTable" type="internal" />
            </sources>

            <field name="start" type="timestamp"/>
            <field name="finish" type="timestamp"/>
          </object>
        </data>
      </field>

      <field name="items" type="collection">
        <data>
          <object name="DispatchItem">
            <sources>
              <source name="SQTable" type="internal" />
            </sources>

            <field name="number" type="string"/>
            <field name="state" type="number"/>
            <field name="remark" type="string"/>
            <field name="cause" type="string"/>
            <field name="date" type="timestamp"/>
            <field name="itemid" type="string"/>
            <field name="type" type="string"/>
          </object>
        </data>
      </field>

      <events>
        <event type="put">
          <action name="WriteToLog">$object.type;$object.date</action>
        </event>
      </events>
    </object>

    <object name="DIncass">
      <sources>
        <source name="SQTable" type="internal" />
      </sources>

      <member name="primaryKey">"created,userid"</member>

      <field name="userid" type="string" execOn="Put">$user.id</field>
      <field name="date" type="timestamp"/>
      <field name="created" type="timestamp" />
      <field name="timeZone" type="number" />
      <field name="serverTimeZone" type="number" data="S_TZ" execOn="Put" feature="USE_TIMEZONE">ServerTimeZone()</field>
      <field name="sended" type="timestamp" data="S_DATE" execOn="Put">Now()</field>
      <field name="id" type="string" />
      <field name="latitude" type="number" prec="5" />
      <field name="longitude" type="number" prec="5" />
      <field name="dispatch" type="timestamp"/>
      <field name="disprem" type="string" />
      <field name="number" type="string"/>
      <field name="sum" type="number" prec="2"/>
      <field name="params" type="number" />

      <events>
        <event type="put">
          <action name="WriteToLog">$object.type;$object.date</action>
        </event>
      </events>
    </object>

    <object name="DTask">
      <sources>
        <source name="SQTable" type="internal" />
      </sources>

      <member name="primaryKey">"created,userid"</member>

      <field name="userid" type="string" execOn="Put">$user.id</field>
      <field name="date" type="timestamp"/>
      <field name="created" type="timestamp" />
      <field name="timeZone" type="number" />
      <field name="serverTimeZone" type="number" data="S_TZ" execOn="Put" feature="USE_TIMEZONE">ServerTimeZone()</field>
      <field name="sended" type="timestamp" data="S_DATE" execOn="Put">Now()</field>
      <field name="id" type="string" />
      <field name="latitude" type="number" prec="5" />
      <field name="longitude" type="number" prec="5" />
      <field name="dispatch" type="timestamp"/>
      <field name="disprem" type="string" />
      <field name="number" type="string"/>
      <field name="remark" type="string" />
      <field name="params" type="number" />

      <events>
        <event type="put">
          <action name="WriteToLog">$object.type;$object.date</action>
        </event>
      </events>
    </object>

    <object name="DReturn">
      <sources>
        <source name="SQTable" type="internal" />
      </sources>

      <member name="primaryKey">"created,userid"</member>

      <field name="userid" type="string" execOn="Put">$user.id</field>
      <field name="date" type="timestamp"/>
      <field name="created" type="timestamp" />
      <field name="timeZone" type="number" />
      <field name="serverTimeZone" type="number" data="S_TZ" execOn="Put" feature="USE_TIMEZONE">ServerTimeZone()</field>
      <field name="sended" type="timestamp" data="S_DATE" execOn="Put">Now()</field>
      <field name="id" type="string" />
      <field name="latitude" type="number" prec="5" />
      <field name="longitude" type="number" prec="5" />
      <field name="dispatch" type="timestamp"/>
      <field name="disprem" type="string" />
      <field name="number" type="string"/>
      <field name="remark" type="string" />

      <field name="items" type="collection">
        <data>
          <object name="DReturnItem">
            <sources>
              <source name="SQTable" type="internal" />
            </sources>

            <field name="id" type="string"/>
            <field name="pos" type="number"/>
            <field name="inqty" type="number" prec="3"/>
            <field name="outqty" type="number" prec="3"/>
            <field name="cost" type="number" prec="2"/>
            <field name="remark" type="string"/>
            <field name="cause" type="string"/>
          </object>
        </data>
      </field>

      <events>
        <event type="put">
          <action name="WriteToLog">$object.type;$object.date</action>
        </event>
      </events>
    </object>

    <object name="DShipment">
      <sources>
        <source name="SQTable" type="internal" />
      </sources>

      <member name="primaryKey">"created,userid"</member>

      <field name="userid" type="string" execOn="Put">$user.id</field>
      <field name="date" type="timestamp"/>
      <field name="created" type="timestamp" />
      <field name="timeZone" type="number" />
      <field name="serverTimeZone" type="number" data="S_TZ" execOn="Put" feature="USE_TIMEZONE">ServerTimeZone()</field>
      <field name="sended" type="timestamp" data="S_DATE" execOn="Put">Now()</field>
      <field name="id" type="string" />
      <field name="latitude" type="number" prec="5" />
      <field name="longitude" type="number" prec="5" />
      <field name="dispatch" type="timestamp"/>
      <field name="disprem" type="string" />
      <field name="number" type="string"/>
      <field name="remark" type="string" />
      <field name="routeItemId" type="string" />
      <field name="params" type="number" />

      <field name="items" type="collection">
        <data>
          <object name="DReturnItem">
            <sources>
              <source name="SQTable" type="internal" />
            </sources>

            <field name="id" type="string"/>
            <field name="pos" type="number"/>
            <field name="inqty" type="number" prec="3"/>
            <field name="outqty" type="number" prec="3"/>
            <field name="cost" type="number" prec="2"/>
            <field name="remark" type="string"/>
            <field name="cause" type="string"/>
          </object>
        </data>
      </field>

      <events>
        <event type="put">
          <action name="WriteToLog">$object.type;$object.date</action>
        </event>
      </events>
    </object>

    <object name="Route">
      <sources>
        <source name="SQTable" type="internal" >
          <param name="readFilter">'finish &gt;= ToDate("' + FormatDate(AdjustDate(Now(), -3, "day"),"DD.MM.YYYY") + '") and userid=' + "'"+$user.id+"'"</param>
        </source>
      </sources>

      <member name="primaryKey">"id"</member>

      <field name="id" type="string"/>
      <field name="created" type="timestamp"/>
      <field name="userid" type="string"/>
      <field name="start" type="timestamp"/>
      <field name="finish" type="timestamp"/>
    </object>

    <object name="RouteItem">
      <sources>
        <source name="SQTable" type="internal" >
          <param name="readFilter">'route in (select id from route where finish &gt;= ToDate("' + FormatDate(AdjustDate(Now(), -3, "day"),"DD.MM.YYYY") + '") and userid=' + "'"+$user.id+"')"</param>
        </source>
      </sources>

      <member name="primaryKey">"itemid"</member>

      <field name="route" type="string"/>
      <field name="itemid" type="string"/>
      <field name="id" type="string"/>
      <field name="pos" type="number"/>
      <field name="remark" type="string"/>

      <field name="docs" type="collection">
        <data>
          <object name="ItemDef">
            <sources>
              <source name="SQTable" type="internal" />
            </sources>

            <field name="id" type="string"/>
            <field name="number" type="string"/>
            <field name="pos" type="number"/>
            <field name="remark" type="string"/>
            <field name="type" type="string"/>
            <field name="title" type="string"/>
          </object>
        </data>
      </field>
    </object>

    <object name="Waybill">
      <sources>
        <source name="SQTable" type="internal" >
          <param name="readFilter">
            ' number in ( '+
            'select d.number from Route as r '+
            'left join RouteItem as ri on r.id = ri.route '+
            'left join RouteItem$docs as d on ri.itemid = d.RouteItem$itemid '+
            'where r.start &lt;= ToDate("' + FormatDate(AdjustDate(Now(),1,"day"),"DD.MM.YYYY") +  '") and ' +
            'r.finish &gt;= ToDate("' + FormatDate(Now(),"DD.MM.YYYY") + '") and r.userid=' + "'"+$user.id+"')"
          </param>
          <param name="debug" />
        </source>
      </sources>

      <member name="primaryKey">"number"</member>

      <field name="items" type="collection">
        <data>
          <object name="DocRequestItem">
            <sources>
              <source name="SQTable" type="internal" />
            </sources>

            <field name="id" type="string" data="ID_I"/>
            <field name="qty" type="number" prec="3" />
            <field name="cost" type="number" prec="2" />
            <field name="pos" type="number" />
          </object>
        </data>
      </field>

      <field name="id" type="string" />
      <field name="sumD" type="number" prec="2" />
      <field name="number" type="string" data="NUM" />
      <field name="date" type="date" />
      <field name="payDate" type="date" />
      <field name="created" type="timestamp" />
      <field name="userid" type="string" />
    </object>

    <modify src="Org" dest="RoutePoint">
      <change>
        <sources>
          <source name="SQTable" type="internal" >
            <param name="readFilter">
              'id in (select id from Routeitem as i where i.route in( select id from Route where finish &gt;= ToDate("' +
              FormatDate(AdjustDate(Now(), -3, "day"),"DD.MM.YYYY") + '") and userid=' + "'"+$user.id+"'))"
            </param>
          </source>
        </sources>
      </change>
    </modify>

    <modify src="RoutePoint$contacts" >
      <change>
        <sources>
          <source name="SQTable" type="internal" />
        </sources>
      </change>
    </modify>

    <modify src="Price" dest="DPrice">
      <change>
        <sources>
          <source name="SQLQuery">
            <param name="stmt">
              'select p.id, p.name from Price as p where id in ( '+
              'select distinct(i.id) from Route as r ' +
              'left join RouteItem as ri on r.id = ri.route '+
              'left join RouteItem$docs as d on ri.itemid = d.RouteItem$itemid '+
              'left join waybill as w on d.number = w.number '+
              'left join Waybill$items as i on w.number  = i.Waybill$number ' +
              'where r.start &lt;= ToDate("' + FormatDate(AdjustDate(Now(),2,"day"),"DD.MM.YYYY") +  '") and ' +
              'r.finish &gt;= ToDate("' + FormatDate(AdjustDate(Now(), -3, "day"),"DD.MM.YYYY") + '") and r.userid=' + "'"+$user.id+"')"
            </param>
          </source>
        </sources>
      </change>
    </modify>

    <modify src="Visit">
      <add>
        <field name="routeItemId" type="string" />
      </add>
    </modify>

    <!-- Доставка end !-->
  </objects>
</serverDefs>
