	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="grserver" />
		<Option pch_mode="2" />
		<Option compiler="gcc" />
		<Build>
			<Target title="Debug">
				<Option output="../Build/bin/Debug/grserver" prefix_auto="1" extension_auto="1" />
