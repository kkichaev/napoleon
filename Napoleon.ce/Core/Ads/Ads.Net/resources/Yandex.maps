!beginmap order_map
<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN""http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml"> 
<head><meta http-equiv="Content-Type" content="text/html; charset=utf-8" /> 
<script src="http://api-maps.yandex.ru/1.1/index.xml?key=ANzXmEoBAAAAkjQFPwIAQphddQGLBfkqE3qCI3Vo8OCM8yYAAAAAAAAAAACYpxbA0OaEdJRuAHC50onaXfYLBQ==&" type="text/javascript"></script> 
<script type="text/javascript"> 
YMaps.jQuery(function () { 
var map = new YMaps.Map(YMaps.jQuery("#YMapsID")[0]); 
map.addControl(new YMaps.TypeControl()); 
map.addControl(new YMaps.ToolBar()); 
map.addControl(new YMaps.Zoom()); 
map.addControl(new YMaps.MiniMap()); 
map.addControl(new YMaps.ScaleLine()); 
var placemark; 
var point; 
var bnds = new YMaps.GeoCollectionBounds(); 

var brigadeStyle = new YMaps.Style();
brigadeStyle.iconStyle = new YMaps.IconStyle();
brigadeStyle.iconStyle.href = "http://grsoft.ru/mappic/client.png";
brigadeStyle.iconStyle.size = new YMaps.Point(26, 40);
brigadeStyle.iconStyle.offset = new YMaps.Point(-9, -29);

var clientStyle = new YMaps.Style();
clientStyle.iconStyle = new YMaps.IconStyle();
clientStyle.iconStyle.href = "http://grsoft.ru/mappic/identity.png";
clientStyle.iconStyle.size = new YMaps.Point(26, 40);
clientStyle.iconStyle.offset = new YMaps.Point(-9, -29);

/*Бригады*/
!var
point = new YMaps.GeoPoint(##longitude##, ##latitude##);
bnds.add(point);
placemark = new YMaps.Placemark(point, {style: brigadeStyle, hideIcon: false});
placemark.description="##descr##";
map.addOverlay(placemark);
!endvar

/*Клиент*/
!var
point = new YMaps.GeoPoint(##longitude##, ##latitude##);
bnds.add(point);
placemark = new YMaps.Placemark(point, {style: clientStyle, hideIcon: false});
placemark.description="##descr##";
map.addOverlay(placemark);
!endvar

/*Заявки*/
!var
point = new YMaps.GeoPoint(##longitude##, ##latitude##);
bnds.add(point);
placemark = new YMaps.Placemark(point, {style: "default###color##Point"});
placemark.setIconContent('<font color=blue><b>##name##</b></font>');
placemark.description="##descr##";
map.addOverlay(placemark);
!endvar

map.setBounds(bnds);

var zoom = map.getZoom();
if( zoom > 0 ) { map.setZoom(zoom-1); }
});
</script><style type="text/css">
 body, html { width:100%; height:100%; margin:0; padding:0; overflow:hidden;}
</style>
</head>
<body>
<div id="YMapsID" style="width:100%;height:100%"></div> 
</body> 
</html>
!endmap

-----------------------------------------------------------------------------------------------
!beginmap route_distination
!colorGPS=styleGPS;
!colorGSM=styleGSM;
<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN""http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml"> 
<head><meta http-equiv="Content-Type" content="text/html; charset=utf-8" /> 
<script src="http://api-maps.yandex.ru/1.1/index.xml?key=ANzXmEoBAAAAkjQFPwIAQphddQGLBfkqE3qCI3Vo8OCM8yYAAAAAAAAAAACYpxbA0OaEdJRuAHC50onaXfYLBQ==&" type="text/javascript"></script> 
<script type="text/javascript"> 
YMaps.jQuery(function () { 
var map = new YMaps.Map(YMaps.jQuery("#YMapsID")[0]); 
map.addControl(new YMaps.TypeControl()); 
map.addControl(new YMaps.ToolBar()); 
map.addControl(new YMaps.Zoom()); 
map.addControl(new YMaps.MiniMap()); 
map.addControl(new YMaps.ScaleLine()); 
var placemark; 
var point; 
var bnds = new YMaps.GeoCollectionBounds(); 

!var
point = new YMaps.GeoPoint(##longitude##, ##latitude##);
bnds.add(point);
placemark = new YMaps.Placemark(point);
placemark.setIconContent('<font color=blue><b>##name##</b></font>');placemark.description="##descr##";
map.addOverlay(placemark);
!endvar

var styleGPS = new YMaps.Style(); 
styleGPS.lineStyle = new YMaps.LineStyle(); 
styleGPS.lineStyle.strokeWidth = 4; 
styleGPS.lineStyle.strokeColor='ff0000ff'; 
var styleGSM = new YMaps.Style(); 
styleGSM.lineStyle = new YMaps.LineStyle(); 
styleGSM.lineStyle.strokeWidth = 4; 
styleGSM.lineStyle.strokeColor='b000b0ff'; 

!var
var pl##number## = new YMaps.Polyline([ 
!cont
new YMaps.GeoPoint(##longitude##, ##latitude##)
!endcont
]); 
pl##number##.setStyle(##color##); 
map.addOverlay(pl##number##); 
bnds.add(pl##number##.getPoints());
!endvar

!var
point = new YMaps.GeoPoint(##longitude##, ##latitude##);
bnds.add(point);
placemark = new YMaps.Placemark(point, {style: "default#nightSmallPoint"});
placemark.setIconContent('<font color=white><b>##name##</b></font>');
placemark.description="##descr##";
map.addOverlay(placemark);
!endvar

/*Current location*/
!var
var brigadeStyle = new YMaps.Style();
brigadeStyle.iconStyle = new YMaps.IconStyle();
brigadeStyle.iconStyle.href = "http://grsoft.ru/mappic/cur_brigade_pos.png";
brigadeStyle.iconStyle.size = new YMaps.Point(26, 40);
brigadeStyle.iconStyle.offset = new YMaps.Point(-9, -29);

point = new YMaps.GeoPoint(##longitude##, ##latitude##);
bnds.add(point);
placemark = new YMaps.Placemark(point, {style: brigadeStyle, hideIcon: false});
placemark.description="##descr##";
map.addOverlay(placemark);
!endvar

/*Distination*/
!var
var clientStyle = new YMaps.Style();
clientStyle.iconStyle = new YMaps.IconStyle();
clientStyle.iconStyle.href = "http://grsoft.ru/mappic/identity.png";
clientStyle.iconStyle.size = new YMaps.Point(26, 40);
clientStyle.iconStyle.offset = new YMaps.Point(-9, -29);

point = new YMaps.GeoPoint(##longitude##, ##latitude##);
bnds.add(point);
placemark = new YMaps.Placemark(point, {style: clientStyle, hideIcon: false});
placemark.description="##descr##";
map.addOverlay(placemark);
!endvar

map.setBounds(bnds);

var zoom = map.getZoom();
if( zoom > 0 ) { map.setZoom(zoom-1); }
});
</script><style type="text/css">
 body, html { width:100%; height:100%; margin:0; padding:0; overflow:hidden;}
</style>
</head>
<body>
<div id="YMapsID" style="width:100%;height:100%"></div> 
</body> 
</html>
!endmap

