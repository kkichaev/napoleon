    android:layout_height="fill_parent"
    android:orientation="horizontal" >

    <TextView
        android:id="@+id/tvClmn1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TextView" android:textColor="@color/black" android:layout_weight="1" android:textSize="22sp"/>

    <TextView
        android:id="@+id/tvClmn2"
        android:layout_width="wrap_content"
        android:layout_height="fill_parent"
        android:layout_gravity="right" android:textColor="@color/black" android:paddingRight="3dp" android:gravity="right|center_vertical" android:textSize="22sp"/>

</LinearLayout>