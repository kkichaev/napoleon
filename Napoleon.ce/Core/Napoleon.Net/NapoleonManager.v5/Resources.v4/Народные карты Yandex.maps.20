!name Народные карты Yandex;
-----------------------------------------------------------------------------------------------
!beginmap orgaddress
<!DOCTYPE html "-//W3C//DTD XHTML 1.0 Strict//EN"
"http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd">
<html> 
<head><meta http-equiv="Content-Type" content="text/html; charset=utf-8" /> 
<script src="http://api-maps.yandex.ru/2.0-stable/?load=package.standard,package.geoObjects&lang=ru-RU&key=ANzXmEoBAAAAkjQFPwIAQphddQGLBfkqE3qCI3Vo8OCM8yYAAAAAAAAAAACYpxbA0OaEdJRuAHC50onaXfYLBQ==&" type="text/javascript" >
</script>
<script type="text/javascript"> 
ymaps.ready(function () {
var map = new ymaps.Map("YMapsID", {center: [##latitude##, ##longitude##], zoom: 10, type:'yandex#publicMap'});
map.controls.add('zoomControl').add('miniMap').add('typeSelector').add('mapTools').add('scaleLine');

var mark = new ymaps.Placemark([##latitude##, ##longitude##], { balloonContent:"##name##" });
map.geoObjects.add(mark);
map.setBounds(map.geoObjects.getBounds());
map.setZoom(15);
});
</script><style type="text/css">
 body, html { width:100%; height:100%; margin:0; padding:0; overflow:hidden;}
</style>
</head>
<body>
<div id="YMapsID" style="width:100%;height:100%"></div> 
</body> 
</html>
!endmap
-----------------------------------------------------------------------------------------------
!beginmap route
<!DOCTYPE html "-//W3C//DTD XHTML 1.0 Strict//EN"
"http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd">
<html> 
<head><meta http-equiv="Content-Type" content="text/html; charset=utf-8" /> 
<script src="http://api-maps.yandex.ru/2.0-stable/?load=package.standard,package.geoObjects&lang=ru-RU&key=ANzXmEoBAAAAkjQFPwIAQphddQGLBfkqE3qCI3Vo8OCM8yYAAAAAAAAAAACYpxbA0OaEdJRuAHC50onaXfYLBQ==&" type="text/javascript" >
</script>
<script type="text/javascript"> 
ymaps.ready(function () {
var map = new ymaps.Map("YMapsID", {center: [57.6123, 39.8296], zoom: 10, type:'yandex#publicMap'});
map.controls.add('zoomControl').add('miniMap').add('typeSelector').add('mapTools').add('scaleLine');
var mark;

!var
mark = new ymaps.Placemark([##latitude##, ##longitude##], {iconContent:"<font color='blue'><b>##number##</b></font>",balloonContent:"##name##" }, {preset:'twirl#blueStretchyIcon'});
map.geoObjects.add(mark);
!endvar

map.setBounds(map.geoObjects.getBounds());
var zoom = map.getZoom();if( zoom > 0 ) { map.setZoom(zoom-1); }
});
</script><style type="text/css">
 body, html { width:100%; height:100%; margin:0; padding:0; overflow:hidden;}
</style>
</head>
<body>
<div id="YMapsID" style="width:100%;height:100%"></div> 
</body> 
</html>
!endmap

-----------------------------------------------------------------------------------------------
!beginmap traceroute
!colorGPS=styleGPS;
!colorGSM=styleGSM;
<!DOCTYPE html "-//W3C//DTD XHTML 1.0 Strict//EN"
"http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd">
<html> 
<head><meta http-equiv="Content-Type" content="text/html; charset=utf-8" /> 
<script src="http://api-maps.yandex.ru/2.0-stable/?load=package.standard,package.geoObjects&lang=ru-RU&key=ANzXmEoBAAAAkjQFPwIAQphddQGLBfkqE3qCI3Vo8OCM8yYAAAAAAAAAAACYpxbA0OaEdJRuAHC50onaXfYLBQ==&" type="text/javascript" >
</script>
<script type="text/javascript"> 
ymaps.ready(function () {
var map = new ymaps.Map("YMapsID", {center: [57.6123, 39.8296], zoom: 10, type:'yandex#publicMap'});
map.controls.add('zoomControl').add('miniMap').add('typeSelector').add('mapTools').add('scaleLine');
var mark, point;

!var
mark = new ymaps.Placemark([##latitude##, ##longitude##], {iconContent:"<font color='blue'><b>##name##</b></font>",balloonContent:"##descr##" }, {preset:'twirl#blueStretchyIcon'});
map.geoObjects.add(mark);
!endvar

!var
point = new ymaps.Placemark([##latitude##, ##longitude##], {iconContent:"<font color='grey'><b>##name##</b></font>",balloonContent:"##descr##" }, {preset:'twirl#greyIcon'});
map.geoObjects.add(point);
!endvar

var styleGPS = {
    strokeColor: '#ff0000ff',
    strokeWidth: 4,
    strokeStyle: '2 1'
};

var styleGSM = {
    strokeColor: '#b000b0ff',
    strokeWidth: 4,
    strokeStyle: '2 1'
};

!var
var pl##number## = new ymaps.Polyline([ 
!cont
[##latitude##, ##longitude##]
!endcont
], {
    hintContent: "Маршрут"
}, ##color##);

map.geoObjects.add(pl##number##);
!endvar

!var
point = new ymaps.Placemark([##latitude##, ##longitude##], {iconContent:"<font color='red'><b>##name##</b></font>",balloonContent:"##descr##" }, {preset:'twirl#greenStretchyIcon'});
map.geoObjects.add(point);
!endvar

map.setBounds(map.geoObjects.getBounds());
var zoom = map.getZoom();if( zoom > 0 ) { map.setZoom(zoom-1); }
});
</script><style type="text/css">
 body, html { width:100%; height:100%; margin:0; padding:0; overflow:hidden;}
</style>
</head>
<body>
<div id="YMapsID" style="width:100%;height:100%"></div> 
</body> 
</html>
!endmap


