!beginmap changeorgaddress
<!DOCTYPE html "-//W3C//DTD XHTML 1.0 Strict//EN"
"http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd">
<html> 
<head><meta http-equiv="Content-Type" content="text/html; charset=utf-8" /> 
<script src="http://api-maps.yandex.ru/2.0-stable/?load=package.standard,package.geoObjects&lang=ru-RU&key=ANzXmEoBAAAAkjQFPwIAQphddQGLBfkqE3qCI3Vo8OCM8yYAAAAAAAAAAACYpxbA0OaEdJRuAHC50onaXfYLBQ==&" type="text/javascript" >
</script>
<script type="text/javascript"> 
var map = 0;
var mark;

function ShowOrg(lat, lng, name, updateBounds) {
  if( map == 0 )
     return;
  map.geoObjects.remove(mark);

  zoom = map.getZoom();
  mark = new ymaps.Placemark([lat, lng], { balloonContent:name });
  map.geoObjects.add(mark);

  if( updateBounds ) {
    map.setBounds(map.geoObjects.getBounds());
    map.setZoom(zoom);
  }
}

ymaps.ready(function () {
  var cur = window.external.GetCurrentOrg('lat');
  var startLat = 57.612053, startLng = 39.830773, startName = "Test";

  if( cur != 0 ) {
    startLat = cur;
    startLng = window.external.GetCurrentOrg('lng');
    startName = window.external.GetCurrentOrg('org');
  }  

  map = new ymaps.Map("YMapsID", {center: [startLat, startLng], zoom: 10, type:'yandex#publicMap'});
  map.controls.add('zoomControl').add('miniMap').add('typeSelector').add('mapTools').add('scaleLine');
  map.behaviors.disable('dblClickZoom');

  mark = new ymaps.Placemark([startLat, startLng], { balloonContent: startName });
  map.geoObjects.add(mark);
  map.setBounds(map.geoObjects.getBounds());
  map.setZoom(15);
  map.events.add('dblclick', function(e) {
    var position = e.get('coordPosition');
    window.external.SetNewLocation(position[0], position[1]);
  });
});
</script>
<style type="text/css">
 body, html { width:100%; height:100%; margin:0; padding:0; overflow:hidden;}
</style>
</head>
<body>
<div id="YMapsID" style="width:100%;height:100%"></div> 
</body> 
</html>
!endmap