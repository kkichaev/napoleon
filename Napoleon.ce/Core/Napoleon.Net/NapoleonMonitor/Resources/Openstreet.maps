-----------------------------------------------------------------------------------------------
!beginmap changeorgaddress
<!DOCTYPE html "-//W3C//DTD XHTML 1.0 Strict//EN"
"http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
<meta http-equiv="content-type" content="text/html; charset=utf-8"/>
<title></title>
<script src="http://maps.googleapis.com/maps/api/js?key=AIzaSyAjuQiUAlecbUWCdh1QCnZzrWq37EPqPE0&sensor=false" type="text/javascript"></script>
<script type="text/javascript">
var map = 0;
var marker;
var infoWindow;

function ShowOrg(lat, lng, name, updateBounds) {
  if( map == 0 )
     return;
  var pos = new google.maps.LatLng(lat, lng);
  marker.setPosition(pos);
  infoWindow.setContent(name);
  if( updateBounds )
    map.setCenter(pos);
}

function initialize() {
  var cur = window.external.GetCurrentOrg('lat');
  var startLat = 57.612053, startLng = 39.830773, startName = "Test";

  if( cur != 0 ) {
    startLat = cur;
    startLng = window.external.GetCurrentOrg('lng');
    startName = window.external.GetCurrentOrg('org');
  }  
   var mapTypeIds = [];
   
   for(var type in google.maps.MapTypeId) {
       mapTypeIds.push(google.maps.MapTypeId[type]);
   }
   
   mapTypeIds.push("OSM");

   map = new google.maps.Map(document.getElementById("map_canvas"),
   {
      disableDoubleClickZoom: true,
      mapTypeId: "OSM",
      mapTypeControlOptions: {
         mapTypeIds: mapTypeIds
   }});
   
   marker = new google.maps.Marker({ 
         position: new google.maps.LatLng(startLat, startLng),
         map: map
      });
      
   infoWindow = new google.maps.InfoWindow({content: startName });
   google.maps.event.addListener(marker, 'click', function() {
      infoWindow.open(map,marker);
   });
   google.maps.event.addListener(map, 'dblclick', function(e) {
      e.stop();
      window.external.SetNewLocation(e.latLng.lat(), e.latLng.lng());
   });
   
   map.mapTypes.set("OSM", new google.maps.ImageMapType({
       getTileUrl: function(coord, zoom) {
           return "http://tile.openstreetmap.org/" + zoom + "/" + coord.x + "/" + coord.y + ".png";
       },
       tileSize: new google.maps.Size(256, 256),
       name: "OpenStreetMap",
       maxZoom: 18
   }));
            
   map.setCenter(new google.maps.LatLng(startLat, startLng));
   map.setZoom(12);
}

</script>
<style type="text/css">
 body, html { width:100%; height:100%; margin:0; padding:0; overflow:hidden;}
</style>
</head>
<body onload="initialize()">
<div id="map_canvas" style="width: 100%; height:100%"></div>
</body>
</html>