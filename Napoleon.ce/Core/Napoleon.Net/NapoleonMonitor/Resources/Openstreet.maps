!name Openstreet;
-----------------------------------------------------------------------------------------------
!beginmap orgaddress
<!DOCTYPE html "-//W3C//DTD XHTML 1.0 Strict//EN"
"http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
<meta http-equiv="content-type" content="text/html; charset=utf-8"/>
<title></title>
<script src="http://maps.googleapis.com/maps/api/js?key=AIzaSyAjuQiUAlecbUWCdh1QCnZzrWq37EPqPE0&sensor=false" type="text/javascript"></script>
<script type="text/javascript">
function initialize() {
   var mapTypeIds = [];
   
   for(var type in google.maps.MapTypeId) {
       mapTypeIds.push(google.maps.MapTypeId[type]);
   }
   
   mapTypeIds.push("OSM");

   var map = new google.maps.Map(document.getElementById("map_canvas"),
   {
      mapTypeId: "OSM",
      mapTypeControlOptions: {
         mapTypeIds: mapTypeIds
   }});
   
   var marker = new google.maps.Marker({ 
         position: new google.maps.LatLng(##latitude##, ##longitude##),
         map: map
      });
      
   google.maps.event.addListener(marker, 'click', function() {
      new google.maps.InfoWindow({
         content: "##name##"
      }).open(map,marker);
   });
   
   map.mapTypes.set("OSM", new google.maps.ImageMapType({
       getTileUrl: function(coord, zoom) {
           return "http://tile.openstreetmap.org/" + zoom + "/" + coord.x + "/" + coord.y + ".png";
       },
       tileSize: new google.maps.Size(256, 256),
       name: "OpenStreetMap",
       maxZoom: 18
   }));
            
   map.setCenter(new google.maps.LatLng(##latitude##, ##longitude##));
   map.setZoom(12);
}

</script>
<style type="text/css">
 body, html { width:100%; height:100%; margin:0; padding:0; overflow:hidden;}
</style>
</head>
<body onload="initialize()">
<div id="map_canvas" style="width: 100%; height:100%"></div>
</body>
</html>
!endmap

-----------------------------------------------------------------------------------------------
!beginmap route
<!DOCTYPE html "-//W3C//DTD XHTML 1.0 Strict//EN"
"http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
<meta http-equiv="content-type" content="text/html; charset=utf-8"/>
<title></title>
<script src="http://maps.googleapis.com/maps/api/js?key=AIzaSyAjuQiUAlecbUWCdh1QCnZzrWq37EPqPE0&sensor=false" type="text/javascript"></script>
<script type="text/javascript">
function initialize() {
   var mapTypeIds = [];
   
   for(var type in google.maps.MapTypeId) {
       mapTypeIds.push(google.maps.MapTypeId[type]);
   }
   
   mapTypeIds.push("OSM");

   var map = new google.maps.Map(document.getElementById("map_canvas"),
   {
      mapTypeId: "OSM",
      mapTypeControlOptions: {
         mapTypeIds: mapTypeIds
   }});
   
   var bounds = new google.maps.LatLngBounds();

   !var
      bounds.extend(new google.maps.LatLng(##latitude##, ##longitude##));
      
      bounds.extend(new google.maps.LatLng(##latitude##, ##longitude##));
      var marker##number## = new google.maps.Marker({ 
         position: new google.maps.LatLng(##latitude##, ##longitude##),
         icon: "http://gmaps-samples.googlecode.com/svn/trunk/markers/green/marker##number##.png", 
         map: map
      });
      
      google.maps.event.addListener(marker##number##, 'click', function() {
         new google.maps.InfoWindow({
            content: "##name##"
         }).open(map,marker##number##);
      });
   !endvar

   map.mapTypes.set("OSM", new google.maps.ImageMapType({
       getTileUrl: function(coord, zoom) {
           return "http://tile.openstreetmap.org/" + zoom + "/" + coord.x + "/" + coord.y + ".png";
       },
       tileSize: new google.maps.Size(256, 256),
       name: "OpenStreetMap",
       maxZoom: 18
   }));
   
   map.setCenter(bounds.getCenter());
   map.fitBounds(bounds);
}
</script>
<style type="text/css">
 body, html { width:100%; height:100%; margin:0; padding:0; overflow:hidden;}
</style>
</head>
<body onload="initialize()">
<div id="map_canvas" style="width: 100%; height:100%"></div>
</body>
</html>

!endmap

-----------------------------------------------------------------------------------------------
!beginmap traceroute
!colorGPS=#ff0000;
!colorGSM=#b000b0;
<!DOCTYPE html "-//W3C//DTD XHTML 1.0 Strict//EN"
"http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
<meta http-equiv="content-type" content="text/html; charset=utf-8"/>
<title></title>
<script src="http://maps.googleapis.com/maps/api/js?key=AIzaSyAjuQiUAlecbUWCdh1QCnZzrWq37EPqPE0&sensor=false" type="text/javascript"></script>
<script type="text/javascript">
function initialize() {
   var mapTypeIds = [];
   
   for(var type in google.maps.MapTypeId) {
       mapTypeIds.push(google.maps.MapTypeId[type]);
   }
   
   mapTypeIds.push("OSM");

   var map = new google.maps.Map(document.getElementById("map_canvas"),
   {
      mapTypeId: "OSM",
      mapTypeControlOptions: {
         mapTypeIds: mapTypeIds
   }});
   
   var bounds = new google.maps.LatLngBounds();

   !var
      bounds.extend(new google.maps.LatLng(##latitude##, ##longitude##));
   
      var marker##number## = new google.maps.Marker({ 
         position: new google.maps.LatLng(##latitude##, ##longitude##),
         icon: "http://gmaps-samples.googlecode.com/svn/trunk/markers/blue/marker##number##.png", 
         map: map
      });
   !endvar

   !var
      var pl##number## = new google.maps.Polyline({
      path: [
            !cont
               new google.maps.LatLng(##latitude##, ##longitude##)
            !endcont
            ],
      strokeColor: "##color##",
      strokeWeight: 5,
      strokeOpacity: 1});
      pl##number##.setMap(map);
      bounds.extend(new google.maps.LatLng(##latitude##, ##longitude##));
   !endvar

   !var
      bounds.extend(new google.maps.LatLng(##latitude##, ##longitude##));
      var marker##number## = new google.maps.Marker({ 
         position: new google.maps.LatLng(##latitude##, ##longitude##),
         icon: "http://gmaps-samples.googlecode.com/svn/trunk/markers/green/marker##number##.png", 
         map: map
      });
      
      google.maps.event.addListener(marker##number##, 'click', function() {
         new google.maps.InfoWindow({
            content: "##descr##"
         }).open(map,marker##number##);
      });
   !endvar

   map.mapTypes.set("OSM", new google.maps.ImageMapType({
       getTileUrl: function(coord, zoom) {
           return "http://tile.openstreetmap.org/" + zoom + "/" + coord.x + "/" + coord.y + ".png";
       },
       tileSize: new google.maps.Size(256, 256),
       name: "OpenStreetMap",
       maxZoom: 18
   }));
   map.setCenter(bounds.getCenter());
   map.fitBounds(bounds);
}
</script>
<style type="text/css">
 body, html { width:100%; height:100%; margin:0; padding:0; overflow:hidden;}
</style>
</head>
<body onload="initialize()">
<div id="map_canvas" style="width: 100%; height:100%"></div>
</body>
</html>

!endmap

