!beginmap traceroute
!colorGPS=#ff0000;
!colorGSM=#b000b0;
<!DOCTYPE html "-//W3C//DTD XHTML 1.0 Strict//EN"
"http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
<meta http-equiv="content-type" content="text/html; charset=utf-8"/>
<meta http-equiv='X-UA-Compatible' content='IE=Edge'/>
<title></title>
<script src="https://maps.googleapis.com/maps/api/js?key=AIzaSyAjuQiUAlecbUWCdh1QCnZzrWq37EPqPE0&sensor=false" type="text/javascript"></script>
<script type="text/javascript">
var map;
var markers = {};
var infowindow = null;

function ShowInfo(lat,long) {
  try{
     if (infowindow != null) 
        infowindow.close();

     var m = markers[lat+long];
     google.maps.event.trigger(m, 'click');
     map.setCenter(m.position);
  }catch(err){
    
  }
}

function initialize() {
   var mapTypeIds = [];
   
   for(var type in google.maps.MapTypeId) {
       mapTypeIds.push(google.maps.MapTypeId[type]);
   }
   
   mapTypeIds.push("OSM");

   map = new google.maps.Map(document.getElementById("map_canvas"),
   {
      mapTypeId: "OSM",
      mapTypeControlOptions: {
         mapTypeIds: mapTypeIds
   }});
   
   var bounds = new google.maps.LatLngBounds();

   !var
      bounds.extend(new google.maps.LatLng(##latitude##, ##longitude##));
   
      var marker##number## = new google.maps.Marker({ 
         position: new google.maps.LatLng(##latitude##, ##longitude##),
         title: '##name##',
         icon: "http://grsoft.ru/markers/##iconcolor##/marker##icon##.png", 
         map: map
      });

		google.maps.event.addListener(marker##number##, 'click', function() {
         infowindow = new google.maps.InfoWindow({
            content: '##descr##'
         });
         
         infowindow.open(map,marker##number##);
      });

      markers["##latitude####longitude##"]=marker##number##;
   !endvar

   !var
      var pl##number## = new google.maps.Polyline({
      path: [
            !cont
               new google.maps.LatLng(##latitude##, ##longitude##)
            !endcont
            ],
      icons: [{ icon: {path: 'M -1,2 0,-1 1,2 0,1'},offset: '50%', repeat: '150px' }],
      strokeColor: "##color##",
      strokeWeight: 5,
      strokeOpacity: 1});
      pl##number##.setMap(map);
   !endvar

   !var
      bounds.extend(new google.maps.LatLng(##latitude##, ##longitude##));
      var markerP##number## = new google.maps.Marker({ 
         position: new google.maps.LatLng(##latitude##, ##longitude##),
         icon: "http://grsoft.ru/markers/blue/marker##number##.png", 
         map: map
      });
      
      google.maps.event.addListener(markerP##number##, 'click', function() {
         new google.maps.InfoWindow({
            content: '##descr##'
         }).open(map,markerP##number##);
      });
   !endvar

   !var
      bounds.extend(new google.maps.LatLng(##latitude##, ##longitude##));
      var markerO##number## = new google.maps.Marker({ 
         position: new google.maps.LatLng(##latitude##, ##longitude##),
         icon: "http://grsoft.ru/markers/red/marker##number##.png", 
         map: map
      });
      
      google.maps.event.addListener(markerO##number##, 'click', function() {
         new google.maps.InfoWindow({
            content: '##descr##'
         }).open(map,markerO##number##);
      });
   !endvar


   map.mapTypes.set("OSM", new google.maps.ImageMapType({
       getTileUrl: function(coord, zoom) {
           return "http://tile.openstreetmap.org/" + zoom + "/" + coord.x + "/" + coord.y + ".png";
       },
       tileSize: new google.maps.Size(256, 256),
       name: "OpenStreetMap",
       maxZoom: 18
   }));
   map.setCenter(bounds.getCenter());
   map.fitBounds(bounds);
}
</script>
<style type="text/css">
 body, html { width:100%; height:100%; margin:0; padding:0; overflow:hidden;}
 .infomsg { display:none; }
</style>
</head>
<body onload="initialize()">
<div id="map_canvas" style="width: 100%; height:100%"></div>
</body>
</html>

!endmap

