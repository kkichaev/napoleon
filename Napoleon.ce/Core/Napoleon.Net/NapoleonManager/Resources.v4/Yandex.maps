!beginmap traceroute
!colorGPS=styleGPS;
!colorGSM=styleGSM;
<!DOCTYPE html "-//W3C//DTD XHTML 1.0 Strict//EN"
"http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd">
<html> 
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8" /> 
<meta http-equiv="x-ua-compatible" content="ie=edge">
<script src="http://api-maps.yandex.ru/1.1/index.xml" type="text/javascript"></script> 

<script type="text/javascript"> 
   var map;
   var markers = {};

	function ShowInfo(lat, lng){
      markers[lat+lng].openBalloon();
		point = new YMaps.GeoPoint(lng, lat);
		map.setCenter(point, map.getZoom());
	}

	YMaps.jQuery(function () {
		map = new YMaps.Map(YMaps.jQuery("#YMapsID")[0]); 
		map.addControl(new YMaps.TypeControl()); 
		map.addControl(new YMaps.ToolBar()); 
		map.addControl(new YMaps.Zoom()); 
		map.addControl(new YMaps.MiniMap()); 
		map.addControl(new YMaps.ScaleLine()); 
		map.enableScrollZoom();

		bnds = new YMaps.GeoCollectionBounds();

		!var
			point = new YMaps.GeoPoint(##longitude##, ##latitude##);
			bnds.add(point);
			mark = new YMaps.Placemark(point, {style: "default#greenSmallPoint"});
			mark.setIconContent('<font color=green><b>##name##</b></font>');
			mark.description='##descr##';
			map.addOverlay(mark);
         markers["##latitude####longitude##"]=mark;
		!endvar

		styleGPS = new YMaps.Style(); 
		styleGPS.lineStyle = new YMaps.LineStyle(); 
		styleGPS.lineStyle.strokeWidth = 4; 
		styleGPS.lineStyle.strokeColor='ff0000ff'; 
		styleGSM = new YMaps.Style(); 
		styleGSM.lineStyle = new YMaps.LineStyle(); 
		styleGSM.lineStyle.strokeWidth = 4; 
		styleGSM.lineStyle.strokeColor='b000b0ff'; 

		!var
		var pl##number## = new YMaps.Polyline([ 
		!cont
		new YMaps.GeoPoint(##longitude##, ##latitude##)
		!endcont
		]);

		pl##number##.setStyle(##color##); 
		map.addOverlay(pl##number##); 
		bnds.add(pl##number##.getPoints());
		!endvar

		!var
		point = new YMaps.GeoPoint(##longitude##, ##latitude##);
		bnds.add(point);
		mark = new YMaps.Placemark(point, {style: "default#blueSmallPoint"});
		mark.setIconContent('<font color=blue><b>##name##</b></font>');
		mark.description='##descr##';
		map.addOverlay(mark);
		!endvar

		!var
		point = new YMaps.GeoPoint(##longitude##, ##latitude##);
		bnds.add(point);
		mark = new YMaps.Placemark(point, {style: "default#redSmallPoint"});
		mark.setIconContent('<font color=red><b>##name##</b></font>');
		mark.description='##descr##';
		map.addOverlay(mark);
		!endvar

		map.setBounds(bnds);

		var zoom = map.getZoom();
		if( zoom > 0 ) { map.setZoom(zoom-1); }
	});
</script><style type="text/css">
 body, html { width:100%; height:100%; margin:0; padding:0; overflow:hidden;}
</style>
</head>
<body>
<div id="YMapsID" style="width:100%;height:100%"></div> 
</body> 
</html>
!endmap

