!beginmap route
<!DOCTYPE html "-//W3C//DTD XHTML 1.0 Strict//EN"
"http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd">
<html> 
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8" /> 
<meta http-equiv="x-ua-compatible" content="ie=edge">

<script src="http://api-maps.yandex.ru/1.1/index.xml" type="text/javascript"></script> 

<script type="text/javascript"> 
function havePoint(ar, point) {
index = 0;
for( ; index < ar.length; index++ ) {
  pt = ar[index];
  if( pt.getLat() == point.getLat() && pt.getLng() == point.getLng() )
    return true;
}
return false;
}		

YMaps.jQuery(function () {
	map = new YMaps.Map(YMaps.jQuery("#YMapsID")[0]); 
	map.addControl(new YMaps.TypeControl()); 
	map.addControl(new YMaps.ToolBar()); 
	map.addControl(new YMaps.Zoom()); 
	map.addControl(new YMaps.MiniMap()); 
	map.addControl(new YMaps.ScaleLine()); 
	map.enableScrollZoom();

	bnds = new YMaps.GeoCollectionBounds();

	var mark;

	var plRoute = []; 

	!var
		point = new YMaps.GeoPoint(##longitude##, ##latitude##);
		if( !havePoint(plRoute, point) ) {
			plRoute.push(point);
		bnds.add(point);
		mark = new YMaps.Placemark(point);
		mark.setIconContent('<font color=blue><b>##number##</b></font>');
		mark.description="##name##";
		map.addOverlay(mark); }
	!endvar

	plstyle = new YMaps.Style(); 
	plstyle.lineStyle = new YMaps.LineStyle(); 
	plstyle.lineStyle.strokeWidth = 3; 
	plstyle.lineStyle.strokeColor='707070ff'; 

	var pl1 = new YMaps.Polyline(plRoute);
	pl1.setStyle(plstyle); 
	map.addOverlay(pl1); 
	bnds.add(pl1.getPoints());

	map.setBounds(bnds);
	var zoom = map.getZoom();
	if( zoom > 0 ) { map.setZoom(zoom-1); }
});
</script><style type="text/css">
 body, html { width:100%; height:100%; margin:0; padding:0; overflow:hidden;}
</style>
</head>
<body>
<div id="YMapsID" style="width:100%;height:100%"></div> 
</body> 
</html>
!endmap

