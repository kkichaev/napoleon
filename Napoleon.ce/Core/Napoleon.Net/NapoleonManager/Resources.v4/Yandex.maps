!beginmap changeorgaddress
<!DOCTYPE html "-//W3C//DTD XHTML 1.0 Strict//EN"
"http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd">
<html> 
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8" /> 
<meta http-equiv="x-ua-compatible" content="ie=edge">
<script src="http://api-maps.yandex.ru/1.1/index.xml" type="text/javascript"></script> 

<script type="text/javascript"> 
var map = 0;
var mark;
var point;
var bnds;

function ShowOrg(lat, lng, name, updateBounds) {
  
  if( map == 0 )
     return;

  bnds.clear();
  map.removeAllOverlays();
  point = new YMaps.GeoPoint(lng, lat);
  bnds.add(point);

  zoom = map.getZoom();

  mark = new YMaps.Placemark(point);
  mark.setIconContent(name);
  map.addOverlay(mark);

  map.setBounds(bnds);
  map.setCenter(point, 15);
}

 var hostw = chrome.webview.hostObjects.sync.host;
 YMaps.jQuery(function () {
  var cur = hostw.GetCurrentOrg('lat');
//  var cur = window.external.GetCurrentOrg('lat');
  var startLat = 57.612053, startLng = 39.830773, startName = "Клиент";

  if( cur != 0 ) {
    startLat = cur;
    startLng = hostw.GetCurrentOrg('lng');
    startName = hostw.GetCurrentOrg('org');
//    startLng = window.external.GetCurrentOrg('lng');
//    startName = window.external.GetCurrentOrg('org');
  }  

	map = new YMaps.Map(YMaps.jQuery("#YMapsID")[0]); 
	map.addControl(new YMaps.TypeControl()); 
	map.addControl(new YMaps.ToolBar()); 
	map.addControl(new YMaps.Zoom()); 
	map.addControl(new YMaps.MiniMap()); 
	map.addControl(new YMaps.ScaleLine()); 
	map.enableScrollZoom();

	map.disableDblClickZoom();
	
	bnds = new YMaps.GeoCollectionBounds();

	point = new YMaps.GeoPoint(startLng, startLat);
	bnds.add(point);
	mark = new YMaps.Placemark(point);
	mark.setIconContent(startName);
	map.addOverlay(mark);

	map.setBounds(bnds);
	map.setZoom(15);

	YMaps.Events.observe(map, map.Events.DblClick, function (map, mEvent) {
                p = mEvent.getGeoPoint();
				chrome.webview.hostObjects.host.SetNewLocation(p.getLat(), p.getLng());
                //window.external.SetNewLocation(p.getLat(), p.getLng());
	});
});

</script>
<style type="text/css">
 body, html { width:100%; height:100%; margin:0; padding:0; overflow:hidden;}
</style>
</head>
<body>
<div id="YMapsID" style="width:100%;height:100%"></div> 
</body> 
</html>
!endmap

