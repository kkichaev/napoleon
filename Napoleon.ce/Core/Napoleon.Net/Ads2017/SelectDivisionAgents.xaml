<Window x:Class="Ads2017.SelectDivisionAgents"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:p = "clr-namespace:Ads2017.Properties"
        xmlns:local="clr-namespace:Ads2017"
        mc:Ignorable="d"
        Title="{Binding Source={x:Static p:Resources.select_agents}}" Height="451.907" Width="720">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="35"/>
        </Grid.RowDefinitions>
        <DataGrid x:Name="dgAgents" Margin="0" Grid.ColumnSpan="2" AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="40">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding Path=IsSelected, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Binding="{Binding Name, Mode=OneTime}" Header="{Binding Source={x:Static p:Resources.users}}" Width="2*" />
                <DataGridTextColumn Binding="{Binding Division, Mode=OneTime}" Header="{Binding Source={x:Static p:Resources.division}}" Width="1*" />
            </DataGrid.Columns>
        </DataGrid>
        <Button Content="{Binding Source={x:Static p:Resources.ok}}" HorizontalAlignment="Left" Margin="70,8,0,0" Grid.Row="1" VerticalAlignment="Top" Width="100" Click="Button_Click_1" />
        <Button Content="{Binding Source={x:Static p:Resources.cancel}}" HorizontalAlignment="Left" Margin="550,8,0,0" Grid.Row="1" VerticalAlignment="Top" Width="100" Click="Button_Click"/>

    </Grid>
</Window>
