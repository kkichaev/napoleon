<RibbonWindow x:Class="Ads2017.DistanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Ads2017"
        xmlns:p = "clr-namespace:Ads2017.Properties"
        Title="{x:Static p:Resources.report_by_distance}"
        Icon="napoleon.ico"
        Height="600" Width="850"
        Loaded="RibbonWindow_Loaded">

    <RibbonWindow.CommandBindings>
        <CommandBinding Command="local:AdsCommands.Refresh" Executed="RefreshExecuted"/>
    </RibbonWindow.CommandBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Ribbon Grid.Row="0" SelectedIndex="0">
            <Ribbon.ApplicationMenu>
                <RibbonApplicationMenu Visibility="Collapsed"/>
            </Ribbon.ApplicationMenu>

            <RibbonTab Header="{Binding Source={x:Static p:Resources.operation}}" >
                <RibbonGroup>
                    <RibbonButton 
                         x:Name="btnRefresh" 
                         LargeImageSource="Images\refresh.png" 
                         Label="{Binding Source={x:Static p:Resources.refresh}}"
                         KeyTip="F5" 
                         Command="local:AdsCommands.Refresh"
                         ToolTipTitle ="{Binding Source={x:Static p:Resources.refresh_hint}}"
                         ToolTipDescription="{Binding Source={x:Static p:Resources.refresh_description}}"/>

                    <RibbonButton 
                        x:Name="btnHTML"  
                        Label="{Binding Source={x:Static p:Resources.browser}}"
                        LargeImageSource="Images\browser.png" 
                        Click="HTML_Click"/>

                    <RibbonButton 
                        x:Name="btnReport"  
                        Label="{Binding Source={x:Static p:Resources.excel}}"
                        LargeImageSource="Images\excel.png" 
                        Click="Report_Click"/>
            </RibbonGroup>

            <RibbonGroup Width="460" Header="{Binding Source={x:Static p:Resources.select_period}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>

                            <DatePicker Grid.Column="0" x:Name="startDate"/>
                            <local:TimeControl Grid.Column="1" x:Name="startTime" Mode="Start"/>
                            <Label Grid.Column="2" HorizontalContentAlignment="Center">-</Label>
                            <local:TimeControl Grid.Column="3" x:Name="finishTime" Mode="Finish"/>

                            <DatePicker Grid.Column="4" x:Name="finishDate" Width="100"/>
                        </Grid>
                    </Grid>
                    
                </RibbonGroup>
            </RibbonTab>
        </Ribbon>

        <DataGrid  
            Grid.Row="1" 
            x:Name="grid" 
            AutoGenerateColumns="False" 
            IsReadOnly="True">
            
            <DataGrid.Columns>
            <DataGridTextColumn Header="{Binding Source={x:Static p:Resources.performer}}" Binding="{Binding Agent}" Width="*"/>
            <DataGridTextColumn Header="{Binding Source={x:Static p:Resources.distance}}" Binding="{Binding Distance}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StatusBar 
            Grid.Row="2">

            <StatusBarItem>
               <TextBlock Text="{Binding Source={x:Static p:Resources.distance_gone}}"/>
            </StatusBarItem>

            <StatusBarItem>
                <TextBlock Text="{Binding Path=SumDistance, RelativeSource={RelativeSource AncestorType=RibbonWindow}}"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</RibbonWindow>
