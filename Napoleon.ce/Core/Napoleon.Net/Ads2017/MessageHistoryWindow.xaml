<RibbonWindow 
    x:Class="Ads2017.MessageHistoryWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:Ads2017"
    xmlns:p = "clr-namespace:Ads2017.Properties"
    mc:Ignorable="d"
    Title="{x:Static p:Resources.message_history}" 
    Height="800" 
    Width="600"
    Loaded="RibbonWindow_Loaded"
    Icon="Napoleon.ico">

   <RibbonWindow.CommandBindings>
      <CommandBinding Command="local:AdsCommands.Refresh" Executed="RefreshExecuted"/>
   </RibbonWindow.CommandBindings>

   <Grid>
      <Grid.RowDefinitions>
         <RowDefinition Height="Auto"/>
         <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <Ribbon Grid.Row="0" SelectedIndex="0">
         <Ribbon.ApplicationMenu>
            <RibbonApplicationMenu Visibility="Collapsed"/>
         </Ribbon.ApplicationMenu>

         <RibbonTab Header="{x:Static p:Resources.operation}" >
            <RibbonGroup>
               <RibbonButton 
                         x:Name="btnRefresh" 
                         LargeImageSource="Images\refresh.png" 
                         Label="{x:Static p:Resources.refresh}" 
                         KeyTip="F5" 
                         Command="local:AdsCommands.Refresh"
                         ToolTipTitle ="{x:Static p:Resources.refresh_hint}"
                         ToolTipDescription="{x:Static p:Resources.refresh_description}"/>
            </RibbonGroup>

            <RibbonGroup>
               <Grid>
                  <Grid.ColumnDefinitions>
                     <ColumnDefinition/>
                     <ColumnDefinition/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                     <RowDefinition/>
                     <RowDefinition/>
                     <RowDefinition/>
                  </Grid.RowDefinitions>

                  <Label Grid.ColumnSpan="2" Grid.Row="0" Grid.Column="0"  Content="{x:Static p:Resources.select_period}" FontSize="10"/>
                  <Label Grid.Column="0" Grid.Row="1" Content="c" FontSize="10"/>
                  <DatePicker Grid.Column="1" Grid.Row="1" x:Name="start"/>
                  <Label Grid.Column="0" Grid.Row="2" Content="по" FontSize="10"/>
                  <DatePicker Grid.Column="1" Grid.Row="2" x:Name="finish"/>
               </Grid>
            </RibbonGroup>


         </RibbonTab>
      </Ribbon>

      <DataGrid  Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" x:Name="grid" AutoGenerateColumns="False" IsReadOnly="True">
         <DataGrid.Columns>
            <DataGridTextColumn Header="{x:Static p:Resources.date}" Binding="{Binding Date, StringFormat=\{0:dd.MM.yy HH:mm\}}" Width="90"/>
            <DataGridTextColumn Header="{x:Static p:Resources.message}" Binding="{Binding Message}" Width="*">
               <DataGridTextColumn.ElementStyle>
                  <Style>
                     <Setter Property="TextBlock.TextWrapping" Value="Wrap" />
                  </Style>
               </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>
         </DataGrid.Columns>
      </DataGrid>
   </Grid>
</RibbonWindow>
