<UserControl x:Class="Ads2017.Ticket"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:p = "clr-namespace:Ads2017.Properties"
             xmlns:local="clr-namespace:Ads2017"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300">
   <UserControl.Resources>
      <SolidColorBrush x:Key="AddressForeground" Color="#606060" />
   </UserControl.Resources>
   <Grid>
      <Border x:Name="selection"  BorderBrush="White" BorderThickness="10,1,1,1" >
         <Border x:Name="attaches" BorderBrush="Green" BorderThickness="0,0,0,3" >
            <Grid Background="Azure" >
               <Grid.RowDefinitions>
                  <RowDefinition Height="2*" MinHeight="25"/>
                  <RowDefinition Height="Auto"/>
               </Grid.RowDefinitions>

               <TextBlock x:Name="tbText" 
               Padding="0,3,3,0"        
               Grid.Row="0"
               TextWrapping="Wrap"
               TextTrimming="CharacterEllipsis"
               Text="{Binding Path=Text, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"/>

               <TextBlock x:Name="tbAddress" 
               Padding="0,0,3,0"   
               Grid.Row="1"
               Foreground="{StaticResource AddressForeground}" 
               TextWrapping="Wrap"
               TextTrimming="CharacterEllipsis"
               Text="{Binding Path=Address, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}">
               </TextBlock>
            </Grid>
         </Border>
      </Border>
   </Grid>
    
   <UserControl.CommandBindings>
      <CommandBinding Command="local:AdsCommands.Delete" Executed="DeleteExecuted" CanExecute="CanDeleteExecuted"/>
      <CommandBinding Command="local:AdsCommands.Copy" Executed="CopyExecuted" CanExecute="CanCopyExecuted"/>
      <CommandBinding Command="local:AdsCommands.Cut" Executed="CutExecuted" CanExecute="CanCutExecuted"/>
   </UserControl.CommandBindings>
    
    <UserControl.ContextMenu>
        <ContextMenu>
            <MenuItem 
               Header="{Binding Source={x:Static p:Resources.copy}}" 
               Command="local:AdsCommands.Copy" 
               CommandTarget="{Binding Path=PlacementTarget,RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"/>

            <MenuItem Header="{Binding Source={x:Static p:Resources.cut}}" 
                      Command="local:AdsCommands.Cut" 
                      CommandTarget="{Binding Path=PlacementTarget,RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"/>

         <MenuItem Header="{Binding Source={x:Static p:Resources.del}}" 
                   Command="local:AdsCommands.Delete" 
                   CommandTarget="{Binding Path=PlacementTarget,RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"/>
        </ContextMenu>
    </UserControl.ContextMenu>
</UserControl>
