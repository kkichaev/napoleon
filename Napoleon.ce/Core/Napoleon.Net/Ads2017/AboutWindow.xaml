<Window x:Class="Ads2017.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p = "clr-namespace:Ads2017.Properties"
        Title="{x:Static p:Resources.about}"
        Height="250" Width="270" 
        WindowStartupLocation="CenterOwner"
        Icon="napoleon.ico">
   <Grid Margin="10">
      <Grid.RowDefinitions>
         <RowDefinition Height="30"/>
         <RowDefinition Height="30"/>
         <RowDefinition Height="30"/>
         <RowDefinition Height="30"/>
         <RowDefinition Height="30"/>
         <RowDefinition Height="30"/>
      </Grid.RowDefinitions>

      <Grid.ColumnDefinitions>
         <ColumnDefinition Width="50"/>
         <ColumnDefinition/>
      </Grid.ColumnDefinitions>

      <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="{x:Static p:Resources.programm_name}" VerticalAlignment="Center"/>
      <TextBlock Grid.Row="1" Grid.ColumnSpan="2"  Text="{x:Static p:Resources.myphone}" VerticalAlignment="Center"/>
      <TextBlock Grid.Row="2" Grid.Column="0"  Text="{x:Static p:Resources.version}" VerticalAlignment="Center"/>
      <TextBlock Grid.Row="2" Grid.Column="1"  Text="{StaticResource version}" VerticalAlignment="Center"/>
      <TextBlock Grid.Row="3" Grid.Column="0"  Text="{x:Static p:Resources.web_site}" VerticalAlignment="Center"/>
      <TextBlock Grid.Row="3" Grid.Column="1"  Text="{StaticResource webpage}" VerticalAlignment="Center" TextDecorations="Underline" Foreground="Blue" MouseUp="OpenWep_Click"/>
      <TextBlock Grid.Row="4" Grid.Column="0"  Text="{x:Static p:Resources.email}" VerticalAlignment="Center"/>
      <TextBlock Grid.Row="4" Grid.Column="1"  Text="{StaticResource emailtitle}" VerticalAlignment="Center" TextDecorations="Underline" Foreground="Blue" MouseUp="OpenEmail_Click"/>
      <Button Grid.Row="5" Grid.ColumnSpan="2" Content="{x:Static p:Resources.email}" HorizontalAlignment="Center" VerticalAlignment="Center" Click="Close_Click" Visibility="Collapsed"/>
   </Grid>
</Window>
