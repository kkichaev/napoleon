<Window x:Class="Ads2017.WaitWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p = "clr-namespace:Ads2017.Properties"
        Title="WaitWindow" Height="100" Width="300"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

      <TextBlock Grid.Row="0"  Text="{Binding Source={x:Static p:Resources.please_wait}}" 
                   HorizontalAlignment="Center" 
                   VerticalAlignment="Center" 
                   FontStyle="Italic"
                   FontSize="18"/>
        <ProgressBar Margin="20,20" Grid.Row="1" Height="20" IsIndeterminate="True" Foreground="Blue"/>
        
    </Grid>
</Window>
