<RibbonWindow x:Class="Ads2017.TaskJournalWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Ads2017"
    xmlns:p = "clr-namespace:Ads2017.Properties"
    Title="{x:Static p:Resources.task_journal}"
    Icon="napoleon.ico"      
    Height="700" 
    Width="900">

   <RibbonWindow.CommandBindings>
      <CommandBinding Command="local:AdsCommands.Refresh" Executed="RefreshExecuted"/>
   </RibbonWindow.CommandBindings>

   <Grid>
      <Grid.RowDefinitions>
         <RowDefinition Height="Auto"/>
         <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <Ribbon Grid.Row="0" SelectedIndex="0">
         <Ribbon.ApplicationMenu>
            <RibbonApplicationMenu Visibility="Collapsed"/>
         </Ribbon.ApplicationMenu>

         <RibbonTab Header="{Binding Source={x:Static p:Resources.operation}}" >
            <RibbonGroup>
               <RibbonButton 
                         x:Name="btnRefresh" 
                         LargeImageSource="Images\refresh.png" 
                         Label="{Binding Source={x:Static p:Resources.refresh}}" 
                         KeyTip="F5" 
                         Command="local:AdsCommands.Refresh"
                         ToolTipTitle ="{Binding Source={x:Static p:Resources.refresh_hint}}"
                         ToolTipDescription="{Binding Source={x:Static p:Resources.refresh_description}}"/>
            </RibbonGroup>

            <RibbonGroup Header="{Binding Source={x:Static p:Resources.select_period}}">
               <Grid>
                  <Grid.ColumnDefinitions>
                     <ColumnDefinition/>
                     <ColumnDefinition/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                     <RowDefinition Height="25"/>
                     <RowDefinition/>
                  </Grid.RowDefinitions>

                  <TextBlock Grid.Column="0" Grid.Row="0" Text="{Binding Source={x:Static p:Resources.from}}" FontSize="12"/>
                  <DatePicker Grid.Column="1" Grid.Row="0" x:Name="start" Margin="3,0,0,0"/>
                  <TextBlock Grid.Column="0" Grid.Row="1" Text="{Binding Source={x:Static p:Resources.to}}" FontSize="10"/>
                  <DatePicker Grid.Column="1" Grid.Row="1" x:Name="finish" Margin="3,0,0,0"/>
               </Grid>
            </RibbonGroup>

            <RibbonGroup Header="{Binding Source={x:Static p:Resources.search}}">
               <Grid>
                  <Grid.ColumnDefinitions>
                     <ColumnDefinition Width="*"/>
                     <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>

                  <TextBox x:Name="tbSearch" Grid.Column="0" Width="150" TextChanged="TbSearch_TextChanged"/>
                  <RibbonButton x:Name="btnClear" 
                            Grid.Column="1" 
                            SmallImageSource="Images\clear.png" 
                            ToolTipTitle ="{Binding Source={x:Static p:Resources.clear}}"
                            ToolTipDescription="{Binding Source={x:Static p:Resources.clear_description}}"
                            Click="Clear_Click"/>
               </Grid>
            </RibbonGroup>
         </RibbonTab>
      </Ribbon>

      <DataGrid  Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" x:Name="grid" AutoGenerateColumns="False" IsReadOnly="True">
         <DataGrid.Columns>
            <DataGridTextColumn Header="{Binding Source={x:Static p:Resources.performer}}" Binding="{Binding User}" Width="*"/>
            <DataGridTextColumn Header="{Binding Source={x:Static p:Resources.created}}" Binding="{Binding Created, StringFormat=\{0:dd.MM.yy HH:mm\}}" Width="90"/>
            <DataGridTextColumn Header="{Binding Source={x:Static p:Resources.time_plan}}" Binding="{Binding TimePlan}" Width="150"/>
            <DataGridTextColumn Header="{Binding Source={x:Static p:Resources.time_fact}}" Binding="{Binding TimeFact}" Width="150"/>
            <DataGridTextColumn Header="{Binding Source={x:Static p:Resources.content}}" Binding="{Binding Task}" Width="3*">
               <DataGridTextColumn.ElementStyle>
                  <Style>
                     <Setter Property="TextBlock.TextWrapping" Value="Wrap" />
                  </Style>
               </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>
            <DataGridTextColumn Header="{Binding Source={x:Static p:Resources.client}}" Binding="{Binding Client}" Width="*">
               <DataGridTextColumn.ElementStyle>
                  <Style>
                     <Setter Property="TextBlock.TextWrapping" Value="Wrap" />
                  </Style>
               </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>
            <DataGridTextColumn Header="{Binding Source={x:Static p:Resources.address}}" Binding="{Binding Address}" Width="2*">
               <DataGridTextColumn.ElementStyle>
                  <Style>
                     <Setter Property="TextBlock.TextWrapping" Value="Wrap" />
                  </Style>
               </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>
            <DataGridTextColumn Header="{Binding Source={x:Static p:Resources.status}}" Binding="{Binding Status}" Width="70"/>

            <DataGridTextColumn Header="{Binding Source={x:Static p:Resources.report}}" Binding="{Binding Report}" Width="*">
               <DataGridTextColumn.ElementStyle>
                  <Style>
                     <Setter Property="TextBlock.TextWrapping" Value="Wrap" />
                  </Style>
               </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>

            <DataGridTemplateColumn Header="{Binding Source={x:Static p:Resources.photo}}" Width="40" 
                    IsReadOnly="True">
               <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                     <Image Source="{Binding Image}" MouseUp="Image_MouseUp"/>
                  </DataTemplate>
               </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

         </DataGrid.Columns>
      </DataGrid>
   </Grid>
</RibbonWindow>
