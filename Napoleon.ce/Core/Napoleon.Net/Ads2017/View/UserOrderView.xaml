<UserControl x:Class="Ads2017.UserOrderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Ads2017"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300">
    
    <Border BorderBrush="Blue" BorderThickness="1,0,1,1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <TextBlock 
                x:Name="agent" 
                Grid.Row="0" 
                Text="{Binding Path=User, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"/>

            <TextBlock 
                x:Name="created" 
                Grid.Row="1"
                Text="{Binding Path=Created, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"/>

            <TextBlock 
                x:Name="client" 
                Grid.Row="2"
                Text="{Binding Path=Client, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"/>

            <TextBlock 
                x:Name="address" 
                Grid.Row="3"
                Text="{Binding Path=Address, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"/>

            <TextBlock 
                x:Name="report" 
                Grid.Row="4"
                Text="{Binding Path=Remark, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"/>
        </Grid>
    </Border>

    <UserControl.ContextMenu>
        <ContextMenu>
            <MenuItem Header="Создать задачу" Click="NewTask_Click"/>
            <MenuItem Header="Отметить как прочитанную"  Click="MarkAsReaded_Click"/>
        </ContextMenu>
    </UserControl.ContextMenu>
</UserControl>
