<RibbonWindow 
    x:Class="Napoleon.ReturnPriceWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:Napoleon"
    mc:Ignorable="d"
    Title="Ввод заявки на возврат" 
    Height="600" 
    Width="1137"
    Loaded="RibbonWindow_Loaded"
    Icon="Images\napoleon.ico">

    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="20"/>
            </Grid.RowDefinitions>

            <Ribbon Grid.Row="0" SelectedIndex="0">
                <Ribbon.ApplicationMenu>
                    <RibbonApplicationMenu Visibility="Collapsed"/>
                </Ribbon.ApplicationMenu>

                <RibbonTab 
                    Header="Управление" 
                    KeyTip="H">

                    <RibbonGroup>
                        <RibbonButton
                            x:Name="btnSave" 
                            LargeImageSource="Images\save.png" 
                            Label="Экспорт в 1c" 
                            KeyTip="F5" 
                            Click="BtnSave_Click"
                            ToolTipTitle ="Сохранить (F5)"
                            ToolTipDescription="Сохранить заявку"/>
                    </RibbonGroup>
                    <RibbonGroup>
                        <Grid VerticalAlignment="Stretch">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Label Content="Фабрика" VerticalAlignment="Top" Grid.Row="0" HorizontalAlignment="Left"/>
                            <ComboBox x:Name="cbFactory" Width="220" Grid.Row="1" />
                        </Grid>
                    </RibbonGroup>
                    <RibbonGroup>
                        <StackPanel Margin="0" VerticalAlignment="Top">
                            <Label Content="Причина возврата" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                            <ComboBox  x:Name="cbCause"  VerticalAlignment="Top" Width="200"/>
                        </StackPanel>
                    </RibbonGroup>
                    <RibbonGroup>
                        <StackPanel Margin="0" VerticalAlignment="Top">
                            <Label Content="Лимит возврата" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                            <Label Content="{Binding Path=DocReturnLimit, RelativeSource={RelativeSource AncestorType=RibbonWindow}}" VerticalAlignment="Top" HorizontalAlignment="Left" MinWidth="150" MinHeight="20"/>
                        </StackPanel>
                    </RibbonGroup>
                </RibbonTab>
            </Ribbon>

            <Grid Grid.Row="1" x:Name="progressLayout" Visibility="Hidden">
                <ProgressBar  x:Name="progress" Height="30" IsIndeterminate="True"/>
                <TextBlock Text="Идет сохранение..." HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>

            <DataGrid 
                x:Name="grid" 
                AutoGenerateColumns="False" 
                LoadingRow="Grid_LoadingRow"
                Grid.Row="2"
                RowEditEnding="Grid_RowEditEnding" CanUserSortColumns="False" CanUserReorderColumns="False" CurrentCellChanged="grid_CurrentCellChanged" >

                <DataGrid.Resources>
                    <local:OrderValueConverter x:Key="OrderValueConverter"/>
                </DataGrid.Resources>

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="ContentTemplate">
                            <Setter.Value>
                                <DataTemplate>
                                    <TextBlock TextWrapping="Wrap" Text="{Binding}"></TextBlock>
                                </DataTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Производитель" x:Name="clmnFirm"  Binding="{Binding Manufacture}" Width="60" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Бренд" x:Name="clmnBrand" Binding="{Binding Brend}" Width="60" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Наименование" x:Name="clmnName" Binding="{Binding Name}" Width="*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Документ" x:Name="clmnPrefix" Binding="{Binding DocNumber}" Width="250" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Срок годности" Binding="{Binding Expired, StringFormat={}{0:dd.MM.yy}}" Width="100" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Партия" Binding="{Binding Party}" Width="100" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Цена" x:Name="Column5" Binding="{Binding Cost, StringFormat={}{0:n2}}" Width="80" IsReadOnly="True"/>
                    <!--
                    <DataGridTextColumn Header="План" x:Name="Column7" Binding="{Binding Plan}" Width="60" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Факт" x:Name="Column8" Binding="{Binding Fact}" Width="60" IsReadOnly="True"/>
                    -->
                    <DataGridTextColumn Header="Кол-во" x:Name="Column8" Binding="{Binding DlvQty}" Width="60" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Возврат" x:Name="Column9" Binding="{Binding Qty, UpdateSourceTrigger=LostFocus, Converter={StaticResource OrderValueConverter}}" Width="60"/>
                    <!--<DataGridTextColumn Header="В упак" x:Name="Column11" Binding="{Binding InPack}" Width="60" IsReadOnly="True"/>-->
                    <DataGridTextColumn Header="руб" x:Name="Column10" Binding="{Binding Sum, StringFormat={}{0:n2}}" Width="60" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>

            <Grid  
                Grid.Row="3" 
                >

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="60" />
                </Grid.ColumnDefinitions>
                
                <TextBlock Text="Итоги" Margin="0,0,10,0" FontWeight="Bold" HorizontalAlignment="Right" ></TextBlock>
                <TextBlock Text="{Binding Path=ResultQty, RelativeSource={RelativeSource AncestorType=RibbonWindow}}" Margin="0,0,10,0" FontWeight="Bold" Grid.Column="3" HorizontalAlignment="Left" />
                <TextBlock Text="{Binding Path=ResultSum, StringFormat={}{0:n2}, RelativeSource={RelativeSource AncestorType=RibbonWindow}}" Margin="0,0,10,0" FontWeight="Bold" Grid.Column="4" HorizontalAlignment="Left" />
            </Grid>
        </Grid>
    </Grid>
</RibbonWindow>
