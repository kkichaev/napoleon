<Window x:Class="Napoleon.DataFilterDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Napoleon"
        mc:Ignorable="d"
        Title="Укажите элементы фильтра" Height="309.646" Width="373.312">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <ListBox x:Name="list" Margin="0,0,0,40" ItemsSource="{Binding ElementName=Window, Path=Items}" Grid.ColumnSpan="2">
            <ListBox.ItemTemplate>
                <HierarchicalDataTemplate>
                    <CheckBox Content="{Binding Name}" IsChecked="{Binding Checked}"/>
                </HierarchicalDataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Button Content="Отмена" HorizontalAlignment="Left" Margin="15,0,0,10" VerticalAlignment="Bottom" Width="75" IsCancel="True" Grid.Row="1"/>
        <Button Content="OK" HorizontalAlignment="Right" Margin="0,0,15,10" VerticalAlignment="Bottom" Width="75" IsDefault="True" Click="Button_Click" Grid.Row="1" Grid.Column="1"/>

    </Grid>
</Window>
