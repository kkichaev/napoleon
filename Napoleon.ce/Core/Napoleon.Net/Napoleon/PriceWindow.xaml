<RibbonWindow 
    x:Class="Napoleon.PriceWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:Napoleon"
    mc:Ignorable="d"
    Title="PriceWindow" 
    Height="600" 
    Width="1137"
    Closed="RibbonWindow_Closed"
    Loaded="RibbonWindow_Loaded"
    Icon="Images\napoleon.ico">

    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="20"/>
            </Grid.RowDefinitions>

            <Ribbon Grid.Row="0" SelectedIndex="0">
                <Ribbon.ApplicationMenu>
                    <RibbonApplicationMenu Visibility="Collapsed"/>
                </Ribbon.ApplicationMenu>

                <RibbonTab 
                    Header="Управление" 
                    KeyTip="H">

                    <RibbonGroup>
                        <RibbonButton
                            Margin="0,15,0,0"
                            x:Name="btnSave" 
                            LargeImageSource="Images\save.png" 
                            Label="Сохранить" 
                            KeyTip="F5" 
                            Click="BtnSave_Click"
                            ToolTipTitle ="Сохранить (F5)"
                            ToolTipDescription="Сохранить заявку"/>
                    </RibbonGroup>
                    <RibbonGroup>
                        <Grid VerticalAlignment="Stretch">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Label Content="Дата отгрузки" VerticalAlignment="Top" Grid.Row="0" HorizontalAlignment="Left"/>
                            <DatePicker x:Name="dlvDate" SelectedDate="{Binding Path=DlvDate, RelativeSource={RelativeSource AncestorType=RibbonWindow}, Mode=TwoWay}" Grid.Row="1" SelectedDateChanged="DlvDate_SelectedDateChanged" />
                        </Grid>
                    </RibbonGroup>
                    <RibbonGroup>
                        <Grid VerticalAlignment="Stretch">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Label Content="Дата плана" VerticalAlignment="Top" Grid.Row="0" HorizontalAlignment="Left"/>
                            <DatePicker x:Name="planDate" SelectedDate="{Binding Path=PlanDate, RelativeSource={RelativeSource AncestorType=RibbonWindow}, Mode=OneWay}" Grid.Row="1" SelectedDateChanged="DlvDate_SelectedDateChanged" IsEnabled="False" />
                        </Grid>
                    </RibbonGroup>
                </RibbonTab>
            </Ribbon>

            <Grid Grid.Row="1" x:Name="progressLayout" Visibility="Hidden">
                <ProgressBar  x:Name="progress" Height="30" IsIndeterminate="True"/>
                <TextBlock Text="Идет сохранение..." HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>

            <DataGrid 
                x:Name="grid" 
                AutoGenerateColumns="False" 
                LoadingRow="Grid_LoadingRow"
                Grid.Row="2"
                RowEditEnding="Grid_RowEditEnding" CanUserSortColumns="False" CanUserReorderColumns="False" PreviewMouseLeftButtonDown="grid_PreviewMouseLeftButtonDown" PreviewMouseRightButtonDown="grid_PreviewMouseRightButtonDown">

                <DataGrid.Resources>
                    <local:OrderValueConverter x:Key="OrderValueConverter"/>
                </DataGrid.Resources>

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="ContentTemplate">
                            <Setter.Value>
                                <DataTemplate>
                                    <TextBlock TextWrapping="Wrap" Text="{Binding}"></TextBlock>
                                </DataTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Производитель" x:Name="clmnFirm"  Binding="{Binding Manufacture}" Width="60" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Бренд" x:Name="clmnBrand" Binding="{Binding Brend}" Width="60" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Признак" x:Name="clmnPrefix" Binding="{Binding Prefix}" Width="40" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Наименование" x:Name="clmnName" Binding="{Binding Name}" Width="*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Период cкидки" x:Name="clmnDiscount" Binding="{Binding DscPeriod}" Width="80" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Период акции" x:Name="clmnAction" Binding="{Binding ActPeriod}" Width="80" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Заказ ед. учеа" x:Name="Column9" Binding="{Binding Qty, UpdateSourceTrigger=LostFocus, Converter={StaticResource OrderValueConverter}}" Width="60"/>
                    <DataGridTextColumn Header="Цена" x:Name="Column5" Binding="{Binding Cost}" Width="60" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Кол-во прихода" x:Name="Column6" Binding="{Binding Sell}" Width="70" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Дата прихода" x:Name="Column7" Binding="{Binding SellDate}" Width="70" IsReadOnly="True"/>
                    <!--
                    <DataGridTextColumn Header="План" x:Name="Column7" Binding="{Binding Plan}" Width="60" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Факт" x:Name="Column8" Binding="{Binding Fact}" Width="60" IsReadOnly="True"/>
                    -->
                    <DataGridTextColumn Header="Упак" x:Name="Column8" Binding="{Binding PackName}" Width="60" IsReadOnly="True"/>
                    <DataGridTextColumn Header="В упак" x:Name="Column11" Binding="{Binding InPack}" Width="60" IsReadOnly="True"/>
                    <DataGridTextColumn Header="руб" x:Name="Column10" Binding="{Binding Sum, StringFormat={}{0:n2}}" Width="60" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>

            <Grid  
                Grid.Row="3" 
                >

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="60" />
                </Grid.ColumnDefinitions>
                
                <TextBlock Text="Итоги" Margin="0,0,10,0" FontWeight="Bold" HorizontalAlignment="Right" ></TextBlock>
                <TextBlock Text="{Binding Path=ResultRemn, RelativeSource={RelativeSource AncestorType=RibbonWindow}}" Margin="0,0,10,0" FontWeight="Bold" Grid.Column="1" HorizontalAlignment="Left" />
                <TextBlock Text="{Binding Path=ResultSel, RelativeSource={RelativeSource AncestorType=RibbonWindow}}" Margin="0,0,10,0" FontWeight="Bold" Grid.Column="2" HorizontalAlignment="Left" />
                <TextBlock Text="{Binding Path=ResultQty, RelativeSource={RelativeSource AncestorType=RibbonWindow}}" Margin="0,0,10,0" FontWeight="Bold" Grid.Column="3" HorizontalAlignment="Left" />
                <TextBlock Text="{Binding Path=ResultSum, StringFormat={}{0:n2}, RelativeSource={RelativeSource AncestorType=RibbonWindow}}" Margin="0,0,10,0" FontWeight="Bold" Grid.Column="4" HorizontalAlignment="Left" />
            </Grid>
        </Grid>
    </Grid>
</RibbonWindow>
