IDR_MAIN_FRAME SHMENUBAR DISCARDABLE
BEGIN
    IDR_MAIN_FRAME, 
    1,

    I_IMAGENONE, IDM_HELP, TBSTATE_ENABLED, TBSTYLE_DROPDOWN | TBSTYLE_AUTOSIZE, IDS_HELP, 0, 0,
END

