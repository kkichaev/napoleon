<?xml version='1.0' encoding="utf-8"?>
<Wix xmlns='http://schemas.microsoft.com/wix/2006/wi'>
  <Fragment Id='Folders'>
    <Directory Id='TARGETDIR' Name='SourceDir'>
      <Directory Id='ProgramFilesFolder' Name='PFiles'>
        <Directory Id='GRSoft' Name='GRSoft'>
          <Directory Id='_PRODUCT' Name='АСМТ Наполеон' >
			<Directory Id='MgrRuntimes' Name='runtimes' />
            <Directory Id='Update' Name='Update' />
             <Directory Id='ExpFolder' Name='Exp' />
          </Directory>
        </Directory>
      </Directory>

      <Directory Id="ProgramMenuFolder" Name="Programs">
        <Directory Id="ProgramMenuDir" Name="АСМТ Наполеон">
          <Component Id='ProgramMenuDir' Guid='02BBB265-9DBF-485d-9E11-30875E34903A'>
            <RemoveFolder Id='ProgramMenuDir' On='uninstall' />
            <RegistryValue Root="HKMU" Key="Software\[Manufacturer]\[ProductName]" Type="string" Value="" KeyPath="yes" />
          </Component>
          <Directory Id="Docs" Name="Документация">
            <Component Id='Docs' Guid='36465380-D1C8-48c3-B939-715F88DF363B'>
              <RemoveFolder Id='Docs' On='uninstall' />
              <RegistryValue Root="HKCU" Key="Software\[Manufacturer]\[ProductName]" Type="string" Value="Docs" KeyPath="yes" />
               <File Id='GRSOFT_URL' Name='Сайт разработчика.URL' DiskId='1' Source='Site_Napoleon.URL'  />
               <File Id='KB_URL' Name='База знаний.URL' DiskId='1' Source='KB.URL' />
            </Component>
          </Directory>
        </Directory>
        <Directory Id='StartupFolder' Name='Start' />
      </Directory>
    </Directory>

    <ComponentGroup Id='Docs'>
      <ComponentRef Id='ProgramMenuDir'/>
      <ComponentRef Id='Docs'/>
    </ComponentGroup>
  </Fragment>
</Wix>