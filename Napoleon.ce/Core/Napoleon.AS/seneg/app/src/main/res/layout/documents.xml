<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

	<LinearLayout
		android:id="@+id/llHeader"
		style="?header"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="horizontal">

		<TextView
			android:id="@+id/tvOrgInfo"
			style="?headerText"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="@string/organization" />
	</LinearLayout>

	<LinearLayout  
		android:layout_width="match_parent" 
		android:layout_height="wrap_content"
		android:visibility="gone">
		
		<TextView android:id="@+id/NameTitle" 
			android:layout_width="wrap_content" 
			android:layout_height="wrap_content" 
			android:textColor="#000000" 
			android:layout_weight="0.5" 
			android:background="@color/table_caption" 
			android:width="80dp" 
            android:textSize="16sp"/>

		<TextView
			android:id="@+id/DateTitle"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_weight="0.25"
			android:background="@color/table_caption"
			android:gravity="end"
			android:paddingLeft="7dp"
			android:paddingRight="3dp"
			android:text="@string/date"
			android:textColor="#000000"
			android:textSize="16sp" />

		<TextView
			android:id="@+id/SumColumnTitle"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_weight="0.40"
			android:background="@color/table_caption"
			android:gravity="end"
			android:paddingRight="3dp"
			android:text="@string/sum"
			android:textColor="#000000"
			android:textSize="16sp" />
	</LinearLayout>
			
	<ListView android:id="@+id/lvDocs" 
	    android:layout_weight="1"
		android:layout_height="0dp" 
		android:layout_width="match_parent" 
		android:background="@color/white" />

	<LinearLayout
		android:id="@+id/llTaskBar"
		style="?footer"
		android:layout_width="match_parent"
		android:layout_height="wrap_content">

		<ImageButton
			android:id="@+id/btnDocFilter"
			style="?footerButton"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:contentDescription="@string/selectDocType"
			android:visibility="gone"
			android:src="@drawable/icon" />

		<ImageButton
			android:id="@+id/btnStart"
			style="?footerButton"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:contentDescription="@string/start"
			android:src="@android:drawable/ic_media_play"
			android:visibility="gone" />

		<ImageButton
			android:id="@+id/btnBack"
			style="?footerButton"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:contentDescription="@string/back"
			android:src="@drawable/back" />

		<ImageButton
			android:id="@+id/btnNewDoc"
			style="?footerButton"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:contentDescription="@string/newDoc"
			android:src="@drawable/new_order" />

		<ImageButton
			android:id="@+id/btnGpsStatus"
			style="?footerButton"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:contentDescription="@string/gpsStatus"
			android:src="@drawable/gpsno" />

		<ImageButton
			android:id="@+id/btnTaskAlert"
			style="?footerButton"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:contentDescription="@string/send"
			android:src="@drawable/task_doc_2"
			android:visibility="gone" />

		<ImageButton
			android:id="@+id/btnSendDocList"
			style="?footerButton"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:contentDescription="@string/send"
			android:src="@drawable/send"
			android:visibility="gone" />

		<TextView
			android:id="@+id/tvTotalSum"
			style="?footerText"
			android:layout_width="0dip"
			android:layout_height="wrap_content"
			android:layout_gravity="center_vertical"
			android:layout_weight="1"
			android:gravity="end"
			android:visibility="gone"
			android:text="@string/sum" />
	</LinearLayout>
</LinearLayout>