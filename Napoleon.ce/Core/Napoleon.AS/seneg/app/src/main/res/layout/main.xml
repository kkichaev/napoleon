<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical" >

    <LinearLayout
        android:id="@+id/llTop"
        style="?header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivGoUp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@color/footer"
            android:contentDescription="@string/home"
            android:src="@drawable/goup"></ImageView>

        <TextView
            android:id="@+id/tvFirstColumnCaption"
            style="?headerText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_weight="1"
            android:text="@string/caption" />

        <TextView
            android:id="@+id/tvMainDocValColTitle"
            style="?headerText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:background="@color/footer"
            android:gravity="end"
            android:text="@string/sum" />
    </LinearLayout>

    <ListView
        android:id="@+id/lvMainOrgs"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/white" />

    <LinearLayout
        android:id="@+id/llFind"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="?findPanel" >

        <EditText
            android:id="@+id/edFind"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_weight="1"
            android:hint="@string/find_org"
            tools:ignore="TextFields"
            android:importantForAutofill="no" />

        <ImageButton
            android:id="@+id/btnDelFind"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@null"
            android:contentDescription="@string/delete"
            android:src="@drawable/ic_delete" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/linearLayout1"
        style="?footer"
        android:layout_width="fill_parent" >

        <ImageButton
            android:id="@+id/btnDocFilter"
            style="?footerButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/icon"
            android:visibility="gone"
            tools:ignore="ContentDescription" />

        <ImageButton
            android:id="@+id/btnMode"
            style="?footerButton"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/icon"
            tools:ignore="ContentDescription" />

        <ImageButton
            android:id="@+id/btnLines"
            style="?footerButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/line_2"
            android:visibility="gone"
            tools:ignore="ContentDescription" />

        <ImageButton
            android:id="@+id/btnBack"
            style="?footerButton"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/back"
            android:src="@drawable/back" />

        <ImageButton
            android:id="@+id/btnFind"
            style="?footerButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/find"
            tools:ignore="ContentDescription" />

        <TextView
            android:id="@+id/tvTotalSum"
            style="?footerText"
            android:layout_width="0dip"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_weight="1"
            android:gravity="end"
            android:visibility="gone"
            android:text="@string/sum" />
    </LinearLayout>
</LinearLayout>