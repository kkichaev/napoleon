<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical" >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical" >

        <TextView
            android:id="@+id/textView2"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:text="" />

	    <LinearLayout
	        android:layout_width="match_parent"
	        android:layout_height="wrap_content"
	        android:layout_gravity="center_vertical"
			android:paddingLeft="5dp"
			android:paddingRight="5dp" 
	        android:orientation="vertical" >

		     <TextView
		         android:id="@+id/textView1"
		         android:layout_width="wrap_content"
		         android:layout_height="wrap_content"
		         android:text="@string/enter_pin" />
		
			<LinearLayout
		        android:layout_width="match_parent"
		        android:layout_height="wrap_content" >
		
		        <EditText
		            android:id="@+id/edPin"
		            android:layout_width="0dip"
		            android:layout_height="wrap_content"
		            android:layout_weight="1"
	            	android:inputType="textPassword" 
		            android:ems="10" />
		
		        <ImageButton
		            android:id="@+id/btnSync"
		            android:layout_width="wrap_content"
		            android:layout_height="wrap_content"
		            android:src="@drawable/sync" />
		
		    </LinearLayout>

		    <Button
		        android:id="@+id/btnOK"
		        android:layout_width="wrap_content"
		        android:layout_height="wrap_content"
		        android:layout_gravity="center_horizontal"
		        android:textSize="18sp"
		        android:padding="20dp"
		        android:text="@string/do_pin" />

	    </LinearLayout>

	    <TextView
	        android:id="@+id/textView3"
	        android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="1"
	        android:text="" />
    
    </LinearLayout>

    <TableLayout android:layout_width="fill_parent" 
			android:id="@+id/tableLayout1" 
			android:background="@color/white" 
			android:layout_marginTop="2dp"
			android:paddingLeft="5dp"
			android:paddingRight="5dp" 
			android:layout_height="wrap_content" 
			android:stretchColumns="*" 
            android:shrinkColumns="*">
			
			<TableRow android:layout_height="wrap_content" 
				android:id="@+id/tableRow1" 
				android:layout_width="wrap_content">
				
				<ImageButton android:layout_height="wrap_content" 
					android:contentDescription="@string/digit"
					android:layout_width="wrap_content" 
					android:id="@+id/btn1" 
					android:src="@drawable/k1" 
					android:tag="1"/>
					
				<ImageButton android:layout_height="wrap_content" 
					android:contentDescription="@string/digit"
					android:layout_width="wrap_content" 
					android:id="@+id/btn2" 
					android:tag="2" 
					android:src="@drawable/k2"/>
					
				<ImageButton android:layout_height="wrap_content" 
					android:contentDescription="@string/digit"
					android:layout_width="wrap_content" 
					android:src="@drawable/k3" 
					android:tag="3" 
					android:id="@+id/btn3"/>
				
			</TableRow>
			
			<TableRow android:layout_height="wrap_content" 
				android:id="@+id/tableRow2" 
				android:layout_width="wrap_content">
				
				<ImageButton android:layout_width="wrap_content" 
					android:contentDescription="@string/digit"
                	android:layout_height="wrap_content" 
                	android:id="@+id/btn4" 
                	android:tag="4" 
                	android:src="@drawable/k4"/>
			    
			    <ImageButton android:layout_height="wrap_content" 
					android:contentDescription="@string/digit"
					android:src="@drawable/k5" 
					android:tag="5" 
					android:id="@+id/btn5" 
					
					android:layout_width="wrap_content"/>
			    <ImageButton android:layout_height="wrap_content" 
					android:contentDescription="@string/digit"
					android:layout_width="wrap_content" 
					android:tag="6" 
					android:src="@drawable/k6" 
					android:id="@+id/btn6"/>
					
			</TableRow>
			
			<TableRow android:layout_height="wrap_content" 
				android:id="@+id/tableRow3" 
				android:layout_width="wrap_content">
				
				<ImageButton android:layout_height="wrap_content" 
					android:contentDescription="@string/digit"
					android:layout_width="wrap_content" 
					android:id="@+id/btn7" 
					android:src="@drawable/k7" 
					android:tag="7"/>
					
				<ImageButton android:layout_height="wrap_content" 
					android:contentDescription="@string/digit"
					android:layout_width="wrap_content" 
					android:tag="8" 
					android:src="@drawable/k8" 
					android:id="@+id/btn8"/>
					
			    <ImageButton android:layout_height="wrap_content" 
					android:contentDescription="@string/digit"
					android:layout_width="wrap_content" 
					android:id="@+id/btn9" 
					android:src="@drawable/k9" 
					android:tag="9"/>
					
			</TableRow>
			
			<TableRow android:layout_height="wrap_content" 
				android:layout_width="wrap_content">
			    
			    <ImageButton android:layout_height="wrap_content" 
					android:contentDescription="@string/digit"
					android:layout_width="wrap_content" 
					android:src="@drawable/k0" 
					android:tag="0" 
					android:layout_span="2"
					android:id="@+id/btn0"/>

			    			    			    
			    <ImageButton android:layout_width="wrap_content" 
					android:contentDescription="@string/digit"
                	android:layout_height="wrap_content" 
                	android:tag="7" 
                	android:id="@+id/btnDel" 
                	android:src="@drawable/del"/>
                	
			</TableRow>
	
		</TableLayout>
</LinearLayout>
