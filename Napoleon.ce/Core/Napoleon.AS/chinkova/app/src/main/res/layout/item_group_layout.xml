<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:orientation="vertical" >

    <HorizontalScrollView
        android:id="@+id/hswPricePage"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:background="@color/footer" 
        android:visibility="gone" >

        <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal" >

            <TextView
                android:id="@+id/tvHome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableLeft="@drawable/price_home"
                android:gravity="center_vertical"
                android:textColor="@color/black"
                tools:ignore="HardcodedText" />

            <LinearLayout
                android:id="@+id/llPath"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:orientation="horizontal" >
            </LinearLayout>
        </LinearLayout>
    </HorizontalScrollView>

    <LinearLayout
        android:id="@+id/llInfo"
        android:layout_width="match_parent"
        style="?header"
        android:orientation="horizontal">
            <TextView
                android:id="@+id/tvInfo"
                style="?headerText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="info"
                tools:ignore="NestedWeights,HardcodedText" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/llPriceControl"
        style="?header"
        android:layout_width="match_parent"
        >

        <ImageView
            android:id="@+id/ivGoUp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/goup"
            tools:ignore="ContentDescription" >
        </ImageView>

        <LinearLayout
            android:id="@+id/llLables"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:padding="0dp"
            tools:ignore="NestedWeights" >

            <TextView
                android:id="@+id/tvItemSelectUpLevel"
                style="?headerText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/price"
                tools:ignore="NestedWeights" >
            </TextView>
        </LinearLayout>

        <ImageView
            android:id="@+id/ivFilter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="5dp"
            android:layout_marginTop="5dp"
            android:src="@drawable/filter"
            android:visibility="gone"
            tools:ignore="ContentDescription" >
        </ImageView>
    </LinearLayout>

    <FrameLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:background="@color/white" 
        android:layout_weight="1">

        <ListView
            android:id="@+id/lvOrderItemSelect"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:background="#c0ccff"/>

        <ImageView
            android:id="@+id/ivFilterLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="right|bottom"
            android:layout_marginBottom="20dp"
            android:layout_marginRight="10dp"
            android:layout_marginTop="10dp"
            android:src="@drawable/filter"
            android:visibility="gone"
            tools:ignore="ContentDescription" >
        </ImageView>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/llFind"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:orientation="horizontal" >

        <EditText
            android:id="@+id/edFind"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginLeft="3dp"
            android:layout_marginRight="3dp"
            android:layout_weight="1"
            tools:ignore="TextFields" />

        <ImageButton
            android:id="@+id/btnDelFind"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_delete"
            tools:ignore="ContentDescription" />

        <Spinner
            android:id="@+id/spFind"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:entries="@array/wh_find_choices"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/linearLayout1"
        android:layout_width="match_parent"
        style="?footer">

        <ImageButton
            android:id="@+id/btnUp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="?footerButton"
            android:src="@drawable/up"
            tools:ignore="ContentDescription" />

        <ImageButton
            android:id="@+id/btnDown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="?footerButton"
            android:src="@drawable/down"
            tools:ignore="ContentDescription" />

        <ImageButton
            android:id="@+id/btnLines"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="?footerButton"
            android:src="@drawable/line_2"
            tools:ignore="ContentDescription" />

        <ImageButton
            android:id="@+id/btnFind"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="?footerButton"
            android:src="@drawable/find"
            tools:ignore="ContentDescription" />

        <ImageButton
            android:id="@+id/btnPack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="?footerButton"
            android:src="@drawable/pack_off"
            android:visibility="gone"
            tools:ignore="ContentDescription" />

        <TextView android:layout_height="wrap_content"
            android:text="@string/sum"
            style="?footerText"
            android:layout_width="0dip"
            android:layout_weight="1"
            android:layout_gravity="center_vertical"
            android:gravity="right"
            android:id="@+id/tvTotalSum"/>
    </LinearLayout>

</LinearLayout>