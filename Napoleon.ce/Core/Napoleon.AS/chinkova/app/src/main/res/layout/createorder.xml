<?xml version="1.0" encoding="utf-8"?>
<android.gesture.GestureOverlayView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/gestures"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:gestureStrokeType="single"
    android:eventsInterceptionEnabled="true"
    android:orientation="vertical"
    android:gestureColor="#00000000"
    android:uncertainGestureColor="#00000000">
    
<LinearLayout
 	android:layout_height="fill_parent" 
 	android:layout_width="fill_parent" 
 	android:background="#FFFFFF" 
 	android:orientation="vertical">

	<LinearLayout
		android:id="@+id/llHeader"
		style="?header"
		android:layout_width="fill_parent"
		android:orientation="horizontal" >

		<TextView
			android:id="@+id/tvOrgName"
			style="?headerText"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="@string/organization" />
	</LinearLayout>
	
	<ScrollView 
		android:fillViewport="true"
    	android:layout_width="fill_parent"
    	android:layout_height="wrap_content"
    	android:layout_weight="1"
    	android:id="@+id/scrollview"> 
    	
		<LinearLayout
		    android:layout_width="fill_parent"
		    android:layout_height="fill_parent"
		    android:background="#FFFFFF"
		    android:orientation="vertical" >

		   <TableLayout android:layout_width="fill_parent" 
		    	android:stretchColumns="*"
		    	android:id="@+id/tableLayout1" 
		    	android:layout_height="wrap_content" 
		    	android:layout_weight="0">
		       <TableRow android:id="@+id/tableRow1" 
			    	android:padding="2dp"
		        	android:layout_width="wrap_content" 
		        	android:layout_height="wrap_content">
					<LinearLayout android:id="@+id/LinearLayout02" 
						android:layout_height="wrap_content" 
						android:orientation="horizontal" 
						android:layout_weight="1" 
						android:layout_width="fill_parent">
					
						<TextView android:id="@+id/TextView01" 
							android:layout_width="wrap_content" 
							android:layout_height="wrap_content"
							android:textColor="#000000" 
							android:text="Дата:" 
							android:layout_weight="1"></TextView>
						
						<TextView android:layout_width="wrap_content" 
							android:layout_height="wrap_content" 
							android:textColor="#000000" 
							android:text="25.11.2010" 
							android:layout_weight="1" 
							android:id="@+id/tvDate" 
							android:layout_marginLeft="5dp" 
							android:layout_marginRight="5dp" 
							android:textStyle="bold"></TextView>
					</LinearLayout>
					<LinearLayout android:id="@+id/LinearLayout03" 
						android:layout_height="wrap_content" 
						android:layout_width="fill_parent" 
						android:layout_weight="1" 
						android:orientation="horizontal">
						
						<TextView android:id="@+id/TextView02" 
							android:layout_width="wrap_content" 
							android:layout_height="wrap_content"
							android:textColor="#000000" 
							android:text="Время:" 
							android:layout_weight="1"></TextView>
							
						<TextView android:layout_width="wrap_content" 
							android:layout_height="wrap_content" 
							android:textColor="#000000" 
							android:text="00:00" 
							android:id="@+id/tvTime" 
							android:layout_marginLeft="5dp" 
							android:layout_marginRight="5dp" 
							android:textStyle="bold"></TextView>
					</LinearLayout>
		        </TableRow>
		        
		       <TableRow 
		        	android:layout_width="wrap_content" 
		        	android:layout_height="wrap_content">

			<CheckBox android:layout_width="wrap_content" 
				android:layout_height="wrap_content" 
				android:id="@+id/cbCreateOrderCash" 
				android:text="Наличные" 
				android:textColor="#000000" 
				/>

			<CheckBox
              android:id="@+id/cbDocPacket"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Пакет документов" />
		       </TableRow>
		    </TableLayout>

		   <LinearLayout android:id="@+id/LinearLayout23" 
				android:layout_height="wrap_content" 
				android:layout_width="fill_parent" 
				android:visibility="gone"
				android:orientation="horizontal">
           	<TextView
			    android:id="@+id/tvDelay"
			    android:layout_width="wrap_content"
			    android:layout_height="wrap_content"
			    android:layout_marginLeft="3dp"
			    android:text="Отсрочка: 0"
			    android:textColor="#000000"
			    android:textStyle="bold" />
				
          <LinearLayout
              android:id="@+id/LinearLayout33"
              android:layout_width="fill_parent"
              android:layout_height="wrap_content"
              android:orientation="vertical" >

			<CheckBox android:layout_width="wrap_content" 
				android:layout_height="wrap_content" 
				android:id="@+id/cbDoverPay" 
				android:text="Доверенность на деньги" 
				android:textColor="#000000" 
				></CheckBox>
			<CheckBox android:layout_width="wrap_content" 
				android:layout_height="wrap_content" 
				android:id="@+id/cbDoverRet" 
				android:text="Доверенность на возврат" 
				android:textColor="#000000" 
				></CheckBox>
			</LinearLayout>

		</LinearLayout>
			
		   <TableLayout android:layout_width="fill_parent" 
		    	android:stretchColumns="1"
		    	android:layout_height="wrap_content" 
		    	android:layout_weight="0">
			
		       <TableRow
			    	android:padding="2dp"
			    	android:visibility="gone"
		        	android:layout_width="wrap_content" 
		        	android:layout_height="wrap_content">
					
					<TextView android:id="@+id/TextView03" 
						android:layout_height="wrap_content" 
						android:text="Фирма" 
						android:textColor="#000000" 
						android:layout_marginLeft="5dp" 
						android:layout_marginRight="5dp" android:layout_width="wrap_content" 
						android:layout_gravity="center_vertical"></TextView>
								
					<Spinner android:layout_height="wrap_content" 
						android:layout_weight="1" 
						android:id="@+id/spFirma" android:layout_width="fill_parent"></Spinner>
					
				</TableRow>

		       <TableRow
			    	android:padding="2dp"
		        	android:layout_width="wrap_content" 
		        	android:layout_height="wrap_content">
					
					<TextView
					    android:layout_width="wrap_content"
					    android:layout_height="wrap_content"
					    android:layout_gravity="center_vertical"
					    android:layout_marginLeft="5dp"
					    android:layout_marginRight="5dp"
					    android:text="@string/sklad"
					    android:textColor="#000000" >
</TextView>
								
					<Spinner android:layout_height="wrap_content" 
						android:layout_weight="1" 
						android:id="@+id/spSklad" android:layout_width="fill_parent"></Spinner>
					
				</TableRow>
		       		       
		       <TableRow 
			    	android:padding="2dp"
		        	android:layout_width="wrap_content" 
		        	android:layout_height="wrap_content">
					
					<TextView
						android:layout_height="wrap_content" 
						android:textColor="#000000" 
						android:text="Цена" 
						android:layout_marginLeft="5dp" 
						android:layout_marginRight="5dp" android:layout_width="wrap_content" 
						android:layout_gravity="center_vertical"></TextView>	
					<Spinner android:layout_height="wrap_content" 
						android:layout_weight="1" android:id="@+id/spPrices" android:layout_width="fill_parent"></Spinner>
				</TableRow>		

		       <TableRow
		           android:layout_width="wrap_content"
		           android:layout_height="wrap_content"
		           android:padding="2dp"
		           android:visibility="gone" >
					
					<TextView
						android:layout_height="wrap_content" 
						android:textColor="#000000" 
						android:text="Склад" 
						android:layout_marginLeft="5dp" 
						android:layout_marginRight="5dp" android:layout_width="wrap_content" 
						android:layout_gravity="center_vertical"></TextView>

					<EditText
					    android:id="@+id/edWhRemark"
					    android:layout_width="wrap_content"
					    android:layout_height="wrap_content"
					    android:ems="10" >

					    <requestFocus />
					</EditText>
					
				</TableRow>		
		       
		       <TableRow
		           android:layout_width="wrap_content"
		           android:layout_height="wrap_content"
		           android:padding="2dp"
		           android:visibility="gone" >
					
					<TextView
						android:layout_height="wrap_content" 
						android:textColor="#000000" 
						android:text="Прочее" 
						android:layout_marginLeft="5dp" 
						android:layout_marginRight="5dp" android:layout_width="wrap_content" 
						android:layout_gravity="center_vertical"></TextView>

					<EditText
					    android:id="@+id/edOthRemark"
					    android:layout_width="wrap_content"
					    android:layout_height="wrap_content"
					    android:ems="10" />

				</TableRow>		
		       				
				<TableRow android:id="@+id/ftrAddress"
			    	android:padding="2dp"
			    	android:visibility="gone"
		        	android:layout_width="wrap_content" 
		        	android:layout_height="wrap_content">
					
					<TextView  
						android:layout_height="wrap_content" 
						android:text="Адрес" 
						android:textColor="#000000" 
						android:layout_marginLeft="5dp" 
						android:layout_marginRight="5dp" android:layout_width="wrap_content" 
						android:layout_gravity="center_vertical"></TextView>
								
					<Spinner android:layout_height="wrap_content" 
						android:id="@+id/spAddress" android:layout_width="fill_parent"></Spinner>
					
				</TableRow>
			</TableLayout>
			
			<LinearLayout android:id="@+id/LinearLayout07" 
				android:layout_height="wrap_content" 
				android:layout_width="fill_parent" 
				android:layout_weight="1">
				
				<EditText android:layout_weight="1" 
					android:layout_height="fill_parent" 
					android:layout_width="fill_parent" 
					android:id="@+id/edCreateOrderNotes" 
					android:gravity="top|left" android:minLines="2" android:lines="2"></EditText>
			</LinearLayout>
		</LinearLayout>
	</ScrollView>

	<LinearLayout
		android:id="@+id/LinearLayout08"
		style="?footer"
		android:layout_width="fill_parent" >

		<TextView
			android:id="@+id/btnCancel"
			android:layout_width="0dp"
			android:layout_height="match_parent"
			android:layout_weight="1"
			android:text="@string/cancel"
			style="?textButton"
			android:layout_marginRight="7dp">
		</TextView>

		<TextView
			android:id="@+id/btnOK"
			android:layout_width="0dp"
			android:layout_height="match_parent"
			android:layout_weight="3"
			android:text="@string/ok"
			style="?textButton" >
		</TextView>
	</LinearLayout>
</LinearLayout>
</android.gesture.GestureOverlayView>