<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
  	android:layout_height="fill_parent" 
  	android:layout_width="fill_parent" 
  	android:orientation="vertical" 
  	android:background="@color/white" 
  	android:baselineAligned="false">

    <ScrollView 
        android:layout_width="fill_parent"
        android:layout_height="0dip"
        android:layout_weight="1"
        android:fillViewport="true"
        >
    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" >
  	
    <LinearLayout android:layout_width="fill_parent" 
    	android:id="@+id/linearLayout1" 
    	android:layout_height="wrap_content" 
    	android:background="@color/blue">

        <TextView
            android:id="@+id/tvPriceName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:layout_weight="1"
            android:background="@color/white"
            android:minLines="2"
            android:paddingLeft="5dp"
            android:paddingRight="5dp"
            android:paddingTop="10dp"
            android:textColor="#000000" />

		<ImageView
			android:id="@+id/ivPresent"
			android:layout_width="wrap_content"
			android:layout_height="fill_parent"
			android:layout_marginBottom="2dp"
			android:background="@color/white"
			android:paddingTop="4dp"
			android:src="@drawable/image"
			 />

        <ImageView
            android:id="@+id/ivInfo"
            android:layout_width="wrap_content"
            android:layout_height="fill_parent"
            android:layout_marginBottom="2dp"
            android:background="@color/white"
            android:paddingRight="4dp"
            android:paddingTop="4dp"
            android:src="@drawable/info"
             />

    </LinearLayout>
    
    <LinearLayout 
        android:layout_width="fill_parent"
    	android:id="@+id/linearLayout12" 
    	android:layout_height="0dip" 
        android:layout_weight="1" 
    	android:orientation="vertical">
    <LinearLayout android:layout_width="fill_parent" 
    	android:id="@+id/linearLayout2" 
    	android:layout_height="wrap_content" 
    	android:orientation="horizontal" 
    	android:padding="3dp" 
    	android:baselineAligned="false">
    	
        <TableLayout android:id="@+id/tableLayout2" 
        	android:layout_width="wrap_content" 
        	android:layout_height="fill_parent" 
        	android:layout_weight="1" 
        	android:stretchColumns="*">
        	
            <TableRow android:id="@+id/tableRow4" 
            	android:layout_width="wrap_content" 
            	android:layout_height="wrap_content">
            	
                <TextView android:id="@+id/textView1" 
                	android:layout_height="wrap_content" 
                	android:layout_width="wrap_content" 
                	android:textColor="@color/black" 
                	android:text="@string/onWh" />
                	
                <TextView android:layout_height="wrap_content" 
                	android:layout_width="wrap_content" 
                	android:textColor="@color/black" 
                	android:text="TextView" 
                	android:id="@+id/tvQty" 
                	android:gravity="right" />
            </TableRow>
            
            <TableRow android:id="@+id/tableRow5" 
            	android:layout_width="wrap_content" 
            	android:layout_height="wrap_content">
            	
                <TextView android:id="@+id/textView2" 
                	android:layout_height="wrap_content" 
                	android:layout_width="wrap_content" 
                	android:textColor="@color/black" 
                	android:text="@string/cost" />
                	
                <TextView android:layout_height="wrap_content" 
                	android:layout_width="wrap_content" 
                	android:textColor="@color/black" 
                	android:text="TextView" 
                	android:id="@+id/tvPrice" 
                	android:gravity="right" />
            </TableRow>
            
            <TableRow android:id="@+id/tableRow6" 
            	android:layout_width="wrap_content" 
            	android:layout_height="wrap_content">
            	
                <TextView android:id="@+id/textView3" 
                	android:layout_height="wrap_content" 
                	android:layout_width="wrap_content" 
                	android:textColor="@color/black" 
                	android:text="@string/inPack" />
                	
                <TextView android:layout_height="wrap_content" 
                	android:layout_width="wrap_content" 
                	android:textColor="@color/black" 
                	android:id="@+id/tvQtyInPack" 
                	android:text="TextView" 
                	android:gravity="right" />
            </TableRow>
            
            <TableRow android:id="@+id/tableRow7" 
            	android:layout_width="wrap_content" 
            	android:layout_height="wrap_content">
            	
                <TextView android:id="@+id/textView4" 
                	android:layout_height="wrap_content" 
                	android:layout_width="wrap_content" 
                	android:textColor="@color/black" 
                	android:text="@string/sum1" />
                	
                <TextView android:layout_height="wrap_content" 
                	android:layout_width="wrap_content" 
                	android:textColor="@color/black" 
                	android:id="@+id/tvSum" 
                	android:gravity="right" 
                	android:text="TextView" 
                	android:textStyle="bold" />
            </TableRow>
        </TableLayout>
        
        <TableLayout android:id="@+id/tableLayout3" 
        	android:layout_width="wrap_content" 
        	android:layout_height="fill_parent" 
        	android:layout_weight="1" 
        	android:stretchColumns="1" 
        	android:paddingLeft="3dp">
        	
            <TableRow android:id="@+id/trRest" 
            	android:layout_width="wrap_content" 
            	android:layout_height="wrap_content"
            	android:visibility="gone">
            	
                <TextView android:id="@+id/textView5" 
                	android:layout_width="wrap_content" 
                	android:layout_height="wrap_content" 
                	android:textColor="@color/black" 
                	android:text="@string/orgRest" 
                	android:paddingRight="7dp" />
                	
                <EditText
                    android:inputType="numberDecimal" 
                    android:layout_height="wrap_content" 
                	android:layout_width="wrap_content" 
                	android:text="" 
                	android:id="@+id/edRest" />
            </TableRow>
            
            <TableRow android:id="@+id/tableRow8" 
            	android:layout_width="wrap_content" 
            	android:layout_height="wrap_content">
            	
                <TextView android:id="@+id/textView6" 
                	android:layout_width="wrap_content" 
                	android:layout_height="wrap_content" 
                	android:textColor="@color/black" 
                	android:text="@string/orderQty" 
                	android:paddingRight="7dp" />
                	
                <EditText android:layout_height="wrap_content" 
                    android:inputType="numberDecimal" 
                	android:layout_width="wrap_content" 
                	android:text="" 
                	android:id="@+id/edCount" />
            </TableRow>
            
            <TableRow 
            	android:layout_width="wrap_content" 
            	android:layout_height="wrap_content">
            	
                <CheckBox android:layout_width="wrap_content" 
                	android:layout_height="wrap_content" 
                	android:layout_span="2" 
                	android:id="@+id/cbKG" 
                	android:textColor="@color/black" 
                	android:text="в кг" />
            </TableRow>
            <TableRow android:id="@+id/tableRow9" 
                android:visibility="gone"
            	android:layout_width="wrap_content" 
            	android:layout_height="wrap_content">
            	
                <CheckBox android:layout_width="wrap_content" 
                	android:layout_height="wrap_content" 
                	android:layout_span="2" 
                	android:id="@+id/cbPackets" 
                	android:textColor="@color/black" 
                	android:text="@string/packing" />
            </TableRow>
        </TableLayout>
   </LinearLayout>
   	<LinearLayout
   	    android:layout_width="fill_parent"
   	    android:layout_height="wrap_content"
   	    android:orientation="horizontal"
   	    >

   		<TextView
   		    android:layout_width="wrap_content"
   		    android:layout_height="wrap_content"
            android:textColor="@color/black" 
            android:layout_gravity="center_vertical"
   		    android:text="Примечание\nсклада" />

		<EditText
		    android:id="@+id/edWhRemark"
		    android:layout_width="0dp"
		    android:layout_height="wrap_content"
		    android:layout_weight="1"
		    android:ems="10" >

		</EditText>
		</LinearLayout>
		
		<LinearLayout
   	    android:layout_width="fill_parent"
   	    android:layout_height="wrap_content"
   	    android:orientation="horizontal"
   	    >
   	    <TextView
   		    android:id="@+id/textView7"
   		    android:layout_width="wrap_content"
   		    android:layout_height="wrap_content"
            android:textColor="@color/black" 
   		    android:text="Примечание" />

		<EditText
		    android:id="@+id/edRemark"
		    android:layout_width="fill_parent"
		    android:layout_height="wrap_content"
		    android:ems="10" >

		</EditText>
		    
		</LinearLayout>   	
		<LinearLayout
	        android:id="@+id/llPrcInfo"
	        android:layout_width="fill_parent"
	        android:layout_height="wrap_content"
	        android:orientation="horizontal"
	        >
	
	        <TextView
	            android:id="@+id/tvPrcInfo"
	            android:layout_width="fill_parent"
	            android:layout_height="wrap_content"
	            android:paddingLeft="15dp"
	            android:paddingTop="3dp"
	            android:text=""
	            android:textColor="@color/red"
	            android:textSize="20sp"
	            android:textStyle="bold" />
	
	    </LinearLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/ivPresent2"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:background="@color/white"
        android:paddingTop="4dp"
        android:src="@drawable/image" />
	
	<com.grsoft.napoleon.StripedLinearLayout 
		android:layout_width="fill_parent" 
		android:layout_height="wrap_content" 
		android:orientation="horizontal" 
		android:id="@+id/llSilesHistory" />
    </LinearLayout>
    </ScrollView>

	<LinearLayout
		android:id="@+id/llKeyboard"
		android:layout_width="fill_parent"
		android:layout_height="wrap_content"
		android:background="@color/blue"
		android:baselineAligned="false">

		<LinearLayout
			android:layout_width="0dip"
			android:layout_weight="1"
			android:layout_height="wrap_content"
			>

			<TableLayout
				android:id="@+id/tableLayout1"
				android:layout_width="fill_parent"
				android:layout_height="fill_parent"
				android:layout_marginTop="2dp"
				android:background="@color/white"
				android:shrinkColumns="*"
				android:stretchColumns="*"
				>

				<TableRow
					android:id="@+id/tableRow1"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content" >

					<ImageButton
						android:id="@+id/btn1"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:contentDescription="@string/digit"
						android:src="@drawable/k1"
						android:tag="1" />

					<ImageButton
						android:id="@+id/btn2"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:contentDescription="@string/digit"
						android:src="@drawable/k2"
						android:tag="2" />

					<ImageButton
						android:id="@+id/btn3"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:contentDescription="@string/digit"
						android:src="@drawable/k3"
						android:tag="3" />

					<ImageButton
						android:id="@+id/btn4"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:contentDescription="@string/digit"
						android:src="@drawable/k4"
						android:tag="4" />

					<ImageButton
						android:id="@+id/btn5"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:contentDescription="@string/digit"
						android:src="@drawable/k5"
						android:tag="5" />

				</TableRow>

				<TableRow
					android:id="@+id/tableRow2"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content" >

					<ImageButton
						android:id="@+id/btn6"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:contentDescription="@string/digit"
						android:src="@drawable/k6"
						android:tag="6" />

					<ImageButton
						android:id="@+id/btn7"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:contentDescription="@string/digit"
						android:src="@drawable/k7"
						android:tag="7" />

					<ImageButton
						android:id="@+id/btn8"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:contentDescription="@string/digit"
						android:src="@drawable/k8"
						android:tag="8" />

					<ImageButton
						android:id="@+id/btn9"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:contentDescription="@string/digit"
						android:src="@drawable/k9"
						android:tag="9" />

					<ImageButton
						android:id="@+id/btn0"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:contentDescription="@string/digit"
						android:src="@drawable/k0"
						android:tag="0" />

				</TableRow>

				<TableRow
					android:id="@+id/tableRow3"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content" >

					<ImageButton
						android:id="@+id/btnDel"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:contentDescription="@string/digit"
						android:src="@drawable/del"
						android:tag="7" />

					<ImageButton
						android:id="@+id/btnComma"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:contentDescription="@string/digit"
						android:src="@drawable/zap"
						android:tag="," />

					<ImageButton
						android:id="@+id/btnOK"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_span="3"
						android:contentDescription="@string/ok"
						android:src="@drawable/ok" />
				</TableRow>
			</TableLayout>

		</LinearLayout>

		<LinearLayout
			android:background="@color/white"
			android:layout_marginTop="2dp"
			android:orientation="vertical"
			android:layout_width="wrap_content"
			android:layout_height="fill_parent"
			>

			<ImageButton
				android:visibility="gone"
				android:id="@+id/btnMovePrev"
				android:layout_width="wrap_content"
				android:layout_weight="0.5"
				android:layout_height="wrap_content"
				android:layout_gravity="center_vertical|center_horizontal"
				android:contentDescription="@string/digit"
				android:src="@drawable/price_prev"
				>
			</ImageButton>
			<ImageButton
				android:visibility="gone"
				android:id="@+id/btnMoveNext"
				android:layout_width="wrap_content"
				android:layout_weight="0.5"
				android:layout_height="wrap_content"
				android:layout_gravity="center_vertical|center_horizontal"
				android:contentDescription="@string/digit"
				android:src="@drawable/price_next"
				/>

		</LinearLayout>
	</LinearLayout>
</LinearLayout>
