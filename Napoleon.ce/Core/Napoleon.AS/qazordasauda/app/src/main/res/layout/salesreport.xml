<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/llHeader"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        style="?header">

        <TextView
            style="?headerText"
            android:text=""
            android:id="@+id/tvFilterInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        >

        <TextView android:id="@+id/NameTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textColor="#000000"
            android:layout_weight="1"
            android:text="Название"
            android:paddingLeft="3dp"
            android:background="@color/table_caption"
            android:width="80dp"
            android:textSize="16sp"/>

        <TextView android:id="@+id/DateTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="right"
            android:textColor="#000000"
            android:text="Кол-во"
            android:paddingRight="3dp"
            android:background="@color/table_caption"
            android:textSize="16sp"/>

        <TextView android:id="@+id/SumColumnTitle"
            android:layout_width="90dp"
            android:layout_height="wrap_content"
            android:textColor="#000000"
            android:text="@string/sum"
            android:gravity="right"
            android:background="@color/table_caption"
            android:paddingRight="3dp"
            android:textSize="16sp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/llProgress"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <ProgressBar
            android:id="@+id/pgBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:indeterminate="true"
            android:layout_height="wrap_content"
            />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingBottom="5dp"
            android:text="Обновление отчета..."
            />
    </LinearLayout>

    <ListView android:id="@+id/lvItems"
        android:layout_weight="1"
        android:layout_height="0dp"
        android:layout_width="match_parent"
        android:background="@color/white" />

    <LinearLayout
        android:id="@+id/llTaskBar"
        android:layout_width="match_parent"
        style="?footer">

        <ImageButton
            android:layout_width="wrap_content"
            android:contentDescription="@string/selectDocType"
            android:layout_height="wrap_content"
            android:src="@drawable/filter"
            android:id="@+id/btnFilter"
            style="?footerButton"/>


        <TextView android:layout_height="wrap_content"
            android:text=""
            style="?footerText"
            android:layout_width="0dip"
            android:layout_weight="1"
            android:layout_gravity="center_vertical"
            android:gravity="right"
            android:id="@+id/tvTotalSum"/>
    </LinearLayout>
</LinearLayout>