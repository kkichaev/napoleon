<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    >

    <com.google.android.material.card.MaterialCardView
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_margin="6dp"
        app:cardElevation="2dp"
        >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
             >

            <LinearLayout
                android:id="@+id/packs"
                android:layout_marginTop="4dp"
                android:layout_marginLeft="4dp"
                android:layout_marginRight="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                >

                <Button
                    android:id="@+id/btnItems"
                    style="@style/PackButton"
                    android:layout_weight="1"
                    android:textColor="@color/white"
                    android:backgroundTint="@color/btn_selected"
                    android:text="@string/in_items_st" />

                <View
                    android:layout_height="0dp"
                    android:layout_width="0dp"
                    android:minWidth="8dp"
                    android:layout_weight="0.2" />
                <Button
                    android:layout_weight="1"
                    android:id="@+id/btnPack"
                    style="@style/PackButton"
                    android:text="@string/in_pack_st" />
            </LinearLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/btnCost"
                    style="@style/CostTextLarge"
                    android:gravity="right"
                    android:layout_alignParentTop="true"
                    android:layout_alignParentEnd="true"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:backgroundTint="@color/cost_back"
                    android:padding="8dp"
                    android:text="250"
                    android:textStyle="bold" />

                <com.serviko.view.TextViewCrossOut
                    android:id="@+id/tvRealCost"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="12dp"
                    android:text="350"
                    android:textSize="16sp" />

            </RelativeLayout>

            <ImageView
                android:layout_marginTop="4dp"
                android:id="@+id/imageView"
                android:layout_width="@dimen/preview_sz"
                android:layout_height="@dimen/preview_sz"
                android:src="@drawable/coming_soon"
                tools:srcCompat="@drawable/coming_soon"
                android:layout_gravity="center_horizontal"
                />

            <TextView
                android:id="@+id/tvName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/montserrat"
                android:textSize="16sp"
                android:gravity="center_horizontal"
                android:layout_margin="4dp"
                android:textColor="@color/black"
                tools:text="Водка 5 озер"
                />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                >
                <ImageView
                    android:visibility="invisible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="4dp"
                    android:src="@drawable/ic_action_excl" />
                <TextView
                    android:id="@+id/tvVolume"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:textColor="@color/gray_text"
                    android:fontFamily="@font/montserrat"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:layout_marginLeft="4dp"
                    android:layout_marginRight="4dp"
                    android:textSize="16sp"
                    tools:text="0.7 л"
                    />
                <ImageView
                    android:id="@+id/ivAction"
                    android:visibility="invisible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="4dp"
                    android:src="@drawable/ic_action_excl" />

            </LinearLayout>
            <LinearLayout
                android:id="@+id/llQty"
                android:layout_marginTop="18dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:orientation="horizontal">
                <ImageView
                    android:id="@+id/ivMinus"
                    android:padding="3dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_minus"
                    />
                <TextView
                    android:id="@+id/tvQty"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textColor="@color/black"
                    android:textSize="22sp"
                    android:fontFamily="@font/montserrat"
                    android:textStyle="bold"
                    tools:text="10"
                    />
                <ImageView
                    android:id="@+id/ivPlus"
                    android:padding="3dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_plus"
                    />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>