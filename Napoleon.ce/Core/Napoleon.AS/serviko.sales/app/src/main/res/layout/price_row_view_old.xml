<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    >

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="6dp"
        app:cardElevation="2dp"
        >

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal" >

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="@dimen/preview_sz"
        android:layout_height="@dimen/preview_sz"
        android:src="@drawable/coming_soon"
        tools:srcCompat="@drawable/coming_soon"
        android:layout_gravity="center_vertical"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:minWidth="@dimen/qty_row_width"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:minHeight="88dp"
            >
        <TextView
            android:id="@+id/tvName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/montserrat"
            android:textSize="16sp"
            android:textColor="@color/black"
            tools:text="Водка 5 озер"
            />

        <TextView
            android:id="@+id/tvVolume"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/gray_text"
            android:fontFamily="@font/montserrat"
            android:textSize="16sp"
            tools:text="0.7 л"
            />
        </LinearLayout>

        <LinearLayout
            android:layout_width="@dimen/qty_row_width"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/ivMinus"
                android:padding="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_minus"
                />
            <TextView
                android:id="@+id/tvQty"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:textColor="@color/black"
                android:textSize="20sp"
                android:fontFamily="@font/montserrat"
                android:textStyle="bold"
                tools:text="10"
                />
            <ImageView
                android:id="@+id/ivPlus"
                android:padding="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_plus"
                />
            <View
                android:layout_width="64dp"
                android:layout_height="0dp" />
        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:orientation="vertical"
        >

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            >

        <TextView
            android:id="@+id/btnCost"
            android:textStyle="bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:fontFamily="@font/montserrat"
            android:layout_marginStart="8dp"
            android:layout_marginTop="4dp"
            android:text="250" />


        <ImageView
            android:id="@+id/ivAction"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="4dp"
            android:src="@drawable/ic_action_excl" />

        </LinearLayout>

        <Button
            android:id="@+id/btnItems"
            style="@style/PackButton"
            android:layout_gravity="right"
            android:textColor="@color/white"
            android:backgroundTint="@color/btn_selected"
            android:text="@string/in_items_st" />

        <Button
            android:layout_gravity="right"
            android:id="@+id/btnPack"
            style="@style/PackButton"
            android:text="@string/in_pack_st" />
    </LinearLayout>

</LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>