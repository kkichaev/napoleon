<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_margin="4dp"
    app:cardElevation="2dp"
    android:translationZ="1dp"
    >

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/imageView"
            android:layout_width="@dimen/preview_sz"
            android:layout_height="@dimen/preview_sz"
            android:src="@drawable/coming_soon"
            tools:srcCompat="@drawable/coming_soon"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@id/tvName"
            />

        <TextView
            android:id="@+id/tvName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/montserrat"
            android:textSize="16sp"
            android:textColor="@color/black"
            tools:text="Приправа пищевкусовая Аджика острая Махеевъ с/банка ТВИСТ 190 гр"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/tvVolume"
            app:layout_constraintLeft_toRightOf="@id/imageView"
            app:layout_constraintRight_toLeftOf="@id/ivAction"
            />

        <TextView
            android:id="@+id/tvVolume"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintVertical_weight="1"
            android:textColor="@color/gray_text"
            android:fontFamily="@font/montserrat"
            android:textSize="16sp"
            tools:text="0.7 л"
            android:gravity="top"
            app:layout_constraintTop_toBottomOf="@id/tvName"
            app:layout_constraintBottom_toTopOf="@id/llQty"
            app:layout_constraintLeft_toRightOf="@id/imageView"
            />

        <LinearLayout
            android:id="@+id/llQty"
            app:layout_constraintTop_toBottomOf="@id/tvVolume"
            app:layout_constraintLeft_toRightOf="@id/imageView"
            app:layout_constraintBottom_toBottomOf="parent"

            android:layout_width="0dp"
            app:layout_constraintWidth_min="150dp"
            app:layout_constraintWidth_max="@dimen/qty_row_width"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/ivMinus"
                android:padding="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_minus"
                />
            <TextView
                android:id="@+id/tvQty"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:textColor="@color/black"
                android:textSize="20sp"
                android:fontFamily="@font/montserrat"
                android:textStyle="bold"
                tools:text="10"
                />
            <ImageView
                android:id="@+id/ivPlus"
                android:padding="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_plus"
                />
        </LinearLayout>

        <TextView
            android:id="@+id/btnCost"
            app:layout_constraintVertical_chainStyle="spread_inside"
            app:layout_constraintHeight_min="20sp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintLeft_toRightOf="@id/ivAction"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintBottom_toTopOf="@id/tvRealCost"
            android:layout_marginRight="4dp"
            android:textStyle="bold"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:textSize="18sp"
            android:gravity="top"
            android:fontFamily="@font/montserrat"
            android:text="250 P" />

        <com.serviko.view.TextViewCrossOut
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnCost"
            app:layout_constraintBottom_toTopOf="@id/buttons"
            android:id="@+id/tvRealCost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:layout_marginRight="4dp"
            android:text="350"
            android:textSize="16sp" />

        <ImageView
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintLeft_toRightOf="@id/tvName"
            app:layout_constraintRight_toLeftOf="@id/btnCost"
            android:id="@+id/ivAction"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="4dp"
            android:src="@drawable/ic_action_excl" />

        <LinearLayout
            android:id="@+id/buttons"
            app:layout_constraintTop_toBottomOf="@id/tvRealCost"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            >
            <Button
                android:id="@+id/btnItems"
                style="@style/PackButton"
                android:layout_width="match_parent"
                android:layout_marginRight="4dp"
                android:layout_gravity="right"
                android:textColor="@color/white"
                android:backgroundTint="@color/btn_selected"
                android:text="@string/in_items_st" />

            <Button
                android:layout_gravity="right"
                android:layout_marginRight="4dp"
                android:id="@+id/btnPack"
                style="@style/PackButton"
                android:text="@string/in_pack_st" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>