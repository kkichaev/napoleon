<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bkgColor"
    xmlns:app="http://schemas.android.com/apk/res-auto">


    <ImageView
        android:id="@+id/serviko_text"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        app:layout_constraintVertical_weight="4"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/phone_hint"
        android:src="@drawable/ic_logo" />

    <TextView
        android:id="@+id/phone_hint"
        style="@style/PhoneText"
        app:layout_constraintVertical_weight="1"
        app:layout_constraintTop_toBottomOf="@+id/serviko_text"
        app:layout_constraintBottom_toTopOf="@id/code"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:gravity="bottom"
        android:layout_below="@+id/serviko_text"
        android:text="@string/type_from_sms" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/code"
        app:boxStrokeColor="@color/white"
        app:boxBackgroundColor="@color/transparent"
        android:theme="@style/PhoneInputTheme"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@+id/phone_hint"
        app:layout_constraintBottom_toTopOf="@+id/doButton"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        >

        <com.google.android.material.textfield.TextInputEditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:inputType="number"
            android:ems="10"
            android:imeOptions="actionDone"
            android:fontFamily="@font/montserrat"
            android:textColor="@color/white"
            android:textSize="22sp">
            <requestFocus />
        </com.google.android.material.textfield.TextInputEditText>
    </com.google.android.material.textfield.TextInputLayout>

    <Button
        android:id="@+id/doButton"
        style="@style/PhoneButton"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@+id/code"
        app:layout_constraintBottom_toTopOf="@+id/doButtonSecond"
        android:layout_width="wrap_content"
        android:ems="13"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:text="ОТПРАВИТЬ" />

    <TextView
        android:id="@+id/doButtonSecond"
        style="@style/PhoneText"
        android:gravity="top"
        app:layout_constraintTop_toBottomOf="@+id/doButton"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_marginTop="16dp"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:text="@string/get_code_by_phone_u"
        app:layout_constraintVertical_weight="2"
        android:textSize="18sp" />

</androidx.constraintlayout.widget.ConstraintLayout>