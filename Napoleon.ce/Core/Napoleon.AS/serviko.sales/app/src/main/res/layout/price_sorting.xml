<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/rounded_corner"
    android:translationZ="6dp"
    android:elevation="3dp"
    android:paddingTop="8dp"
    android:layout_margin="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TableLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="24dp"
        android:paddingRight="24dp"
        android:paddingBottom="16dp"
        android:paddingTop="8dp"
        android:stretchColumns="0"
        >
        <TableRow
            android:id="@+id/trAscending"
            android:background="@drawable/order_filter_back"
            android:clickable="true"
            android:focusable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            >
            <TextView
                style="@style/OrderFilterText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sort_ascending"
                />

            <ImageView
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:paddingRight="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_select_off"
                />
        </TableRow>
        <TableRow
            android:id="@+id/trDescending"
            android:background="@drawable/order_filter_back"
            android:clickable="true"
            android:focusable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            >
            <TextView
                style="@style/OrderFilterText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sort_descending"
                />

            <ImageView
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:paddingRight="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_select_off"
                />

        </TableRow>
        <TableRow
            android:id="@+id/trDiscount"
            android:background="@drawable/order_filter_back"
            android:clickable="true"
            android:focusable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            >
            <TextView
                style="@style/OrderFilterText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sort_discount"
                />

            <ImageView
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:paddingRight="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_select_off"
                />
        </TableRow>
    </TableLayout>
</LinearLayout>