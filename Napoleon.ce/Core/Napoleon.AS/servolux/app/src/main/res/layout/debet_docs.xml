<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:tools="http://schemas.android.com/tools"
    android:baselineAligned="false"
  	android:layout_width="fill_parent" 
  	android:layout_height="fill_parent" 
  	android:orientation="vertical">

	<LinearLayout
		android:id="@+id/LinearLayout01"
		android:layout_width="fill_parent"
		style="?header">

		<TextView
			android:id="@+id/tvOrgInfo"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:scrollHorizontally="true"
			android:text="OrgName"
			style="?headerText" />
	</LinearLayout>

	<LinearLayout android:id="@+id/LinearLayout04" 
		android:layout_width="fill_parent" 
		android:layout_height="wrap_content"
		android:background="@color/black">
		
		<TextView 
			android:layout_width="0dip" 
			android:layout_height="fill_parent" 
			android:textColor="#000000" 
			android:layout_weight="0.5" 
			android:paddingLeft="3dp" 
			android:text="ТТН/Дата"
			tools:ignore="HardcodedText"
			android:background="@color/table_caption" 
			android:width="80dp" />

		<TextView  
			android:layout_width="wrap_content" 
			android:layout_height="wrap_content" 
			android:textColor="#000000" 
			android:text="Долг/просроч"
			tools:ignore="HardcodedText"
			android:background="@color/table_caption" 
			android:width="80dp" />
							
		<TextView  
			android:layout_width="wrap_content" 
			android:layout_height="fill_parent" 
			android:textColor="#000000" 
			android:width="80dp" 
			android:text="Дата оплаты" 
			tools:ignore="HardcodedText"
			android:paddingLeft="7dp" 
			android:background="@color/table_caption" 
			 />

		<TextView  
			android:layout_width="wrap_content" 
			android:layout_height="fill_parent" 
			android:textColor="#000000" 
			android:width="90dip"
			android:text="до 5 дн." 
			tools:ignore="HardcodedText"
			android:paddingLeft="7dp" 
			android:background="@color/table_caption" 
			/>
		
		<TextView
			android:layout_width="wrap_content" 
			android:layout_height="fill_parent" 
			android:textColor="#000000" 
			android:width="90dip"
			android:text="от 5 до 16" 
			tools:ignore="HardcodedText"
			android:paddingLeft="7dp" 
			android:background="@color/table_caption" 
			/>
		
		<TextView  
			android:layout_width="wrap_content" 
			android:layout_height="fill_parent" 
			android:textColor="#000000" 
			android:width="90dip"
			android:text="от 16 до 30" 
			
			tools:ignore="HardcodedText"
			android:paddingLeft="7dp" 
			android:background="@color/table_caption" 
			 />
																		
		<TextView
		    android:layout_width="wrap_content"
			android:layout_height="fill_parent" 
			android:width="90dip"
			android:background="@color/table_caption" 
		    android:gravity="right"
		    android:paddingRight="3dp"
		    android:text="более 30 дн"
		    tools:ignore="HardcodedText"
		    android:textColor="#000000" />

	</LinearLayout>
			
	<ExpandableListView android:id="@+id/lvDocs" 
	    android:layout_weight="1"
		android:layout_height="0dp" 
		android:layout_width="fill_parent" 
		android:background="@color/white" />

	<LinearLayout
		android:id="@+id/linearLayout1"
		android:layout_width="fill_parent"
		style="?footer"
		>
		
		<ImageButton android:layout_width="wrap_content"
		    android:contentDescription="@string/selectDocType" 
			android:layout_height="wrap_content" 
			android:src="@drawable/icon" 
			android:id="@+id/btnDocFilter"
			style="?footerButton"
			/>
			
		<ImageButton android:layout_width="wrap_content" 
			android:layout_height="wrap_content" 
			android:src="@drawable/new_order"
			android:contentDescription="@string/newDoc" 
			android:id="@+id/btnNewDoc"
			style="?footerButton"
			/>
			
		<ImageButton android:layout_width="wrap_content" 
			android:layout_height="wrap_content" 
			android:id="@+id/btnGpsStatus" 
			android:contentDescription="@string/gpsStatus" 
			android:src="@drawable/gpsno"
			style="?footerButton"
			/>

		<TextView
			android:id="@+id/tvTotalSum"
			android:layout_width="fill_parent"
			android:layout_height="wrap_content"
			android:layout_gravity="center_vertical"
			android:gravity="right"
			android:text="@string/sum"
			style="?footerText"/>
	</LinearLayout>
</LinearLayout>
