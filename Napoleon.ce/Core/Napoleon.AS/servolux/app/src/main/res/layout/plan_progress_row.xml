<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:background="@drawable/list_selector"
    android:orientation="horizontal" >
    
        <TextView
	        android:id="@+id/tvName"
            android:textColor="@color/black"
            android:paddingLeft="5dp"
            android:layout_weight="1"
            android:textSize="18sp"
            android:gravity="left"
            android:layout_width="0dip"
            android:layout_height="wrap_content"
            android:text="" />

        <View style="@style/LeftLine" />
        
        <TextView
	        android:id="@+id/tvPlan"
	        style="@style/PlanRowItem"
            android:text="" />

        <View style="@style/LeftLine" />
        
        <TextView
	        android:id="@+id/tvFact"
	        style="@style/PlanRowItem"
            android:text="" />

        <View style="@style/LeftLine" />
        
        <TextView
	        android:id="@+id/tvDiff"
	        style="@style/PlanRowItem"
            android:text="" />
        
        <View style="@style/LeftLine" />
        
        <TextView
	        android:id="@+id/tvPlanMonth"
	        style="@style/PlanRowItem"
            android:text="" />

        <View style="@style/LeftLine" />
        
        <TextView
	        android:id="@+id/tvPlanToDate"
	        style="@style/PlanRowItem"
            android:text="" />
        
        <View style="@style/LeftLine" />
        
        <TextView
	        android:id="@+id/tvFactToDate"
	        style="@style/PlanRowItem"
            android:text="" />
        
        <View style="@style/LeftLine" />
        
        <TextView
	        android:id="@+id/tvDiffMonth"
	        style="@style/PlanRowItem"
            android:text="" />
        
        <View style="@style/LeftLine" />
        
        <TextView
	        android:id="@+id/tvDiffToDate"
	        style="@style/PlanRowItem"
            android:text="" />
        
</LinearLayout>
