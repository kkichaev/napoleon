<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:android="http://schemas.android.com/apk/res/android">

    <style name="RemnantsHead">
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">15sp</item>
        <item name="android:background">@color/table_caption</item>
        <item name="android:gravity">center</item>
    </style>
    <style name="WarehouseNumItem">
        <item name="android:layout_height">fill_parent</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:width">55dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">15sp</item>
        <item name="android:weightSum">0</item>
        <item name="android:paddingRight">3dp</item>
        <item name="android:background">@color/white</item>
        <item name="android:layout_marginLeft">1dp</item>
        </style>

    <style name="RjectActOKButton">
        <item name="android:minWidth">100dp</item>
        <item name="android:minHeight">100dp</item>
        <item name="android:layout_gravity">center</item>
    </style>

    <style name="RejectActEdit">
        <item name="android:ems">4</item>
        <item name="android:inputType">none</item>
        <item name="android:textSize">20sp</item>
    </style>
    
    <style name="WarehouseNumItemHead">
        <item name="android:layout_height">fill_parent</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:width">55dp</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:background">@color/bar_visit_color</item>
        <item name="android:textSize">12sp</item>
        <item name="android:weightSum">0</item>
        <item name="android:layout_marginBottom">1dp</item>
        <item name="android:layout_marginLeft">1dp</item>
     </style>

    <style name="PlanItemHead">
        <item name="android:layout_height">fill_parent</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:width">55dp</item>
        <item name="android:background">@color/bar_visit_color</item>
        <item name="android:layout_marginTop">1dp</item>
        <item name="android:layout_marginRight">1dp</item>
        <item name="android:gravity">center_vertical|center_horizontal</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">12sp</item>
        <item name="android:weightSum">0</item>
     </style>

    <style name="PlanRowItem">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:width">55dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">14sp</item>
        <item name="android:weightSum">0</item>
        <item name="android:paddingRight">3dp</item>
	</style>

    <style name="LeftLine">
        <item name="android:layout_height">fill_parent</item>
        <item name="android:layout_width">1dp</item>
        <item name="android:background">@android:color/darker_gray</item>
	</style>

    <style name="FirmCell">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">fill_parent</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">16sp</item>
        <item name="android:background">@color/lightgreen</item>
        <item name="android:layout_marginLeft">1dp</item>
        <item name="android:layout_marginTop">1dp</item>
        <item name="android:gravity">center</item>
        <item name="android:minWidth">30dp</item>
        <item name="android:paddingBottom">1dp</item>
        <item name="android:visibility">gone</item>
        
    </style>
    
    <style name="ActCell">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">fill_parent</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:background">@color/white</item>
        <item name="android:paddingLeft">2dp</item>
        <item name="android:layout_marginRight">1dp</item>
        <item name="android:layout_marginBottom">1dp</item>
        <item name="android:width">80dp</item>
    </style>
    
    <style name="ActDetailCell" parent="ActCell">
        <item name="android:layout_marginRight">0dp</item>
        <item name="android:layout_marginBottom">0dp</item>
        <item name="android:background">@color/table_caption</item>
    </style>

    <style name="ActRowCell" parent="ActCell">
        <item name="android:layout_marginRight">0dp</item>
        <item name="android:layout_marginBottom">0dp</item>
    </style>
    
</resources>
