<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.grsoft.ads"
    android:versionCode="5"
    android:versionName="3.1.1.8" >

    <uses-feature
        android:name="android.hardware.location"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.location.network"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.wifi"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Camera features. I think it can bring an installation problem

 		<uses-feature android:name="android.hardware.camera.autofocus" />
 		-->

    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="oppo.permission.OPPO_COMPONENT_SAFE" />
    <uses-permission android:name="com.huawei.permission.external_app_settings.USE_COMPONENT" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
    <uses-permission android:name="android.permission.ACTION_MANAGE_OVERLAY_PERMISSION"/>

    <application
        android:icon="@drawable/pictograms"
        android:label="@string/app_name" 
        android:name="AdsAppEx"
        android:requestLegacyExternalStorage="true"
        android:theme="@style/Theme">
        
        <service android:name="com.grsoft.ads.AdsServiceEx"/>

        <activity
            android:name="com.grsoft.ads.AdsNew"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name="SettingNetwork"
            android:label="@string/network_setting"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize">
             <intent-filter>
                <action android:name="com.grsoft.ads.OPEN_NETWORK_SETTING"/>
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        
        <activity android:name="com.grsoft.ads.SettingDataBase"
            android:label="@string/dbase_setting"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize"> 
            <intent-filter>
                <action android:name="com.grsoft.ads.OPEN_DATA_BASE_SETTING"/>
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        
        <activity android:name="SettingGPS" 
            android:label="@string/gps_setting"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize">
            <intent-filter>
                <action android:name="com.grsoft.ads.OPEN_GPS_SETTING"/>
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
         
        <activity android:name="SettingSync"
            android:label="@string/sync_setting"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize">
             <intent-filter>
                <action android:name="com.grsoft.ads.OPEN_SYNC_SETTING"/>
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        
        <activity android:name="SettingNotify"
            android:label="@string/notify_setting"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize">
             <intent-filter>
                <action android:name="com.grsoft.ads.OPEN_NOTIFY_SETTING"/>
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        
        <activity android:name="SettingMainPage"
        	android:configChanges="keyboard|keyboardHidden|orientation|screenSize"/>
        
        <activity android:name="com.grsoft.ads.SettingActivity" 
            android:label="@string/setting"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize"/>
        <activity android:name="TaskProp" 
            android:label="@string/setting"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize"/>
        <activity android:name="QuestionWebView" 
            android:label="@string/task"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize"/>
        <activity android:name="TaskPhoto" 
            android:label="@string/task"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize"/>
        
        <activity android:name="com.grsoft.ads.SettingNew">
            <intent-filter>
                <action android:name="com.grsoft.ads.SettingNew.OPEN"/>
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        
        <activity android:name="com.grsoft.ads.NewTaskList" android:configChanges="keyboard|keyboardHidden|orientation|screenSize">
             <intent-filter>
                <action android:name="com.grsoft.ads.OPEN_NEWTASKLIST"/>
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name="com.grsoft.ads.TaskEdit" android:configChanges="keyboard|keyboardHidden|orientation|screenSize"/>
        <activity android:name="com.grsoft.ads.TaskPreview" android:configChanges="keyboard|keyboardHidden|orientation|screenSize"/>
        <activity android:name="com.grsoft.ads.TaskReadyToStart" android:configChanges="keyboard|keyboardHidden|orientation|screenSize"/>
        <activity android:name="com.grsoft.napoleon.CrashReport" android:configChanges="keyboard|keyboardHidden|orientation|screenSize"/>
        
        <receiver android:name="com.grsoft.util.SystemActionReciever" 
         android:permission="android.permission.RECEIVE_BOOT_COMPLETED">
      
         <intent-filter>
            <action android:name="android.location.PROVIDERS_CHANGED"/>
            <action android:name="android.intent.action.TIME_SET"/>
                <action android:name="android.intent.action.DATE_SET"/>
                <action android:name="android.intent.action.TIME_TICK"/>
            <action android:name="android.intent.action.BOOT_COMPLETED"/>
            <action android:name="android.intent.action.ACTION_SHUTDOWN"/>
            <category android:name="android.intent.category.DEFAULT" />
         </intent-filter>
      </receiver>
      
      <activity android:name="com.grsoft.network.BaseSimpleActivity" android:configChanges="keyboard|keyboardHidden|orientation|screenSize"/>
      <activity android:name="com.grsoft.ads.TaskReview" android:configChanges="keyboard|keyboardHidden|orientation|screenSize"/>
      <service android:name="com.grsoft.util.NapoleonServiceW"/>
      <service android:name="com.grsoft.util.NapoleonService"/>
      <activity android:name="com.grsoft.ads.MessageList" android:configChanges="keyboard|keyboardHidden|orientation|screenSize"/>
      <activity android:name="com.grsoft.ads.TaskAttachmentActivity" android:configChanges="keyboard|keyboardHidden|orientation|screenSize"/>
      <activity android:name="com.grsoft.ads.SyncActivity" android:configChanges="keyboard|keyboardHidden|orientation|screenSize"/>
      <activity android:name="com.grsoft.ads.Ads" android:configChanges="keyboard|keyboardHidden|orientation|screenSize"/>
      
      <receiver android:name="com.grsoft.ads.TaskNotify">
            <intent-filter>
		        <action android:name="android.intent.action.SEND" />
		        <category android:name="android.intent.category.DEFAULT" />
		        <data android:mimeType="text/plain" />
    		</intent-filter>
        </receiver>
      
      <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="@string/ads_file_provider"
            android:exported="false"
            android:grantUriPermissions="true">
            
          <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/providers_path"/>
      </provider>
      
      <activity android:name="com.grsoft.ads.ClearActivity" android:configChanges="keyboard|keyboardHidden|orientation|screenSize"/>
    </application>

</manifest>