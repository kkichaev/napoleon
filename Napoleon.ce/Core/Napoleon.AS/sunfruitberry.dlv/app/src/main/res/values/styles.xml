<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AutoInfoRow" parent="@android:style/TextAppearance">
        <item name="android:textSize">24sp</item>
        <item name="android:padding">24dp</item>
    </style>

    <style name="TableRow">
        <item name="android:paddingLeft">10dp</item>
        <item name="android:paddingRight">10dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">5dp</item>
    </style>

    <style name="CloseButton">
        <item name="android:textSize">@dimen/text_button_textSize</item>
        <item name="android:textColor">@color/red</item>
        <item name="android:gravity">center</item>
        <item name="android:layout_marginTop">@dimen/text_button_marginTop</item>
        <item name="android:layout_marginBottom">@dimen/text_button_marginBottom</item>
        <item name="android:background">@drawable/button_shape2</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>