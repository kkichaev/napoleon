<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
     xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:background="@color/white"
    android:orientation="vertical" >
    
    <ImageView
        android:id="@+id/ivPresent"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_gravity="center"
        android:src="@drawable/icon"
        android:visibility="visible"
        tools:ignore="ContentDescription" />

    <TextView
        android:id="@+id/tvQty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/rest_qty"
        android:layout_gravity="top|right"
        android:textColor="#00137F"
        android:textStyle="bold"
        android:textSize="22sp"/>

    <TextView
        android:id="@+id/tvName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="60dp"
        android:text="Name"
        android:layout_gravity="bottom|center"
        android:textColor="#404040"
        android:textSize="24sp"/>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" 
        android:layout_gravity="bottom|center">

        <ImageButton
            android:id="@+id/btnDec"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_remove_circle_black"
            android:gravity="center"/>

        <TextView
            android:id="@+id/tvCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="50dp"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:text="0" 
            android:textSize="22sp"/>

        <ImageButton
            android:id="@+id/btnInc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_add_circle_black"
            android:gravity="center"/>

        <TextView
            android:id="@+id/tvSum"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingLeft="20dp"
            android:gravity="right"
            android:text="@string/sum_str"
            android:layout_gravity="center_vertical" 
            android:textSize="22sp"/>
    </LinearLayout>

    <TextView
        android:id="@+id/tvCost"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#00137F"
        android:textSize="22sp"
        android:text="@string/item_cost"
        android:layout_gravity="top|right" 
        android:layout_marginTop="80dp"/>

    <TextView
        android:id="@+id/tvQtyInPack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#00137F"
        android:textSize="22sp"
        android:text="@string/qty_str" 
        android:layout_gravity="top|right" 
        android:layout_marginTop="100dp"/>

</FrameLayout>
