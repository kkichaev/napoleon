<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical" >

    <LinearLayout
        android:id="@+id/llTop"
        style="?header"
        android:layout_width="match_parent"
        android:orientation="horizontal" >

        <ImageView
            android:id="@+id/ivGoUp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@color/footer"
            android:src="@drawable/goup" >
        </ImageView>

        <TextView
            android:id="@+id/tvFirstColumnCaption"
            style="?headerText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_weight="1"
            android:text="@string/caption" />

        <TextView
            android:id="@+id/tvMainDocValColTitle"
            style="?headerText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:background="@color/footer"
            android:gravity="right"
            android:text="@string/sum" />
        </LinearLayout>


        <LinearLayout
            android:id="@+id/LinearLayout04"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1" >

            <ListView
                android:id="@+id/lvMainOrgs"
                android:layout_width="0dp"
                android:layout_height="fill_parent"
                android:layout_weight="1"
                android:background="@color/white"
                tools:ignore="NestedWeights" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/llFind"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:orientation="horizontal" >

            <EditText
                android:id="@+id/edFind"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginLeft="3dp"
                android:layout_marginRight="3dp"
                android:layout_weight="1"
                tools:ignore="TextFields" />

            <ImageButton
                android:id="@+id/btnDelFind"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_delete"
                tools:ignore="ContentDescription" />

        </LinearLayout>

    <LinearLayout
        android:id="@+id/linearLayout1"
        style="?footer"
        android:layout_width="fill_parent"
        >

            <ImageButton
                android:id="@+id/btnDocFilter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="?footerButton"
                android:src="@drawable/icon"
                tools:ignore="ContentDescription" />

            <ImageButton
                android:id="@+id/btnMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="?footerButton"
                android:src="@drawable/icon"
                tools:ignore="ContentDescription" />

            <ImageButton
                android:id="@+id/btnLines"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="?footerButton"
                android:src="@drawable/line_2"
                tools:ignore="ContentDescription" />

            <ImageButton
                android:id="@+id/btnFind"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="?footerButton"
                android:src="@drawable/find"
                tools:ignore="ContentDescription" />

            <ImageButton
                android:id="@+id/btnFilter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="?footerButton"
                android:src="@drawable/filter"
                tools:ignore="ContentDescription" />

        <TextView
            android:id="@+id/tvTotalSum"
            style="?footerText"
            android:layout_width="0dip"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:gravity="right"
            android:text="@string/sum" />
        </LinearLayout>

</LinearLayout>