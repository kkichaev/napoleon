<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:orientation="vertical">

    <HorizontalScrollView
        android:id="@+id/hswPricePage"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:background="@color/footer"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvHome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableLeft="@drawable/price_home"
                android:gravity="center_vertical"
                android:textColor="@color/black"
                tools:ignore="HardcodedText" />

            <LinearLayout
                android:id="@+id/llPath"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:orientation="horizontal"></LinearLayout>
        </LinearLayout>
    </HorizontalScrollView>

    <LinearLayout
        android:id="@+id/llPriceControl"
        style="?header"
        android:layout_width="fill_parent"
        android:visibility="visible">

        <ImageView
            android:id="@+id/ivGoUp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/goup"
            tools:ignore="ContentDescription"></ImageView>

        <LinearLayout
            android:id="@+id/llLables"
            android:layout_width="0dp"
            android:layout_height="fill_parent"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:padding="0dp"
            tools:ignore="NestedWeights">

            <TextView
                android:id="@+id/tvItemSelectUpLevel"
                android:layout_width="0dp"
                android:layout_height="fill_parent"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:lines="1"
                android:scrollHorizontally="true"
                android:text="@string/price"
                android:textColor="@color/dark_blue"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:ignore="NestedWeights"></TextView>
        </LinearLayout>

        <ImageView
            android:id="@+id/ivFilter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginRight="5dp"
            android:src="@drawable/filter"
            android:visibility="gone"
            tools:ignore="ContentDescription"></ImageView>
    </LinearLayout>

    <FrameLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="@color/white">

        <ListView
            android:id="@+id/lvOrderItemSelect"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:background="#c0ccff" />

        <ImageView
            android:id="@+id/ivFilterLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="right|bottom"
            android:layout_marginTop="10dp"
            android:layout_marginRight="10dp"
            android:layout_marginBottom="20dp"
            android:src="@drawable/filter2"
            android:visibility="gone"
            tools:ignore="ContentDescription"></ImageView>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/llFind"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/edFind"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginLeft="3dp"
            android:layout_marginRight="3dp"
            android:layout_weight="1"
            tools:ignore="TextFields" />

        <ImageButton
            android:id="@+id/btnDelFind"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@null"
            android:src="@drawable/ic_delete" />

        <Spinner
            android:id="@+id/spFind"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:entries="@array/wh_find_choices"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/llMatrixOrder"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        style="?footer">

        <TextView
            android:id="@+id/tvMatrixName"
            android:layout_width="0dip"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_weight="1"
            android:gravity="center_vertical|center_horizontal"
            android:text=""
            android:textSize="18sp"
            android:textStyle="bold"
            style="?footerText"/>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/linearLayout1"
        style="?footer"
        android:layout_width="fill_parent"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnUp"
            style="?footerButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/up" />

        <ImageButton
            android:id="@+id/btnDown"
            style="?footerButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/down" />

        <ImageButton
            android:id="@+id/btnLines"
            style="?footerButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/line_2" />

        <ImageButton
            android:id="@+id/btnFind"
            style="?footerButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/find" />

        <ImageButton
            android:id="@+id/btnPack"
            style="?footerButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/pack_off"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvTotalSum"
            style="?footerText"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:gravity="right"
            android:text="@string/sum" />

        <ImageButton
            android:id="@+id/ibNextPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="?footerButton"
            android:src="@drawable/next_matrix" />
    </LinearLayout>

</LinearLayout>