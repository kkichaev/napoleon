<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  android:orientation="vertical"
  android:layout_width="fill_parent"
  android:layout_height="fill_parent">
    
<TableLayout android:layout_width="fill_parent" 
   	android:stretchColumns="1"
   	android:id="@+id/tableLayout1" 
   	android:layout_height="wrap_content" 
   	android:layout_weight="0">

      <TableRow android:id="@+id/tableRow1" 
    	android:padding="2dp"
       	android:layout_width="wrap_content" 
       	android:layout_height="wrap_content">
		
		<TextView android:id="@+id/TextView04" 
			android:layout_height="wrap_content" 
			android:text="Форма оплаты" 
			android:layout_marginLeft="5dp" 
			android:layout_marginRight="5dp" android:layout_width="wrap_content" 
			android:layout_gravity="center_vertical"></TextView>
		<CheckBox 
			android:text="Банк" 
			android:id="@+id/cbBank" 
			android:layout_width="wrap_content" android:layout_height="wrap_content"></CheckBox>	
	  </TableRow>		
      <TableRow  
    	android:padding="2dp"
       	android:layout_width="wrap_content" 
       	android:layout_height="wrap_content">
		
		<TextView  
			android:layout_height="wrap_content" 
			android:text="Метод доставки" 
			android:layout_marginLeft="5dp" 
			android:layout_marginRight="5dp" android:layout_width="wrap_content" 
			android:layout_gravity="center_vertical"></TextView>	
		<Spinner android:layout_height="wrap_content" 
			android:layout_weight="1" android:id="@+id/spDlvMethod" android:layout_width="fill_parent"></Spinner>
	</TableRow>		
      <TableRow  
    	android:padding="2dp"
       	android:layout_width="wrap_content" 
       	android:layout_height="wrap_content">
		
		<TextView  
			android:layout_height="wrap_content" 
			android:text="Тип учета" 
			android:layout_marginLeft="5dp" 
			android:layout_marginRight="5dp" android:layout_width="wrap_content" 
			android:layout_gravity="center_vertical"></TextView>	
		<Spinner android:layout_height="wrap_content" 
			android:layout_weight="1" android:id="@+id/spControlType" android:layout_width="fill_parent"></Spinner>
	</TableRow>		
</TableLayout>

</LinearLayout>
