<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_gravity="right"
    android:orientation="vertical" >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/orgMissingBack"
        android:layout_marginLeft="6dp"
        android:layout_marginTop="6dp" 
        android:layout_marginBottom="6dp" 
        >

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="vertical" >

            <TextView
		        android:id="@+id/tvOrgName"
	            style="@style/taskHead"
	            android:paddingRight="4dp"
		        android:layout_width="wrap_content"
		        android:layout_height="wrap_content"
		        android:text="" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" >

		        <TextView
		            android:id="@+id/textView1"
		            style="@style/taskHead"
		            android:layout_marginRight="4dp"
		            android:layout_width="wrap_content"
		            android:layout_height="match_parent"
		            android:text="@string/tasks_from" />
		
		        <TextView
		            android:id="@+id/tvFrom"
		            style="@style/taskHead"
		            android:layout_width="wrap_content"
		            android:layout_height="match_parent"
		            android:layout_marginRight="4dp"
		            android:text="TextView"
		            android:textColor="@color/blue"
		            android:textStyle="bold" />
		
		        <TextView
		            android:id="@+id/textView3"
		            style="@style/taskHead"
		            android:layout_marginRight="4dp"
		            android:layout_width="wrap_content"
		            android:layout_height="match_parent"
		            android:text="@string/task_till" />
		
		        <TextView
		            android:id="@+id/tvTill"
		            style="@style/taskHead"
		            android:layout_width="wrap_content"
		            android:layout_height="match_parent"
		            android:layout_marginRight="4dp"
		            android:text="TextView"
		            android:textColor="@color/blue"
		            android:textStyle="bold" />
		
            </LinearLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/textView2"
            android:layout_width="0dip"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="" />
                        

        <ImageButton
            android:id="@+id/btnAdd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/task_new" 
            android:visibility="invisible"/>

        <ImageButton
            android:id="@+id/btnRefresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/sync" 
            android:visibility="invisible"/>

    </LinearLayout>

    <LinearLayout
        android:background="@color/black"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" >

        <TextView
            android:id="@+id/textView4"
            style="@style/TaskTable"
            android:width="80dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/begin_text" />

        <TextView
            android:id="@+id/textView5"
            style="@style/TaskTable"
            android:width="80dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/end_text" />

        <TextView
            android:id="@+id/textView6"
            style="@style/TaskTable"
            android:gravity="center"
            android:layout_weight="1"
            android:layout_width="0dip"
            android:layout_height="wrap_content"
            android:text="@string/text" />

    </LinearLayout>

    <ListView
        android:id="@+id/lvItems"
        android:layout_weight="1"
        android:layout_width="match_parent"
        android:layout_height="0dip" >
    </ListView>

</LinearLayout>
