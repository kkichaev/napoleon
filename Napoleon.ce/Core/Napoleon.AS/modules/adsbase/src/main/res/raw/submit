<script type="text/javascript">
	
	function isArray(it) { return it && (it instanceof Array || typeof it == "array"); }
	
	function setValue(/*Object*/obj, /*String*/name, /*String*/value){
		if(value == null)
			return;
	
		var val = obj[name];
		if(typeof val == "string"){
			obj[name] = [val, value];
		}else if(isArray(val)){
			val.push(value);
		}else{
			obj[name] = value;
		}
	}
	
	function forEach(arr, callback) {
		if(!arr || !arr.length){ return; }
		for(var i=0,l=arr.length; i<l; ++i){ 
			callback.call(null,arr[i], i, arr);
		}
	}
	
	function fieldToObject(item) {
		var ret = null;
		if(item){
			var _in = item.name;
			var type = (item.type||"").toLowerCase();
			if(_in && type && !item.disabled){
				if(type == "radio" || type == "checkbox"){
					if(item.checked){ ret = item.value }
				}else if(item.multiple){
					ret = [];
					forEach(item.options, function(opt){
						if(opt.selected){
							ret.push(opt.value);
						}
					});
				}else{
					ret = item.value;
				}
			}
		}
		return ret;
	}
	
	function formToObject(form) {
		var ret = {};
		var exclude = "file|submit|image|reset|button|";
	
		forEach(form.elements, function(item) {
			var _in = item.id;
			var type = (item.type||"").toLowerCase();
			if(_in && type && exclude.indexOf(type) == -1 && !item.disabled){
				setValue(ret, _in, fieldToObject(item));
				if(type == "image"){
					ret[_in+".x"] = ret[_in+".y"] = ret[_in].x = ret[_in].y = 0;
				}
			}
		});
		return ret;
	}
	
	function objectToQuery(map) {
		var enc = encodeURIComponent;
		var pairs = [];
		var backstop = {};
		for(var name in map){
			var value = map[name];
			if(value != backstop[name]){
				var assign = enc(name) + "=";
				if(isArray(value)){
					for(var i=0; i < value.length; i++){
						pairs.push(assign + enc(value[i]));
					}
				}else{
					pairs.push(assign + enc(value));
				}
			}
		}
		return pairs.join("&");
	}
	
	function formToQuery(form) { return objectToQuery(formToObject(form)); }
		
	function doSubmit(formId) {
		form = document.getElementById(formId);
		val = formToQuery(form);
		Android.handle(val);
	}
    
    function numbersonly(myfield, e)
	{
		var key;
		var keychar;
		
		if (window.event)
		   key = window.event.keyCode;
		else if (e)
		   key = e.which;
		else
		   return true;
		keychar = String.fromCharCode(key);
		
		if ((key==null) || (key==0) || (key==8) || 
		    (key==9) || (key==13) || (key==27) )
		   return true;
		
		else if ((("0123456789").indexOf(keychar) > -1))
		   return true;
		
		else if (keychar == ',' && myfield.value.indexOf(keychar) == -1)
		   return true;   
		else
		   return false;
	}
</script>
