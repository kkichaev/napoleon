<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
 	android:layout_height="fill_parent" 
 	android:layout_width="fill_parent" 
 	android:background="#FFFFFF" 
 	android:orientation="vertical">

	<LinearLayout
		android:id="@+id/llHeader"
		style="?header"
		android:layout_width="fill_parent"
		android:orientation="horizontal" >

		<TextView
			android:id="@+id/tvOrgName"
			style="?headerText"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="@string/organization" />
	</LinearLayout>
		
   <TableLayout android:layout_width="fill_parent" 
    	android:stretchColumns="1"
    	android:id="@+id/tableLayout1" 
    	android:layout_height="wrap_content" 
    	android:layout_weight="0">
	
       <TableRow
	    	android:padding="2dp"
        	android:layout_width="wrap_content" 
        	android:layout_height="wrap_content">
			
			<TextView android:id="@+id/TextView01" 
				android:layout_width="wrap_content" 
				android:layout_height="wrap_content"
				android:textColor="#000000" 
				android:text="Дата" 
				android:layout_marginRight="5dp" 
				android:layout_gravity="right"></TextView>
			
			<TextView android:layout_width="wrap_content" 
				android:layout_height="wrap_content" 
				android:textColor="#000000" 
				android:text="25.11.2010" 
				android:layout_weight="1" 
				android:id="@+id/tvDate" 
				android:textStyle="bold"></TextView>
		</TableRow>
       <TableRow
	    	android:padding="2dp"
        	android:layout_width="wrap_content" 
        	android:layout_height="wrap_content"
            android:visibility="gone">
			<TextView android:id="@+id/TextView03" 
				android:layout_height="wrap_content" 
				android:text="Накладная" 
				android:textColor="#000000" 
				android:layout_marginRight="5dp" 
				android:layout_width="wrap_content" 
				android:layout_gravity="center_vertical|right"></TextView>
						
			<Spinner android:layout_height="wrap_content" 
				android:layout_weight="1" 
				android:id="@+id/spDelivery" android:layout_width="fill_parent"></Spinner>
		</TableRow>
	</TableLayout>
	<EditText android:layout_weight="1" 
		android:layout_height="fill_parent" 
		android:layout_width="fill_parent" 
		android:id="@+id/edCreateOrderNotes" 
		android:gravity="top|left" android:minLines="2" android:lines="2"></EditText>
	<LinearLayout
		android:id="@+id/LinearLayout08"
		style="?footer"
		android:layout_width="fill_parent" >

		<TextView
			android:id="@+id/btnCancel"
			android:layout_width="0dp"
			android:layout_height="match_parent"
			android:layout_weight="1"
			android:text="@string/cancel"
			style="?textButton"
			android:layout_marginRight="7dp">
		</TextView>

		<TextView
			android:id="@+id/btnOK"
			android:layout_width="0dp"
			android:layout_height="match_parent"
			android:layout_weight="3"
			android:text="@string/ok"
			style="?textButton" >
		</TextView>
	</LinearLayout>
</LinearLayout>
