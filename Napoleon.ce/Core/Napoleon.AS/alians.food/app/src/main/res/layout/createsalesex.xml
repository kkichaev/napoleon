<?xml version="1.0" encoding="utf-8"?>
   
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
 	android:layout_height="fill_parent" 
 	android:layout_width="fill_parent" 
 	android:background="#FFFFFF" 
 	android:orientation="vertical">

	<LinearLayout
		android:id="@+id/llHeader"
		style="?header"
		android:layout_width="fill_parent"
		android:orientation="horizontal">

		<TextView
			android:id="@+id/tvOrgName"
			style="?headerText"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="@string/organization" />
	</LinearLayout>
	
   <TableLayout android:layout_width="fill_parent" 
    	android:stretchColumns="1"
    	android:id="@+id/tableLayout1" 
    	android:layout_height="wrap_content" 
    	android:layout_weight="0">
	
       <TableRow
	    	android:padding="2dp"
        	android:layout_width="wrap_content" 
        	android:layout_height="wrap_content">
			
			<TextView
				android:layout_height="wrap_content" 
				android:text="№ Док." 
				android:textColor="#000000" 
				android:layout_marginLeft="5dp" 
				android:layout_marginRight="5dp" android:layout_width="wrap_content" 
				android:layout_gravity="center_vertical"></TextView>
						
			<EditText android:id="@+id/edNumber"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content" android:layout_marginRight="3dp">
				<requestFocus></requestFocus>
			</EditText>
			
	   </TableRow>
		
       <TableRow android:id="@+id/tableRow1"
	    	android:padding="2dp"
        	android:layout_width="wrap_content" 
        	android:layout_height="wrap_content">
			
			<TextView android:id="@+id/TextView03" 
				android:layout_height="wrap_content" 
				android:text="Фирма" 
				android:textColor="#000000" 
				android:layout_marginLeft="5dp" 
				android:layout_marginRight="5dp" android:layout_width="wrap_content" 
				android:layout_gravity="center_vertical"></TextView>
						
			<Spinner android:layout_height="wrap_content" 
				android:layout_weight="1" 
				android:id="@+id/spFirma" android:layout_width="fill_parent"></Spinner>
			
		</TableRow>
       <TableRow android:id="@+id/trDog"
	    	android:padding="2dp"
        	android:layout_width="wrap_content" 
        	android:layout_height="wrap_content">
			
			<TextView android:id="@+id/TextView13" 
				android:layout_height="wrap_content" 
				android:text="Договор" 
				android:textColor="#000000" 
				android:layout_marginLeft="5dp" 
				android:layout_marginRight="5dp" android:layout_width="wrap_content" 
				android:layout_gravity="center_vertical"></TextView>
						
			<Spinner android:layout_height="wrap_content" 
				android:layout_weight="1" 
				android:id="@+id/spDog" android:layout_width="fill_parent"></Spinner>
			
		</TableRow>
       		
       <TableRow android:id="@+id/trCost"
	    	android:padding="2dp"
        	android:layout_width="wrap_content" 
        	android:layout_height="wrap_content">
			
			<TextView android:id="@+id/TextView04" 
				android:layout_height="wrap_content" 
				android:textColor="#000000" 
				android:text="Цена" 
				android:layout_marginLeft="5dp" 
				android:layout_marginRight="5dp" android:layout_width="wrap_content" 
				android:layout_gravity="center_vertical"></TextView>	
			<Spinner android:layout_height="wrap_content" 
				android:layout_weight="1" android:id="@+id/spPrices" android:layout_width="fill_parent"></Spinner>
		</TableRow>		
	</TableLayout>
	
	<LinearLayout android:id="@+id/LinearLayout07" 
		android:layout_height="wrap_content" 
		android:layout_width="fill_parent" 
		android:layout_weight="1">
		
		<EditText android:layout_weight="1" 
			android:layout_height="fill_parent" 
			android:layout_width="fill_parent" 
			android:id="@+id/edCreateOrderNotes" 
			android:gravity="top|left" android:minLines="2" android:lines="2"></EditText>
	</LinearLayout>

	<LinearLayout
		android:id="@+id/LinearLayout08"
		style="?footer"
		android:layout_width="fill_parent" >

		<TextView
			android:id="@+id/btnCancel"
			android:layout_width="0dp"
			android:layout_height="match_parent"
			android:layout_weight="1"
			android:text="@string/cancel"
			style="?textButton"
			android:layout_marginRight="7dp">
		</TextView>

		<TextView
			android:id="@+id/btnOK"
			android:layout_width="0dp"
			android:layout_height="match_parent"
			android:layout_weight="3"
			android:text="@string/ok"
			style="?textButton" >
		</TextView>
	</LinearLayout>
</LinearLayout>
