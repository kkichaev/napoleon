<?xml version="1.0" encoding="utf-8"?>
<resources>
    <dimen name="button_margin">25dp</dimen>
    <dimen name="button_height">100dp</dimen>
    <dimen name="button_text_sz">32sp</dimen>
    <dimen name="button_text_margin">40dp</dimen>
    <dimen name="button_drawable_padding">12dp</dimen>

    <style name="TextButtonEx">
        <item name="android:textSize">@dimen/button_text_sz</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:gravity">left|center_vertical</item>
        <item name="android:layout_marginTop">@dimen/button_text_margin</item>

        <item name="android:background">@drawable/button_shape_ex</item>
        <item name="android:layout_height">@dimen/button_height</item>
        <item name="android:layout_marginLeft">@dimen/button_margin</item>
        <item name="android:layout_marginRight">@dimen/button_margin</item>
        <item name="android:paddingLeft">@dimen/button_drawable_padding</item>
        <item name="android:drawablePadding">@dimen/button_drawable_padding</item>
    </style>
</resources>
