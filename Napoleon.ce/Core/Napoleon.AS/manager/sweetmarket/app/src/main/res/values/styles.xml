<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="RetDocBase">
        <item name="android:textSize">18sp</item>
    </style>
    <style name="RetDocNew" parent="RetDocBase">
        <item name="android:textColor">@color/black</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="RetDocReject" parent="RetDocBase">
        <item name="android:textColor">@color/red</item>
    </style>
    <style name="RetDocAccept" parent="RetDocBase">
        <item name="android:textColor">@color/lightgreen</item>
    </style>
    <style name="ReturnItem">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/black</item>
    </style>
    <style name="ActionButton">
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:width">160dp</item>
        <item name="android:gravity">center_horizontal</item>
    </style>
</resources>