<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="8dp"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <TextView
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/agent"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintHorizontal_weight="0.7"
        android:id="@+id/org"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textAppearance="@style/RetDocNew"
        tools:text="Новая фирма"
        />
    <TextView
        app:layout_constraintTop_toBottomOf="@id/org"
        app:layout_constraintStart_toStartOf="@id/org"
        app:layout_constraintEnd_toStartOf="@id/agent_limit"
        android:id="@+id/address"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textAppearance="@style/RetDocNew"
        android:textStyle="italic"
        tools:text="Адрес фирмы"
        />
    <TextView
        app:layout_constraintBaseline_toBaselineOf="@id/org"
        app:layout_constraintStart_toEndOf="@id/org"
        app:layout_constraintEnd_toStartOf="@id/date"
        android:id="@+id/agent"
        app:layout_constraintHorizontal_weight="0.5"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="right"
        android:layout_marginEnd="8dp"
        tools:text="Агент"
        />
    <TextView
        app:layout_constraintTop_toBottomOf="@id/agent"
        app:layout_constraintEnd_toEndOf="@id/agent"
        android:id="@+id/agent_limit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textStyle="italic"
        android:gravity="right"
        tools:text="3000.00"
        />

    <TextView
        app:layout_constraintBaseline_toBaselineOf="@id/org"
        app:layout_constraintStart_toEndOf="@id/agent"
        app:layout_constraintEnd_toStartOf="@id/sum"
        android:id="@+id/date"
        android:width="75dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="20/02/23"
        />
    <TextView
        app:layout_constraintBaseline_toBaselineOf="@id/org"
        app:layout_constraintStart_toEndOf="@id/date"
        app:layout_constraintEnd_toEndOf="parent"
        android:id="@+id/sum"
        android:width="90dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="right"
        tools:text="200000.00"
        />
    <TextView
        app:layout_constraintTop_toBottomOf="@id/sum"
        app:layout_constraintEnd_toEndOf="@id/sum"
        android:id="@+id/limit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textStyle="italic"
        android:gravity="right"
        tools:text="20000.00"
        />
</androidx.constraintlayout.widget.ConstraintLayout>