<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="4dp"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    >

    <TextView
        android:id="@+id/item_name"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/item_qty"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        style="@style/ReturnItem"
        tools:text="test item"
        />
    <TextView
        android:id="@+id/item_qty"
        app:layout_constraintStart_toEndOf="@id/item_name"
        app:layout_constraintEnd_toStartOf="@id/item_sum"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/ReturnItem"
        tools:text="test item"
        />
    <TextView
        android:id="@+id/item_sum"
        android:width="90dp"
        android:gravity="right"
        app:layout_constraintStart_toEndOf="@id/item_qty"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/ReturnItem"
        tools:text="test item"
        />
    <TextView
        android:id="@+id/item_remark"
        app:layout_constraintTop_toBottomOf="@id/item_name"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        style="@style/ReturnItem"
        android:textStyle="italic"
        tools:text="test item"
        android:minLines="1"
        />
</androidx.constraintlayout.widget.ConstraintLayout>