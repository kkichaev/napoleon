<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TableLayout
        android:layout_margin="8dp"
        android:stretchColumns="0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TableRow
            android:background="@drawable/ordering_pressed"
            android:id="@+id/topic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/topic"
                android:textSize="22sp"
                android:textColor="@color/black"
                />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/topic_order"
                android:textSize="22sp"
                android:textColor="@color/black"
                tools:text="1"
                tools:drawableRight="@drawable/sort_up"
                />
        </TableRow>
        <TableRow
            android:paddingTop="8dp"
            android:layout_width="wrap_content"
            android:id="@+id/status"
            android:background="@drawable/ordering_pressed"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status"
                android:textSize="22sp"
                android:textColor="@color/black"
                />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/status_order"
                android:textSize="22sp"
                android:textColor="@color/black"
                tools:text="2"
                tools:drawableRight="@drawable/sort_down"
                />
        </TableRow>

        <TableRow
            android:background="@drawable/ordering_pressed"
            android:id="@+id/created"
            android:paddingTop="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/created"
                android:textSize="22sp"
                android:textColor="@color/black"
                />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/created_order"
                android:textSize="22sp"
                android:textColor="@color/black"
                tools:text="1"
                tools:drawableRight="@drawable/sort_up"
                />
        </TableRow>
        <TableRow
            android:background="@drawable/ordering_pressed"
            android:id="@+id/org"
            android:paddingTop="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/org_sort"
                android:textSize="22sp"
                android:textColor="@color/black"
                />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/org_order"
                android:textSize="22sp"
                android:textColor="@color/black"
                tools:text="1"
                tools:drawableRight="@drawable/sort_up"
                />
        </TableRow>
    </TableLayout>

    <Button
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:id="@+id/ok"
        android:ems="8"
        android:layout_gravity="center_horizontal"
        android:text="@android:string/ok"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        />
</LinearLayout>