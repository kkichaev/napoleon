<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
 	android:layout_height="match_parent"
 	android:layout_width="match_parent"
 	android:background="#FFFFFF" 
 	android:orientation="vertical">

	<LinearLayout
		android:id="@+id/llHeader"
		style="?header"
		android:layout_width="fill_parent"
		android:orientation="horizontal"
		android:layout_height="wrap_content">

		<TextView
			android:id="@+id/tvOrgName"
			style="?headerText"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="@string/organization" />
	</LinearLayout>

   <TableLayout android:layout_width="fill_parent" 
    	android:stretchColumns="*"
    	android:id="@+id/tableLayout1" 
    	android:layout_height="wrap_content" 
    	android:layout_weight="0">
       <TableRow android:id="@+id/tableRow1" 
	    	android:padding="2dp"
        	android:layout_width="wrap_content" 
        	android:layout_height="wrap_content">
			<LinearLayout android:id="@+id/LinearLayout02" 
				android:layout_height="wrap_content" 
				android:orientation="horizontal" 
				android:layout_weight="1" 
				android:layout_width="fill_parent">
			
				<TextView android:id="@+id/TextView01" 
					android:layout_width="wrap_content" 
					android:layout_height="wrap_content"
					android:textColor="#000000" 
					android:text="Дата:" 
					android:layout_weight="1" />
				
				<TextView android:layout_width="wrap_content" 
					android:layout_height="wrap_content" 
					android:textColor="#000000" 
					android:text="25.11.2010" 
					android:layout_weight="1" 
					android:id="@+id/tvDate" 
					android:layout_marginLeft="5dp" 
					android:layout_marginRight="5dp" 
					android:textStyle="bold" />
			</LinearLayout>
			<LinearLayout android:id="@+id/LinearLayout03" 
				android:layout_height="wrap_content" 
				android:layout_width="fill_parent" 
				android:layout_weight="1" 
				android:orientation="horizontal">
				
				<TextView android:id="@+id/TextView02" 
					android:layout_width="wrap_content" 
					android:layout_height="wrap_content"
					android:textColor="#000000" 
					android:text="Время:" 
					android:layout_weight="1" />
					
				<TextView android:layout_width="wrap_content" 
					android:layout_height="wrap_content" 
					android:textColor="#000000" 
					android:text="00:00" 
					android:id="@+id/tvTime" 
					android:layout_marginLeft="5dp" 
					android:layout_marginRight="5dp" 
					android:textStyle="bold" />
			</LinearLayout>
        </TableRow>
       <TableRow  
	    	android:padding="2dp"
        	android:layout_width="wrap_content" 
        	android:layout_height="wrap_content">
			<TextView android:layout_width="wrap_content" 
				android:layout_height="wrap_content" 
				android:textColor="#000000" 
				android:text="Отсрочка: 0" 
				android:layout_weight="1" 
				android:id="@+id/tvDelay" 
				android:layout_marginLeft="3dp" 
				android:textStyle="bold" />
				
			<CheckBox android:layout_width="wrap_content" 
				android:layout_height="wrap_content" 
				android:id="@+id/cbCreateOrderCash" 
				android:text="Наличные" 
				android:textColor="#000000" 
				android:layout_weight="0" />
        </TableRow>
    </TableLayout>
	
   <TableLayout android:layout_width="fill_parent" 
    	android:stretchColumns="1"
    	android:layout_height="wrap_content" 
    	android:layout_weight="0">
	
       <TableRow 
	    	android:padding="2dp"
        	android:layout_width="wrap_content" 
        	android:layout_height="wrap_content">
			
			<TextView android:id="@+id/TextView03" 
				android:layout_height="wrap_content" 
				android:text="Фирма" 
				android:textColor="#000000" 
				android:layout_marginLeft="5dp" 
				android:layout_marginRight="5dp" android:layout_width="wrap_content" 
				android:layout_gravity="center_vertical" />
						
			<Spinner android:layout_height="wrap_content" 
				android:layout_weight="1" 
				android:id="@+id/spFirma"
				android:layout_width="fill_parent" />
			
		</TableRow>
		
		<TableRow
			android:visibility="gone"
	    	android:padding="2dp"
        	android:layout_width="wrap_content" 
        	android:layout_height="wrap_content">
			
			<TextView  
				android:layout_height="wrap_content" 
				android:text="Вид оплаты" 
				android:textColor="#000000" 
				android:layout_marginLeft="5dp" 
				android:layout_marginRight="5dp" android:layout_width="wrap_content" 
				android:layout_gravity="center_vertical" />
						
			<Spinner android:layout_height="wrap_content" 
				android:layout_weight="1" 
				android:id="@+id/spPayType"
				android:layout_width="fill_parent" />
			
		</TableRow>       
       <TableRow
	    	android:padding="2dp"
        	android:layout_width="wrap_content"
        	android:layout_height="wrap_content">
			
			<TextView 
				android:layout_height="wrap_content" 
				android:text="Договор" 
				android:textColor="#000000" 
				android:layout_marginLeft="5dp" 
				android:layout_marginRight="5dp" android:layout_width="wrap_content" 
				android:layout_gravity="center_vertical" />
						
			<Spinner android:layout_height="wrap_content" 
				android:layout_weight="1" 
				android:id="@+id/spDog"
				android:layout_width="fill_parent" />
			
		</TableRow>
       
       <TableRow 
	    	android:padding="2dp"
        	android:layout_width="wrap_content" 
        	android:layout_height="wrap_content">
			
			<TextView
				android:layout_height="wrap_content" 
				android:text="Склад" 
				android:textColor="#000000" 
				android:layout_marginLeft="5dp" 
				android:layout_marginRight="5dp" android:layout_width="wrap_content" 
				android:layout_gravity="center_vertical" />
						
			<Spinner android:layout_height="wrap_content" 
				android:layout_weight="1" 
				android:id="@+id/spWh"
				android:layout_width="fill_parent" />
			
		</TableRow>
       <TableRow 
	    	android:padding="2dp"
        	android:layout_width="wrap_content" 
        	android:layout_height="wrap_content" android:visibility="gone">
			
			<TextView android:id="@+id/TextView04" 
				android:layout_height="wrap_content" 
				android:textColor="#000000" 
				android:text="Цена" 
				android:layout_marginLeft="5dp" 
				android:layout_marginRight="5dp" android:layout_width="wrap_content" 
				android:layout_gravity="center_vertical" />
			<Spinner android:layout_height="wrap_content" 
				android:layout_weight="1"
				android:id="@+id/spPrices"
				android:layout_width="fill_parent" />
		</TableRow>		
	</TableLayout>
	
	<LinearLayout android:id="@+id/LinearLayout07" 
		android:layout_height="wrap_content" 
		android:layout_width="fill_parent" 
		android:layout_weight="1">
		
		<EditText android:layout_weight="1" 
			android:layout_height="fill_parent" 
			android:layout_width="fill_parent" 
			android:id="@+id/edCreateOrderNotes" 
			android:gravity="top|left"
			android:minLines="2" android:lines="2" />
	</LinearLayout>

	<LinearLayout
		android:id="@+id/LinearLayout08"
		style="?footer"
		android:layout_width="fill_parent"
		android:layout_height="wrap_content">

		<TextView
			android:id="@+id/btnCancel"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:text="@string/cancel"
			android:paddingTop="8dp"
			android:paddingBottom="8dp"
			style="?textButton"
			android:layout_marginRight="7dp">
		</TextView>

		<TextView
			android:id="@+id/btnOK"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="3"
			android:text="@string/ok"
			android:paddingTop="8dp"
			android:paddingBottom="8dp"
			style="?textButton" >
		</TextView>
	</LinearLayout>
</LinearLayout>
