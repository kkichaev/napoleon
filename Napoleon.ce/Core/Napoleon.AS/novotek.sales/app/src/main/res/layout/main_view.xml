<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#A41E22">

    <TextView
        android:id="@+id/select_org"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/srch_ctr"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingTop="8dp"
        tools:text="630078, Новосибирская обл, Новосибирск г, Карла Маркса пл, дом № 3"
        android:textColor="@color/white"
        android:drawableEnd="@drawable/ic_expand_more"
        />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:id="@+id/srch_ctr"
        android:layout_marginLeft="20dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@id/favorites"
        app:layout_constraintTop_toBottomOf="@id/select_org"
        app:layout_constraintBottom_toTopOf="@id/body"
        android:background="@drawable/rounded_corner_find"
        >
        <androidx.appcompat.widget.SearchView
            android:id="@+id/find"
            app:iconifiedByDefault="false"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            app:queryHint="@string/find_items"
            />
        <ImageView
            android:id="@+id/barcode"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_barcode"
            android:layout_gravity="center"
            android:paddingRight="16dp"
            android:paddingTop="8dp"
            android:paddingLeft="8dp"
            android:paddingBottom="8dp"
             />
    </LinearLayout>

    <ImageButton
        android:id="@+id/favorites"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="20dp"
        android:background="@drawable/rounded_corner_find"
        android:src="@drawable/ic_favorite"
        app:layout_constraintLeft_toRightOf="@id/srch_ctr"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/select_org"
        tools:ignore="SpeakableTextPresentCheck" />

    <LinearLayout
        android:id="@+id/body"
        app:layout_constraintTop_toBottomOf="@id/srch_ctr"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/rounded_top"
        android:orientation="vertical"
        >

        <androidx.fragment.app.FragmentContainerView
            android:layout_marginTop="16dp"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/frmActions"
            />

        <androidx.fragment.app.FragmentContainerView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:id="@+id/frmCatalog"
            />

        <androidx.fragment.app.FragmentContainerView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:id="@+id/frmBrands"
            />

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>