<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bkgColor"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">


    <TextView
        android:id="@+id/confirm"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/hint_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/PhoneText"
        android:text="@string/confirm"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_marginTop="8dp"
        />

    <TextView
        android:id="@+id/hint_text"
        app:layout_constraintTop_toBottomOf="@id/confirm"
        android:layout_marginTop="64dp"
        app:layout_constraintBottom_toTopOf="@id/phone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/PhoneTextSmall"
        android:text="@string/type_from_sms"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        />

    <TextView
        android:id="@+id/phone"
        style="@style/PhoneText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="bottom"
        android:text=""
        tools:text="+7 999 999 99"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/hint_text"
        app:layout_constraintBottom_toTopOf="@id/code"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
         />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/code"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="160dp"
        android:layout_height="0dp"
        app:layout_constraintHeight_min="60dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@+id/phone"
        app:layout_constraintBottom_toTopOf="@+id/doButton"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        >

        <com.google.android.material.textfield.TextInputEditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:imeOptions="actionDone"
            android:fontFamily="@font/montserrat"
            android:textSize="22sp"
            android:autofillHints="smsOTPCode"
            android:importantForAutofill="yes">
            <requestFocus />
        </com.google.android.material.textfield.TextInputEditText>
    </com.google.android.material.textfield.TextInputLayout>

<!--    <View-->
<!--        android:id="@+id/dummy"-->
<!--        app:layout_constraintLeft_toLeftOf="parent"-->
<!--        app:layout_constraintTop_toBottomOf="@id/code"-->
<!--        app:layout_constraintBottom_toTopOf="@id/doButton"-->
<!--        android:layout_width="0dp"-->
<!--        android:layout_height="0dp"-->
<!--        android:minHeight="5dp"-->
<!--        app:layout_constraintVertical_weight="1"-->
<!--        />-->

    <Button
        android:id="@+id/doButton"
        style="@style/PhoneButton"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@+id/code"
        app:layout_constraintBottom_toTopOf="@id/doAgain"
        android:layout_width="wrap_content"
        android:ems="17"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:text="ПОДТВЕРДИТЬ" />

    <Button
        android:id="@+id/doAgain"
        style="@style/PhoneButton"
        android:layout_marginTop="0dp"
        android:layout_marginBottom="16dp"
        android:backgroundTint="@color/gray_bg"
        android:textColor="@color/black"
        app:layout_constraintTop_toBottomOf="@+id/doButton"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_width="wrap_content"
        android:ems="17"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:text="@string/send_again" />

</androidx.constraintlayout.widget.ConstraintLayout>