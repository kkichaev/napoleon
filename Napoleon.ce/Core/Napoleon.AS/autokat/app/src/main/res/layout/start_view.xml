<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.appcompat.widget.SearchView
        android:id="@+id/search"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:iconifiedByDefault="false"
        app:queryHint="@string/search_hint"
        android:focusableInTouchMode="true"
        />
    <View
        android:id="@+id/div1"
        app:layout_constraintTop_toBottomOf="@id/search"
        android:background="@color/ltGray"
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider"
        />

    <LinearLayout
        app:layout_constraintTop_toBottomOf="@id/div1"
        app:layout_constraintBottom_toTopOf="@id/bottom_bar"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@id/div2"
        android:id="@+id/left_panel"
        app:layout_constraintVertical_weight="1"
        app:layout_constraintHorizontal_weight="1"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        >

        <Button
            android:backgroundTint="@color/ltGray"
            android:background="?attr/selectableItemBackground"
            android:textColor="@android:color/black"
            android:textSize="18sp"
            android:fontFamily="@font/inter"
            android:id="@+id/set_date"
            android:layout_width="match_parent"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:layout_height="wrap_content"
            tools:text="15.01.2022"
            />
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/items"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            />
        <View
            app:layout_constraintTop_toBottomOf="@id/search"
            android:background="@color/ltGray"
            android:layout_width="match_parent"
            android:layout_height="@dimen/divider"
            />
    </LinearLayout>

    <View
        android:id="@+id/div2"
        app:layout_constraintTop_toBottomOf="@id/div1"
        app:layout_constraintBottom_toTopOf="@id/bottom_bar"
        app:layout_constraintLeft_toRightOf="@id/left_panel"
        app:layout_constraintRight_toLeftOf="@id/right_panel"
        android:background="@color/ltGray"
        android:layout_width="@dimen/divider"
        android:layout_height="0dp"
        />

    <androidx.constraintlayout.widget.ConstraintLayout
        app:layout_constraintLeft_toRightOf="@id/div2"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/search"
        app:layout_constraintBottom_toTopOf="@id/bottom_bar"
        app:layout_constraintVertical_weight="1"
        app:layout_constraintHorizontal_weight="1"
        android:id="@+id/right_panel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        >

        <TextView
            android:id="@+id/start_visit"
            style="@style/ActionText"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            android:drawableStart="@drawable/ic_start_visit"
            android:text="@string/start_visit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            />

        <View
            app:layout_constraintTop_toBottomOf="@id/start_visit"
            app:layout_constraintLeft_toLeftOf="parent"
            android:id="@+id/div3"
            android:layout_width="match_parent"
            android:layout_height="@dimen/divider"
            android:background="@color/ltGray"
            />

        <TextView
            android:id="@+id/add_new_client"
            style="@style/ActionText"
            app:layout_constraintTop_toBottomOf="@id/div3"
            app:layout_constraintLeft_toLeftOf="parent"
            android:drawableStart="@drawable/ic_add_new_client"
            android:text="@string/add_new_client"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            />

        <TextView
            android:id="@+id/edit_client"
            style="@style/ActionText"
            app:layout_constraintTop_toBottomOf="@id/add_new_client"
            app:layout_constraintLeft_toLeftOf="parent"
            android:drawableStart="@drawable/ic_edit_client"
            android:text="@string/edit_client"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            />

        <TextView
            android:id="@+id/show_map"
            style="@style/ActionText"
            app:layout_constraintTop_toBottomOf="@id/edit_client"
            app:layout_constraintLeft_toLeftOf="parent"
            android:drawableStart="@drawable/ic_show_map"
            android:text="@string/show_map"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            />

        <TextView
            android:id="@+id/show_documents"
            style="@style/ActionText"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            android:drawableStart="@drawable/ic_documents"
            android:text="@string/show_documents"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            />

    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/bottom_bar"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/primary"
        >
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            >
            <View
                android:id="@+id/guide1"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="4dp" />
            <View
                android:id="@+id/guide2"
                android:background="@color/white"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="4dp" />
            <View
                android:layout_width="0dp"
                android:layout_weight="2"
                android:layout_height="4dp" />
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            >
            <TextView
                android:id="@+id/show_route"
                android:textColor="@color/white"
                android:text="@string/route"
                android:textSize="14sp"
                android:fontFamily="@font/inter"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:gravity="center"
                />
            <TextView
                android:id="@+id/showo_clients"
                android:textColor="@color/white"
                android:text="@string/clients"
                android:textSize="14sp"
                android:gravity="center"
                android:fontFamily="@font/inter"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                />
            <View
                android:layout_width="0dp"
                android:layout_weight="2"
                android:layout_height="0dp" />
        </LinearLayout>
    </LinearLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:visibility="gone"
        android:background="@color/wait_bg"
        android:id="@+id/waiting"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        >

        <LinearLayout
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintLeft_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:background="@drawable/wait_rounded_corner"
            android:id="@+id/load_progress"
            android:layout_gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp"
            android:padding="24dp"
            android:orientation="vertical">
            <TextView
                android:id="@+id/progress_text"
                android:gravity="center_horizontal"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sync"
                android:layout_marginBottom="8dp"
                />
            <ProgressBar
                style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                android:id="@+id/progress"
                android:layout_marginLeft="24dp"
                android:layout_marginRight="24dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>