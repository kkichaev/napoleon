<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="MainTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorSecondary">@color/primary</item>
    </style>

    <style name="ActionText">
        <item name="android:textSize">22sp</item>
        <item name="fontFamily">@font/inter</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingTop">26dp</item>
        <item name="android:paddingBottom">26dp</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:textColor">@color/black</item>
    </style>
    
    <style name="SettingsButton">
        <item name="android:textSize">18sp</item>
        <item name="fontFamily">@font/inter</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="SettingSwitch" parent="Widget.MaterialComponents.CompoundButton.Switch">
        <item name="materialThemeOverlay">@style/ThemeOverlay.App.Switch</item>
    </style>

    <style name="SettingTextBox">
        <item name="android:layout_marginTop">8dp</item>
    </style>

    <style name="SettingCombo" parent="Widget.MaterialComponents.TextInputLayout.FilledBox.ExposedDropdownMenu">
        <item name="android:layout_marginTop">8dp</item>
    </style>

    <style name="ComboDropdown" parent="Widget.MaterialComponents.TextInputLayout.FilledBox.ExposedDropdownMenu">
        <item name="android:layout_marginTop">8dp</item>
    </style>

    <style name="SettingTab">
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:layout_marginBottom">16dp</item>
    </style>

    <style name="ThemeOverlay.App.Switch" parent="">
        <item name="colorSecondary">@color/primary</item>
    </style>

    <style name="TitleBar" parent="ThemeOverlay.AppCompat.Dark.ActionBar">
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">@color/white</item>
        <item name="actionMenuTextColor">@color/green</item>
    </style>

    <style name="OrgTextPrimary">
        <item name="fontFamily">@font/inter</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@android:color/black</item>
    </style>

    <style name="OrgTextSecondary">
        <item name="fontFamily">@font/inter</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@android:color/black</item>
    </style>

    <style name="AboutText">
        <item name="fontFamily">@font/inter</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@android:color/black</item>
    </style>

    <style name="TitleDlgText">
        <item name="fontFamily">@font/inter</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@android:color/black</item>
    </style>

    <style name="PurchaseText">
        <item name="android:gravity">center_vertical</item>
        <item name="fontFamily">@font/inter</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/black</item>
    </style>
    <style name="PurchaseHeadText" parent="PurchaseText">
        <item name="android:layout_marginTop">1dp</item>
        <item name="android:layout_marginBottom">1dp</item>
        <item name="android:layout_marginStart">1dp</item>
    </style>
    <style name="PurchaseRowText" parent="PurchaseText">
        <item name="android:textStyle">normal</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>
    <style name="InputItemText">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:layout_gravity">bottom</item>
        <item name="android:layout_marginBottom">2dp</item>
    </style>
    <style name="InputButtonText">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:gravity">center</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:background">?attr/selectableItemBackground</item>
    </style>
    <style name="InputButton">
        <item name="android:layout_width">@dimen/input_button_sz</item>
        <item name="android:layout_height">@dimen/input_button_sz</item>
        <item name="cardElevation">4dp</item>
        <item name="cardUseCompatPadding">true</item>
        <item name="cardCornerRadius">8dp</item>
        <item name="android:layout_marginStart">@dimen/input_button_margin</item>
        <item name="android:layout_marginBottom">16dp</item>
    </style>
    <style name="PriceHead">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textStyle">bold</item>
        <item name="android:padding">16dp</item>
    </style>
    <style name="PriceText" parent="PriceHead">
        <item name="android:textStyle">normal</item>
    </style>
    <style name="spinnerItem" parent="@android:style/Widget.TextView">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:background">#d3d3d3</item>
    </style>
    <style name="ScriptPropText">
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">16sp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>
    <style name="ScriptPropCombo" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="errorEnabled">true</item>
    </style>
    <style name="ScripPropInput" parent="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="errorEnabled">true</item>
    </style>

    <style name="CalendarDateText" parent="@android:style/TextAppearance.Material.Caption">
        <item name="fontFamily">@font/inter</item>
        <item name="android:textColor" >@color/inverse_text_color</item>
        <item name="android:textSize">16sp</item>
    </style>
</resources>