<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/dialog_bg_round"
    xmlns:tools="http://schemas.android.com/tools"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    >

    <LinearLayout
        android:id="@+id/panel"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintLeft_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="4dp"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/rounded_top"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"

        android:paddingBottom="20dp"
        >

        <TextView
            android:paddingTop="16dp"
            android:paddingBottom="8dp"
            style="@style/TitleDlgText"
            android:text="@string/attantion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"/>

        <TextView
            android:id="@+id/message"
            android:textStyle="normal"
            android:paddingTop="16dp"
            style="@style/AboutText"
            android:text="@string/passport_not_validated"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"/>
    </LinearLayout>

    <TextView
        android:background="@null"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/pca"
        app:layout_constraintTop_toBottomOf="@id/panel"
        app:layout_constraintBottom_toBottomOf="parent"
        android:text="@string/repeat"
        android:id="@+id/repeat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:paddingEnd="15dp"
        android:paddingStart="8dp"/>

    <TextView
        android:background="@null"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/panel"
        app:layout_constraintBottom_toBottomOf="parent"
        android:text="@string/pca2"
        android:id="@+id/pca"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:paddingEnd="8dp"
        android:paddingStart="8dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>