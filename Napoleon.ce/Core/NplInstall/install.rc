    PUSHBUTTON      "Отмена",IDCANCEL,7,140,50,14
    LISTBOX         IDC_FOLDER_LIST,7,7,231,130,LBS_SORT | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
END

IDD_PROGRESS_DIALOG DIALOGEX 0, 0, 229, 87
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
