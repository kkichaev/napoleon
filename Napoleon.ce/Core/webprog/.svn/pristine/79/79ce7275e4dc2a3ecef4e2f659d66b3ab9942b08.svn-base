<p>{{ _('Dear  %(username)s,', username=user.name ) }}</p>
<p>
    {{ _('To confirm email')}}
    <a href="{{ url_for('auth.handle_create_user', token=token, _external=True) }}">
        {{_('click here')}}
    </a>.
</p>
<p>{{ _("Alternatively, you can paste the following link in your browser's address bar:") }}</p>
<p>{{ url_for('auth.handle_create_user', token=token, _external=True) }}</p>
<p>{{ _('If you have not requested a password reset simply ignore this message.') }}</p>
<p>{{_('Sincerely')}},</p>
<p>{{_('The GRSoft Team')}}</p>
