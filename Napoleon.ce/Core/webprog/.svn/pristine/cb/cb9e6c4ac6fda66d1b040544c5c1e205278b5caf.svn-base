import api from "axios";
import { useBackendStore } from "src/stores/backend";

function getHost() {
  const http = 'http://'
  const port = 3000

  return http + useBackendStore().baseURL + ':' + port
}

export function registerUser(user) {
  const headers = {
    "Content-Type": "application/json;charset=UTF-8",
  };

  const url = "/api/users";

  return api.post(getHost(), user, headers)
}

