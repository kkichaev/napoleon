<template>
  <q-layout view="hHh Lpr lff">
    <q-header elevated>
      <q-toolbar class="toolbar">
        <q-btn flat @click="drawer = !drawer" round dense icon="menu" />

        <q-avatar>
          <img src="~/assets/ic_launcher.png" />
        </q-avatar>
        <q-toolbar-title style="font-weight: 500">{{
          $t("appTitle")
        }}</q-toolbar-title>

        <q-space />

        <q-btn-dropdown
          flat
          :label="getLocaleLabel($i18n.locale)"
          no-caps
          dropdown-icon="img: /src/assets/arrow-white.png"
        >
          <q-list>
            <q-item
              v-for="opt in locales"
              clickable
              v-close-popup
              @click="selectLocale(opt.value)"
              :key="opt.value"
            >
              <q-item-section>
                <q-item-label>{{ opt.label }}</q-item-label>
              </q-item-section>
            </q-item>
          </q-list>
        </q-btn-dropdown>
      </q-toolbar>
    </q-header>

    <q-drawer
      v-model="drawer"
      show-if-above
      :width="256"
      :breakpoint="500"
      bordered
      :class="$q.dark.isActive ? 'bg-grey-9' : 'bg-grey-3'"
    >
      <q-list class="full-height">
        <template v-for="(menuItem, index) in menuList" :key="index">
          <q-item
            clickable
            :active="menuItem.label === 'profil'"
            v-ripple
            :to="{ name: menuItem.route }"
          >
            <q-item-section avatar>
              <q-icon :name=getIconName(menuItem.icon) />
            </q-item-section>
            <q-item-section>
              {{ $t(menuItem.label) }}
            </q-item-section>
          </q-item>
        </template>
      </q-list>

      <q-item class="fixed-bottom" clickable v-ripple>
        <q-item-section avatar>
          <q-icon name="img: /src/assets/exit.png" />
        </q-item-section>
        <q-item-section @click="exit">
          {{ $t("exit") }}
        </q-item-section>
      </q-item>
    </q-drawer>

    <q-page-container>
      <router-view />
    </q-page-container>
  </q-layout>
</template>

<script setup>
import { computed, ref } from "vue";
import { useQuasar, Quasar } from "quasar";
import { useI18n } from "vue-i18n";
import { logout } from "src/backend/backend";

const menuList = [
  {
    icon: "user",
    label: "profil",
    route: "Profile",
  },
  {
    icon: "projects",
    label: "project",
    route: "Project",
  },
  {
    icon: "billing",
    label: "balance.title",
    route: "Balance",
  },
  {
    icon: "tarif",
    label: "tarif",
    route: "Tarif",
  },
];

const locale = computed(() => getLocaleLabel($q.lang.isoName));
const $q = useQuasar();
const i18n = useI18n();
const drawer = ref(true)

const locales = [
  { value: "en-US", label: "En" },
  { value: "ru", label: "Ru" },
];

function getLocaleLabel(key) {
  var res = "";
  if (key == "") {
    key = $q.lang.isoName;
  }
  locales.every((loc) => {
    if (loc.value === key) {
      res = loc.label;
      return false;
    }
    return true;
  });

  return res;
}

function selectLocale(key) {
  i18n.locale.value = key;
}

const exit = () => {
  logout();
}

const getIconName = (icon)=>{
  return `img: src/assets/${icon}.png`
  //return ""
}

</script>

<style scoped></style>
