</template>

<script setup>
import { ref } from "vue";
import { useMainStore } from "src/stores/main-store";
import { registerUser } from "src/backend/backend";

const save_password = ref(false);
const mainStore = useMainStore();
const email = ref("test@test.com");
const password = ref("123456");
const regSuccess = ref(false)

function register() {
  registerUser({ email: email.value, password: password.value }).then((response) => {
      console.log("https://aceteam.app/api/users - success : ", response);
      regSuccess.value = true
    })
    .catch((error) => {
      console.log("/api/users : ", error);
    });
}

</script>

