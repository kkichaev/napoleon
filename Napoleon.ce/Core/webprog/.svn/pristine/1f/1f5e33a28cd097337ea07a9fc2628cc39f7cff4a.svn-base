    "clean": "npm-run-all \"clean:*\"",
    "clean:example": "rm -rf ./examples/dist",
    "clean:lib": "rm -rf ./lib",
    "dev": "vite examples --config ./examples/vite.config.ts",
    "dev:composition": "vite examples/composition --config ./examples/composition/vite.config.ts",
