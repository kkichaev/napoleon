import { api } from "boot/axios";

function getHost(){
  return window.location.protocol + "//" + window.location.hostname;
}

export async function registerUser(user) {
  const headers = {
    "Content-Type": "application/json;charset=UTF-8",
  };

  const url = getHost() + "/api/users";

  const responce = await api.post(url, user, {
    headers,
    withCredentials: true,
  })

  if (responce.message != undefined)
    throw({message: "RegisterUser Error", code: responce.message})

  return responce
}

export async function sendRegToken(token){
  console.log('sendRegToken')
  const headers = {
    "Content-Type": "application/json;charset=UTF-8",
  };

  const url = getHost() + "/auth/cnf_email/" + token;

  const responce = await api.get(url, {
      headers,
      withCredentials: true
    })

  if (responce.status != '200' || responce.data == undefined)
    throw({message: "SendRegToken Error", code: responce.status})

  return responce
}

export async function isAuth(){
  try{
    var res = await users()

    if (res)
      return true
  }catch{
    return false
  }

  return false
}

export async function users(){
  const headers = {
    "Content-Type": "application/json;charset=UTF-8",
  };

  const url = getHost() + "/auth/user";

  var responce = await api.get(url, {
      headers,
      withCredentials: true,
    })

  if (responce.status != '200' || responce.data == undefined)
    throw({message: "User Error", code: responce.status})

  return responce
}

export async function loginUser(user){
  const headers = {
    "Content-Type": "application/json;charset=UTF-8",
  };

  const url = getHost() + "/auth/login";

  const responce =  await api.post(url, {email: user.email, password: user.password, remember: user.remember},
    {
      headers,
      withCredentials: true
    })

  if (responce.status != '200' || responce.data == undefined)
    throw({message: "LoginUser Error", code: responce.status})

  return responce
}

function zdig(dig){
  if (dig < 10)
    dig = '0' + dig

  return dig
}

export async function registerProject(data){
  const headers = {
    "Content-Type": "application/json;charset=UTF-8",
  };

  var url = getHost() + "/api/account";

  var responce = await api.post(url, {country: data.country, currency: data.currency},
    {
      headers,
      withCredentials: true
    })

  if (responce.status != '200' || responce.data == undefined)
    throw({message: "Register Project Account Error", code: responce.status})

  const now = new Date();
  const date = `${now.getFullYear()}${zdig(now.getMonth()+1)}${zdig(now.getDate())}`
  const tarif = "standard"

  url = getHost() + "/api/tarif";

  responce = await api.post(url, {date: date, serverid: data.serverid, tarif: tarif},
    {
      headers,
      withCredentials: true
    })

  if (responce.status != '200' || responce.data == undefined)
    throw({message: "Register Project Tarif Error", code: responce.status})

  return responce
}

export async function logout(){
  console.log('logout')
  const headers = {
    "Content-Type": "application/json;charset=UTF-8",
  };

  const url = getHost() + "/auth/logout";

  const responce = await api.get(url, {
      headers,
      withCredentials: true
    })

  return responce
}
