// app global css in SCSS form

.form-title{
  font-size: 24px;
  font-weight: bold;
}

.toolbar{
  background-color: #126E82 ;
}

.login-btn{
  width: 100%;
  height: 50px;
  background-color: #4FBDBA;
  color: #ffffff;
  padding: 0px;
}

.login-form-text{
  font-size: 20px;
}

.login-form{
  width: 280px
}

.login-card-section{
  padding: 0px
}

.login-page{
  margin-top: 32px;
}

.dropdown-btn{
  width: 100%;
  height: 42px;
  background-color: "#66D9D9D9";

  padding: 0px;
}

.error-message{
  font-size: 16px;
  color: #FF0000;
}
