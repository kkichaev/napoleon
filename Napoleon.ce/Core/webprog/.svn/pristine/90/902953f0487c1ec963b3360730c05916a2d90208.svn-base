<template>
  <q-page class="login-page">
    <q-card class="q-ml-auto q-mr-auto login-form" flat>
      <q-card-section class="form-title text-center login-card-section">
        {{ $t("login.title") }}
      </q-card-section>

      <q-card-section
        v-if="loginError"
        class="error-message text-center login-card-section"
        style="margin-top: 8px"
      >
        {{ $t("login.error") }}
      </q-card-section>

      <q-card-section class="login-card-section" style="margin-top: 40px">
        <q-form ref="form">
          <q-input
            v-model="email"
            :label="$t('login.emailLabel')"
            filled
            :rules="[(val) => !!val || $t('field_is_required')]"
            hide-bottom-space
          />

          <q-input
            style="margin-top: 32px"
            :label="$t('login.passwordLabel')"
            filled
            v-model="password"
            :rules="[(val) => !!val || $t('field_is_required')]"
            hide-bottom-space
          />

          <q-checkbox
            :label="$t('login.savePassword')"
            style="margin-top: 33px"
            v-model="remember"
            class="login-form-text"
            hide-bottom-space
          />
        </q-form>

        <q-card-section
          class="text-center login-card-section"
          v-if="loginError"
          style="margin-top: 33px"
        >
          <q-btn
            flat
            :label="$t('login.forgotPassword')"
            no-caps
            class="login-form-text"
            :to="{ name: 'RestorePassword' }"
          />
        </q-card-section>

        <q-btn
          class="login-btn login-form-text"
          no-caps
          style="margin-top: 32px"
          :label="$t('login.enter')"
          @click="login"
        />
      </q-card-section>

      <q-card-section
        class="text-center login-card-section"
        style="margin-top: 32px"
      >
        <q-btn
          class="login-form-text"
          flat
          :label="$t('login.reqistration')"
          no-caps
          :to="{ name: 'Register' }"
        />
      </q-card-section>

      <q-card-section
        class="text-center login-card-section"
        style="margin-top: 32px"
      >
        <q-btn class="login-form-text" flat no-caps padding="0px">
          <u>{{ $t("login.supportEmail") }}</u>
        </q-btn>
      </q-card-section>
    </q-card>
  </q-page>
</template>

<script>
import { ref } from "vue";
import { useBackendStore } from "src/stores/backend";
import { useGuard } from "src/components/guard";
import { loginUser } from "src/backend/backend";
import { useRouter } from "vue-router";

export default {
  setup() {
    //const guard = useGuard()
    const remember = ref(true);
    const email = ref("");
    const password = ref("");
    const form = ref(null);
    const forgotPassword = ref(false);
    const store = useBackendStore();
    const router = useRouter();
    const loginError = ref(false);

    function login() {
      loginError.value = false;

      form.value.validate().then((success) => {
        if (success)
          loginUser({
            email: email.value,
            password: password.value,
            remember: remember.value,
          })
            .then((responce) => {
              useBackendStore().isAuth = true;
              router.push({ name: "Profile" });
            })
            .catch((error) => (loginError.value = true));
      });
    }

    return {
      remember,
      email,
      password,
      form,
      forgotPassword,
      store,
      login,
      loginError,
    };
  },
};

