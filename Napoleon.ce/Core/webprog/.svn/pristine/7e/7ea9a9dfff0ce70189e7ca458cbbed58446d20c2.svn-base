.scrollarea{max-height:calc(100vh - 200px);overflow:auto}.num_col{max-width:15px}.q-btn{padding:4px}.page-header{margin-bottom:16px}.form{border:2px solid #126E82;min-height:calc(100vh - 150px);margin-right:4px}@media (max-width: 1023.98px){.form{min-height:calc(50vh - 100px);margin-right:0}}.dlg-form{border:2px solid #126E82;min-height:calc(100vh - 120px);margin-right:2px}@media (max-width: 1023.98px){.dlg-form{min-height:calc(50vh - 70px);margin-right:0}}.dlg-form .dlg-scroll{height:calc(100% - 65px)}.header-form{border-bottom:2px solid #126E82;padding-left:6px;min-height:50px}.form+.form{margin-left:4px;margin-right:0}@media (max-width: 1023.98px){.form+.form{margin-top:10px;margin-left:0;margin-right:0}}.dlg-form+.dlg-form{margin-left:2px;margin-right:0}@media (max-width: 1023.98px){.dlg-form+.dlg-form{margin-top:10px;margin-left:0;margin-right:0}}.folder-row{background-color:#d9d9d933}
