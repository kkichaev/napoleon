import { api } from "boot/axios";
import { useBackendStore } from "src/stores/backend";

function getHost(){
  return window.location.protocol + "//" + window.location.hostname;
}

export function registerUser(user) {
  const headers = {
    "Content-Type": "application/json;charset=UTF-8",
  };

  const url = getHost() + "/api/users";

  return api.post(url, user, {
    headers,
    withCredentials: true,
  })
}

export function sendRegToken(token){
  console.log('sendRegToken')
  const headers = {
    "Content-Type": "application/json;charset=UTF-8",
  };

  const url = getHost() + "/auth/cnf_email/" + token;
  api.get(url, {
    headers,
    withCredentials: true
  })
    .then((resopnce)=>{console.log('success: ', resopnce)})
    .catch((error)=>{console.log('error: ', error)})
}

export async function isAuth(){
  const headers = {
    "Content-Type": "application/json;charset=UTF-8",
  };

  const url = getHost() + "/auth/user";

  try{
    var responce = await api.get(url, {
      headers,
      withCredentials: true,
    })

    if (responce.status != '200' || responce.data == undefined)
      throw('auth error: ' + responce)

    return responce
  }catch(error){
    throw('auth error: ' + error)
  }
}

export async function loginUser(user){
  console.log('login: ', user )
  const headers = {
    "Content-Type": "application/json;charset=UTF-8",
  };

  const url = getHost() + "/auth/login";

  console.log('login user: ' + url)

  try{
    return await api.post(url, {email: user.email, password: user.password, remember: user.remember},
      {
        headers,
        withCredentials: true
      })

  }catch(error){
    throw(error)
  }
}
