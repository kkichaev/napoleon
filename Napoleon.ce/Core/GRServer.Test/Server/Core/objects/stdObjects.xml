<?xml version="1.0" ?>
<serverDefs xmlns="http://grsoft.ru/schemas/serverDefs.xsd">
   <objects>
      <object name="ServerCommand">
         <field name="command" type="string" />
         <field name="param" type="string" />
         <field name="userid" type="string" />
         <field name="password" type="string" />
         <field name="version" type="string" />
         <field name="duration" type="number" />
         <field name="category" type="string" />
         <field name="progid" type="string" feature="CHECK_LOGIN_PROGID" />
      </object>

      <object name="ServerAnswer">
         <field name="response" type="number" />
         <field name="message" type="string" />
      </object>

      <object name="UpdatePacket">
         <field name="packet" type="binary" />
      </object>

      <object name="UpdateCommand">
         <!-- пакет серверу для обновления -->
         <field name="userid" type="string" />
         <field name="password" type="string" />
         <field name="packet" type="binary" />
      </object>

      <object name="StreamContinue">
         <field name="continue" type="number" />
      </object>

      <object name="UserActivity">
         <sources>
            <source name="SQTable" type="internal" />
         </sources>

         <member name="primaryKey">"id"</member>

         <field name="id" type="string" />
         <field name="date" type="timestamp" />
         <field name="version" type="string" />
         <field name="duration" type="number" />
      </object>

      <object name="LicensedUsers">
         <sources>
            <source name="LicensedUsersSource" type="any" />
         </sources>

         <field name="id" type="string" />
         <field name="type" type="string" />
      </object>

      <object name="LicenseCount">
         <sources>
            <source name="LicenseCountSource" />
         </sources>

         <field name="pda" type="number" />
         <field name="manager" type="number" />
         <field name="exclusiveManager" type="number" />
      </object>

      <object name="LicenseCountEx">
         <sources>
            <source name="LicenseCountSourceEx" />
         </sources>

         <field name="type" type="string" />
         <field name="count" type="number" />
      </object>

      <object name="LicenseType">
         <sources>
            <source name="LicenseTypeSource" />
         </sources>

         <field name="type" type="string" />
         <field name="forAgents" type="number" />
         <field name="title" type="string" />
      </object>

      <object name="LicenseProjectData">
         <sources>
            <source name="LicenseProjectDataSource" />
         </sources>

         <field name="id" type="number" />
         <field name="type" type="string" />
         <field name="count" type="number" />
         <field name="start" type="date" />
         <field name="end" type="date" />
      </object>

     <object name="DemoProjectData">
       <sources>
         <source name="DemoProjectDataSource" />
       </sources>

       <field name="id" type="number" />
       <field name="type" type="string" />
       <field name="allowCount" type="number" />
       <field name="timeSpan" type="number" />
     </object>

     <object name="ReqServerData">
       <field name="name" type="string" />
       <field name="data" type="string" />
       <field name="tz" type="number" />
     </object>

     <object name="LicensingUsersData">
         <sources>
            <source name="LicensingUsersDataSource" />
         </sources>

         <field name="licenseID" type="number" />
         <field name="login" type="string" />
      </object>

      <object name="User">
         <field name="id" type="string" />
         <field name="name" type="string" />
         <field name="duration" type="number" />
         <field name="registred" type="number" />
         <field name="version" type="string" />
         <field name="progID" type="string" />
      </object>

      <object name="LogData">
         <sources>
            <source name="LogSource" />
         </sources>
         <field name="date" type="timestamp" />
         <field name="text" type="string" />
      </object>

      <object name="%ServerInfo">
         <sources>
            <source name="ServerInfo" />
         </sources>
         <field name="curdate" type="timestamp" />
         <field name="userid" type="string" />
         <field name="serverTimeZone" type="number" execOn="Get">ServerTimeZone()</field>
      </object>

      <object name="%ActiveUsers">
         <sources>
            <source name="ActiveUsers" />
         </sources>
         <field name="duration" type="number" />
         <field name="userid" type="string" />
         <field name="ip" type="string" />
         <field name="isExclusive" type="number" />
      </object>

      <object name="%ResolveInfo">
         <field name="name" type="string" />
      </object>

      <object name="%ReportSourceParam">
         <field name="condition" type="string" />
         <field name="objectName" type="string" />
      </object>
   </objects>

   <actions>
      <action name="WriteActivity">
         <do>
            <put object="UserActivity" sourceType="internal">$object.id=$user.id;$object.date=Now();$object.version=$user.version;$object.duration=$user.duration</put>
         </do>
      </action>
   </actions>

   <events>
      <event type="login">
         <action name="WriteActivity" />
      </event>
   </events>
</serverDefs>
