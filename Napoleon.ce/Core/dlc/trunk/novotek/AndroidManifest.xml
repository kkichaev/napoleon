<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.grsoft.dlc.trial"
    android:versionCode="3"
    android:versionName="1.2" xmlns:tools="http://schemas.android.com/tools" 
    tools:ignore="UsesMinSdkAttributes">

    <uses-sdk android:minSdkVersion="8" />
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE"/>

    <application
        android:label="@string/app_name" 
        android:name="com.grsoft.dlc.trial.DLCAppTrial" 
        android:icon="@drawable/icon">
        
        <activity
            android:name="com.grsoft.dlc.trial.DLCEx"
            android:launchMode="singleInstance"
            android:stateNotNeeded="true"
            android:theme="@android:style/Theme.NoTitleBar">
            
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME"/>
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        
        <activity android:name="com.grsoft.dlc.AppList" android:label="Все приложения">
             <intent-filter>
                <action android:name="com.grsoft.dls.APP_LIST"/>
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        
        <activity android:name="com.grsoft.dlc.Preferences" android:label="Настройки">
             <intent-filter>
                <action android:name="com.grsoft.dls.PREFERENCES"/>
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        
        <activity android:name="com.grsoft.dlc.Wallpaper"
                android:label="Wallpaper"
                android:icon="@drawable/bg_android_icon">
            <intent-filter>
                <action android:name="android.intent.action.SET_WALLPAPER" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        
        <receiver android:name="com.grsoft.dlc.ApplicationsIntentReceiver">
            <intent-filter>
                <action android:name="android.intent.action.PACKAGE_ADDED" />
    			<action android:name="android.intent.action.PACKAGE_REMOVED" />
				<data android:scheme="package" />
			</intent-filter>
        </receiver>
    </application>

</manifest>