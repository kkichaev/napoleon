<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical" >

    <LinearLayout 
		android:id="@+id/llHeader" 
		android:layout_height="wrap_content" 
		android:orientation="horizontal" 
		android:layout_width="fill_parent" 
		android:background="#80ffcc" 
		android:paddingBottom="10dp" 
		android:paddingTop="5dp">
		
		<TextView android:textColor="#000000"
			android:text="@string/organization" 
			android:id="@+id/tvOrgInfo" 
			android:layout_width="wrap_content" 
			android:layout_height="wrap_content" 
			android:textSize="18sp" 
			android:layout_marginLeft="3dp" 
			android:layout_marginRight="3dp" />
	</LinearLayout>

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dip"
            android:layout_weight="1"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnPhoto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/button_selector"
                android:src="@drawable/ic_add_a_photo_black_48dp"
                android:textColor="@color/btnok" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="@dimen/previewPhotoHightControl" >

                <LinearLayout
                    android:id="@+id/preview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal" >
                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="75dp"
        android:background="@color/footer" />

</LinearLayout>