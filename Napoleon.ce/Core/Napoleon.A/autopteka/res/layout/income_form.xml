<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
  	android:layout_width="fill_parent" 
  	android:layout_height="fill_parent" 
  	android:orientation="vertical">

	<LinearLayout android:id="@+id/llHead" 
		android:layout_height="wrap_content" 
		android:layout_width="fill_parent" 
		android:layout_weight="0" 
		android:background="#80ffcc" 
		android:paddingBottom="10dp" 
		android:paddingTop="5dp">
		
    	<ImageView android:layout_width="wrap_content" 
    		android:layout_height="wrap_content" 
    		android:id="@+id/ivGoUp" 
    		android:src="@drawable/goup"></ImageView>
    	
		<TextView android:text="Приходы" 
			android:id="@+id/tvGoUp" 
			android:textColor="@color/dark_blue" 
			android:textStyle="bold" 
			android:textSize="18sp" 
			android:layout_height="fill_parent" 
			android:gravity="center_vertical" 
			android:lines="1" 
			android:ellipsize="end" 
			android:scrollHorizontally="true" android:layout_width="wrap_content" android:layout_weight="1"></TextView>
	</LinearLayout>

	<ListView android:layout_height="wrap_content" 
		android:id="@+id/lvItems" 
		android:layout_weight="1" 
		android:layout_width="fill_parent" 
		android:background="#c0ccff"/>
		
	<LinearLayout android:layout_width="fill_parent" 
		android:id="@+id/linearLayout1" 
		android:layout_height="wrap_content" 
		android:background="@color/footer" 
		android:padding="7dp" 
		android:orientation="horizontal">
		
		<ImageButton android:layout_width="wrap_content" 
			android:layout_height="wrap_content" 
			android:id="@+id/btnUp" 
			android:src="@drawable/up" android:layout_marginRight="7dp"/>
			
		<ImageButton android:layout_width="wrap_content" 
			android:layout_height="wrap_content" 
			android:src="@drawable/down" 
			android:id="@+id/btnDown" android:layout_marginRight="7dp"/>
			
		<ImageButton android:layout_width="wrap_content" 
			android:layout_height="wrap_content" 
			android:id="@+id/btnLines" 
			android:src="@drawable/line_2" android:layout_marginRight="7dp"/>
			
		<ImageButton android:layout_width="wrap_content" 
			android:layout_height="wrap_content" 
			android:src="@drawable/view_tree" 
			android:id="@+id/btnViewMode" android:layout_marginRight="7dp"/>
			
	</LinearLayout>
</LinearLayout>
