<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
 	xmlns:android="http://schemas.android.com/apk/res/android"
 	android:layout_height="fill_parent" 
 	android:layout_width="fill_parent" 
 	android:background="#FFFFFF" 
 	android:orientation="vertical">
 	
	<TextView android:layout_height="wrap_content" 
		android:layout_weight="0" 
		android:layout_width="fill_parent" 
		android:text="Имя организации" 
		android:textStyle="bold" 
		android:textColor="#0000FF" 
		android:textSize="20sp" android:id="@+id/tvOrgName" 
		android:ellipsize="end" 
		android:lines="1" 
		android:scrollHorizontally="true"></TextView>
		
	<TableLayout android:id="@+id/tableLayout1" android:layout_height="wrap_content" android:layout_width="fill_parent" android:layout_weight="0">
		<TableRow android:id="@+id/tableRow1" 
			android:paddingBottom="5dp" android:paddingTop="5dp" 
			android:layout_width="fill_parent" android:layout_height="wrap_content">
			<TextView 
				android:layout_marginLeft="5dp"
				android:layout_width="wrap_content" 
				android:textColor="#000000" 
				android:layout_height="wrap_content" android:id="@+id/TextView01" android:text="Дата"></TextView>
			<TextView 
				android:layout_marginLeft="5dp" 
				android:layout_width="wrap_content" 
				android:textColor="#000000" android:layout_height="wrap_content" 
				android:id="@+id/tvDate" 
				android:text="25.11.2010" 
				android:textStyle="bold" android:layout_marginRight="5dp"></TextView>
		</TableRow>
		<TableRow android:id="@+id/tableRow2" android:layout_width="fill_parent" android:layout_height="wrap_content">
			<TextView 
				android:layout_marginLeft="5dp" 
				android:layout_width="fill_parent" 
				android:layout_gravity="center_vertical"
				android:textColor="#000000" android:layout_height="wrap_content" android:id="@+id/TextView03" 
				android:text="Договор"></TextView>
			<Spinner 
				android:layout_weight="1" 
				android:layout_height="wrap_content" 
				android:id="@+id/spDogovor" android:layout_width="fill_parent"></Spinner>
		</TableRow>
		<TableRow android:id="@+id/tableRow3" android:layout_width="fill_parent" android:layout_height="wrap_content" android:visibility="gone">
			<TextView 
				android:layout_marginLeft="5dp" 
				android:layout_gravity="center_vertical"
				android:layout_width="fill_parent" android:textColor="#000000" 
				android:layout_height="wrap_content" android:id="@+id/TextView04" android:text="Цена"></TextView>
			<Spinner android:layout_weight="1" 
				android:layout_height="wrap_content" 
				android:id="@+id/spPrices" android:layout_width="fill_parent"></Spinner>
		</TableRow>
	</TableLayout>
	
	<LinearLayout android:id="@+id/LinearLayout07" 
		android:layout_height="wrap_content" 
		android:layout_width="fill_parent" 
		android:layout_weight="1">
		
		<EditText android:layout_weight="1" 
			android:layout_height="fill_parent" 
			android:layout_width="fill_parent" 
			android:id="@+id/edRemark" 
			android:gravity="top|left" android:minLines="2" android:lines="2"></EditText>
	</LinearLayout>
	
	<LinearLayout android:id="@+id/LinearLayout08" 
		android:layout_height="wrap_content" 
		android:layout_width="fill_parent" 
		android:layout_weight="0" android:padding="5dp" android:background="@color/button_panel">
		
		<Button android:layout_width="wrap_content" 
			android:layout_height="wrap_content" 
			android:layout_weight="1" 
			android:text="Отмена" android:id="@+id/btnCancel"></Button>
		
		<Button android:layout_width="wrap_content" 
			android:layout_height="wrap_content" 
			android:text="ОК" android:id="@+id/btnOK" 
			android:layout_weight="3" 
			android:textStyle="bold"></Button>
	</LinearLayout>
</LinearLayout>
