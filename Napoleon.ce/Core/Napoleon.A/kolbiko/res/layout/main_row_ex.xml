<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
  	xmlns:android="http://schemas.android.com/apk/res/android"
  	android:layout_width="wrap_content"
  	android:layout_height="wrap_content"
  	android:layout_weight="1" 
  	android:background="@drawable/list_selector" android:id="@+id/llOrgRow">
    <ImageView android:layout_width="wrap_content" android:layout_height="wrap_content" android:src="@drawable/icon" android:id="@+id/ivFolder" android:layout_marginLeft="5dp"></ImageView>
  
	<TextView
	    android:id="@+id/tvTime"
	    android:layout_width="wrap_content"
	    android:layout_height="wrap_content"
	    android:padding="5dp"
	    android:textSize="14sp"
	    android:text="10:12"
	    android:textColor="#000000" 
	    android:lines="3" 
	    android:ellipsize="end" 
	    android:scrollHorizontally="true" 
	    android:layout_marginLeft="3dp" />

	<TextView
	    android:id="@+id/tvOrgName"
	    android:layout_width="wrap_content"
	    android:layout_height="wrap_content"
	    android:padding="5dp"
	    android:textSize="14sp"
	    android:layout_weight="1"
	    android:text="OrgName"
	    android:textColor="#000000" 
	    android:lines="3" 
	    android:ellipsize="end" 
	    android:scrollHorizontally="true" 
	    android:layout_marginLeft="3dp" />
	
	<TextView
    	android:id="@+id/tvOrgSum"
    	android:layout_width="wrap_content"
    	android:layout_height="wrap_content"
    	android:padding="5dp"
    	android:gravity="right"
    	android:layout_weight="0"
    	android:text="OrgSum" 
    	android:textColor="#000000" 
    	android:layout_marginRight="3dp" />
		
</LinearLayout>
