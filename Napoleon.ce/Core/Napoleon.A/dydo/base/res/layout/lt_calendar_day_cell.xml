<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:background="@color/calendar_cell_background"
    android:clickable="true"
    android:minHeight="40dip"
    android:orientation="vertical" >

    <TextView
        android:id="@+id/textViewCalendarDay"
        style="@style/calendarDayTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="15"
        tools:ignore="HardcodedText" >
    </TextView>

    <TextView
        android:id="@+id/textViewChildCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="right|bottom"
        android:background="@drawable/widget_oval"
        android:gravity="center"
        android:minWidth="18dip"
        android:padding="3dip"
        android:text="55"
        android:textColor="@color/widget_oval_stroke"
        android:textSize="9sp"
        android:visibility="invisible"
        tools:ignore="HardcodedText" >

    </TextView>

</FrameLayout>