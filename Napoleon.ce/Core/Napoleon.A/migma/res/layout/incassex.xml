<?xml version="1.0" encoding="utf-8"?>
<android.gesture.GestureOverlayView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/gestures"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:gestureStrokeType="single"
    android:eventsInterceptionEnabled="true"
    android:orientation="vertical"
    android:gestureColor="#00000000"
    android:uncertainGestureColor="#00000000">
    
<LinearLayout
  	android:layout_height="fill_parent" 
  	android:layout_width="fill_parent" 
  	android:orientation="vertical" 
  	android:background="@color/white">
  	
    <TextView
        android:id="@+id/tvOrgName"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:layout_weight="0"
        android:background="@color/white"
        android:lines="2"
        android:paddingLeft="5dp"
        android:paddingRight="5dp"
        android:paddingTop="10dp"
        android:text="OrgName"
        android:textColor="#000000"
        android:visibility="gone" />
    
    <LinearLayout
    	android:layout_width="fill_parent" 
    	android:id="@+id/linearLayout2" 
    	android:layout_height="wrap_content" 
    	android:orientation="horizontal" 
    	android:layout_weight="0">
    	
        <TextView android:id="@+id/textView2" 
        	android:layout_width="wrap_content" 
        	android:layout_height="fill_parent" 
        	android:textColor="@color/black" 
        	android:gravity="center_vertical"
        	android:paddingLeft="5dp"
        	android:text="Дата" 
        	android:paddingRight="7dp" />
        	
        <TextView android:id="@+id/tvDate" 
        	android:layout_width="wrap_content" 
        	android:layout_height="fill_parent" 
        	android:textColor="@color/black" 
        	android:textStyle="bold"
        	android:gravity="center_vertical"
        	android:text="01/01/2012" 
        	android:paddingRight="7dp" />
        	
        <TextView  
        	android:layout_width="wrap_content" 
        	android:layout_height="fill_parent" 
        	android:textColor="@color/black" 
        	android:gravity="center_vertical"
        	android:text="Сумма" 
        	android:paddingRight="7dp" />
        	
        <EditText android:layout_height="fill_parent" 
        	android:layout_width="wrap_content" 
        	android:gravity="center_vertical"
			android:layout_weight="1" 
        	android:text="0" 
        	android:id="@+id/edCount" />
    </LinearLayout>

   <ImageView
	    android:src="@android:drawable/divider_horizontal_textfield"
	    android:layout_width="fill_parent"
	    android:layout_height="wrap_content"
	    android:scaleType="fitXY"
	    android:paddingBottom="2dp"
	    android:paddingTop="2dp" />
    
    <ListView 
    	android:layout_marginTop="2dp"
    	android:layout_height="fill_parent" 
    	android:id="@+id/lvItems" 
    	android:layout_weight="1" 
		android:layout_width="fill_parent"/>
    
    <ImageView
	    android:src="@android:drawable/divider_horizontal_textfield"
	    android:layout_width="fill_parent"
	    android:layout_height="wrap_content"
	    android:scaleType="fitXY"
	    android:paddingBottom="2dp"
	    android:paddingTop="2dp" />
    
    <TextView android:layout_height="wrap_content" 
        	android:layout_width="wrap_content"
        	android:text="Комментарий"
        	android:textColor="@color/black"/>
    
    <EditText android:layout_height="fill_parent" 
        	android:layout_width="fill_parent"
        	android:gravity="top|left" 
			android:layout_weight="1" 
        	android:text="remark" 
        	android:id="@+id/edRemark" />
    
    <LinearLayout android:layout_height="wrap_content" 
    	android:layout_width="fill_parent" 
    	android:background="@color/footer" 
    	android:padding="7dp">
        	
        <ImageButton android:layout_width="wrap_content" 
        	android:layout_height="wrap_content" 
        	android:src="@drawable/send" 
        	android:id="@+id/btnSend" android:layout_marginRight="7dp"/>

        <TextView
            android:id="@+id/textView1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1" />
        
        <ImageButton
            android:id="@+id/btnOK"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="5dp"
            android:src="@drawable/ok" 
            android:visibility="gone"/>

    </LinearLayout>
</LinearLayout>    
</android.gesture.GestureOverlayView>
