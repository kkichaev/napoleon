<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:orientation="vertical">
    
	<LinearLayout 
		android:id="@+id/llHeader" 
		android:layout_height="wrap_content" 
		android:orientation="horizontal" 
		android:layout_width="fill_parent" 
		android:background="#80ffcc" 
		android:paddingBottom="10dp" 
		android:paddingTop="5dp">
		
		<TextView android:textColor="#000000"
			android:text="@string/organization" 
			android:id="@+id/tvOrgInfo" 
			android:layout_width="wrap_content" 
			android:layout_height="wrap_content" 
			android:textSize="18sp" 
			android:layout_marginLeft="3dp" 
			android:layout_marginRight="3dp" />
	</LinearLayout>

	<LinearLayout  
		android:background="@color/table_caption" 
		android:layout_width="fill_parent" 
		android:layout_height="wrap_content">
	    	    		
		<TextView
		    android:id="@+id/NameTitle"
		    android:layout_width="wrap_content"
		    android:layout_height="wrap_content"
		    android:background="@color/table_caption"
		    android:text="@string/date_number"
		    android:textColor="#000000"
		    android:textSize="16sp"
		    android:width="100dp" />
			
		<TextView android:id="@+id/DateTitle" 
		    android:visibility="gone"
			android:layout_width="wrap_content" 
			android:layout_height="wrap_content" 
			android:textColor="#000000" 
			android:text="@string/date" 
			android:paddingLeft="3dp" 
			android:background="@color/table_caption" 
			android:textSize="16sp"/>
		
		<TextView android:id="@+id/SumColumnTitle" 
		    android:visibility="gone"
			android:layout_width="wrap_content" 
			android:layout_height="wrap_content" 
			android:textColor="#000000" 
			android:text="@string/sum" 
			android:gravity="right" 
			android:background="@color/table_caption" 
			android:paddingRight="3dp" 
	           android:textSize="16sp"/>
					
		<TextView android:id="@+id/DebtColumnTitle" 
			android:layout_width="0dip" 
			android:layout_height="wrap_content"
			android:layout_weight="1" 
			android:textColor="#000000" 
			android:text="Долг/Сумма"
			android:layout_gravity="center_horizontal" 
			android:gravity="center_horizontal" 
			android:background="@color/table_caption" 
			android:paddingRight="3dp" 
	           android:textSize="16sp"/>
		
		<TextView android:id="@+id/Overhead" 
			android:layout_width="wrap_content" 
			android:layout_height="wrap_content" 
			android:textColor="#000000" 
			android:text="Просрочка/\nОтсрочка" 
			android:gravity="right" 
			android:background="@color/table_caption" 
			android:paddingRight="3dp" 
	           android:textSize="16sp"/>
	</LinearLayout>
			
	<LinearLayout  
	    android:orientation="vertical"
		android:background="@color/white"
		android:layout_weight="1"
		android:layout_width="fill_parent" 
		android:layout_height="0dip">
		
		<ListView android:id="@+id/lvDocs" 
			android:layout_weight="1"
			android:layout_height="wrap_content" 
			android:layout_width="fill_parent" 
			android:background="@color/white" />
		
		<TextView android:id="@+id/orderInfo" 
			android:layout_width="wrap_content" 
			android:layout_height="wrap_content" 
			android:textColor="#000000" 
			android:text="Сумма накладных"
            android:textSize="16sp"/>
		
	</LinearLayout>
		
	<LinearLayout android:id="@+id/llTaskBar" 
		android:layout_height="wrap_content" 
		android:layout_width="fill_parent" 
		android:background="@color/footer" 
		android:padding="7dp">
		
		<ImageButton android:layout_width="wrap_content"
		    android:contentDescription="@string/selectDocType" 
			android:layout_height="wrap_content" 
			android:src="@drawable/icon" 
			android:id="@+id/btnDocFilter" android:layout_marginRight="7dp"/>
			
		<ImageButton android:layout_width="wrap_content" 
			android:layout_height="wrap_content" 
			android:src="@drawable/new_order"
			android:contentDescription="@string/newDoc" 
			android:id="@+id/btnNewDoc" android:layout_marginRight="7dp"/>
			
		<ImageButton android:layout_width="wrap_content" 
			android:layout_height="wrap_content" 
			android:id="@+id/btnGpsStatus" 
			android:contentDescription="@string/gpsStatus" 
			android:src="@drawable/gpsno" android:layout_marginRight="7dp"/>
			
		<ImageButton android:layout_width="wrap_content" 
			android:layout_height="wrap_content" 
			android:src="@drawable/send"
			android:visibility="gone"
			android:contentDescription="@string/send" 
			android:id="@+id/btnSendDocList" android:layout_marginRight="7dp"/>
			
		<TextView android:layout_height="wrap_content" 
			android:text="@string/sum" 
			android:textColor="@color/black" 
			android:layout_width="fill_parent" 
			android:layout_gravity="center_vertical" 
			android:gravity="right" 
            android:id="@+id/tvTotalSum"
            android:textSize="16sp"/>
	</LinearLayout>
</LinearLayout>