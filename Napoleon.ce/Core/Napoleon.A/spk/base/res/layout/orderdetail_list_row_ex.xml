<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:background="@drawable/list_selector" >

    <LinearLayout
        android:id="@+id/LinearLayout1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal" >

        <TextView
            android:id="@+id/tvOrder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="1dp"
            android:layout_marginRight="4dp"
            android:layout_toLeftOf="@id/tvName"
            android:text="№"
            android:textColor="@color/black"
            android:textSize="18sp"
            tools:ignore="HardcodedText,ObsoleteLayoutParam" />

        <TextView
            android:id="@+id/tvName"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_toLeftOf="@id/tvQty"
            android:layout_weight="1"
            android:ellipsize="end"
            android:lines="1"
            android:scrollHorizontally="true"
            android:text="Name"
            android:textColor="@color/black"
            android:textSize="18sp"
            tools:ignore="HardcodedText,ObsoleteLayoutParam" />

        <TextView
            android:id="@+id/tvQty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignTop="@id/tvSum"
            android:layout_toLeftOf="@id/tvSum"
            android:layout_weight="0"
            android:gravity="right"
            android:maxWidth="80dp"
            android:minWidth="80dp"
            android:text="Qty"
            android:textColor="@color/black"
            android:textSize="18sp"
            android:width="50dp"
            tools:ignore="HardcodedText,ObsoleteLayoutParam,ObsoleteLayoutParam" />

        <TextView
            android:id="@+id/tvSum"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_weight="0"
            android:gravity="right"
            android:maxWidth="80dp"
            android:minWidth="80dp"
            android:text="tvSum"
            android:textColor="@color/black"
            android:textSize="18sp"
            android:width="70dp"
            tools:ignore="HardcodedText,ObsoleteLayoutParam" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvQuality"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/LinearLayout1"
        android:layout_marginLeft="15dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:lines="1"
        android:scrollHorizontally="true"
        android:text="tvQuality"
        android:textColor="@color/black"
        android:textSize="18sp"
        tools:ignore="HardcodedText,ObsoleteLayoutParam" />

</RelativeLayout>