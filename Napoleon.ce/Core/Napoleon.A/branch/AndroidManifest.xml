<?xml version="1.0" encoding="utf-8" standalone="no"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" android:versionCode="1" android:versionName="@string/version" package="com.grsoft.napoleon">
    
<uses-permission android:name="android.permission.INTERNET"/>
  <uses-permission android:name="android.permission.CAMERA"/>
  <uses-feature android:name="android.hardware.camera"/>
  <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
  <uses-permission android:name="android.permission.VIBRATE"/>
  <uses-permission android:name="android.permission.CALL_PHONE"/>
  <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"/>
  <application android:debuggable="true" android:icon="@drawable/pictograms" android:label="@string/app_name" android:name="com.grsoft.napoleon.NapoleonApp">

		<activity android:label="@string/app_name" android:name="com.grsoft.napoleon.Napoleon">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
		
		<uses-library android:name="android.test.runner"/>
		
		<activity android:name="com.grsoft.napoleon.Configuration"/>
		<activity android:configChanges="keyboardHidden|orientation" android:name="com.grsoft.napoleon.UpdateDB"/>
		<activity android:name="com.grsoft.napoleon.VisitEdit"/>
		<activity android:name="com.grsoft.napoleon.Documents"/>
		<activity android:name="com.grsoft.napoleon.CreateOrder"/>
		<activity android:name="Warehouse"/>
		<activity android:name="com.grsoft.napoleon.PriceCount"/>
		<activity android:name=".OrderDetail"/>
		<activity android:name="DeliveryDetail"/>
		<activity android:name="VisitEdit"/>
		<activity android:name="CameraPreview"/>
		<activity android:name="DocList"/>
		<activity android:name="Messages"/>
		<activity android:name="RemnantsDetail"/>
		<activity android:name="Setting" android:configChanges="keyboardHidden|orientation"/>
		<activity android:name="PhotoSetting"/>
		<activity android:name="BehaviorSetting"/>
		<activity android:name="GpsSetting"/>
		<service android:name="com.grsoft.util.NapoleonService"/>
		<activity android:name=".PricePresentation" android:noHistory="true"/>
		<activity android:name="UpdateDBEx"/>
		<activity android:name="OrderDetailEx"/>
		<activity android:name="WarehouseSetting"></activity>
		
   <receiver android:enabled="true" android:name="com.grsoft.util.BootUpReceiver" android:permission="android.permission.RECEIVE_BOOT_COMPLETED">

        	<intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <category android:name="android.intent.category.DEFAULT"/>
        	</intent-filter>
		</receiver>
    <activity android:name="WarehouseSetting"/>
	
	<receiver android:name="com.grsoft.util.SystemActionReciever" 
 		android:permission="android.permission.RECEIVE_BOOT_COMPLETED">
 		
			<intent-filter>
				<action android:name="android.location.PROVIDERS_CHANGED"/>
				<action android:name="android.intent.action.TIME_SET"/>
				<action android:name="android.intent.action.BOOT_COMPLETED"/>
				<action android:name="android.intent.action.ACTION_SHUTDOWN"/>
				<category android:name="android.intent.category.DEFAULT" />
			</intent-filter>
		</receiver>
	<activity android:name=".CrashReport"></activity>
	<service android:name="com.grsoft.util.NapoleonServiceEx"></service>
		<activity android:name="CalendarActivity"/>
		<service android:name="com.grsoft.util.ReportService"/>				
  </application>
<uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
</manifest>
