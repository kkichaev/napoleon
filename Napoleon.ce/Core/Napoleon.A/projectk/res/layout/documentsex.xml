<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
  	android:layout_width="fill_parent" 
  	android:layout_height="fill_parent" 
  	android:orientation="vertical">
	
	<LinearLayout 
		android:id="@+id/LinearLayout01" 
		android:layout_height="wrap_content" 
		android:orientation="horizontal" 
		android:layout_width="fill_parent" 
		android:background="#80ffcc" 
		android:layout_weight="0" 
		android:paddingBottom="10dp" 
		android:paddingTop="5dp">
		
		<TextView android:textColor="#000000"
			android:text="Организация" 
			android:id="@+id/tvOrgInfo" 
			android:layout_width="wrap_content" 
			android:layout_height="wrap_content" 
			android:textSize="18sp" 
			android:layout_marginLeft="3dp" 
			android:layout_marginRight="3dp" />
	</LinearLayout>

	<LinearLayout
	    android:id="@+id/llDebtInfo"
	    android:layout_width="fill_parent"
	    android:layout_height="wrap_content"
	    android:layout_weight="0"
	    android:orientation="vertical" android:background="@color/footer" android:visibility="gone">

		<LinearLayout
		    android:layout_width="fill_parent"
		    android:layout_height="wrap_content"
		    android:layout_weight="0"
		    android:orientation="horizontal" >

		    <TextView
		        android:id="@+id/textView1"
		        android:layout_width="wrap_content"
		        android:layout_height="wrap_content"
		        android:text="Информация на"
		        android:textColor="@color/black" android:paddingRight="5dp"/>

		    <TextView
		        android:id="@+id/tvSyncData"
		        android:layout_width="wrap_content"
		        android:layout_height="wrap_content"
		        android:text="tvSyncData" android:textColor="@color/black"/>

		</LinearLayout>

		<LinearLayout
		    android:id="@+id/linearLayout2"
		    android:layout_width="fill_parent"
		    android:layout_height="wrap_content"
		    android:layout_weight="0" >

			<TextView
			    android:id="@+id/textView3"
			    android:layout_width="wrap_content"
			    android:layout_height="wrap_content"
			    android:text="Долг/Пр.долг:" android:paddingRight="5dp" android:textColor="@color/black"/>

			<TextView
			    android:id="@+id/tvDebtInfo"
			    android:layout_width="wrap_content"
			    android:layout_height="wrap_content"
			    android:text="tvDolgInfo" android:textColor="@color/black"/>

		</LinearLayout>

	</LinearLayout>

	<LinearLayout android:id="@+id/LinearLayout04" 
		android:layout_width="fill_parent" 
		android:layout_height="wrap_content"
		android:layout_weight="0" 
		android:background="@color/black">
		
		<TextView android:id="@+id/NameTitle" 
			android:layout_width="wrap_content" 
			android:layout_height="wrap_content" 
			android:textColor="#000000" 
			android:layout_weight="1" 
			android:background="@color/table_caption" 
			android:width="80dp" />
			
		<TextView android:id="@+id/DateTitle" 
			android:layout_width="wrap_content" 
			android:layout_height="wrap_content" 
			android:textColor="#000000" 
			android:layout_weight="1" 
			android:text="Дата" 
			android:paddingLeft="7dp" 
			android:background="@color/table_caption" 
			android:layout_marginLeft="1dp" />
			
		<TextView android:id="@+id/SumColumnTitle" 
			android:layout_width="wrap_content" 
			android:layout_height="wrap_content" 
			android:textColor="#000000" 
			android:layout_weight="1" 
			android:text="Сумма" 
			android:gravity="right" 
			android:background="@color/table_caption" 
			android:layout_marginLeft="1dp" 
			android:paddingRight="3dp" />
	</LinearLayout>
			
	<LinearLayout 
		android:id="@+id/LinearLayout02" 
		android:layout_width="fill_parent" 
		android:layout_weight="1" 
		android:layout_height="fill_parent">
		
		<ListView android:id="@+id/lvDocs" 
			android:layout_height="fill_parent" 
			android:layout_width="fill_parent" 
			android:background="@color/white" />
	</LinearLayout>
	
	<LinearLayout android:id="@+id/llTaskBar" 
		android:layout_height="wrap_content" 
		android:layout_width="fill_parent" 
		android:background="@color/footer" 
		android:padding="7dp">
		
		<ImageButton android:layout_width="wrap_content" 
			android:layout_height="wrap_content" 
			android:src="@drawable/icon" 
			android:id="@+id/btnDocFilter" android:layout_marginRight="7dp"/>
			
		<ImageButton android:layout_width="wrap_content" 
			android:layout_height="wrap_content" 
			android:src="@drawable/new_order" 
			android:id="@+id/btnNewDoc" android:layout_marginRight="7dp"/>
			
		<ImageButton android:layout_width="wrap_content" 
			android:layout_height="wrap_content" 
			android:id="@+id/btnGpsStatus" 
			android:src="@drawable/gpsno" android:layout_marginRight="7dp"/>
			
		<TextView android:layout_height="wrap_content" 
			android:text="Сумма" 
			android:textColor="@color/black" 
			android:layout_width="fill_parent" 
			android:layout_gravity="center_vertical" 
			android:gravity="right" android:id="@+id/tvTotalSum"/>
	</LinearLayout>
</LinearLayout>
