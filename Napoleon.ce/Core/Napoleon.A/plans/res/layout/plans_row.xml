<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:orientation="vertical" android:background="@color/black">

    <TextView
        android:id="@+id/tvName"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:text="tvName" android:textColor="@color/black" android:background="@color/white" android:textSize="15sp"/>

    <TextView
        android:id="@+id/tvRange"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:text="tvRange" android:background="@color/white" android:textColor="@color/black" android:gravity="bottom|center_horizontal" android:textSize="11sp" android:layout_marginBottom="1dp"/>

    <LinearLayout
        android:id="@+id/linearLayout1"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content" >

        <TextView
            android:id="@+id/tvPlan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="tvPlan" android:textColor="@color/black" android:layout_weight="1" android:gravity="right" android:background="@color/white" android:paddingRight="3dp"/>

        <TextView
            android:id="@+id/tvFact"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="tvFact" android:textColor="@color/black" android:gravity="right" android:background="@color/white" android:layout_marginLeft="1dp" android:layout_marginRight="1dp" android:paddingRight="3dp" android:width="100dp"/>

        <TextView
            android:id="@+id/tvPercent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="tvPercent" android:textColor="@color/black" android:layout_weight="0" android:gravity="right" android:background="@color/white" android:paddingRight="3dp" android:width="80dp"/>

    </LinearLayout>

</LinearLayout>