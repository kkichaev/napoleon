<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:orientation="vertical">
    
<LinearLayout
  	android:layout_height="fill_parent" 
  	android:layout_width="fill_parent" 
  	android:orientation="vertical" 
  	android:background="@color/white">
  	
   	<RadioGroup
		android:orientation="horizontal" 
		android:id="@+id/radioGroup1" 
		android:layout_width="wrap_content" 
		android:layout_height="wrap_content">
		<RadioButton 
			android:text="@string/manual" 
			android:id="@+id/rbCustom" 
	       	android:textColor="#000000" 
			android:layout_width="wrap_content" 
			android:layout_height="wrap_content"
		/>
		<RadioButton 
			android:text="@string/automatic" 
			android:id="@+id/rbAuto" 
	       	android:textColor="#000000" 
			android:layout_width="wrap_content" 
			android:layout_height="wrap_content"
		/>
	</RadioGroup>

       <TextView
       	android:visibility="gone" 
       	android:paddingRight="5dp" 
       	android:paddingLeft="5dp" 
       	android:id="@+id/tvOrgName" 
       	android:layout_height="wrap_content" 
       	android:lines="2" 
       	android:layout_width="fill_parent" 
       	android:textColor="#000000" 
       	android:text="OrgName" 
       	android:layout_weight="0" 
       	android:background="@color/white" 
       	android:paddingTop="10dp" 
       	android:layout_marginBottom="2dp" />
    
    <LinearLayout
    	android:layout_width="fill_parent" 
    	android:id="@+id/linearLayout2" 
    	android:layout_height="wrap_content" 
    	android:orientation="horizontal" 
    	android:layout_weight="0" 
	>
    	
        <TextView android:id="@+id/textView2" 
        	android:layout_width="wrap_content" 
        	android:layout_height="fill_parent" 
        	android:textColor="@color/black" 
        	android:gravity="center_vertical"
        	android:paddingLeft="5dp"
        	android:text="@string/date" 
        	android:paddingRight="7dp" />
        	
        <TextView android:id="@+id/tvDate" 
        	android:layout_width="wrap_content" 
        	android:layout_height="fill_parent" 
        	android:textColor="@color/black" 
        	android:textStyle="bold"
        	android:gravity="center_vertical"
        	android:text="01/01/2012" 
        	android:paddingRight="7dp" />
        	
        <TextView android:id="@+id/textView3" 
        	android:layout_width="wrap_content" 
        	android:layout_height="fill_parent" 
        	android:textColor="@color/black" 
        	android:gravity="center_vertical"
        	android:text="@string/sum" 
        	android:paddingRight="7dp" />
        	
        <EditText android:layout_height="fill_parent" 
        	android:layout_width="wrap_content" 
        	android:gravity="center_vertical"
			android:layout_weight="1" 
        	android:text="0" 
        	android:id="@+id/edCount" />
    </LinearLayout>

    <EditText
        android:id="@+id/edRemark"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:gravity="top|left"
        android:text="remark"
        android:visibility="visible" />
   
   <ImageView
	    android:src="@android:drawable/divider_horizontal_textfield"
	    android:layout_width="fill_parent"
	    android:layout_height="wrap_content"
	    android:scaleType="fitXY"
	    android:paddingBottom="2dp"
	    android:paddingTop="2dp" />
    
    <ListView 
    	android:layout_marginTop="2dp"
    	android:layout_height="fill_parent" 
    	android:id="@+id/lvItems" 
    	android:layout_weight="1" 
		android:layout_width="fill_parent" 
	/>
    
    <LinearLayout
        android:id="@+id/brakAnswerLayout" 
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        
        <TextView android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/black"
            android:textSize="18sp"
            android:text="Вам необходимо забрать брак в данной торговой точке, вы забрали брак ?"/>
        
        <RadioGroup 
            android:id="@+id/rgBrakAnswer"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            
            <RadioButton android:id="@+id/rbYes" android:text="Да"/>
            <RadioButton android:id="@+id/rbNo" android:text="Нет"/>
            
        </RadioGroup>
    </LinearLayout>
	
	<LinearLayout android:layout_width="fill_parent" 
		android:layout_height="wrap_content" 
		android:background="@color/blue" 
		android:id="@+id/llKeyboard">
		
		<TableLayout android:layout_width="fill_parent" 
			android:id="@+id/tableLayout1" 
			android:background="@color/white" 
			android:layout_marginTop="2dp" 
			android:layout_height="fill_parent" 
			android:stretchColumns="*" 
            android:shrinkColumns="*">
			
			<TableRow android:layout_height="wrap_content" 
				android:id="@+id/tableRow1" 
				android:layout_width="wrap_content">
				
				<ImageButton android:layout_height="wrap_content" 
					android:layout_width="wrap_content" 
					android:id="@+id/btn1" 
					android:src="@drawable/k1" 
					android:tag="1"/>
					
				<ImageButton android:layout_height="wrap_content" 
					android:layout_width="wrap_content" 
					android:id="@+id/btn2" 
					android:tag="2" 
					android:src="@drawable/k2"/>
					
				<ImageButton android:layout_height="wrap_content" 
					android:layout_width="wrap_content" 
					android:src="@drawable/k3" 
					android:tag="3" 
					android:id="@+id/btn3"/>
				
				<ImageButton android:layout_width="wrap_content" 
                	android:layout_height="wrap_content" 
                	android:id="@+id/btn4" 
                	android:tag="4" 
                	android:src="@drawable/k4"/>
                	
				<ImageButton android:layout_height="wrap_content" 
					android:src="@drawable/k5" 
					android:tag="5" 
					android:id="@+id/btn5" 
					android:layout_width="wrap_content"/>
			</TableRow>
			
			<TableRow android:layout_height="wrap_content" 
				android:id="@+id/tableRow2" 
				android:layout_width="wrap_content">
				
				<ImageButton android:layout_height="wrap_content" 
					android:layout_width="wrap_content" 
					android:tag="6" 
					android:src="@drawable/k6" 
					android:id="@+id/btn6"/>
					
				<ImageButton android:layout_height="wrap_content" 
					android:layout_width="wrap_content" 
					android:id="@+id/btn7" 
					android:src="@drawable/k7" 
					android:tag="7"/>
					
				<ImageButton android:layout_height="wrap_content" 
					android:layout_width="wrap_content" 
					android:tag="8" 
					android:src="@drawable/k8" 
					android:id="@+id/btn8"/>
					
				<ImageButton android:layout_height="wrap_content" 
					android:layout_width="wrap_content" 
					android:id="@+id/btn9" 
					android:src="@drawable/k9" 
					android:tag="9"/>
					
				<ImageButton android:layout_height="wrap_content" 
					android:layout_width="wrap_content" 
					android:src="@drawable/k0" 
					android:tag="0" 
					android:id="@+id/btn0"/>
			</TableRow>
			
			<TableRow android:layout_height="wrap_content" 
				android:id="@+id/tableRow3" 
				android:layout_width="wrap_content">
				
				<ImageButton android:layout_width="wrap_content" 
                	android:layout_height="wrap_content" 
                	android:tag="7" 
                	android:id="@+id/btnDel" 
                	android:src="@drawable/del"/>
                	
				<ImageButton android:layout_height="wrap_content" 
					android:layout_width="wrap_content" 
					android:src="@drawable/zap" 
					android:id="@+id/btnComma" 
					android:tag=","/>
					
				<ImageButton android:layout_height="wrap_content" 
					android:layout_width="wrap_content" 
					android:id="@+id/btnOK" 
					android:src="@drawable/ok" 
					android:layout_span="3"/>
			</TableRow>
		</TableLayout>
	</LinearLayout>
    <LinearLayout android:layout_height="wrap_content" 
    	android:layout_width="fill_parent" 
    	android:id="@+id/linearLayout3" 
    	android:background="@color/footer" 
    	android:padding="7dp">
        	
        <ImageButton android:layout_width="wrap_content" 
        	android:layout_height="wrap_content" 
        	android:src="@drawable/send" 
        	android:id="@+id/btnSend" android:layout_marginRight="7dp"/>
    </LinearLayout>
</LinearLayout>
</LinearLayout>