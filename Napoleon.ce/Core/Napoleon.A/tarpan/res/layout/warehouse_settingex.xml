<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:orientation="vertical"
    android:padding="7dp" >

    <ScrollView
        android:id="@+id/scrollView1"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content" >

        <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:orientation="vertical" >

            <TableLayout
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:stretchColumns="1" >

                <TableRow
                    android:id="@+id/trColumn2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" >

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="3dp"
                        android:layout_marginRight="10dp"
                        android:text="@string/clmn_2"
                        android:textSize="16sp" />

                    <Spinner
                        android:id="@+id/spColumn2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:entries="@array/warehouse_column_values" />
                </TableRow>

                <TableRow
                    android:id="@+id/trColumn3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" >

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="3dp"
                        android:text="@string/clmn_3"
                        android:textSize="16sp" />

                    <Spinner
                        android:id="@+id/spColumn3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:entries="@array/warehouse_column_values" />
                </TableRow>

                <TableRow
                    android:id="@+id/trItemID"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone" >

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="3dp"
                        android:textSize="16sp" />

                    <CheckBox
                        android:id="@+id/cbItemID"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/code_sku" />
                </TableRow>
            </TableLayout>

            <CheckBox
                android:id="@+id/checkPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:text="@string/check_remains"
                android:visibility="gone" />

            <CheckBox
                android:id="@+id/cbComplexSalesHistory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/complete_story" 
                android:visibility="gone"/>

            <CheckBox
                android:id="@+id/cbPackView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/show_packs_in_order"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_type"
                android:textSize="16sp"
                android:visibility="gone" />

            <Spinner
                android:id="@+id/spNavType"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:entries="@array/nav_type_items"
                android:visibility="gone" />

            <CheckBox
                android:id="@+id/cbBuh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/buh" />

            <LinearLayout
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" >

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/time_order_from"
                    android:textColor="@color/white"
                    android:textSize="18sp" />

                <TimePicker
                    android:id="@+id/tpFrom"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" >

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/time_order_to"
                    android:textColor="@color/white"
                    android:textSize="18sp" />

                <TimePicker
                    android:id="@+id/tpTo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <CheckBox
                android:id="@+id/cbVibrate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/vibration" />

            <CheckBox
                android:id="@+id/cbAllowRotateScreen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rotate_screen" />
        </LinearLayout>

    </ScrollView>

</LinearLayout>