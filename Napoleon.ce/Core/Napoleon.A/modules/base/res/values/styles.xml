<?xml version="1.0" encoding="utf-8"?>
<resources>
	<style name="mainListViewStyle">
		<item name="android:background">@android:color/white</item>
	</style>

	<style name="valueTextView" parent="@android:style/Widget.TextView">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/value_color</item>
    </style> 
	<style name="calendarDayTextView" parent="@android:style/Widget.TextView">
        <item name="android:textSize">16sp</item>
    </style> 

	<style name="calendarDayOfWeekTextView" parent="@android:style/Widget.TextView">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style> 
    
    <style name="linkTextView" parent="@android:style/Widget.TextView">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/link_color</item>
        <item name="android:textStyle">bold</item>
    </style> 
    
    <style name="spinnerItem" parent="@android:style/Widget.TextView">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:background">@color/white</item>
    </style> 
    
    <dimen name="report_date_width">80dp</dimen>
</resources>
