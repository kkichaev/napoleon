<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical" >

    <LinearLayout 
        android:layout_height="wrap_content"
        android:layout_width="match_parent"
        android:orientation="horizontal"
        android:background="@color/title_color">
        
        <TextView 
            android:layout_height="wrap_content"
            android:layout_width="@dimen/slc_pos_col"
            android:text="№"/>
        
        <TextView 
            android:layout_height="wrap_content"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="Клиент(ТТ)"/>
        
        <TextView 
            android:layout_height="wrap_content"
            android:layout_width="@dimen/slc_val_col"
            android:text="Отгрузки"/>
        
        <TextView 
            android:layout_height="wrap_content"
            android:layout_width="@dimen/slc_val_col"
            android:text="Вес КМЗ"/>
        
        <TextView 
            android:layout_height="wrap_content"
            android:layout_width="@dimen/slc_val_col"
            android:text="Фасовка КМЗ"/>
        
        <TextView 
            android:layout_height="wrap_content"
            android:layout_width="@dimen/slc_val_col"
            android:text="Покупной"/>
        
        <TextView 
            android:layout_height="wrap_content"
            android:layout_width="@dimen/slc_val_col"
            android:text="Всего"/>
    </LinearLayout>
    
    <ListView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="0dip"
        android:layout_weight="1" />

    <LinearLayout 
        android:layout_height="wrap_content"
        android:layout_width="match_parent"
        android:orientation="horizontal"
        android:background="@color/title_color">
        
        <TextView 
            android:layout_height="wrap_content"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:gravity="right"
            android:paddingRight="30dp"
            android:text="ИТОГО"/>
        
        <TextView 
            android:id="@+id/tvSum1"
            android:layout_height="wrap_content"
            android:layout_width="@dimen/slc_val_col"
            android:text="0"/>
        
        <TextView 
            android:id="@+id/tvSum2"
            android:layout_height="wrap_content"
            android:layout_width="@dimen/slc_val_col"
            android:text="0"/>
        
        <TextView 
            android:id="@+id/tvSum3"
            android:layout_height="wrap_content"
            android:layout_width="@dimen/slc_val_col"
            android:text="0"/>
        
        <TextView 
            android:id="@+id/tvSumRes"
            android:layout_height="wrap_content"
            android:layout_width="@dimen/slc_val_col"
            android:text="0"/>
    </LinearLayout>
    
    <LinearLayout
        android:id="@+id/linearLayout1"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:background="@color/footer"
        android:orientation="horizontal"
        android:padding="7dp" >

        <ImageButton
            android:id="@+id/btnFilter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/filter" >
        </ImageButton>
    </LinearLayout>

</LinearLayout>