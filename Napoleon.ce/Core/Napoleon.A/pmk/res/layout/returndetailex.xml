<?xml version="1.0" encoding="utf-8"?>
    <LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
	    xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:orientation="vertical" >

        <LinearLayout
            android:id="@+id/LinearLayout01"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:background="@color/footer"
            android:paddingBottom="10sp"
            android:paddingTop="5sp" >

            <TextView
                android:id="@+id/tvOrg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:scrollHorizontally="true"
                android:text="OrgName"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:ignore="HardcodedText" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/LinearLayout02"
            android:layout_weight="1"
            android:layout_width="fill_parent"
            android:layout_height="0dip"
            android:orientation="vertical" >

            <LinearLayout
                android:id="@+id/LinearLayout04"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:background="@color/black"
                tools:ignore="NestedWeights" >

                <TextView
                    android:id="@+id/TextView01"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="1sp"
                    android:layout_weight="1"
                    android:background="@color/white"
                    android:paddingLeft="3sp"
                    android:text="@string/caption"
                    android:textColor="@color/black"
                    tools:ignore="NestedWeights" />

                <TextView
                    android:id="@+id/TextView02"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="1sp"
                    android:layout_marginRight="1sp"
                    android:layout_marginTop="1sp"
                    android:layout_weight="0"
                    android:background="@color/white"
                    android:minWidth="80sp"
                    android:paddingLeft="2sp"
                    android:paddingRight="2sp"
                    android:text="@string/qty"
                    android:textColor="@color/black" />

                <TextView
                    android:id="@+id/TextView03"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="1sp"
                    android:layout_marginLeft="0sp"
                    android:layout_marginRight="1sp"
                    android:layout_marginTop="1sp"
                    android:layout_weight="0"
                    android:background="@color/white"
                    android:minWidth="80sp"
                    android:paddingRight="3sp"
                    android:text="@string/sum"
                    android:textColor="@color/black" />
            </LinearLayout>

            <ListView
                android:id="@+id/lvItems"
                android:layout_width="fill_parent"
                android:layout_height="0dip"
                android:layout_weight="1"
                android:background="@color/white" />

            <LinearLayout
                android:id="@+id/llFocus"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:orientation="vertical"
                android:visibility="gone" >

                <Button
                    android:id="@+id/btnFocus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/order_to_target_price"
                    android:textColor="#FF0000" >
                </Button>
            </LinearLayout>
            
			<com.grsoft.napoleon.util.HorizontalListView
			    android:id="@+id/gvItems"
                android:background="#FFFFFF"
                android:paddingBottom="1sp"
			    android:layout_width="fill_parent"
			    android:layout_height="wrap_content"
			    />
            
        </LinearLayout>

		<LinearLayout
	        android:id="@+id/llDocInfo"
	        android:layout_width="fill_parent"
	        android:layout_height="wrap_content"
	        android:background="@color/footer"
	        android:orientation="horizontal"
	         >
	
	        <TextView
	            android:id="@+id/tvDocInfo"
	            android:layout_width="0dip"
	            android:layout_weight="1"
	            android:layout_height="wrap_content"
	            android:textColor="@color/black"
	            android:text="" />
	
	    </LinearLayout>        
        <LinearLayout
            android:id="@+id/linearLayout1"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:background="@color/footer"
            android:orientation="horizontal"
            android:padding="7sp" >

            <ImageButton
                android:id="@+id/btnAddItems"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="7sp"
                android:src="@drawable/new_order"
                tools:ignore="ContentDescription" />

            <ImageButton
                android:id="@+id/btnPhoto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="7sp"
                android:src="@drawable/camera"
                tools:ignore="ContentDescription" />
            
            <ImageButton
                android:id="@+id/btnEditOrder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="7sp"
                android:src="@drawable/orderedit"
                tools:ignore="ContentDescription" />

            <ImageButton
                android:id="@+id/btnLines"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="7sp"
                android:src="@drawable/line_2"
                tools:ignore="ContentDescription" />

            <ImageButton
                android:id="@+id/btnSend"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="7sp"
                android:src="@drawable/send"
                tools:ignore="ContentDescription" />

            <TextView
                android:id="@+id/tvTotalSum"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:gravity="right"
                android:text="@string/sum"
                android:textColor="@color/black" />
        </LinearLayout>
    </LinearLayout>
