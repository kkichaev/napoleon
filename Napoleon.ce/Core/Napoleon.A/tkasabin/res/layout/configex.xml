<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical" >

    <TableLayout
        android:id="@+id/LinearLayout01"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        tools:ignore="UselessParent" >

        <TableRow>

            <TextView
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:gravity="right"
                android:paddingRight="5dp"
                android:text="@string/ip" 
                android:textSize="16sp"/>

            <EditText
                android:id="@+id/edIp"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_weight="0.5"
                android:imeOptions="actionNext"
                tools:ignore="TextFields" />

        </TableRow>

        <TableRow>

            <TextView
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:gravity="right"
                android:paddingRight="5dp"
                android:text="@string/ip2" 
                android:textSize="16sp"/>

            <EditText
                android:id="@+id/edIp2"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_weight="0.5"
                android:imeOptions="actionNext"
                tools:ignore="TextFields" />

        </TableRow>
        
        <TableRow>

            <TextView
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:gravity="right"
                android:paddingRight="5dp"
                android:text="@string/ip3" 
                android:textSize="16sp"/>

            <EditText
                android:id="@+id/edIp3"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_weight="0.5"
                android:imeOptions="actionNext"
                tools:ignore="TextFields" />

        </TableRow>

        <TableRow>

            <TextView
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:gravity="right"
                android:paddingRight="5dp"
                android:text="@string/port" 
                android:textSize="16sp"/>

            <EditText
                android:id="@+id/edPort"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_weight="0.5"
                android:imeOptions="actionNext"
                android:inputType="number" />
        </TableRow>

        <TableRow>

            <TextView
                android:id="@+id/TextView03"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:gravity="right"
                android:paddingRight="5dp"
                android:text="@string/login" 
                android:textSize="16sp"/>

            <EditText
                android:id="@+id/edLogin"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_weight="0.5"
                android:imeOptions="actionNext"
                tools:ignore="TextFields" />

        </TableRow>

        <TableRow>

            <TextView
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:gravity="right"
                android:paddingTop="5dp"
                android:text="@string/passw" 
                android:textSize="16sp"/>

            <EditText
                android:id="@+id/edPassw"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_weight="0.5"
                android:imeOptions="actionDone"
                tools:ignore="TextFields" />

        </TableRow>

        <TableRow
            android:id="@+id/trOnLine"
            android:visibility="gone" >

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="right"
                android:paddingTop="5dp"
                android:text="@string/on_line_ip" 
                android:textSize="16sp"/>

            <Spinner
                android:id="@+id/spOnLine"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="0.5"
                android:entries="@array/on_line_items" />
        </TableRow>
    </TableLayout>

</LinearLayout>