<?xml version="1.0" encoding="utf-8"?>

<android.gesture.GestureOverlayView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/gestures"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:gestureStrokeType="single"
    android:eventsInterceptionEnabled="true"
    android:orientation="vertical"
    android:gestureColor="#00000000"
    android:uncertainGestureColor="#00000000">
     
<LinearLayout 
	android:id="@+id/LinearLayout01" 
	android:layout_width="fill_parent" 
	android:layout_height="fill_parent" 
	android:orientation="vertical"
	android:layout_weight="1" >
	
	<LinearLayout android:layout_height="wrap_content" 
		android:layout_width="fill_parent" 
        android:layout_weight="0" 
        android:background="@color/black" 
        android:id="@+id/llTop">
        
		<ImageView android:layout_width="wrap_content"
		    android:visibility="gone" 
            android:background="@color/footer" 
            android:layout_marginLeft="1sp" 
            android:layout_marginBottom="1sp" 
            android:layout_marginTop="1sp" 
            android:src="@drawable/goup" 
            android:layout_height="fill_parent" 
            android:id="@+id/ivGoUp" 
            android:paddingLeft="5sp" 
            android:paddingRight="5sp"/>
		
		<TextView
			android:text="Документ"
			android:textSize="@dimen/head_font"
			android:textColor="#000000"
			android:layout_height="wrap_content" 
			android:background="@color/footer" 
			android:layout_marginTop="1sp" 
			android:layout_marginBottom="1sp" 
			android:layout_marginLeft="1sp" 
			android:layout_marginRight="1sp" 
			android:paddingLeft="2sp" 
			android:paddingBottom="5sp" 
			android:paddingTop="5sp" 
			android:layout_width="wrap_content" 
			android:layout_weight="2" 
			android:id="@+id/tvFirstColumnCaption" android:layout_gravity="center_vertical"/>
		
		<TextView
			android:id="@+id/tvRingTitle"
			android:text="Круг"
			android:textSize="@dimen/head_font"
			android:textColor="#000000"
			android:layout_height="wrap_content" 
			android:layout_weight="1" 
			android:gravity="right" 
			android:background="@color/footer" 
			android:layout_marginTop="1sp" 
			android:layout_marginBottom="1sp" 
			android:layout_marginRight="1sp" 
			android:paddingRight="2sp" 
			android:paddingTop="5sp" 
			android:paddingBottom="5sp" 
			android:layout_width="wrap_content" 
            android:layout_gravity="center_vertical"/>
	</LinearLayout>
	
	<LinearLayout android:id="@+id/LinearLayout04" 
		android:layout_width="fill_parent" 
		android:layout_height="wrap_content" 
		android:layout_weight="1">
		
		<ListView android:id="@+id/lvMainOrgs" 
			android:layout_width="fill_parent" 
			android:layout_weight="1" 
			android:layout_height="fill_parent" 
			android:background="@color/white"/>
		
	</LinearLayout>
	
	<LinearLayout android:id="@+id/llFind" 
		android:layout_height="wrap_content" 
		android:layout_width="fill_parent"
		android:orientation="horizontal" android:background="@color/white">
		
		<EditText android:layout_height="wrap_content" 
			android:layout_width="wrap_content" 
			android:id="@+id/edFind" 
			android:layout_weight="1" 
			android:layout_gravity="center_vertical" 
			android:layout_marginLeft="3sp" 
			android:layout_marginRight="3sp"/>
		
		<ImageButton android:layout_width="wrap_content" 
			android:layout_height="wrap_content" 
			android:src="@drawable/ic_delete" 
			android:id="@+id/btnDelFind"/>
		
	</LinearLayout>		
	
	<LinearLayout android:id="@+id/linearLayout1" 
		android:layout_height="wrap_content" 
		android:layout_width="fill_parent" 
		android:background="@color/footer" 
		android:padding="7sp">
		
		<ImageButton android:layout_width="wrap_content" 
			android:layout_height="wrap_content" 
			android:src="@drawable/icon" 
			android:id="@+id/btnDocFilter" android:layout_marginRight="7sp"/>
					
		<ImageButton android:layout_width="wrap_content" 
			android:layout_height="wrap_content" 
			android:src="@drawable/icon" 
			android:id="@+id/btnMode" android:layout_marginRight="7sp"/>
			
		<ImageButton android:layout_width="wrap_content" 
			android:layout_height="wrap_content" 
			android:id="@+id/btnLines" 
			android:src="@drawable/line_2" android:layout_marginRight="7sp"/>
			
		<ImageButton android:layout_width="wrap_content" 
			android:layout_height="wrap_content" 
			android:src="@drawable/find" 
			android:id="@+id/btnFind" android:layout_marginRight="7sp"/>
			
		<TextView android:layout_height="wrap_content" 
			android:layout_gravity="center_vertical" 
			android:layout_width="fill_parent" 
			android:paddingRight="3sp" 
			android:gravity="right" 
			android:id="@+id/tvTotalSum" 
			android:textColor="@color/black" 
			android:text="Сумма" />
        
        <ImageButton android:layout_width="wrap_content" 
            android:layout_height="wrap_content" 
            android:src="@drawable/send" 
            android:id="@+id/btnSync" 
            android:layout_marginRight="7sp"/>
        
		<ImageButton android:layout_width="wrap_content" 
			android:layout_height="wrap_content" 
			android:src="@drawable/price_list" 
			android:id="@+id/btnPriceList" android:layout_marginRight="7sp"/>
        
		<ImageButton android:layout_width="wrap_content" 
			android:layout_height="wrap_content" 
			android:src="@drawable/view_archive" 
			android:id="@+id/btnChangeMode" android:layout_marginRight="7sp"/>
	</LinearLayout>
</LinearLayout>
</android.gesture.GestureOverlayView> 