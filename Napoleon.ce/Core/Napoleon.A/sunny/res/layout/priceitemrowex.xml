<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:background="@color/black"
    android:orientation="horizontal" >
    
    <LinearLayout 
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:background="@color/black">
        

      <TextView
          android:id="@+id/tvName"
          android:layout_width="0dip"
          android:layout_height="fill_parent"
          android:layout_margin="1dp"
          android:layout_weight="1"
          android:background="@drawable/list_selector"
          android:gravity="center"
          android:text="@string/title"
          android:textColor="@color/black"
          android:textSize="@dimen/title_text_sz" />
  
      <LinearLayout
          android:layout_width="@dimen/col_2width"
          android:layout_height="fill_parent"
          android:orientation="vertical" >
  
          <LinearLayout
              android:layout_width="fill_parent"
              android:layout_height="0dip"
              android:layout_weight="0.5"
              android:orientation="horizontal" >
  
              <TextView
                  android:id="@+id/tvPrevRem"        
                  android:layout_width="0dip"
                  android:layout_height="fill_parent"
                  android:layout_margin="1dp"
                  android:layout_weight="0.5"
                  android:background="@drawable/list_selector"
                  android:gravity="center"
                  android:text="@string/remains_doc_title"
                  android:textColor="@color/black"
                  android:textSize="@dimen/title_text_sz" />
  
              <TextView
                  android:id="@+id/tvPrevOrd"
                  android:layout_width="0dip"
                  android:layout_height="fill_parent"
                  android:layout_margin="1dp"
                  android:layout_weight="0.5"
                  android:background="@drawable/list_selector"
                  android:gravity="center"
                  android:text="@string/ord_title"
                  android:textColor="@color/black"
                  android:textSize="@dimen/title_text_sz" />
          </LinearLayout>
  
          <TextView
              android:id="@+id/tvDate"
              android:layout_width="fill_parent"
              android:layout_height="0dip"
              android:layout_margin="1dp"
              android:layout_weight="0.5"
              android:background="@drawable/list_selector"
              android:gravity="center"
              android:text="@string/date"
              android:textColor="@color/black"
              android:textSize="@dimen/title_text_sz" />
      </LinearLayout>
  
      <TextView
          android:id="@+id/tvRemn"
          android:layout_width="@dimen/col_width"
          android:layout_height="fill_parent"
          android:layout_margin="1dp"
          android:background="@drawable/list_selector"
          android:gravity="center"
          android:text="@string/remains_doc_title"
          android:textColor="@color/black"
          android:textSize="@dimen/title_text_sz" />
  
      <TextView
          android:id="@+id/tvOrd"
          android:layout_width="@dimen/col_width"
          android:layout_height="fill_parent"
          android:layout_margin="1dp"
          android:background="@drawable/list_selector"
          android:gravity="center"
          android:text="@string/ord_title"
          android:textColor="@color/black"
          android:textSize="@dimen/title_text_sz" />
  
      <LinearLayout
          android:layout_width="@dimen/colwprc"
          android:layout_height="fill_parent"
          android:orientation="vertical" >
  
          <TextView
              android:id="@+id/tvCost"
              android:layout_width="fill_parent"
              android:layout_height="0dip"
              android:layout_margin="1dp"
              android:layout_weight="0.5"
              android:background="@drawable/list_selector"
              android:gravity="center"
              android:text="@string/cost"
              android:textColor="@color/black"
              android:textSize="@dimen/title_text_sz" />
  
          <TextView
              android:id="@+id/tvWhQty"
              android:layout_width="fill_parent"
              android:layout_height="0dip"
              android:layout_margin="1dp"
              android:layout_weight="0.5"
              android:background="@drawable/list_selector"
              android:gravity="center"
              android:text="@string/in_store"
              android:textColor="@color/black"
              android:textSize="@dimen/title_text_sz" />
      </LinearLayout>
    </LinearLayout>
</LinearLayout>