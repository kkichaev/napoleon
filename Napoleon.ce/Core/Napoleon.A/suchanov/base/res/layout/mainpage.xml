<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
 	xmlns:android="http://schemas.android.com/apk/res/android"
 	android:layout_height="fill_parent" 
 	android:layout_width="fill_parent" 
 	android:background="#FFFFFF" 
 	android:orientation="vertical">
    <TableLayout android:layout_width="fill_parent" 
    	android:stretchColumns="*"
    	android:id="@+id/tableLayout1" 
    	android:layout_height="wrap_content" 
    	android:layout_weight="0">
    	
        <TableRow android:id="@+id/tableRow1" 
	    	android:padding="2dp"
        	android:layout_width="wrap_content" 
        	android:layout_height="wrap_content">
        	
			<TextView android:id="@+id/TextView01" 
				android:layout_width="wrap_content" 
				android:layout_height="wrap_content"
				android:textColor="#000000" 
				android:text="Дата:"></TextView>
			
			<TextView android:layout_width="wrap_content" 
				android:layout_height="wrap_content" 
				android:textColor="#000000" 
				android:text="25.11.2010" 
				android:id="@+id/tvDate" 
				android:textStyle="bold"></TextView>
				
			<TextView android:id="@+id/TextView02" 
				android:layout_width="wrap_content" 
				android:layout_height="wrap_content"
				android:textColor="#000000" 
				android:text="Время:" ></TextView>
				
			<TextView android:layout_width="wrap_content" 
				android:layout_height="wrap_content" 
				android:textColor="#000000" 
				android:text="00:00" 
				android:id="@+id/tvTime" 
				android:textStyle="bold"></TextView>
        </TableRow>

        <TableRow android:id="@+id/tableRow2" 
	    	android:padding="2dp"
        	android:layout_width="wrap_content" 
        	android:layout_height="wrap_content">
        	
			<TextView android:id="@+id/TextView01" 
				android:layout_width="wrap_content" 
				android:layout_height="wrap_content"
				android:textColor="#000000" 
				android:text="Оплата:"></TextView>
			
			<TextView android:layout_width="wrap_content" 
				android:layout_height="wrap_content" 
				android:textColor="#000000" 
				android:text="25.11.2010" 
				android:id="@+id/tvPayDate" 
				android:textStyle="bold"></TextView>
				
			<TextView android:id="@+id/TextView02" 
				android:layout_width="wrap_content" 
				android:layout_height="wrap_content"
				android:textColor="#000000" 
				android:text="Лимит:" ></TextView>
				
			<TextView android:layout_width="wrap_content" 
				android:layout_height="wrap_content" 
				android:textColor="#000000" 
				android:text="00:00" 
				android:id="@+id/tvLimitTime" 
				android:textStyle="bold"></TextView>
        </TableRow>
    </TableLayout>
 	
	<LinearLayout android:id="@+id/LinearLayout04" 
		android:layout_height="wrap_content" 
		android:layout_width="fill_parent" 
		android:layout_weight="0">
		
		<CheckBox android:layout_width="wrap_content" 
			android:layout_height="wrap_content" 
			android:id="@+id/cbCash" 
			android:text="Тема Б" 
			android:textColor="#000000" 
			android:layout_weight="0.5"></CheckBox>
		<CheckBox android:layout_width="wrap_content" 
			android:layout_height="wrap_content" 
			android:id="@+id/cbWDiscount" 
			android:text="Б/скидки" 
			android:textColor="#000000" 
			android:layout_weight="0.5"></CheckBox>
	</LinearLayout>
	
    <TableLayout android:layout_width="fill_parent" 
    	android:stretchColumns="1"
    	android:id="@+id/tableLayout1" 
    	android:layout_height="wrap_content" 
    	android:layout_weight="0">
	
        <TableRow android:id="@+id/tableRow1" 
	    	android:padding="2dp"
        	android:layout_width="wrap_content" 
        	android:layout_height="wrap_content">
        	
			<TextView android:id="@+id/TextView03" 
				android:layout_height="wrap_content" 
				android:text="Фирма" 
				android:textColor="#000000" 
				android:layout_marginLeft="5dp" 
				android:layout_marginRight="5dp" 
				android:layout_width="wrap_content" 
				android:layout_gravity="center_vertical"></TextView>
			<Spinner android:layout_height="wrap_content" 
				android:layout_weight="1" 
				android:id="@+id/spFirma" android:layout_width="wrap_content"></Spinner>
        </TableRow>
        <TableRow android:id="@+id/tableRow2" 
	    	android:padding="2dp"
        	android:layout_width="wrap_content" 
        	android:layout_height="wrap_content">
        	
			<TextView android:id="@+id/TextView04" 
				android:layout_height="wrap_content" 
				android:textColor="#000000" 
				android:text="Цена" 
				android:layout_marginLeft="5dp" 
				android:layout_marginRight="5dp"
				android:layout_width="wrap_content" android:layout_gravity="center_vertical"></TextView>	
			
			<Spinner android:layout_height="wrap_content" 
				android:layout_weight="1" android:id="@+id/spPrices" android:layout_width="wrap_content"></Spinner>
		</TableRow>
        <TableRow android:id="@+id/tableRow3" 
	    	android:padding="2dp"
        	android:layout_width="wrap_content" 
        	android:layout_height="wrap_content">
        	
			<TextView android:id="@+id/TextView04" 
				android:layout_height="wrap_content" 
				android:textColor="#000000" 
				android:text="Банк" 
				android:layout_marginLeft="5dp" 
				android:layout_marginRight="5dp"
				android:layout_width="wrap_content" android:layout_gravity="center_vertical"></TextView>	
			
			<Spinner android:layout_height="wrap_content" 
				android:layout_weight="1" android:id="@+id/spBank" android:layout_width="wrap_content"></Spinner>
		</TableRow>
 	</TableLayout>
</LinearLayout>
