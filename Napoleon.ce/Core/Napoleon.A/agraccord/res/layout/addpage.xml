<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  android:background="#FFFFFF"
  android:orientation="vertical"
  android:layout_width="fill_parent"
  android:layout_height="fill_parent">

<ScrollView 
	android:fillViewport="true"
   	android:layout_width="fill_parent"
   	android:layout_height="wrap_content"
   	android:layout_weight="1"
   	android:id="@+id/scrollview"> 
    	
<LinearLayout
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:orientation="vertical" >
<TableLayout android:layout_width="fill_parent" 
   	android:id="@+id/tableLayout1" 
   	android:layout_height="wrap_content" 
   	android:layout_weight="0">

      <TableRow android:id="@+id/tableRow1" 
    	android:padding="2dp"
       	android:layout_width="wrap_content" 
       	android:layout_height="wrap_content">
		
		<CheckBox 
			android:text="Паспорт" 
			android:textColor="#000000" 
			android:id="@+id/cbPasport" 
			android:layout_width="wrap_content" android:layout_height="wrap_content"></CheckBox>	
		<CheckBox 
			android:text="Сертификат" 
			android:textColor="#000000" 
			android:id="@+id/cbSert" 
			android:layout_width="wrap_content" android:layout_height="wrap_content"></CheckBox>	
	  </TableRow>		
      <TableRow android:id="@+id/tableRow1" 
    	android:padding="2dp"
       	android:layout_width="wrap_content" 
       	android:layout_height="wrap_content">
		
		<CheckBox 
			android:text="Схема проезда" 
			android:textColor="#000000" 
			android:id="@+id/cbShema" 
			android:layout_width="wrap_content" android:layout_height="wrap_content"></CheckBox>	
		<CheckBox 
			android:text="Счет" 
			android:textColor="#000000" 
			android:id="@+id/cbSchet" 
			android:layout_width="wrap_content" android:layout_height="wrap_content"></CheckBox>	
	  </TableRow>		
      <TableRow android:id="@+id/tableRow1" 
    	android:padding="2dp"
       	android:layout_width="wrap_content" 
       	android:layout_height="wrap_content">

		<CheckBox 
			android:text="Представительские" 
			android:textColor="#000000" 
			android:id="@+id/cbPredstav" 
			android:layout_span="2"
			android:layout_width="wrap_content" 
			android:layout_height="wrap_content"
			/>	
	  </TableRow>		
</TableLayout>
<TableLayout android:layout_width="fill_parent" 
   	android:stretchColumns="1"
   	android:id="@+id/tableLayout1" 
   	android:layout_height="wrap_content" 
   	android:layout_weight="0">

      <TableRow android:id="@+id/tableRow1" 
    	android:padding="2dp"
       	android:layout_width="wrap_content" 
       	android:layout_height="wrap_content">
		
		<TextView android:id="@+id/TextView04" 
			android:layout_height="wrap_content" 
			android:textColor="#000000" 
			android:text="Грузополучатель" 
			android:layout_marginLeft="5dp" 
			android:layout_marginRight="5dp" android:layout_width="wrap_content" 
			android:layout_gravity="center_vertical"></TextView>	
		<Spinner android:layout_height="wrap_content" 
			android:layout_weight="1" android:id="@+id/spConsignee" android:layout_width="fill_parent"></Spinner>
	</TableRow>		
      <TableRow android:id="@+id/tableRow1" 
    	android:padding="2dp"
       	android:layout_width="wrap_content" 
       	android:layout_height="wrap_content">
		
		<TextView android:id="@+id/TextView04" 
			android:layout_height="wrap_content" 
			android:textColor="#000000" 
			android:text="Грузоприемщик" 
			android:layout_marginLeft="5dp" 
			android:layout_marginRight="5dp" android:layout_width="wrap_content" 
			android:layout_gravity="center_vertical"></TextView>	
		<Spinner android:layout_height="wrap_content" 
			android:layout_weight="1" android:id="@+id/spGprm" android:layout_width="fill_parent"></Spinner>
	</TableRow>		
      <TableRow android:id="@+id/tableRow1" 
    	android:padding="2dp"
       	android:layout_width="wrap_content" 
       	android:layout_height="wrap_content">
		
		<TextView android:id="@+id/TextView04" 
			android:layout_height="wrap_content" 
			android:textColor="#000000" 
			android:text="Плательщик" 
			android:layout_marginLeft="5dp" 
			android:layout_marginRight="5dp" android:layout_width="wrap_content" 
			android:layout_gravity="center_vertical"></TextView>	
		<Spinner android:layout_height="wrap_content" 
			android:layout_weight="1" android:id="@+id/spPayer" android:layout_width="fill_parent"></Spinner>
	</TableRow>		
      <TableRow android:id="@+id/tableRow1" 
    	android:padding="2dp"
       	android:layout_width="wrap_content" 
       	android:layout_height="wrap_content">
		
		<TextView android:id="@+id/TextView04" 
			android:layout_height="wrap_content" 
			android:textColor="#000000" 
			android:text="Отв.менеджер" 
			android:layout_marginLeft="5dp" 
			android:layout_marginRight="5dp" android:layout_width="wrap_content" 
			android:layout_gravity="center_vertical"></TextView>	
		<Spinner android:layout_height="wrap_content" 
			android:layout_weight="1" android:id="@+id/spExecutive" android:layout_width="fill_parent"></Spinner>
	</TableRow>		
</TableLayout>
</LinearLayout>
</ScrollView>
</LinearLayout>
