<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:orientation="vertical" >

	<LinearLayout
        android:id="@+id/llOrgName"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_weight="0"
        android:background="@color/footer"
        android:paddingBottom="10dp"
        android:visibility="gone"
        android:paddingTop="5dp" >

        <TextView
            android:id="@+id/tvOrg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scrollHorizontally="true"
            android:text="OrgName"
            android:textColor="@color/black"
            android:textSize="18sp"
            tools:ignore="HardcodedText" />
    </LinearLayout>    
    <LinearLayout
        android:id="@+id/llOrder"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content" 
        android:background="@color/black"
        android:visibility="visible">

        <TextView
            android:id="@+id/tvMfr"
            android:layout_width="wrap_content"
            android:layout_height="fill_parent"
            android:text="@string/manufactur"
            android:textColor="@color/black" 
            android:textSize="18sp"
            android:layout_weight="1"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:background="@color/footer" 
            android:layout_marginRight="1dp"
            android:gravity="center"/>

        <TextView
            android:id="@+id/tvDraft"
            android:layout_width="wrap_content"
            android:layout_height="fill_parent"
            android:text="@string/draft" 
            android:textColor="@color/black"
            android:textSize="18sp"
            android:layout_weight="1"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:background="@color/footer"
            android:layout_marginRight="1dp" 
            android:gravity="center"/>

        <TextView
            android:id="@+id/tvNew"
            android:layout_width="wrap_content"
            android:layout_height="fill_parent"
            android:text="@string/newst" 
            android:textColor="@color/black"
            android:textSize="18sp"
            android:layout_weight="1"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:background="@color/footer"
            android:layout_marginRight="1dp" 
            android:gravity="center"/>

        <TextView
            android:id="@+id/tvAct"
            android:layout_width="wrap_content"
            android:layout_height="fill_parent"
            android:text="@string/actions" 
            android:textColor="@color/black"
            android:textSize="18sp"
            android:layout_weight="1"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:background="@color/footer"
            android:layout_marginRight="1dp" 
            android:gravity="center"/>

        <TextView
            android:id="@+id/tvHit"
            android:layout_width="wrap_content"
            android:layout_height="fill_parent"
            android:text="@string/hits" 
            android:textColor="@color/black"
            android:textSize="18sp"
            android:layout_weight="1"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:background="@color/footer"
            android:gravity="center" />

        <ImageView
            android:id="@+id/ivFilter"
            android:background="@color/footer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingRight="5dp"
            android:paddingTop="5dp"
            android:src="@drawable/filter"
            tools:ignore="ContentDescription" >
        </ImageView>
    </LinearLayout>

    <View android:layout_width="wrap_content"
        android:layout_height="1dp"
        android:background="@color/grey"/>
    
    <HorizontalScrollView
        android:id="@+id/hswPricePage"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:background="@color/footer" 
        android:visibility="gone" >

        <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal" >

            <TextView
                android:id="@+id/tvHome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableLeft="@drawable/price_home"
                android:gravity="center_vertical"
                android:textColor="@color/black"
                tools:ignore="HardcodedText" />

            <LinearLayout
                android:id="@+id/llPath"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:orientation="horizontal" >
            </LinearLayout>
        </LinearLayout>
    </HorizontalScrollView>

    <LinearLayout
        android:id="@+id/llPriceControl"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_weight="0"
        android:background="#80ffcc"
        android:paddingBottom="10dp"
        android:paddingTop="5dp"
        android:visibility="visible" >

        <ImageView
            android:id="@+id/ivGoUp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/goup"
            tools:ignore="ContentDescription" >
        </ImageView>

        <LinearLayout
            android:id="@+id/llLables"
            android:layout_width="0dp"
            android:layout_height="fill_parent"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:padding="0dp"
            tools:ignore="NestedWeights" >

            <TextView
                android:id="@+id/tvItemSelectUpLevel"
                android:layout_width="0dp"
                android:layout_height="fill_parent"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:lines="1"
                android:scrollHorizontally="true"
                android:text="@string/price"
                android:textColor="@color/dark_blue"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:ignore="NestedWeights" >
            </TextView>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_weight="0"
        android:background="@color/footer" >

        <TextView
            android:layout_width="0dip"
            android:layout_height="wrap_content"
            android:text="Наименование"
            android:layout_weight="1"
            android:textColor="@color/black" 
            android:gravity="center_horizontal"/>

        <TextView
            android:layout_width="@dimen/whclmn"
            android:layout_height="wrap_content"
            android:text="Заказано"
            android:textColor="@color/black" 
            android:gravity="center_horizontal"/>
        
        <TextView
            android:layout_width="@dimen/whclmn"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:text="Остатки"
            android:textColor="@color/black" 
            android:gravity="center_horizontal"/>

        <TextView
            android:layout_width="@dimen/whclmn"
            android:layout_height="wrap_content"
            android:text="Цена" 
            android:textColor="@color/black"
            android:gravity="center_horizontal"/>

        <TextView
            android:layout_width="@dimen/whclmn"
            android:layout_height="wrap_content"
            android:text="Скидка"
            android:textColor="@color/black" 
            android:gravity="center_horizontal"/>
        

        <TextView
            android:layout_width="@dimen/whclmn"
            android:layout_height="wrap_content"
            android:text="Итог" 
            android:textColor="@color/black"
            android:gravity="center_horizontal"/>
   </LinearLayout>

    <TextView
        android:id="@+id/tvActionDescr"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:textColor="@color/grey"
        android:textSize="22sp"
        android:text="TextView" 
        android:paddingTop="7dp"
        android:paddingBottom="7dp"/>

    <FrameLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:background="@color/white" 
        android:layout_weight="1">

        <ListView
            android:id="@+id/lvOrderItemSelect"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:background="#c0ccff"/>

        <ImageView
            android:id="@+id/ivFilterLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="right|bottom"
            android:layout_marginBottom="20dp"
            android:layout_marginRight="10dp"
            android:layout_marginTop="10dp"
            android:src="@drawable/filter"
            android:visibility="gone"
            tools:ignore="ContentDescription" >
        </ImageView>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/llFind"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:orientation="horizontal" >

        <EditText
            android:id="@+id/edFind"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginLeft="3dp"
            android:layout_marginRight="3dp"
            android:textColor="@color/red"
            android:layout_weight="1"
            tools:ignore="TextFields" />

        <ImageButton
            android:id="@+id/btnDelFind"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_delete"
            tools:ignore="ContentDescription" />

        <Spinner
            android:id="@+id/spFind"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:entries="@array/wh_find_choices"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/linearLayout1"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:background="@color/footer"
        android:orientation="horizontal"
        android:padding="7dp">

        <ImageButton
            android:id="@+id/btnUp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="7dp"
            android:src="@drawable/up"
            tools:ignore="ContentDescription" />

        <ImageButton
            android:id="@+id/btnDown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="7dp"
            android:src="@drawable/down"
            tools:ignore="ContentDescription" />

        <ImageButton
            android:id="@+id/btnLines"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="7dp"
            android:src="@drawable/line_2"
            android:visibility="gone"
            tools:ignore="ContentDescription" />

        <ImageButton
            android:id="@+id/btnFind"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="7dp"
            android:src="@drawable/find"
            tools:ignore="ContentDescription" />

        <ImageButton
            android:id="@+id/btnPack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="4dp"
            android:src="@drawable/pack_off"
            android:visibility="gone"
            tools:ignore="ContentDescription" />

        <ImageButton
            android:id="@+id/btnAttach"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/setting_photo"
            android:layout_marginRight="4dp" />

        <ImageButton
            android:id="@+id/btnExpand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="4dp"
            android:src="@drawable/view_list" />

        <Button
            android:id="@+id/btnOK"
            android:layout_width="75dp"
            android:layout_height="fill_parent"
            android:layout_marginRight="4dp"
            android:text="@string/ok"
            android:textSize="24sp" />
        
        <TextView
            android:id="@+id/tvTotalSum"
            android:layout_width="0dip"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_weight="1"
            android:gravity="right"
            android:text="@string/sum"
            android:textColor="@color/black"
            android:textSize="16sp" />
    </LinearLayout>

</LinearLayout>