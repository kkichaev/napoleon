<?xml version="1.0" encoding="utf-8"?>
<android.gesture.GestureOverlayView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/gestures"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:gestureStrokeType="single"
    android:eventsInterceptionEnabled="true"
    android:orientation="vertical"
    android:gestureColor="#00000000"
    android:uncertainGestureColor="#00000000">
    
<LinearLayout
  	android:layout_height="fill_parent" 
  	android:layout_width="fill_parent" 
  	android:orientation="vertical" 
  	android:background="@color/white">
  	
    <LinearLayout android:layout_width="fill_parent" 
    	android:id="@+id/linearLayout2" 
    	android:layout_height="wrap_content" 
    	android:orientation="horizontal" 
    	android:layout_weight="1" 
    	android:padding="3dp">
    	
        <TextView android:id="@+id/textView2" 
        	android:layout_width="wrap_content" 
        	android:layout_height="wrap_content" 
        	android:textColor="@color/black" 
        	android:text="@string/date" 
        	android:paddingRight="7dp" />
        	
        <TextView android:id="@+id/tvDate" 
        	android:layout_width="wrap_content" 
        	android:layout_height="wrap_content" 
        	android:textColor="@color/black" 
        	android:textStyle="bold"
        	android:gravity="center_vertical"
        	android:text="@string/dateSample" 
        	android:paddingRight="7dp" />
        	
        <TextView android:id="@+id/textView3" 
        	android:layout_width="wrap_content" 
        	android:layout_height="wrap_content" 
        	android:textColor="@color/black" 
        	android:text="@string/sum" 
        	android:paddingRight="7dp" />
        	
        <EditText android:layout_height="wrap_content" 
        	android:layout_width="0dip" 
			android:layout_weight="1" 
        	android:text="" 
        	android:id="@+id/edCount" android:inputType="numberDecimal"/>
    </LinearLayout>

	<LinearLayout android:layout_width="fill_parent" 
		android:layout_height="wrap_content" 
		android:background="@color/blue" 
		android:id="@+id/llKeyboard">
		
		<TableLayout android:layout_width="fill_parent" 
			android:id="@+id/tableLayout1" 
			android:background="@color/white" 
			android:layout_marginTop="2dp" 
			android:layout_height="fill_parent" 
			android:stretchColumns="*" 
            android:shrinkColumns="*">
			
			<TableRow android:layout_height="wrap_content" 
				android:id="@+id/tableRow1" 
				android:layout_width="wrap_content">
				
				<ImageButton android:layout_height="wrap_content" 
					android:contentDescription="@string/digit"
					android:layout_width="wrap_content" 
					android:id="@+id/btn1" 
					android:src="@drawable/k1" 
					android:tag="1"/>
					
				<ImageButton android:layout_height="wrap_content" 
					android:contentDescription="@string/digit"
					android:layout_width="wrap_content" 
					android:id="@+id/btn2" 
					android:tag="2" 
					android:src="@drawable/k2"/>
					
				<ImageButton android:layout_height="wrap_content" 
					android:contentDescription="@string/digit"
					android:layout_width="wrap_content" 
					android:src="@drawable/k3" 
					android:tag="3" 
					android:id="@+id/btn3"/>
				
				<ImageButton android:layout_width="wrap_content" 
					android:contentDescription="@string/digit"
                	android:layout_height="wrap_content" 
                	android:id="@+id/btn4" 
                	android:tag="4" 
                	android:src="@drawable/k4"/>
                	
				<ImageButton android:layout_height="wrap_content" 
					android:contentDescription="@string/digit"
					android:src="@drawable/k5" 
					android:tag="5" 
					android:id="@+id/btn5" 
					android:layout_width="wrap_content"/>
			</TableRow>
			
			<TableRow android:layout_height="wrap_content" 
				android:id="@+id/tableRow2" 
				android:layout_width="wrap_content">
				
				<ImageButton android:layout_height="wrap_content" 
					android:contentDescription="@string/digit"
					android:layout_width="wrap_content" 
					android:tag="6" 
					android:src="@drawable/k6" 
					android:id="@+id/btn6"/>
					
				<ImageButton android:layout_height="wrap_content" 
					android:contentDescription="@string/digit"
					android:layout_width="wrap_content" 
					android:id="@+id/btn7" 
					android:src="@drawable/k7" 
					android:tag="7"/>
					
				<ImageButton android:layout_height="wrap_content" 
					android:contentDescription="@string/digit"
					android:layout_width="wrap_content" 
					android:tag="8" 
					android:src="@drawable/k8" 
					android:id="@+id/btn8"/>
					
				<ImageButton android:layout_height="wrap_content" 
					android:contentDescription="@string/digit"
					android:layout_width="wrap_content" 
					android:id="@+id/btn9" 
					android:src="@drawable/k9" 
					android:tag="9"/>
					
				<ImageButton android:layout_height="wrap_content" 
					android:contentDescription="@string/digit"
					android:layout_width="wrap_content" 
					android:src="@drawable/k0" 
					android:tag="0" 
					android:id="@+id/btn0"/>
			</TableRow>
			
			<TableRow android:layout_height="wrap_content" 
				android:id="@+id/tableRow3" 
				android:layout_width="wrap_content">
				
				<ImageButton android:layout_width="wrap_content" 
					android:contentDescription="@string/digit"
                	android:layout_height="wrap_content" 
                	android:tag="7" 
                	android:id="@+id/btnDel" 
                	android:src="@drawable/del"/>
                	
				<ImageButton android:layout_height="wrap_content" 
					android:contentDescription="@string/digit"
					android:layout_width="wrap_content" 
					android:src="@drawable/zap" 
					android:id="@+id/btnComma" 
					android:tag=","/>
					
				<ImageButton android:layout_height="wrap_content" 
					android:contentDescription="@string/ok"
					android:layout_width="wrap_content" 
					android:id="@+id/btnOK" 
					android:visibility="invisible"
					android:src="@drawable/ok" 
					android:layout_span="3"/>
			</TableRow>
		</TableLayout>
	</LinearLayout>
    <LinearLayout android:layout_height="wrap_content" 
    	android:layout_width="fill_parent" 
    	android:id="@+id/linearLayout3" 
    	android:background="@color/footer" 
    	android:padding="7dp">
        	
        <ImageButton android:layout_width="wrap_content" 
            android:contentDescription="@string/send"
        	android:layout_height="wrap_content" 
        	android:src="@drawable/send" 
        	android:id="@+id/btnSend" android:layout_marginRight="7dp"/>
    </LinearLayout>
</LinearLayout>
</android.gesture.GestureOverlayView>