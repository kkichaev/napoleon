<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:background="@color/white" >

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical" >

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/client_caption"
            android:textColor="@color/blue"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/tvName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TextView"
            android:textColor="@color/black"
            android:textSize="18sp"
            tools:ignore="HardcodedText" />

        <TextView
            android:id="@+id/textView1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/real_client"
            android:textColor="@color/blue"
            android:textSize="20sp" />

        <CheckBox
            android:id="@+id/cbYes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="20dp"
            android:text="@string/yes"
            android:textColor="@color/black" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/product_category"
            android:textColor="@color/blue"
            android:textSize="20sp" />

        <Spinner
            android:id="@+id/spCategoryProduct"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/segment"
            android:textColor="@color/blue"
            android:textSize="20sp" />

        <Spinner
            android:id="@+id/spSegment"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/suppose_date_first_order"
            android:textColor="@color/blue"
            android:textSize="20sp" />

        <DatePicker
            android:id="@+id/dpFirst"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/success_reasons"
            android:textColor="@color/blue"
            android:textSize="20sp" />

        <EditText
            android:id="@+id/edSuccesReason"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:ems="10"
            android:inputType="textMultiLine" >
        </EditText>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/chance"
            android:textColor="@color/blue"
            android:textSize="20sp" />

        <Spinner
            android:id="@+id/spChance"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/suppose_year_cubature"
            android:textColor="@color/blue"
            android:textSize="20sp" />

        <EditText
            android:id="@+id/edCub"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:ems="10"
            android:inputType="number" >
        </EditText>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/strS"
            android:textColor="@color/blue"
            android:textSize="20sp" />

        <DatePicker
            android:id="@+id/dpS"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/strP"
            android:textColor="@color/blue"
            android:textSize="20sp" />

        <DatePicker
            android:id="@+id/dpP1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/strA"
            android:textColor="@color/blue"
            android:textSize="20sp" />

        <DatePicker
            android:id="@+id/dpA"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/strN"
            android:textColor="@color/blue"
            android:textSize="20sp" />

        <DatePicker
            android:id="@+id/dpN"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/strC"
            android:textColor="@color/blue"
            android:textSize="20sp" />

        <DatePicker
            android:id="@+id/dpC"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/strO"
            android:textColor="@color/blue"
            android:textSize="20sp" />

        <DatePicker
            android:id="@+id/dpO"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/strP"
            android:textColor="@color/blue"
            android:textSize="20sp" />

        <DatePicker
            android:id="@+id/dpP2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/notice"
            android:textColor="@color/blue"
            android:textSize="20sp" />

        <EditText
            android:id="@+id/edNotice"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:ems="10"
            android:inputType="textMultiLine" >
        </EditText>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/holding"
            android:textColor="@color/blue"
            android:textSize="20sp" />

        <EditText
            android:id="@+id/edHolding"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:ems="10"
            android:inputType="text" >
        </EditText>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/clientlevel"
            android:textColor="@color/blue"
            android:textSize="20sp" />

        <Spinner
            android:id="@+id/spClientLevel"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content" />
        
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/competitor"
            android:textColor="@color/blue"
            android:textSize="20sp" />

        <Spinner
            android:id="@+id/spCompetitor"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>

</ScrollView>