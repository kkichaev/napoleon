<?xml version="1.0" encoding="utf-8"?>
<android.gesture.GestureOverlayView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/gestures"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:gestureStrokeType="single"
    android:eventsInterceptionEnabled="true"
    android:orientation="vertical"
    android:gestureColor="#00000000"
    android:uncertainGestureColor="#00000000">
    
<LinearLayout
    android:baselineAligned="false"
  	android:layout_width="fill_parent" 
  	android:layout_height="fill_parent" 
  	android:orientation="vertical">
	
	<LinearLayout 
		android:id="@+id/LinearLayout01" 
		android:layout_height="wrap_content" 
		android:orientation="horizontal" 
		android:layout_width="fill_parent" 
		android:background="#80ffcc" 
		android:paddingBottom="10dp" 
		android:paddingTop="5dp">
		
		<TextView android:textColor="#000000"
			android:text="@string/organization" 
			android:id="@+id/tvOrgInfo" 
			android:layout_width="wrap_content" 
			android:layout_height="wrap_content" 
			android:textSize="18sp" 
			android:layout_marginLeft="3dp" 
			android:layout_marginRight="3dp" />
	</LinearLayout>

	<LinearLayout android:id="@+id/LinearLayout04" 
		android:layout_width="fill_parent" 
		android:layout_height="wrap_content"
		android:background="@color/black">
		
		<TextView 
			android:layout_width="0dip" 
			android:layout_height="fill_parent" 
			android:textColor="#000000" 
			android:layout_weight="0.5" 
			android:paddingLeft="3dp" 
			android:text="ТТН/Дата"
			tools:ignore="HardcodedText"
			android:background="@color/table_caption" 
			android:width="80dp" />

		<TextView  
			android:layout_width="wrap_content" 
			android:layout_height="wrap_content" 
			android:textColor="#000000" 
			android:text="Долг/просроч"
			tools:ignore="HardcodedText"
			android:background="@color/table_caption" 
			android:width="80dp" />
							
		<TextView  
			android:layout_width="wrap_content" 
			android:layout_height="fill_parent" 
			android:textColor="#000000" 
			android:width="80dp" 
			android:text="Дата оплаты" 
			tools:ignore="HardcodedText"
			android:paddingLeft="7dp" 
			android:background="@color/table_caption" 
			 />

		<TextView  
			android:layout_width="wrap_content" 
			android:layout_height="fill_parent" 
			android:textColor="#000000" 
			android:width="90dip"
			android:text="до 5 дн." 
			tools:ignore="HardcodedText"
			android:paddingLeft="7dp" 
			android:background="@color/table_caption" 
			/>
		
		<TextView
			android:layout_width="wrap_content" 
			android:layout_height="fill_parent" 
			android:textColor="#000000" 
			android:width="90dip"
			android:text="от 5 до 16" 
			tools:ignore="HardcodedText"
			android:paddingLeft="7dp" 
			android:background="@color/table_caption" 
			/>
		
		<TextView  
			android:layout_width="wrap_content" 
			android:layout_height="fill_parent" 
			android:textColor="#000000" 
			android:width="90dip"
			android:text="от 16 до 30" 
			
			tools:ignore="HardcodedText"
			android:paddingLeft="7dp" 
			android:background="@color/table_caption" 
			 />
																		
		<TextView
		    android:layout_width="wrap_content"
			android:layout_height="fill_parent" 
			android:width="90dip"
			android:background="@color/table_caption" 
		    android:gravity="right"
		    android:paddingRight="3dp"
		    android:text="более 30 дн"
		    tools:ignore="HardcodedText"
		    android:textColor="#000000" />

	</LinearLayout>
			
	<ExpandableListView android:id="@+id/lvDocs" 
	    android:layout_weight="1"
		android:layout_height="0dp" 
		android:layout_width="fill_parent" 
		android:background="@color/white" />
	
	<LinearLayout android:id="@+id/llTaskBar" 
		android:layout_height="wrap_content" 
		android:layout_width="fill_parent" 
		android:background="@color/footer" 
		android:padding="7dp">
		
		<ImageButton android:layout_width="wrap_content"
		    android:contentDescription="@string/selectDocType" 
			android:layout_height="wrap_content" 
			android:src="@drawable/icon" 
			android:id="@+id/btnDocFilter" android:layout_marginRight="7dp"/>
			
		<ImageButton android:layout_width="wrap_content" 
			android:layout_height="wrap_content" 
			android:src="@drawable/new_order"
			android:contentDescription="@string/newDoc" 
			android:id="@+id/btnNewDoc" android:layout_marginRight="7dp"/>
			
		<ImageButton android:layout_width="wrap_content" 
			android:layout_height="wrap_content" 
			android:id="@+id/btnGpsStatus" 
			android:contentDescription="@string/gpsStatus" 
			android:src="@drawable/gpsno" android:layout_marginRight="7dp"/>
			
		<TextView android:layout_height="wrap_content" 
			android:text="@string/sum" 
			android:textColor="@color/black" 
			android:layout_width="fill_parent" 
			android:layout_gravity="center_vertical" 
			android:gravity="right" android:id="@+id/tvTotalSum"/>
	</LinearLayout>
</LinearLayout>
</android.gesture.GestureOverlayView>