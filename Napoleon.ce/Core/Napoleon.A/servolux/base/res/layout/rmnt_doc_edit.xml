<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:orientation="vertical" >

    <LinearLayout
        android:id="@+id/linearLayout1"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_weight="0"
        android:background="@color/footer"
        android:paddingBottom="10dp"
        android:paddingTop="5dp" >

        <TextView
            android:id="@+id/tvOrg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:lines="1"
            android:scrollHorizontally="true"
            android:text="OrgName"
            android:textColor="@color/black"
            android:textSize="18sp"
            tools:ignore="HardcodedText" >
        </TextView>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/linearLayout2"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical" >

        <LinearLayout
            android:id="@+id/linearLayout3"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_weight="0"
            android:background="@color/black"
            android:orientation="horizontal"
            tools:ignore="NestedWeights" >

            <TextView
                android:id="@+id/tvBrand"
                android:layout_width="wrap_content"
                android:layout_height="fill_parent"
                android:background="@color/table_caption"
                android:gravity="center"
                android:paddingLeft="3dp"
                android:width="@dimen/brand_width"
            	android:text="@string/brand"
                android:textColor="@color/black"
                android:textSize="16sp"
                tools:ignore="HardcodedText" >

            </TextView>
            
        <TextView
            android:id="@+id/tvPrefix"
                android:layout_width="wrap_content"
                android:layout_height="fill_parent"
                android:background="@color/table_caption"
                android:gravity="center"
        		android:layout_marginLeft="1dp"
                android:paddingLeft="3dp"
                android:width="@dimen/prefix_width"
            	android:text="@string/prefix"
                android:textColor="@color/black"
                android:textSize="16sp"
                tools:ignore="HardcodedText"
			 />
            
            <TextView
                android:id="@+id/tvName"
                android:layout_width="0dip"
                android:layout_height="fill_parent"
                android:layout_weight="1"
        		android:layout_marginLeft="1dp"
                android:background="@color/table_caption"
                android:gravity="center"
                android:paddingLeft="3dp"
                android:text="@string/caption"
                android:textColor="@color/black"
                android:textSize="16sp"
                tools:ignore="NestedWeights" >

            </TextView>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical" >

                <TextView
	                    android:id="@+id/tvQtyTitle"
		                android:background="@color/table_caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                		android:textSize="16sp"
                		android:paddingLeft="2dp"
                		android:paddingRight="2dp"
		                android:textColor="@color/black"
		                tools:ignore="HardcodedText"
                        android:text="Остатки по местам продаж" />
                <LinearLayout
                    android:id="@+id/llRestQty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" >

                    <TextView
	                    android:id="@+id/tvWhQty"
		                android:layout_marginLeft="1dp"
		                android:layout_marginTop="1dp"
		                android:paddingRight="2dp"
		                android:background="@color/table_caption"
                        android:layout_width="wrap_content"
                        android:layout_height="fill_parent"
                		android:textSize="16sp"
                		android:gravity="center_horizontal"
		                android:textColor="@color/black"
		                tools:ignore="HardcodedText"
		                android:width="@dimen/rmnt_item"
                        android:text="Склад" />

                </LinearLayout>

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="fill_parent"
                android:layout_marginLeft="1dp"
                android:paddingLeft="2dp"
                android:paddingRight="2dp"
                android:background="@color/table_caption"
                tools:ignore="HardcodedText"
                android:text="Итого"
                android:width="60dp"
                android:gravity="center"
                android:textColor="@color/black" 
                android:textSize="16sp">
            </TextView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="fill_parent"
                android:paddingLeft="2dp"
                android:paddingRight="2dp"
                android:layout_marginLeft="1dp"
                android:background="@color/table_caption"
                tools:ignore="HardcodedText"
                android:text="Приход\nдата ТТН"
                android:gravity="center"
                android:width="80dp"
                android:textColor="@color/black" 
                android:textSize="16sp">
            </TextView>
        </LinearLayout>

        <ListView
            android:id="@+id/lvItems"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@color/white" >
        </ListView>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/linearLayout4"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:background="@color/footer"
        android:orientation="horizontal"
        android:padding="7dp" >
        
        
        <ImageButton
            android:id="@+id/btnSend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/send"
            tools:ignore="ContentDescription" >

        </ImageButton>
    </LinearLayout>
</LinearLayout>