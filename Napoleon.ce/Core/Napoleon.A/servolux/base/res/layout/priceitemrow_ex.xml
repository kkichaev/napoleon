<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/list_selector"
    android:orientation="horizontal" >

    <TextView
        android:id="@+id/tvPriceItemName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="PriceItem"
        android:textColor="@color/black"
        android:textSize="18sp"
        tools:ignore="HardcodedText" />
	
    <TextView
        android:id="@+id/tvPackName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_weight="0"
        android:width="60dp"
        android:text="Pk"
        android:textColor="@color/black"
        android:textSize="18sp"
        tools:ignore="HardcodedText" />

    <TextView
        android:id="@+id/tvThermal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_weight="0"
        android:text="Th"
        android:width="60dp"
        android:textColor="@color/black"
        android:textSize="18sp"
        tools:ignore="HardcodedText" />
	    
    <View style="@style/LeftLine" />
    
    <TextView
        android:id="@+id/tvPrevRestQty"
        style="@style/WarehouseNumItem"
        android:text="PrvRQ"
        tools:ignore="HardcodedText" />
    
    <View style="@style/LeftLine" />
    
    <TextView
        android:id="@+id/tvPrevOrdQty"
        style="@style/WarehouseNumItem"
        android:text="PrvOQ"
        tools:ignore="HardcodedText" />

    <View style="@style/LeftLine" />
    
    <TextView
        android:id="@+id/tvRestQty"
        style="@style/WarehouseNumItem"
        android:text="RQ"
        tools:ignore="HardcodedText" />

    <View style="@style/LeftLine" />
    
    <TextView
        android:id="@+id/tvAutoOrdQty"
        style="@style/WarehouseNumItem"
        android:text="AOQ"
        tools:ignore="HardcodedText" />
    
    <View style="@style/LeftLine" />
    
    <TextView
        android:id="@+id/tvOrdQty"
        style="@style/WarehouseNumItem"
        android:text="OQ"
        tools:ignore="HardcodedText" />
    
    <View style="@style/LeftLine" />
    
    <TextView
        android:id="@+id/tvPlanQty"
        style="@style/WarehouseNumItem"
        android:text="PQ"
        tools:ignore="HardcodedText" />
    
    <View style="@style/LeftLine" />
    
    <TextView
        android:id="@+id/tvFactQty"
        style="@style/WarehouseNumItem"
        android:text="FQ"
        tools:ignore="HardcodedText" />

    <TextView
        android:id="@+id/tvItemID"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingLeft="2dp"
        android:paddingRight="2dp"
        android:text="ID"
        android:textColor="@color/black"
        android:textSize="16sp"
        android:textStyle="italic"
        android:visibility="gone"
        tools:ignore="HardcodedText" />

    <LinearLayout
        android:id="@+id/llQuant"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_weight="0"
        android:orientation="horizontal"
        android:visibility="gone" >

        <TextView
            android:id="@+id/tvClmn1"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="right"
            android:paddingLeft="20dp"
            android:paddingRight="5dp"
            android:text="Clmn1"
            android:textColor="@color/black"
            android:textSize="18sp"
            tools:ignore="HardcodedText,NestedWeights" >

        </TextView>

        <TextView
            android:id="@+id/tvClmn2"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="right"
            android:paddingLeft="5dp"
            android:paddingRight="5dp"
            android:text="Clmn2"
            android:textColor="@color/black"
            android:textSize="18sp"
            tools:ignore="HardcodedText" >

        </TextView>
    </LinearLayout>
    
</LinearLayout>