<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:orientation="vertical" >

    <HorizontalScrollView
        android:id="@+id/hswPricePage"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:background="@color/footer" 
        android:visibility="gone" >

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" >

            <TextView
                android:id="@+id/tvHome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableLeft="@drawable/price_home"
                android:gravity="center_vertical"
                android:textColor="@color/black"
                tools:ignore="HardcodedText" />

            <LinearLayout
                android:id="@+id/llPath"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:orientation="horizontal" >
            </LinearLayout>
        </LinearLayout>
    </HorizontalScrollView>

    <LinearLayout
        android:id="@+id/llPriceControl"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_weight="0"
        android:background="#80ffcc"
        android:paddingBottom="10dp"
        android:paddingTop="5dp"
        android:visibility="visible" >

        <ImageView
            android:id="@+id/ivGoUp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/goup"
            tools:ignore="ContentDescription" >
        </ImageView>

        <LinearLayout
            android:id="@+id/llLables"
            android:layout_width="0dp"
            android:layout_height="fill_parent"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:padding="0dp"
            tools:ignore="NestedWeights" >

            <TextView
                android:id="@+id/tvItemSelectUpLevel"
                android:layout_width="0dp"
                android:layout_height="fill_parent"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:lines="1"
                android:scrollHorizontally="true"
                android:text="@string/price"
                android:textColor="@color/dark_blue"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:ignore="NestedWeights" >
            </TextView>
        </LinearLayout>

        <ImageView
            android:id="@+id/ivFilter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="5dp"
            android:layout_marginTop="5dp"
            android:src="@drawable/filter"
            android:visibility="gone"
            tools:ignore="ContentDescription" >
        </ImageView>
    </LinearLayout>

    <LinearLayout
        android:background="@color/black"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        >

        <TextView
            android:id="@+id/tvSortName"
	        android:background="#80ffcc"
            android:layout_width="wrap_content"
            android:layout_height="fill_parent"
            android:gravity="center_vertical"
            android:textSize="16sp"
            android:paddingRight="16dp"
            android:text="@string/item_name"
            android:textColor="@color/black" />

        <TextView
            android:id="@+id/tvSortPack"
	        android:background="#80ffcc"
            android:layout_width="wrap_content"
            android:layout_height="fill_parent"
            android:gravity="center_vertical"
            android:textSize="16sp"
            android:paddingRight="16dp"
            android:text="@string/pack_name"
            android:textColor="@color/black" />

        <TextView
            android:id="@+id/tvSortTherm"
	        android:background="#80ffcc"
            android:layout_width="0dip"
            android:layout_height="fill_parent"
            android:gravity="center_vertical"
            android:text="@string/state"
            android:textColor="@color/black"
            android:paddingRight="5dp"
            android:layout_weight="1"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="fill_parent"
            android:orientation="vertical" >

            <TextView
                android:id="@+id/tvPrevDate"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="1dp"
                android:layout_marginLeft="1dp"
                android:background="#80ffcc"
                android:gravity="center_horizontal"
                android:text="tvPrevDate"
                android:textColor="@color/black"
                tools:ignore="HardcodedText" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="fill_parent" >

                <TextView
                    style="@style/WarehouseNumItemHead"
                    tools:ignore="HardcodedText"
                    android:text="остатки" />

                <TextView
                    style="@style/WarehouseNumItemHead"
                    tools:ignore="HardcodedText"
                    android:text="продажи" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical" >

            <TextView
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:background="#80ffcc"
                android:gravity="center_horizontal"
                android:layout_marginLeft="1dp"
                android:layout_marginBottom="1dp"
                tools:ignore="HardcodedText"
                android:text="сегодня"
                android:textColor="@color/black" />

            <LinearLayout                
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" >

                <TextView
                    style="@style/WarehouseNumItemHead"
                    tools:ignore="HardcodedText"
                    android:text="остатки" />

                <TextView
                    style="@style/WarehouseNumItemHead"
                    tools:ignore="HardcodedText"
                    android:text="рек.заказ" />

				<TextView
                    style="@style/WarehouseNumItemHead"
                    tools:ignore="HardcodedText"
                    android:text="заказ" />
            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="fill_parent"
            android:orientation="vertical" >

            <TextView
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:background="#80ffcc"
                android:gravity="center_horizontal"
                android:layout_marginLeft="1dp"
                android:layout_marginBottom="1dp"
                tools:ignore="HardcodedText"
                android:text="на день"
                android:textColor="@color/black" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="fill_parent" >

                <TextView
                    style="@style/WarehouseNumItemHead"
                    tools:ignore="HardcodedText"
                    android:text="план" />

                <TextView
                    style="@style/WarehouseNumItemHead"
                    tools:ignore="HardcodedText"
                    android:text="факт" />

            </LinearLayout>

        </LinearLayout>
        
    </LinearLayout>
    
    <FrameLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:background="@color/white" 
        android:layout_weight="1">

        <ListView
            android:id="@+id/lvOrderItemSelect"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:background="#c0ccff"/>

        <ImageView
            android:id="@+id/ivFilterLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="right|bottom"
            android:layout_marginBottom="20dp"
            android:layout_marginRight="10dp"
            android:layout_marginTop="10dp"
            android:src="@drawable/filter"
            android:visibility="gone"
            tools:ignore="ContentDescription" >
        </ImageView>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/llFind"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:orientation="horizontal" >

        <EditText
            android:id="@+id/edFind"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginLeft="3dp"
            android:layout_marginRight="3dp"
            android:layout_weight="1"
            tools:ignore="TextFields" />

        <ImageButton
            android:id="@+id/btnDelFind"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_delete"
            tools:ignore="ContentDescription" />

        <Spinner
            android:id="@+id/spFind"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:entries="@array/wh_find_choices"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:background="@color/footer"
        android:orientation="horizontal"
        android:paddingLeft="7dp">
    	<LinearLayout
                android:layout_width="fill_parent"
                android:layout_height="wrap_content" 
                android:background="@android:color/black"
                android:orientation="horizontal">
            
    	    <TextView
                    style="@style/WarehouseNumItemHead"
                    android:layout_weight="1"
                    tools:ignore="HardcodedText"
                    android:layout_margin="0dp"
                    android:layout_width="0dip"
                    android:gravity="right"
                    android:paddingRight="10dp"
                    android:text="Итого" />
    	    
                <TextView
                    android:id="@+id/tvPrevRest"
                    style="@style/WarehouseNumItemHead"
                    tools:ignore="HardcodedText"
                    android:text="" />

                <TextView
                    android:id="@+id/tvPrevSales"
                    style="@style/WarehouseNumItemHead"
                    tools:ignore="HardcodedText"
                    android:text="" />

                <TextView
                    android:id="@+id/tvCurRest"
                    style="@style/WarehouseNumItemHead"
                    tools:ignore="HardcodedText"
                    android:text="" />
                
                <TextView
                    android:id="@+id/tvAutoOrder"
                    style="@style/WarehouseNumItemHead"
                    tools:ignore="HardcodedText"
                    android:text="" />
                
                <TextView
                    android:id="@+id/tvCurOrder"
                    style="@style/WarehouseNumItemHead"
                    tools:ignore="HardcodedText"
                    android:text="" />
                
                <TextView
                    android:id="@+id/tvPlan"
                    style="@style/WarehouseNumItemHead"
                    tools:ignore="HardcodedText"
                    android:text="" />
                
                <TextView
                    android:id="@+id/tvFact"
                    style="@style/WarehouseNumItemHead"
                    tools:ignore="HardcodedText"
                    android:text="" />
                
            </LinearLayout>
    </LinearLayout>
    
    <LinearLayout
        android:id="@+id/linearLayout1"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:background="@color/footer"
        android:orientation="horizontal"
        android:padding="7dp">

        <ImageButton
            android:id="@+id/btnUp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="7dp"
            android:src="@drawable/up"
            tools:ignore="ContentDescription" />

        <ImageButton
            android:id="@+id/btnDown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="7dp"
            android:src="@drawable/down"
            tools:ignore="ContentDescription" />

        <ImageButton
            android:id="@+id/btnLines"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="7dp"
            android:src="@drawable/line_2"
            tools:ignore="ContentDescription" />

        <ImageButton
            android:id="@+id/btnFind"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="7dp"
            android:src="@drawable/find"
            tools:ignore="ContentDescription" />

        <ImageButton
            android:id="@+id/btnPack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="4dp"
            android:src="@drawable/pack_off"
            android:visibility="gone"
            tools:ignore="ContentDescription" />

		<ImageButton
		    tools:ignore="ContentDescription"
           android:id="@+id/ibNextPrice"
           android:layout_width="wrap_content"
           android:layout_height="wrap_content"
           android:src="@drawable/next_matrix" />        
        
        <TextView
            android:id="@+id/tvTotalSum"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:gravity="right"
            android:text="@string/sum"
            android:textColor="@color/black"
            android:textSize="16sp" />
    </LinearLayout>

</LinearLayout>