<?xml version="1.0" encoding="utf-8" standalone="no"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" android:versionName="@string/version" package="com.grsoft.napoleon2" android:versionCode="4">
      
    <supports-screens android:resizeable="true"/>
    <uses-sdk android:minSdkVersion="4"/>
    <uses-permission android:name="android.permission.CALL_PHONE"/>
    <uses-permission android:name="android.permission.INTERNET"/>  
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-feature android:name="android.hardware.camera"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    
    <!-- Camera features. I think it can bring an installation problem 
    	
 		<uses-feature android:name="android.hardware.camera.autofocus" />  
 		-->
 	
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.VIBRATE"/>
    <uses-permission android:name="android.permission.CALL_PHONE"></uses-permission>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    
    <!--  
    	<uses-permission android:name="android.permission.FLASHLIGHT"/>
    	<uses-feature android:name="android.hardware.camera.flash" />
 	-->
 	
    <application android:debuggable="true" android:icon="@drawable/pictograms" android:label="@string/app_name" android:name="com.grsoft.napoleon.NapoleonApp">
    
    	<receiver android:enabled="true" android:permission="android.permission.RECEIVE_BOOT_COMPLETED" android:name="com.grsoft.util.BootUpReceiver">

        	<intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <category android:name="android.intent.category.DEFAULT" />
        	</intent-filter>
		</receiver>
    	
    	<activity android:label="@string/app_name" android:launchMode="singleTask" android:name="com.grsoft.napoleon.NapoleonEx">
        	
        	<intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
		
		<uses-library android:name="android.test.runner"/>
		
		<activity android:name="com.grsoft.napoleon.Configuration"/>
		<activity android:configChanges="keyboardHidden|orientation" android:name="com.grsoft.napoleon.UpdateDB"/>
		<activity android:name="com.grsoft.napoleon.VisitEdit"/>
		<activity android:name="com.grsoft.napoleon.DocumentsEx"/>
		<activity android:name="com.grsoft.napoleon.CreateOrder"/>
		<activity android:name="com.grsoft.napoleon.WarehouseNew" android:configChanges="keyboardHidden|orientation"/>
		<activity android:name="com.grsoft.napoleon.PriceCount"/>
		<activity android:name="com.grsoft.napoleon.OrderDetail"/>
		<activity android:name="com.grsoft.napoleon.DeliveryDetail"/>
		<activity android:name="com.grsoft.napoleon.CameraPreview"/>
		<activity android:name="com.grsoft.napoleon.DocList"/>
		<activity android:name="com.grsoft.napoleon.Messages"/>
		<activity android:name="com.grsoft.napoleon.RemnantsDetail"/>
		<activity android:name="com.grsoft.napoleon.Setting" android:configChanges="keyboardHidden|orientation"/>
		<activity android:name="com.grsoft.napoleon.PhotoSetting"/>
		<activity android:name="com.grsoft.napoleon.BehaviorSetting"/>
		<activity android:name="com.grsoft.napoleon.GpsSetting"/>
		<service android:name="com.grsoft.util.NapoleonService"/>
		<activity android:name="com.grsoft.napoleon.OrderDeliveryDetail"/>
		<activity android:name="com.grsoft.napoleon.PricePresentation" android:noHistory="true"/>
		<activity android:name="com.grsoft.napoleon.Presentation"/>
		<activity android:name="com.grsoft.napoleon.WarehouseSetting"></activity>
        <activity android:name="com.grsoft.napoleon.QuestAnswer"></activity>
        <activity android:name="com.grsoft.napoleon.QuestionWebView"></activity>
				
		<receiver android:name="com.grsoft.util.SystemActionReciever" 
 			android:permission="android.permission.RECEIVE_BOOT_COMPLETED">
 		
			<intent-filter>
				<action android:name="android.location.PROVIDERS_CHANGED"/>
				<action android:name="android.intent.action.TIME_SET"/>
				<action android:name="android.intent.action.BOOT_COMPLETED"/>
				<action android:name="android.intent.action.ACTION_SHUTDOWN"/>
				<category android:name="android.intent.category.DEFAULT" />
			</intent-filter>
		</receiver>
		
		<activity android:name="com.grsoft.napoleon.CrashReport"></activity>
		<activity android:name="com.grsoft.napoleon.PotenzialOrg"></activity>
		<activity android:name="com.grsoft.napoleon.TaskForm"></activity>
		<activity android:name="com.grsoft.napoleon.FocusItemEditor"></activity>
		<activity android:name="com.grsoft.napoleon.UpdateDBEx" android:configChanges="keyboardHidden|orientation"></activity>
		<activity android:name="com.grsoft.napoleon.WarehouseBase"></activity>
		<activity android:name="com.grsoft.napoleon.DocumentsClassic"></activity>
		<activity android:name="com.grsoft.napoleon.OrderDetailClassic"></activity>
		<activity android:name="com.grsoft.napoleon.FocusedItemEditorEx"></activity>
		<activity android:name="com.grsoft.napoleon.DocumentsPrint"></activity>
		<activity android:name="com.grsoft.napoleon.SalesProperties"></activity>
		<activity android:name="com.grsoft.napoleon.SalesDetail"></activity>
		<activity android:name="com.grsoft.napoleon.IncassEdit"></activity>
  		<activity android:name="com.grsoft.napoleon.ScriptEdit"></activity>
		<activity android:name="com.grsoft.napoleon.VanRestReport"></activity>
		<activity android:name="com.grsoft.script.ScriptEdit"/>
		<activity android:name="com.grsoft.napoleon.CalendarActivity"/>
		<service android:name="com.grsoft.util.ReportService"/>
        <activity android:name="OrgTaskList" />
</application>

    <instrumentation android:label="All Tests" android:name="com.grsoft.tests.NapoleonInstrumentationTestRunner" android:targetPackage="grsoft.napoleon"/>
</manifest>
