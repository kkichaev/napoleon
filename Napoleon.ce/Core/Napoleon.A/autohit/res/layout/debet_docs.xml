<?xml version="1.0" encoding="utf-8"?>
<android.gesture.GestureOverlayView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/gestures"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:gestureStrokeType="single"
    android:eventsInterceptionEnabled="true"
    android:orientation="vertical"
    android:gestureColor="#00000000"
    android:uncertainGestureColor="#00000000">
    
<LinearLayout
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:background="@color/white"
    android:baselineAligned="false"
    android:orientation="vertical" >
	
	<LinearLayout 
		android:id="@+id/llHeader" 
		android:layout_height="wrap_content" 
		android:orientation="horizontal" 
		android:layout_width="fill_parent" 
		android:background="#80ffcc" 
		android:paddingBottom="10dp" 
		android:paddingTop="5dp">
		
		<TextView android:textColor="#000000"
			android:text="@string/organization" 
			android:id="@+id/tvOrgInfo" 
			android:layout_width="wrap_content" 
			android:layout_height="wrap_content" 
			android:textSize="18sp" 
			android:layout_marginLeft="3dp" 
			android:layout_marginRight="3dp" />
	</LinearLayout>

	<LinearLayout android:id="@+id/LinearLayout04" 
		android:layout_width="fill_parent" 
		android:layout_height="wrap_content"
		android:background="@color/black">
		
		<TextView android:id="@+id/NameTitle" 
			android:layout_width="wrap_content" 
			android:layout_height="wrap_content" 
			android:textColor="#000000" 
			android:layout_weight="0.5" 
			android:background="@color/table_caption" 
			android:width="80dp" />
			
		<TextView android:id="@+id/DateTitle" 
			android:layout_width="wrap_content" 
			android:layout_height="wrap_content" 
			android:textColor="#000000" 
			android:layout_weight="0.25" 
			android:text="@string/date" 
			android:paddingLeft="7dp" 
			android:background="@color/table_caption" 
			android:layout_marginLeft="1dp" />
			
		<TextView android:id="@+id/SumColumnTitle" 
			android:layout_width="wrap_content" 
			android:layout_height="wrap_content" 
			android:textColor="#000000" 
			android:layout_weight="0.25" 
			android:text="@string/sum" 
			android:gravity="right" 
			android:background="@color/table_caption" 
			android:layout_marginLeft="1dp" 
			android:paddingRight="3dp" />
	</LinearLayout>
			
	<ExpandableListView android:id="@+id/lvDocs" 
	    android:layout_weight="1"
		android:layout_height="0dp" 
		android:layout_width="fill_parent" 
		android:background="@color/white" />
	
	<LinearLayout android:id="@+id/llTaskBar" 
		android:layout_height="wrap_content" 
		android:layout_width="fill_parent" 
		android:background="@color/footer" 
		android:padding="7dp">
		
		<ImageButton android:layout_width="wrap_content"
		    android:contentDescription="@string/selectDocType" 
			android:layout_height="wrap_content" 
			android:src="@drawable/icon" 
			android:id="@+id/btnDocFilter" android:layout_marginRight="7dp"/>
			
		<ImageButton android:layout_width="wrap_content" 
			android:layout_height="wrap_content" 
			android:src="@drawable/new_order"
			android:contentDescription="@string/newDoc" 
			android:id="@+id/btnNewDoc" android:layout_marginRight="7dp"/>
			
		<ImageButton android:layout_width="wrap_content" 
			android:layout_height="wrap_content" 
			android:id="@+id/btnGpsStatus" 
			android:contentDescription="@string/gpsStatus" 
			android:src="@drawable/gpsno" android:layout_marginRight="7dp"/>
			
		<TextView android:layout_height="wrap_content" 
			android:text="@string/sum" 
			android:textColor="@color/black" 
			android:layout_width="fill_parent" 
			android:layout_gravity="center_vertical" 
			android:gravity="right" android:id="@+id/tvTotalSum"/>
	</LinearLayout>
</LinearLayout>
</android.gesture.GestureOverlayView>