<?xml version="1.0" encoding="utf-8"?>
<android.gesture.GestureOverlayView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/gestures"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:eventsInterceptionEnabled="true"
    android:gestureColor="#00000000"
    android:gestureStrokeType="single"
    android:orientation="vertical"
    android:uncertainGestureColor="#00000000" >

    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:orientation="vertical" >

        <LinearLayout
            android:id="@+id/llFilterPanel"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:background="@color/footer"
            android:orientation="vertical"
            android:paddingBottom="5dp"
            android:paddingTop="5dp" >

            <TextView
                android:id="@+id/tvFilter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="TextView"
                android:textColor="@color/black"
                tools:ignore="HardcodedText" >
            </TextView>
        </LinearLayout>

        <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="50dp"
            android:background="@color/black"
            android:orientation="horizontal"
            android:padding="0.5dp" >

            <LinearLayout
                android:layout_width="70dp"
                android:layout_height="match_parent"
                android:orientation="vertical" >

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="0dip"
                    android:layout_weight="0.5"
                    android:background="@color/white"
                    android:gravity="center"
                    android:text="Дата /" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="0dip"
                    android:layout_weight="0.5"
                    android:background="@color/white"
                    android:gravity="center"
                    android:text="Номер" />
            </LinearLayout>

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_gravity="center_vertical"
                android:layout_marginLeft="0.5dp"
                android:layout_marginRight="0.5dp"
                android:layout_weight="1"
                android:background="@color/white"
                android:gravity="center"
                android:text="Наименование товара" />

            <LinearLayout
                android:layout_width="@dimen/sum_width"
                android:layout_height="match_parent"
                android:orientation="vertical" >

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="0dip"
                    android:background="@color/white"
                    android:layout_weight="0.5"
                    android:gravity="center"
                    android:text="Цена CC" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="0dip"
                    android:layout_gravity="bottom"
                    android:layout_weight="0.5"
                    android:background="@color/white"
                    android:gravity="center"
                    android:text="/ % ск." />
            </LinearLayout>

            <TextView
                android:layout_width="@dimen/sum_width"
                android:layout_height="match_parent"
                android:layout_gravity="bottom"
                android:background="@color/white"
                android:layout_marginLeft="0.5dp"
                android:gravity="center"
                android:text="Кол." />

            <TextView
                android:layout_width="@dimen/sum_width"
                android:layout_height="match_parent"
                android:layout_gravity="bottom"
                android:layout_marginLeft="0.5dp"
                android:background="@color/white"
                android:gravity="center"
                android:text="Сумма" />
        </LinearLayout>

        <ListView
            android:id="@+id/lvDocs"
            android:layout_width="fill_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/white"
            android:clickable="true" />

        <LinearLayout
            android:id="@+id/linearLayout1"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:background="@color/footer"
            android:orientation="horizontal"
            android:padding="7dp" >

            <ImageButton
                android:id="@+id/btnDocFilter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="7dp"
                android:src="@drawable/icon"
                tools:ignore="ContentDescription" />

            <ImageButton
                android:id="@+id/btnSend"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="7dp"
                android:src="@drawable/send"
                tools:ignore="ContentDescription" />

            <ImageButton
                android:id="@+id/btnDelete"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="7dp"
                android:src="@drawable/left"
                tools:ignore="ContentDescription" />

            <ImageButton
                android:id="@+id/btnFilter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/filter"
                tools:ignore="ContentDescription" >
            </ImageButton>

            <TextView
                android:id="@+id/tvDocSum"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_weight="1"
                android:gravity="right"
                android:text="tvDocSum"
                android:textColor="@color/black"
                android:textStyle="bold"
                tools:ignore="HardcodedText" >
            </TextView>
        </LinearLayout>
    </LinearLayout>

</android.gesture.GestureOverlayView>