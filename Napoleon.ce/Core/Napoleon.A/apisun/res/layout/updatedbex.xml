<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:orientation="vertical" >

    <ScrollView
        android:id="@+id/svScroll"
        android:layout_width="fill_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:keepScreenOn="true" >

        <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" >

            <LinearLayout
                android:id="@+id/LinearLayout02"
                android:layout_width="fill_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                tools:ignore="UselessParent" >

                <LinearLayout
                    android:id="@+id/linearLayout1"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" >

                    <LinearLayout
                        android:id="@+id/linearLayout2"
                        android:layout_width="fill_parent"
                        android:layout_height="fill_parent"
                        android:layout_marginBottom="2dp"
                        android:orientation="vertical" >

                        <CheckBox
                            android:id="@+id/cbClearDB"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/clear_base" />
                        
		                <TextView
		                    android:id="@+id/tvSyncClearDB"
		                    android:layout_width="wrap_content"
		                    android:layout_height="wrap_content"
		                    android:layout_gravity="top|right"
		                    android:gravity="right"
		                    android:paddingLeft="2dp"
		                    android:paddingRight="8dp"
		                    android:text="20:12 12.10.15"
		                    android:textSize="12sp"
		                    android:visibility="gone"
		                    tools:ignore="HardcodedText" />

                        </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/LinearLayout03"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="2dp" >

                    <CheckBox
                        android:id="@+id/cbGenData"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="@string/gen_data" />

                    <CheckBox
                        android:id="@+id/cbRemains"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="@string/remains_la_zero" />
                </LinearLayout>
                
                <CheckBox
                    android:id="@+id/cbPlanogramm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/planogramm" />

                <TextView
                    android:id="@+id/tvSyncCommon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|right"
                    android:paddingRight="8dp"
                    android:text="20:12 12.10.15"
                    android:textSize="12sp"
                    android:visibility="gone"
                    tools:ignore="HardcodedText" />

                <CheckBox
                    android:id="@+id/cbDocs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/gen_docs" />

                <TextView
                    android:id="@+id/tvSyncDocs"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|right"
                    android:paddingRight="8dp"
                    tools:ignore="HardcodedText"
                    android:text="20:12 12.10.15"
                    android:textSize="12sp" />

                <CheckBox
                    android:id="@+id/cbVisit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/photo_visit" />

                <TextView
                    android:id="@+id/tvSyncVisits"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|right"
                    android:paddingRight="8dp"
                    tools:ignore="HardcodedText"
                    android:text="20:12 12.10.15"
                    android:textSize="12sp" />
                
                <CheckBox
                    android:id="@+id/cbPresent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/presents" />
                
                <TextView
                    android:id="@+id/tvSyncPhoto"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|right"
                    android:paddingRight="8dp"
                    tools:ignore="HardcodedText"
                    android:text="20:12 12.10.15"
                    android:textSize="12sp" />
                
                <CheckBox
                    android:id="@+id/cbCost"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/costs" />
                
                <TextView
                    android:id="@+id/tvSyncCost"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|right"
                    android:paddingRight="8dp"
                    tools:ignore="HardcodedText"
                    android:text="20:12 12.10.15"
                    android:textSize="12sp" />
                
                <CheckBox
                    android:id="@+id/cbDebt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/shipped_and_debts" />
                <TextView
                    android:id="@+id/tvSyncDebt"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|right"
                    android:paddingRight="8dp"
                    tools:ignore="HardcodedText"
                    android:text="20:12 12.10.15"
                    android:textSize="12sp" />
                

                <LinearLayout
                    android:id="@+id/linearLayout3"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent">

                    <LinearLayout
                        android:id="@+id/linearLayout4"
                        android:layout_width="fill_parent"
                        android:layout_height="fill_parent"
                        android:layout_marginTop="2dp">

                        <CheckBox
                            android:id="@+id/cbRecreateStory"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/recreate_order" />

                        <Spinner
                            android:id="@+id/spMonthRecreate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:entries="@array/months_to_recreate"
                            android:paddingLeft="2sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/LinearLayout01"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content" >

        <Button
            android:id="@+id/btnSettings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/settings" />

        <Button
            android:id="@+id/btnUpdate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:text="@string/update" />
    </LinearLayout>
</LinearLayout>