<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:android="http://schemas.android.com/apk/res/android">

    <color name="appBackground">#FFFFFFFF</color>
    <color name="defaultTextColor">#000000</color>
    <color name="pageIndicatorFooterColor">#008fdd</color>
    <color name="indicatorSelectedColor">#008fdd</color>
    <color name="managerTitle">#FFFFFF</color>
    <color name="button_panel">#c8c8ff</color>
    <color name="reportTableHeaderBackgroundColor">#DDDDDD</color>
    <color name="toxic_green">#00a808</color>
    <color name="lightgrey">#f0f0f0</color>
    <color name="grey">#888888</color>
    <color name="white">#ffffff</color>
    <color name="black">#000000</color>
    <color name="documentsHeadBack">#008fdd</color>
    <color name="mainCalendarBack">#b4c8ff</color>
    <color name="mainHeadBack">#ffffff</color>
    <color name="orgMissingBack">#f7f7f9</color>
    <color name="progressLowBackgroundColor">#F80909</color>
    <color name="progressLowBorderColor">#bf0707</color>
    <color name="progressMediumBackgroundColor">#fbf250</color>
    <color name="progressMediumBorderColor">#e8df49</color>
    <color name="progressHighBackgroundColor">#4cf85c</color>
    <color name="progressHighBorderColor">#299333</color>

    <style name="HeaderRow">
        <item name="android:background">@color/reportTableHeaderBackgroundColor</item>
        <item name="android:layout_width">fill_parent</item>
        <item name="android:layout_height">fill_parent</item>
    </style>
    
    <style name="MainHeader">
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">16sp</item>
        <item name="android:paddingBottom">2dp</item>
        <item name="android:paddingTop">2dp</item>
    </style>

    <style name="HeaderText">
        <item name="android:textColor">#000000</item>
        <item name="android:shadowColor">#AFFFFFFF</item>
        <item name="android:shadowDx">1</item>
        <item name="android:shadowDy">1</item>
        <item name="android:shadowRadius">1.0</item>
        <item name="android:padding">6dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:background">@drawable/border</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="TaskTable">
        <item name="android:paddingLeft">4dp</item>
        <item name="android:layout_marginBottom">1dp</item>
        <item name="android:background">@color/white</item>
	</style>
	
    <style name="TaskRow" parent="@style/TaskTable">
        <item name="android:textSize">18sp</item>
        <item name="android:background">@android:color/transparent</item>
        </style>
    
    <style name="BodyRow">
        <item name="android:background">#DFDFDF</item>
        <item name="android:layout_width">fill_parent</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="BodyText">
        <item name="android:textColor">#000000</item>
        <item name="android:shadowColor">#AFFFFFFF</item>
        <item name="android:shadowDx">1</item>
        <item name="android:shadowDy">1</item>
        <item name="android:shadowRadius">1.0</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">normal</item>
        <!-- <item name="android:background">@drawable/border</item> -->
        <item name="android:background">#FFF</item>
        <item name="android:padding">4dp</item>
        <!--
     <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item> 
        <item name="android:padding">5dp</item>
        <item name="android:gravity">center</item>
        -->
    </style>

    <style name="tableText">
        <item name="android:textColor">@color/defaultTextColor</item>
        <item name="android:textSize">18sp</item>
        <item name="android:layout_gravity">center_vertical</item>
    </style>
    
    <style name="taskHead">
        <item name="android:textSize">18sp</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="tableTextGroup" parent="tableText">
        <item name="android:textStyle">bold</item>
    </style>

    <style name="tablePhoneStyle">
        <item name="android:textColor">@color/defaultTextColor</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:autoLink">phone</item>
    </style>

    <style name="tableSyncStyle">
        <item name="android:textColor">@color/defaultTextColor</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="tableDistanceStyle">
        <item name="android:textColor">@color/defaultTextColor</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">normal</item>
    </style>
    
    <style name="AboutDialog" parent="@android:style/Theme.Dialog">
		<item name="android:textColor">@color/white</item>
	</style>
	
    <style name="spinnerItem" parent="@android:style/Widget.TextView">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/black</item>
    </style> 
    
    <style name="formHeader">
        <item name="android:background">@drawable/managertitlebackground</item>
    </style>
    
    <style name="formHeaderText" parent="@android:style/Widget.TextView">
        <item name="android:textColor">@color/managerTitle</item>
        <item name="android:textSize">@dimen/managerTitleFontSize</item>
    </style>
    
    <style name="tableHeaderText" parent="@android:style/Widget.TextView">
        <item name="android:textColor">@color/blue</item>
        <item name="android:textSize">18sp</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:layout_marginBottom">6dp</item>
    </style>
    
    <style name="actionBarText" parent="@android:style/Widget.TextView">
        <item name="android:textColor">@color/actionbartextcolor</item>
        <item name="android:textSize">22sp</item>
    </style>
    
    <style name="reportHeaderText" parent="@android:style/Widget.TextView">
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    
    <style name="reportDescribeText" parent="@android:style/Widget.TextView">
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">20sp</item>
    </style>
</resources>