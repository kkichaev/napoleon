#
# общие переменные для сборки
# необходимо определить ROOT и MAKE
#

ROOT = $(NAPOLEON_ROOT)
#/cygdrive/c/Works/Napoleon.ce
ifeq ($(ROOT),)
   $(error "need set NAPOLEON_ROOT in environment, eg. NAPOLEON_ROOT = /cygdrive/c/Works/Napoleon.ce  ")
endif

MAKE = make
PLATFORM = armv4i

tmpVar = $(subst /, ,$(ROOT))
WIN_DRIVE := $(word 2, $(tmpVar)):
CYG_DRIVE := /$(word 1, $(tmpVar))/$(word 2, $(tmpVar))

#
# определение производных переменных
#
DEBUG_DIR=$(ROOT)/bin/Debug
RELEASE_DIR=$(ROOT)/bin/Release
PROJECT_DIR=$(ROOT)/Projects

ifdef DEBUG
 INT_DIR = $(DEBUG_DIR)/$(PROJECT)/$(PROGRAM)
 OUT_DIR = $(DEBUG_DIR)/$(PROJECT)
else
 INT_DIR = $(RELEASE_DIR)/$(PROJECT)/$(PROGRAM)
 OUT_DIR = $(RELEASE_DIR)/$(PROJECT)
endif

